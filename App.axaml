<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FujinTerm.App"
             RequestedThemeVariant="Dark">
    <!-- Dark variant matches the skeleton's chrome palette. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Skeleton-derived design tokens. See docs/UI-design-spec.md
                     and docs/skeleton/main-shell.jsx for the source values.
                     Issue #4 tracks moving these into user preferences. -->
                <ResourceInclude Source="avares://FujinTerm/Themes/Palette.axaml"/>
                <ResourceInclude Source="avares://FujinTerm/Themes/Typography.axaml"/>
                <ResourceInclude Source="avares://FujinTerm/Themes/Density.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Fluent theme styles the standard chrome (buttons, text boxes,
             scrollbars). The terminal area itself is rendered manually and
             ignores these styles. PR 1.1.b layers FujinTerm-specific style
             overrides on top of Fluent. -->
        <FluentTheme />
    </Application.Styles>
</Application>
