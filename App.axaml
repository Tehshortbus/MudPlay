<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FujinTerm.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the OS light/dark setting. -->

    <Application.Styles>
        <!-- Fluent theme styles the standard chrome (buttons, text boxes,
             scrollbars). The terminal area itself is rendered manually and
             ignores these styles. -->
        <FluentTheme />
    </Application.Styles>
</Application>
