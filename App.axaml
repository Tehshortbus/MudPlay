<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FujinTerm.Controls"
             x:Class="FujinTerm.App"
             RequestedThemeVariant="Dark">
    <!-- Dark variant matches the skeleton's chrome palette. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Skeleton-derived design tokens. See docs/UI-design-spec.md
                     and docs/skeleton/main-shell.jsx for the source values.
                     Issue #4 tracks moving these into user preferences. -->
                <ResourceInclude Source="avares://FujinTerm/Themes/Palette.axaml"/>
                <ResourceInclude Source="avares://FujinTerm/Themes/Typography.axaml"/>
                <ResourceInclude Source="avares://FujinTerm/Themes/Density.axaml"/>
                <ResourceInclude Source="avares://FujinTerm/Themes/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Fluent theme styles the standard chrome (buttons, text boxes,
             scrollbars). The terminal area itself is rendered manually and
             ignores these styles. The FujinTerm overrides in Controls.axaml
             layer on top — they only touch chrome surfaces tagged with style
             classes (Menu.Chrome, Border.Toolbar, Button.ToolbarBtn, etc.) so
             unscoped controls keep the Fluent baseline. -->
        <FluentTheme />
        <!-- DataGrid ships its theme separately from FluentTheme; without
             this the Game Data Browser grids render with no chrome. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <!-- The stock DataGrid header ellipsis-trims its label and reserves
             padding plus a sort-glyph slot, so even a short header like "Str"
             clips inside an otherwise roomy column. Render the label in a
             non-trimming TextBlock and tighten the padding so the full text
             always shows across every grid in the app. ReflectionBinding
             (empty path -> the header string) matches the compiled-binding
             fallback the grids' cells already use. Must sit after the DataGrid
             Fluent StyleInclude to override its DataGridColumnHeader template. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="4,0,2,0"/>
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <TextBlock Text="{ReflectionBinding}" TextTrimming="None"/>
                </DataTemplate>
            </Setter>
        </Style>
        <StyleInclude Source="avares://FujinTerm/Themes/Controls.axaml"/>
        <!-- Click any modeless tool window to raise it above its siblings — owned
             windows don't auto-raise on click on several Linux WMs. See
             WindowBehaviors.RaiseToFrontOnClick. -->
        <Style Selector="Window">
            <Setter Property="controls:WindowBehaviors.RaiseToFrontOnClick" Value="True"/>
        </Style>
    </Application.Styles>
</Application>
