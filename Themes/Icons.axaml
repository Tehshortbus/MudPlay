<!--
  Geometry resources for the toolbar / menu / status-bar icon set, ported
  from docs/skeleton/main-shell.jsx (the `Icon` component's `paths` map).
  All SVG paths are authored on the 24×24 grid the skeleton uses; consumers
  render them inside a 16×16 (toolbar) or 12×12 (title-bar / muted) box via
  Path Stretch="Uniform".

  Stroke style at the call site: 1.5 px stroke, round caps + joins, no fill.
  Mirrors the skeleton's `<svg fill="none" strokeWidth="1.5"
  strokeLinecap="round" strokeLinejoin="round">` baseline so a port stays
  pixel-faithful.

  Naming: matches the skeleton's keys verbatim (so "IconPlug" ≡ skeleton's
  `plug`) for grep-back convenience. New icons get appended; never reuse a
  key for a different glyph.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Connection -->
    <StreamGeometry x:Key="IconPlug">M9 4 V8 M15 4 V8 M7 8 H17 V14 H7 Z M12 14 V17 A3 3 0 0 0 15 20</StreamGeometry>
    <StreamGeometry x:Key="IconUnplug">M9 4 V8 M15 4 V8 M7 8 H17 V14 H7 Z M5 19 L19 5</StreamGeometry>

    <!-- Settings -->
    <StreamGeometry x:Key="IconGear">M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z M12 2 V5 M12 19 V22 M4.2 4.2 L6.3 6.3 M17.7 17.7 L19.8 19.8 M2 12 H5 M19 12 H22 M4.2 19.8 L6.3 17.7 M17.7 6.3 L19.8 4.2</StreamGeometry>

    <!-- Navigation -->
    <StreamGeometry x:Key="IconMap">M9 4 L3 6 V20 L9 18 L15 20 L21 18 V4 L15 6 L9 4 Z M9 4 V18 M15 6 V20</StreamGeometry>
    <StreamGeometry x:Key="IconLoop">M3 12 A9 9 0 1 1 6 18.7 M3 20 V15 H8</StreamGeometry>

    <!-- Capture / history -->
    <StreamGeometry x:Key="IconHistory">M21 12 A9 9 0 1 1 12 3 A9 9 0 1 1 21 12 Z M12 7 V12 L15 14 M3 12 H5</StreamGeometry>
    <StreamGeometry x:Key="IconRecord">M21 12 A9 9 0 1 1 12 3 A9 9 0 1 1 21 12 Z M15 12 A3 3 0 1 1 12 9 A3 3 0 1 1 15 12 Z</StreamGeometry>

    <!-- Tools -->
    <StreamGeometry x:Key="IconTools">M3 17 L11 9 A4 4 0 0 1 16.5 3.5 L14 6 L15.5 7.5 L18 5 A4 4 0 0 1 12.5 11 L4.5 19 A1.4 1.4 0 0 1 2.5 17 Z</StreamGeometry>

    <!-- Panels -->
    <StreamGeometry x:Key="IconChat">M4 5 H20 V16 H9 L4 20 Z</StreamGeometry>
    <StreamGeometry x:Key="IconUser">M16 8 A4 4 0 1 1 8 8 A4 4 0 1 1 16 8 Z M4 21 A8 8 0 0 1 20 21</StreamGeometry>
    <StreamGeometry x:Key="IconParty">M12 9 A3 3 0 1 1 6 9 A3 3 0 1 1 12 9 Z M19.5 10 A2.5 2.5 0 1 1 14.5 10 A2.5 2.5 0 1 1 19.5 10 Z M3 19 A6 6 0 0 1 15 19 M15 19 A4 4 0 0 1 22 19</StreamGeometry>
    <StreamGeometry x:Key="IconBook">M5 4 H17 A2 2 0 0 1 19 6 V20 H7 A2 2 0 0 1 5 18 Z M5 18 H19</StreamGeometry>
    <StreamGeometry x:Key="IconLog">M5 4 H16 L19 7 V20 H5 Z M16 4 V7 H19 M8 12 H16 M8 16 H14</StreamGeometry>
    <StreamGeometry x:Key="IconQuick">M12 2 L15 8 L21 9 L16.5 13.2 L18 20 L12 17 L6 20 L7.5 13.2 L3 9 L9 8 Z</StreamGeometry>
    <!-- Three ascending bars on a baseline — session stats / kills-per-hour sparkline. -->
    <StreamGeometry x:Key="IconStats">M4 20 H20 M7 20 V14 M12 20 V10 M17 20 V6</StreamGeometry>
    <!-- Stacked-cylinders database glyph — game data browser. -->
    <StreamGeometry x:Key="IconDatabase">M5 6 A7 2 0 1 1 19 6 A7 2 0 1 1 5 6 Z M5 6 V12 A7 2 0 0 0 19 12 V6 M5 12 V18 A7 2 0 0 0 19 18 V12</StreamGeometry>

    <!-- Chrome glyphs -->
    <StreamGeometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 6 L15 12 L9 18</StreamGeometry>
    <StreamGeometry x:Key="IconPin">M12 3 L15 7 V12 L18 15 H6 L9 12 V7 Z M12 15 V21</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M5 12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconSquare">M5 5 H19 V19 H5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6 6 L18 18 M6 18 L18 6</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M17 11 A6 6 0 1 1 5 11 A6 6 0 1 1 17 11 Z M16 16 L20 20</StreamGeometry>

</ResourceDictionary>
