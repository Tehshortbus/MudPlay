<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="180"
        x:Class="FujinTerm.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Padding="22" Background="{StaticResource ChromeBgBrush}">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Body}"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontSize="{StaticResource FontSizeMd}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{Binding NoLabel}"  Command="{Binding NoCommand}"
                        MinWidth="80" IsCancel="True"/>
                <Button Content="{Binding YesLabel}" Command="{Binding YesCommand}"
                        MinWidth="80" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
