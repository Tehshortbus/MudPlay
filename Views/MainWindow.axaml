<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctl="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="560"
        x:Class="FujinTerm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FujinTerm"
        Width="660" Height="560">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding ToggleConnectionCommand}"/>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
        <KeyBinding Gesture="F1"     Command="{Binding OpenHelpTopicsCommand}"/>
        <KeyBinding Gesture="F2"     Command="{Binding OpenConversationCommand}"/>
        <KeyBinding Gesture="F3"     Command="{Binding OpenPartyCommand}"/>
        <KeyBinding Gesture="F4"     Command="{Binding OpenWorkshopCommand}"/>
        <KeyBinding Gesture="F5"     Command="{Binding OpenNavigationCommand}"/>
        <KeyBinding Gesture="F7"     Command="{Binding OpenSpellBookCommand}"/>
        <KeyBinding Gesture="F9"     Command="{Binding OpenLogPaneCommand}"/>
        <KeyBinding Gesture="F10"    Command="{Binding OpenBackscrollCommand}"/>
        <KeyBinding Gesture="F11"    Command="{Binding OpenSessionStatsCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGameDataBrowserCommand}"/>
    </Window.KeyBindings>

    <DockPanel LastChildFill="True">

        <!-- ============ Menu bar (chrome-styled, unchanged surface) ============ -->
        <Menu DockPanel.Dock="Top" Classes="Chrome">

            <MenuItem Header="_File">
                <MenuItem Header="{Binding ConnectionLabel}"
                          Command="{Binding ToggleConnectionCommand}"
                          InputGesture="Ctrl+K"/>
                <MenuItem Header="BBS list"      Command="{Binding OpenBbsSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="_New profile…"  InputGesture="Ctrl+N" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <MenuItem Header="_Open profile…" InputGesture="Ctrl+O" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <MenuItem Header="_Save profile"  InputGesture="Ctrl+S" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <Separator/>
                <MenuItem Header="Recent profiles" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <Separator/>
                <MenuItem Header="_Quit" Command="{Binding QuitCommand}" InputGesture="Ctrl+Q"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Settings…"     InputGesture="Ctrl+," Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Conversation"  InputGesture="F2"  Command="{Binding OpenConversationCommand}"/>
                <MenuItem Header="Party"         InputGesture="F3"  Command="{Binding OpenPartyCommand}"/>
                <MenuItem Header="Player Workshop" InputGesture="F4" Command="{Binding OpenWorkshopCommand}"/>
                <MenuItem Header="Navigation"      InputGesture="F5" Command="{Binding OpenNavigationCommand}"/>
                <MenuItem Header="Spell Book"    InputGesture="F7"  Command="{Binding OpenSpellBookCommand}"/>
                <MenuItem Header="Backscroll"    InputGesture="F10" Command="{Binding OpenBackscrollCommand}"/>
                <MenuItem Header="Session Stats" InputGesture="F11" Command="{Binding OpenSessionStatsCommand}"/>
                <Separator/>
                <MenuItem Header="Reset layout" Command="{Binding ResetLayoutCommand}"/>
            </MenuItem>

            <MenuItem Header="_Action">
                <!-- Bulk one-shot commands. Wired progressively as the
                     owning phases ship; Action menu's job is the surface,
                     not the engines. -->
                <MenuItem Header="Get All"     IsEnabled="False" ToolTip.Tip="Wired in Phase 12 PR 12.4 (Quick Tools)"/>
                <MenuItem Header="Drop All"    IsEnabled="False" ToolTip.Tip="Wired in Phase 12 PR 12.4 (Quick Tools)"/>
                <MenuItem Header="Equip All"   IsEnabled="False" ToolTip.Tip="Wired in Phase 9 PR 9.11 (Workshop EQUIP → apply active set)"/>
                <MenuItem Header="Deposit All" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.E (CashManager)"/>
                <Separator/>

                <MenuItem Header="All Auto-Responses Off"
                          IsEnabled="False"
                          ToolTip.Tip="Master kill-switch — wired in Phase 13 (clears every auto-toggle below)"/>
                <Separator/>

                <!-- Master auto-engine toggles. Per-item / per-spell tuning
                     for these lives in the matching Settings tab; the menu
                     is the on / off surface during play. -->
                <MenuItem Header="Auto Combat"      ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.A (CombatManager)"/>
                <MenuItem Header="Auto Nuke"        ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.A (multi-attack room spells)"/>
                <MenuItem Header="Auto Rest / Heal" ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PRs 13.B + 13.D"/>
                <MenuItem Header="Auto Bless"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.D (CastingDirector)"/>
                <MenuItem Header="Auto Light"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 — dark-room detection + light-source use"/>
                <MenuItem Header="Auto Get Items"   ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 — uses Phase 5 Items.auto-collect + max-to-get flags"/>
                <MenuItem Header="Auto Get Cash"    ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.E (CashManager)"/>
                <MenuItem Header="Auto Sneak"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.F (StealthManager)"/>
                <MenuItem Header="Auto Hide"        ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.F (StealthManager)"/>
                <MenuItem Header="Auto Search"      ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 7 (AutoWalkManager) — search rooms while running"/>

                <!-- Corpse-recovery actions land here when Phase 9 DEATH ships. -->
            </MenuItem>

            <MenuItem Header="_Game Data">
                <MenuItem Header="Active set"             IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
                <Separator/>
                <MenuItem Header="Open Browser…"          InputGesture="Ctrl+G" Command="{Binding OpenGameDataBrowserCommand}"/>
                <Separator/>
                <MenuItem Header="Import .mdb…"           IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
                <MenuItem Header="Import Spell Messages…" IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
                <MenuItem Header="Import loops (MegaMUD .mp)…" IsEnabled="False" ToolTip.Tip="Wired in Phase 7 (MpFileImporter)"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="{Binding CaptureMenuLabel}"  Command="{Binding ToggleDumpCommand}"/>
                <Separator/>
                <MenuItem Header="Program Log…" InputGesture="F9" Command="{Binding OpenLogPaneCommand}"/>
                <MenuItem Header="Wire Inspector…"             Command="{Binding OpenWireInspectorCommand}"/>
                <Separator/>
                <MenuItem Header="Export chatlog…"             Command="{Binding ExportChatlogCommand}"/>
                <MenuItem Header="Clear chatlog"               Command="{Binding ClearChatlogCommand}"/>
                <MenuItem Header="Open Logs folder…"           Command="{Binding OpenLogsFolderCommand}"/>
                <Separator/>
                <!-- Dev-facing entrypoint to inspect every edit-dialog
                     placeholder. Once each owning phase ships a real list
                     row that opens its editor, this submenu can go away. -->
                <MenuItem Header="Preview placeholder dialogs">
                    <MenuItem Header="Spell — Edit…"              Command="{Binding PreviewSpellEditDialogCommand}"/>
                    <MenuItem Header="Trigger — Edit…"            Command="{Binding PreviewTriggerEditDialogCommand}"/>
                    <MenuItem Header="Alias — Edit…"              Command="{Binding PreviewAliasEditDialogCommand}"/>
                    <MenuItem Header="Condition — Edit…"          Command="{Binding PreviewConditionEditDialogCommand}"/>
                    <MenuItem Header="Macro — Edit…"              Command="{Binding PreviewMacroEditDialogCommand}"/>
                    <MenuItem Header="Event — Edit…"              Command="{Binding PreviewEventEditDialogCommand}"/>
                    <MenuItem Header="Ambiguous Location…"        Command="{Binding PreviewAmbiguousLocationDialogCommand}"/>
                    <MenuItem Header="Import Conflict…"           Command="{Binding PreviewImportConflictDialogCommand}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Help topics…"        InputGesture="F1" Command="{Binding OpenHelpTopicsCommand}"/>
                <MenuItem Header="Keyboard shortcuts…" Command="{Binding OpenKeyboardShortcutsCommand}"/>
                <Separator/>
                <MenuItem Header="MajorMUD wiki ↗"     Command="{Binding OpenMajorMudWikiCommand}"/>
                <MenuItem Header="MajorMUD subreddit ↗" Command="{Binding OpenMajorMudRedditCommand}"/>
                <MenuItem Header="BBS site ↗" IsEnabled="False" ToolTip.Tip="Wired in Phase 4 (BBS profile field)"/>
                <Separator/>
                <MenuItem Header="Report an issue…"    Command="{Binding ReportIssueCommand}"/>
                <Separator/>
                <MenuItem Header="License…"            Command="{Binding OpenLicenseCommand}"/>
                <MenuItem Header="About FujinTerm"     Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar (icon groups + char picker + BBS badge) ============ -->
        <Border DockPanel.Dock="Top" Classes="Toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <!-- Icon button groups -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    <!-- Group 1: connection toggle. One button, three states
                         (Idle / Connecting / Connected) — the icon swap is
                         done via two stacked Paths with IsVisible bindings
                         because StaticResource bindings can't switch at
                         runtime. The Active style class lights the button
                         in amber while a connect attempt is in flight; the
                         Danger style class colours the hover state red when
                         the next click would disconnect. -->
                    <Button Classes="ToolbarBtn"
                            Classes.Active="{Binding IsConnecting}"
                            Classes.Danger="{Binding IsConnected}"
                            Command="{Binding ToggleConnectionCommand}"
                            ToolTip.Tip="{Binding ConnectionLabel}">
                        <Panel>
                            <Path Data="{StaticResource IconPlug}"
                                  IsVisible="{Binding !IsConnected}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                            <Path Data="{StaticResource IconUnplug}"
                                  IsVisible="{Binding IsConnected}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Panel>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 2: settings -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)">
                        <Path Data="{StaticResource IconGear}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 3: navigation / capture / wire -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenNavigationCommand}" ToolTip.Tip="Navigation (F5)">
                        <Path Data="{StaticResource IconMap}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenBackscrollCommand}" ToolTip.Tip="Backscroll (F10)">
                        <Path Data="{StaticResource IconHistory}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding ToggleDumpCommand}"
                            Classes.Active="{Binding IsDumping}" ToolTip.Tip="Capture — toggle session capture">
                        <Path Data="{StaticResource IconRecord}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenWireInspectorCommand}"
                            ToolTip.Tip="Wire Inspector — view raw + stripped byte streams">
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 4: panel toggles (stubbed) -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenConversationCommand}" ToolTip.Tip="Conversation (F2)">
                        <Path Data="{StaticResource IconChat}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenPartyCommand}" ToolTip.Tip="Party (F3)">
                        <Path Data="{StaticResource IconParty}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenWorkshopCommand}" ToolTip.Tip="Player Workshop (F4)">
                        <Path Data="{StaticResource IconUser}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenSpellBookCommand}" ToolTip.Tip="Spell Book (F7)">
                        <Path Data="{StaticResource IconBook}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenSessionStatsCommand}" ToolTip.Tip="Session Stats (F11)">
                        <Path Data="{StaticResource IconStats}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenGameDataBrowserCommand}" ToolTip.Tip="Game Data Browser (Ctrl+G)">
                        <Path Data="{StaticResource IconDatabase}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenLogPaneCommand}" ToolTip.Tip="Log (F9)">
                        <Path Data="{StaticResource IconLog}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ============ Secondary strip (transitional Host / Port editor) ============ -->
        <!-- Phase 4 PR 4.5 BBS-profile editor will absorb these; until then the
             toolbar BBS badge displays the values and this strip lets the user
             edit them. -->
        <Border DockPanel.Dock="Top" Classes="SecondaryStrip">
            <Grid ColumnDefinitions="Auto,*,Auto,80" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="{StaticResource FontSizeSm}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Host}" MinWidth="220"
                         Background="{StaticResource ChromeBgBrush}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
                <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="{StaticResource FontSizeSm}" Margin="12,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding Port}"
                         Background="{StaticResource ChromeBgBrush}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
            </Grid>
        </Border>

        <!-- ============ Status bar (two slots) ============ -->
        <!-- Left  : room + confidence dot (Phase 7 wires the live values).
             Mid   : tick countdowns — combat tick + HP (natural / rest) +
                     MA (natural / medi). Source-of-truth: TickEngine +
                     RegenTracker. -->
        <Border DockPanel.Dock="Bottom" Classes="StatusBar">
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBlock Classes="StatusSlot StatusMuted"
                               Text="Unknown location"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Cycle countdowns as plain text. Natural HP / MA are always
                     visible once observed; rest / medi are appended only while
                     Position=Resting / Position=Meditating. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock x:Name="CombatTickLabel"
                               Classes="StatusSlot StatusMono"
                               Text="{Binding CombatTickText}"/>
                    <TextBlock Classes="StatusSlot StatusMono" Text="{Binding HpTickText}"/>
                    <TextBlock Classes="StatusSlot StatusMono" Text="{Binding MaTickText}"/>
                </StackPanel>

                <!-- Connection stoplight: red disconnected · yellow connecting · green connected. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentRedBrush}"
                             IsVisible="{Binding IsIdle}"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentYellowBrush}"
                             IsVisible="{Binding IsConnecting}"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentGreenBrush}"
                             IsVisible="{Binding IsConnected}"/>
                    <TextBlock Classes="StatusSlot" Text="{Binding ConnectionStatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Terminal canvas ============ -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ChromeBgSunkenBrush}">
            <ctl:TerminalControl x:Name="Terminal"
                                 Emulator="{Binding Emulator}"
                                 FontSize="{Binding TerminalFontSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <ctl:TerminalControl.ContextMenu>
                    <ContextMenu>
                        <!-- Edit group — terminal-specific selection operations. -->
                        <MenuItem Header="Copy"                 InputGesture="Ctrl+Shift+C" IsEnabled="False" ToolTip.Tip="Selection support lands with the chrome polish"/>
                        <MenuItem Header="Paste"                InputGesture="Ctrl+Shift+V" IsEnabled="False" ToolTip.Tip="Paste lands with the chrome polish"/>
                        <MenuItem Header="Select all"           IsEnabled="False" ToolTip.Tip="Selection support lands with the chrome polish"/>
                        <MenuItem Header="Find in scrollback…"  Command="{Binding FindInScrollbackCommand}"/>
                        <MenuItem Header="Clear screen"         IsEnabled="False" ToolTip.Tip="Screen-clear command lands with the chrome polish"/>
                        <Separator/>
                        <!-- View group — the panel quick-opens that make
                             sense from a right-click on the canvas. The full
                             six-group mirror of the menu bar can land later
                             alongside selection support. -->
                        <MenuItem Header="Open Player Workshop" InputGesture="F4"  Command="{Binding OpenWorkshopCommand}"/>
                        <MenuItem Header="Open Log pane"        InputGesture="F9"  Command="{Binding OpenLogPaneCommand}"/>
                        <MenuItem Header="Open Backscroll"      InputGesture="F10" Command="{Binding OpenBackscrollCommand}"/>
                    </ContextMenu>
                </ctl:TerminalControl.ContextMenu>
            </ctl:TerminalControl>
        </ScrollViewer>

    </DockPanel>

</Window>
