<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:ctl="using:MudPlay.Controls"
        xmlns:svc="using:MudPlay.Services"
        xmlns:views="using:MudPlay.Views"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="520"
        x:Class="MudPlay.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle, FallbackValue=MudPlay}"
        Width="660" Height="520">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Visual Guides: glow the menu item the current step points at. -->
        <Style Selector="MenuItem.tutTarget">
            <Setter Property="Background" Value="{StaticResource AccentAmberSoftBrush}"/>
        </Style>

    </Window.Styles>

    <!-- KeyBindings are wired in code-behind from KeybindingStore so the
         per-character rebind UI takes effect at runtime — see
         GlobalHotkeys.AttachMain in MainWindow.axaml.cs. -->


    <!-- The DockPanel is the app chrome; the Visual Guides overlay floats above
         it (same Panel) so it can spotlight the menu bar. The overlay is
         hit-test-transparent except its card, so it never blocks the terminal. -->
    <Panel>
    <DockPanel LastChildFill="True">

        <!-- ============ Menu bar (chrome-styled, unchanged surface) ============ -->
        <Menu DockPanel.Dock="Top" Classes="Chrome">

            <MenuItem x:Name="FileMenu" Header="_File">
                <MenuItem Header="{Binding ConnectionLabel}"
                          Command="{Binding ToggleConnectionCommand}"
                          InputGesture="{Binding ToggleConnectionGesture}"/>
                <MenuItem Header="_Quick Connect…" Command="{Binding OpenQuickConnectCommand}"/>
                <MenuItem Header="Disable hangups"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsDisableHangupsActive, Mode=TwoWay}"
                          ToolTip.Tip="Block every automatic disconnect — only you can hang up (hotkey / toolbar / menu)"/>
                <Separator/>
                <MenuItem Header="_Save profile" InputGesture="{Binding SaveProfileGesture}"
                          Command="{Binding SaveProfileCommand}"
                          ToolTip.Tip="Write the current profile and its settings to disk"/>
                <MenuItem Header="_Profile Management…"
                          InputGesture="{Binding ProfileManagerGesture}"
                          Command="{Binding OpenProfileManagerCommand}"
                          Classes.tutTarget="{Binding Guide.HighlightProfileManagement}"/>
                <Separator/>
                <MenuItem Header="Auto-load last profile on startup"
                          ToggleType="CheckBox"
                          IsChecked="{Binding AutoLoadLastProfile, Mode=TwoWay}"
                          ToolTip.Tip="When checked, MudPlay reopens the profile you loaded last time on launch instead of a blank draft (falls back to blank if that profile was deleted). Applies app-wide."/>
                <Separator IsVisible="{Binding HasRecents}"/>
                <!-- Recent profiles. Header shows "<profile> - <BBS>:<realm>"
                     (or just the name when no BBS is pinned);
                     CommandParameter is the slot's ProfileRef
                     (ProfileNameN) so the command gets the (BBS,
                     character) key regardless of how the label renders. -->
                <MenuItem Header="{Binding Recent0, StringFormat='_1)  {0}'}"
                          IsVisible="{Binding Recent0, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName0}"/>
                <MenuItem Header="{Binding Recent1, StringFormat='_2)  {0}'}"
                          IsVisible="{Binding Recent1, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName1}"/>
                <MenuItem Header="{Binding Recent2, StringFormat='_3)  {0}'}"
                          IsVisible="{Binding Recent2, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName2}"/>
                <MenuItem Header="{Binding Recent3, StringFormat='_4)  {0}'}"
                          IsVisible="{Binding Recent3, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName3}"/>
                <MenuItem Header="{Binding Recent4, StringFormat='_5)  {0}'}"
                          IsVisible="{Binding Recent4, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName4}"/>
                <MenuItem Header="{Binding Recent5, StringFormat='_6)  {0}'}"
                          IsVisible="{Binding Recent5, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName5}"/>
                <MenuItem Header="{Binding Recent6, StringFormat='_7)  {0}'}"
                          IsVisible="{Binding Recent6, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName6}"/>
                <MenuItem Header="{Binding Recent7, StringFormat='_8)  {0}'}"
                          IsVisible="{Binding Recent7, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName7}"/>
                <MenuItem Header="{Binding Recent8, StringFormat='_9)  {0}'}"
                          IsVisible="{Binding Recent8, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName8}"/>
                <MenuItem Header="{Binding Recent9, StringFormat='1_0)  {0}'}"
                          IsVisible="{Binding Recent9, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding ProfileName9}"/>
                <Separator/>
                <MenuItem Header="_Quit" Command="{Binding QuitCommand}" InputGesture="{Binding QuitGesture}"/>
            </MenuItem>

            <MenuItem x:Name="ViewMenu" Header="_View">
                <MenuItem Header="Settings…"     InputGesture="{Binding SettingsGesture}" Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="Backscroll"    InputGesture="{Binding BackscrollGesture}" Command="{Binding OpenBackscrollCommand}"/>
                <Separator/>
                <MenuItem Header="Conversation"  InputGesture="{Binding ConversationGesture}"  Command="{Binding OpenConversationCommand}"/>
                <MenuItem Header="Party"         InputGesture="{Binding PartyGesture}"  Command="{Binding OpenPartyCommand}"/>
                <MenuItem Header="Buff Watchdog" InputGesture="{Binding BuffWatchdogGesture}" Command="{Binding OpenBuffWatchdogCommand}"/>
                <MenuItem Header="Profile Management" InputGesture="{Binding ProfileManagerGesture}" Command="{Binding OpenProfileManagerCommand}"/>
                <MenuItem Header="Player Workshop" InputGesture="{Binding WorkshopGesture}" Command="{Binding OpenWorkshopCommand}"/>
                <MenuItem Header="Navigation"      InputGesture="{Binding NavigationGesture}" Command="{Binding OpenNavigationCommand}"/>
                <MenuItem Header="Spell Book"    InputGesture="{Binding SpellBookGesture}"  Command="{Binding OpenSpellBookCommand}"/>
                <MenuItem Header="Monster Intel" InputGesture="{Binding MonsterIntelGesture}" Command="{Binding OpenMonsterIntelCommand}"/>
                <MenuItem Header="Session Stats" InputGesture="{Binding SessionStatsGesture}" Command="{Binding OpenSessionStatsCommand}"/>
                <MenuItem Header="Round Totals"  InputGesture="{Binding RoundTotalsGesture}" Command="{Binding OpenRoundTotalsCommand}"/>
                <Separator/>
                <MenuItem Header="Players"  Command="{Binding OpenGameDataPlayersCommand}"/>
                <MenuItem Header="Macros"   Command="{Binding OpenGameDataMacrosCommand}"/>
                <MenuItem Header="Triggers" Command="{Binding OpenGameDataTriggersCommand}"/>
                <MenuItem Header="Aliases"  Command="{Binding OpenGameDataAliasesCommand}"/>
                <MenuItem Header="Events"   Command="{Binding OpenEventsCommand}"/>
            </MenuItem>

            <MenuItem Header="_Action">
                <!-- Recovery escape hatch — clear my own stuck ailments and the
                     movement holds / party-wait signals they drive, returning me
                     to an idle, unafflicted state. -->
                <MenuItem Header="Reset States" Command="{Binding ResetStatesCommand}"
                          ToolTip.Tip="Stop every engine and clear stuck ailments, waits, holds and pending walks — return to idle (auto toggles untouched)"/>
                <Separator/>

                <!-- Casting spell profiles: a fly-out of every configured combat-spell
                     profile ("N) name"), the active one checked. Populated in
                     code-behind from CombatProfileItems (a bound ItemsSource can't
                     coexist with future static items), rebuilt on any change. -->
                <MenuItem x:Name="ProfilesMenu" Header="Combat Profiles"
                          ToolTip.Tip="Switch the active casting spell profile"/>
                <Separator/>

                <!-- Bulk one-shot commands. Local twins of the @get-all /
                     @drop-all / @hide-all / @deposit-all remote commands and the Default
                     gear set; the toolbar Get/Drop/Equip/Deposit buttons drive
                     the same commands via the catalogue. -->
                <MenuItem Header="Get All"     Command="{Binding GetAllCommand}"     ToolTip.Tip="Pick up every item on the room floor"/>
                <MenuItem Header="Drop">
                    <MenuItem Header="All (unworn items)" Command="{Binding DropAllCommand}"        ToolTip.Tip="Drop every carried (unworn) item"/>
                    <MenuItem Header="Everything"         Command="{Binding DropEverythingCommand}" ToolTip.Tip="Drop everything held — worn gear, light, keys and coins too"/>
                    <MenuItem Header="Coins"              Command="{Binding DropCoinsCommand}"      ToolTip.Tip="Drop every coin you're carrying"/>
                    <MenuItem Header="Keys"               Command="{Binding DropKeysCommand}"       ToolTip.Tip="Drop every key on your key ring"/>
                </MenuItem>
                <MenuItem Header="Hide">
                    <MenuItem Header="All (unworn items)" Command="{Binding HideAllCommand}"        ToolTip.Tip="Hide every carried (unworn) item in the room — only a search finds it"/>
                    <MenuItem Header="Everything"         Command="{Binding HideEverythingCommand}" ToolTip.Tip="Hide everything held in the room — worn gear, light, keys and coins too"/>
                    <MenuItem Header="Coins"              Command="{Binding HideCoinsCommand}"      ToolTip.Tip="Hide every coin you're carrying in the room"/>
                    <MenuItem Header="Keys"               Command="{Binding HideKeysCommand}"       ToolTip.Tip="Hide every key on your key ring in the room"/>
                </MenuItem>
                <MenuItem Header="Equip">
                    <MenuItem Header="Default set"       Command="{Binding EquipAllCommand}"                                  ToolTip.Tip="Wear the Default gear set"/>
                    <!-- Any set but Default is a hold: it stays on, ticked here, with
                         automatic gear swaps off until it's picked again or Default is. -->
                    <MenuItem Header="Backstab set"      Command="{Binding EquipSetCommand}" CommandParameter="backstab"
                              ToggleType="CheckBox" IsChecked="{Binding IsBackstabSetHeld, Mode=OneWay}"
                              ToolTip.Tip="Wear this set and keep it on until you pick it again (or Default); automatic gear swaps stay off meanwhile"/>
                    <MenuItem Header="Pre-rest HP set"   Command="{Binding EquipSetCommand}" CommandParameter="resthp"
                              ToggleType="CheckBox" IsChecked="{Binding IsRestHpSetHeld, Mode=OneWay}"
                              ToolTip.Tip="Wear this set and keep it on until you pick it again (or Default); automatic gear swaps stay off meanwhile"/>
                    <MenuItem Header="Pre-rest Mana set" Command="{Binding EquipSetCommand}" CommandParameter="restma"
                              ToggleType="CheckBox" IsChecked="{Binding IsRestManaSetHeld, Mode=OneWay}"
                              ToolTip.Tip="Wear this set and keep it on until you pick it again (or Default); automatic gear swaps stay off meanwhile"/>
                    <MenuItem Header="While Moving set"  Command="{Binding EquipSetCommand}" CommandParameter="moving"
                              ToggleType="CheckBox" IsChecked="{Binding IsMovingSetHeld, Mode=OneWay}"
                              ToolTip.Tip="Wear this set and keep it on until you pick it again (or Default); automatic gear swaps stay off meanwhile"/>
                    <MenuItem Header="Bossing set"       Command="{Binding EquipSetCommand}" CommandParameter="bossing"
                              ToggleType="CheckBox" IsChecked="{Binding IsBossingSetHeld, Mode=OneWay}"
                              ToolTip.Tip="Wear this set and keep it on until you pick it again (or Default); automatic gear swaps stay off meanwhile"/>
                </MenuItem>
                <MenuItem Header="Deposit All" Command="{Binding DepositAllCommand}" ToolTip.Tip="Bank wealth down to the keep-on-hand floor"/>
                <Separator/>

                <!-- Never pause to rest/heal-wait; forces Auto Combat off for the
                     duration (restored on turning it back off); still casts heals;
                     only death stops it. -->
                <MenuItem Header="Sprint Mode" ToggleType="CheckBox" IsChecked="{Binding IsSprintModeActive, Mode=TwoWay}"
                          ToolTip.Tip="Never pause to rest — force Auto Combat off, keep casting heals, only death stops it"/>
                <Separator/>

                <!-- The master switch. Its logic lives in AutoModeController, so
                     this drives a Command (not a two-way bool). Ticked = the
                     switch is on; unticked = nothing automatic acts. -->
                <MenuItem Header="All auto-responses"
                          ToggleType="CheckBox"
                          IsChecked="{Binding IsMasterSwitchOn, Mode=OneWay}"
                          Command="{Binding AllAutoOffCommand}"
                          ToolTip.Tip="Master switch — off stops everything automatic (remembering which toggles were on); on gives them back"/>
                <Separator/>

                <!-- Master auto-engine toggles. Per-item / per-spell tuning
                     for these lives in the matching Settings tab; the menu
                     is the on / off surface during play. -->
                <MenuItem Header="Auto Combat"      ToggleType="CheckBox" IsChecked="{Binding IsAutoCombatActive,   Mode=TwoWay}"/>
                <MenuItem Header="Auto Nuke"        ToggleType="CheckBox" IsChecked="{Binding IsAutoNukeActive,     Mode=TwoWay}"/>
                <MenuItem Header="Auto Rest / Heal" ToggleType="CheckBox" IsChecked="{Binding IsAutoHealRestActive, Mode=TwoWay}"/>
                <MenuItem Header="Auto Heal"        ToggleType="CheckBox" IsChecked="{Binding IsAutoHealActive,     Mode=TwoWay}"/>
                <MenuItem Header="Auto Rest"        ToggleType="CheckBox" IsChecked="{Binding IsAutoRestActive,     Mode=TwoWay}"/>
                <MenuItem Header="Auto Bless"       ToggleType="CheckBox" IsChecked="{Binding IsAutoBlessActive,    Mode=TwoWay}"/>
                <MenuItem Header="Auto Light"       ToggleType="CheckBox" IsChecked="{Binding IsAutoLightActive,    Mode=TwoWay}"/>
                <MenuItem Header="Auto Get Items"   ToggleType="CheckBox" IsChecked="{Binding IsAutoGetItemsActive, Mode=TwoWay}"/>
                <MenuItem Header="Auto Get Cash"    ToggleType="CheckBox" IsChecked="{Binding IsAutoGetCashActive,  Mode=TwoWay}"/>
                <MenuItem Header="Auto Sneak"       ToggleType="CheckBox" IsChecked="{Binding IsAutoSneakActive,    Mode=TwoWay}"/>
                <MenuItem Header="Auto Hide"        ToggleType="CheckBox" IsChecked="{Binding IsAutoHideActive,     Mode=TwoWay}"/>
                <MenuItem Header="Auto Search"      ToggleType="CheckBox" IsChecked="{Binding IsAutoSearchActive,   Mode=TwoWay}"/>
                <!-- Auto-train is toggled from Player Workshop → CP Allocation and
                     Settings → Auto-Trainer (not here). -->
            </MenuItem>

            <!-- Game Data: dynamic set list at the top (rebuilt from
                 code-behind whenever GameDataSets changes), then the
                 static actions. Inline sets + inline static items can't
                 coexist via XAML binding on a single MenuItem, so the
                 items collection is composed in code. -->
            <MenuItem x:Name="GameDataMenu" Header="_Game Data"/>

            <MenuItem Header="_Tools">
                <MenuItem Header="{Binding CaptureMenuLabel}"  Command="{Binding ToggleDumpCommand}"/>
                <Separator/>
                <MenuItem Header="Program Log…" InputGesture="{Binding LogPaneGesture}" Command="{Binding OpenLogPaneCommand}"/>
                <MenuItem Header="Wire Inspector…"             Command="{Binding OpenWireInspectorCommand}"/>
                <Separator/>
                <MenuItem Header="Clear chatlog"               Command="{Binding ClearChatlogCommand}"/>
                <MenuItem Header="Open Logs folder…"           Command="{Binding OpenLogsFolderCommand}"/>
                <Separator/>
                <MenuItem Header="Update the Client"            Command="{Binding OpenUpdateCommand}"
                          ToolTip.Tip="See whether a newer build is available and install it."/>
            </MenuItem>

            <!-- Help: the website links are user-editable (Settings → Toolbar +
                 Shortcuts) so the dropdown is composed in code-behind, same as
                 the Game Data menu — a MenuItem can't mix a bound dynamic list
                 with inline static children. -->
            <MenuItem x:Name="HelpMenu" Header="_Help"/>

            <!-- Standalone action, no dropdown — clicking fires the capture
                 directly (freeze client state + recent output into a Markdown
                 report on the Desktop). -->
            <MenuItem x:Name="BugReportMenu" Header="Bug Report" Command="{Binding ReportBugCommand}"
                      ToolTip.Tip="Capture current client state and recent output to a report file on your Desktop"/>
        </Menu>

        <!-- ============ Toolbar (dynamic — built from ToolbarItems) ============ -->
        <!-- Layout comes from the active character's ToolbarSettings.Layout
             via the catalogue. The four Borders mount at top / bottom / left /
             right; IsVisible on each is driven by ToolbarConfig's derived
             ShowTop / ShowBottom / ShowLeft / ShowRight flags so toggling the
             Settings → Toolbar Show / Position controls re-docks
             without a window rebuild. Item templates are inlined per-
             orientation because StackPanel orientation lives on the
             ItemsPanel, not the items themselves. -->

        <!-- Top (horizontal) -->
        <Border DockPanel.Dock="Top" Classes="Toolbar"
                IsVisible="{Binding Toolbar.ShowTop}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <ItemsControl x:Name="TopToolbarItems" Grid.Column="0"
                              ItemsSource="{Binding ToolbarItems}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:ToolbarButtonItem">
                            <Panel>
                                <Border Classes="ToolbarSeparator"
                                        IsVisible="{Binding IsSeparator}"/>
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsButton}">
                                    <Button Classes="ToolbarBtn"
                                            Classes.Active="{Binding IsActive}"
                                            Classes.Danger="{Binding IsDanger}"
                                            IsVisible="{Binding IsButton}" IsEnabled="{Binding IsActionEnabled}"
                                            Command="{Binding Command}"
                                            ToolTip.Tip="{Binding Tooltip}"
                                            Click="OnToolbarButtonClick"
                                            PointerReleased="OnToolbarButtonPointerReleased">
                                        <Panel>
                                            <TextBlock Text="{Binding BadgeText}" IsVisible="{Binding HasBadgeText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding $parent[Button].Foreground}"/>
                                            <Panel IsVisible="{Binding !HasBadgeText}">
                                                <Path Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                      IsVisible="{Binding !ShowAlternate}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                                <Path Data="{Binding AlternateIconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                      IsVisible="{Binding ShowAlternate}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Panel>
                                        </Panel>
                                    </Button>
                                    <Button Classes="ToolbarBtn ToolbarArrow"
                                            IsVisible="{Binding HasSubActions}"
                                            ToolTip.Tip="Pick what this button does (click the button to run it)"
                                            Click="OnToolbarSubActionsClick">
                                        <Path Data="M1 3 L4 6 L7 3" Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="8" Height="8" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Left (vertical) -->
        <Border DockPanel.Dock="Left" Classes="ToolbarV"
                IsVisible="{Binding Toolbar.ShowLeft}">
            <ItemsControl ItemsSource="{Binding ToolbarItems}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:ToolbarButtonItem">
                        <Panel>
                            <Border Classes="ToolbarSeparatorV"
                                    IsVisible="{Binding IsSeparator}"/>
                            <StackPanel Orientation="Vertical" IsVisible="{Binding IsButton}">
                                <Button Classes="ToolbarBtn"
                                        Classes.Active="{Binding IsActive}"
                                        Classes.Danger="{Binding IsDanger}"
                                        IsVisible="{Binding IsButton}" IsEnabled="{Binding IsActionEnabled}"
                                        Command="{Binding Command}"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Click="OnToolbarButtonClick"
                                        PointerReleased="OnToolbarButtonPointerReleased">
                                    <Panel>
                                        <TextBlock Text="{Binding BadgeText}" IsVisible="{Binding HasBadgeText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding $parent[Button].Foreground}"/>
                                        <Panel IsVisible="{Binding !HasBadgeText}">
                                            <Path Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                  IsVisible="{Binding !ShowAlternate}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                            <Path Data="{Binding AlternateIconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                  IsVisible="{Binding ShowAlternate}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                        </Panel>
                                    </Panel>
                                </Button>
                                <Button Classes="ToolbarBtn ToolbarArrowV"
                                        IsVisible="{Binding HasSubActions}"
                                        ToolTip.Tip="Pick what this button does (click the button to run it)"
                                        Click="OnToolbarSubActionsClick">
                                    <Path Data="M1 3 L4 6 L7 3" Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="8" Height="8" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Right (vertical) -->
        <Border DockPanel.Dock="Right" Classes="ToolbarV"
                IsVisible="{Binding Toolbar.ShowRight}">
            <ItemsControl ItemsSource="{Binding ToolbarItems}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:ToolbarButtonItem">
                        <Panel>
                            <Border Classes="ToolbarSeparatorV"
                                    IsVisible="{Binding IsSeparator}"/>
                            <StackPanel Orientation="Vertical" IsVisible="{Binding IsButton}">
                                <Button Classes="ToolbarBtn"
                                        Classes.Active="{Binding IsActive}"
                                        Classes.Danger="{Binding IsDanger}"
                                        IsVisible="{Binding IsButton}" IsEnabled="{Binding IsActionEnabled}"
                                        Command="{Binding Command}"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Click="OnToolbarButtonClick"
                                        PointerReleased="OnToolbarButtonPointerReleased">
                                    <Panel>
                                        <TextBlock Text="{Binding BadgeText}" IsVisible="{Binding HasBadgeText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding $parent[Button].Foreground}"/>
                                        <Panel IsVisible="{Binding !HasBadgeText}">
                                            <Path Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                  IsVisible="{Binding !ShowAlternate}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                            <Path Data="{Binding AlternateIconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                  IsVisible="{Binding ShowAlternate}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                  Width="16" Height="16" Stretch="Uniform"/>
                                        </Panel>
                                    </Panel>
                                </Button>
                                <Button Classes="ToolbarBtn ToolbarArrowV"
                                        IsVisible="{Binding HasSubActions}"
                                        ToolTip.Tip="Pick what this button does (click the button to run it)"
                                        Click="OnToolbarSubActionsClick">
                                    <Path Data="M1 3 L4 6 L7 3" Stroke="{Binding $parent[Button].Foreground}"
                                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="8" Height="8" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ============ Status bar ============ -->
        <!-- One or more rows the user lays out in Settings → BBS + Display. The
             default is a single row: engine chip and location on the left, the
             looked-at target in the middle, ticks and the connection light on the
             right. -->
        <views:StatusBarView x:Name="StatusBarHost" DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}"/>

        <!-- Bottom (horizontal). Docked after the status bar so the status
             bar keeps the very-bottom edge and this toolbar sits directly
             above it. Mirrors the Top border; ShowBottom drives visibility. -->
        <Border DockPanel.Dock="Bottom" Classes="Toolbar"
                IsVisible="{Binding Toolbar.ShowBottom}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <ItemsControl x:Name="BottomToolbarItems" Grid.Column="0"
                              ItemsSource="{Binding ToolbarItems}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:ToolbarButtonItem">
                            <Panel>
                                <Border Classes="ToolbarSeparator"
                                        IsVisible="{Binding IsSeparator}"/>
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsButton}">
                                    <Button Classes="ToolbarBtn"
                                            Classes.Active="{Binding IsActive}"
                                            Classes.Danger="{Binding IsDanger}"
                                            IsVisible="{Binding IsButton}" IsEnabled="{Binding IsActionEnabled}"
                                            Command="{Binding Command}"
                                            ToolTip.Tip="{Binding Tooltip}"
                                            Click="OnToolbarButtonClick"
                                            PointerReleased="OnToolbarButtonPointerReleased">
                                        <Panel>
                                            <TextBlock Text="{Binding BadgeText}" IsVisible="{Binding HasBadgeText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding $parent[Button].Foreground}"/>
                                            <Panel IsVisible="{Binding !HasBadgeText}">
                                                <Path Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                      IsVisible="{Binding !ShowAlternate}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                                <Path Data="{Binding AlternateIconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                                      IsVisible="{Binding ShowAlternate}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Panel>
                                        </Panel>
                                    </Button>
                                    <Button Classes="ToolbarBtn ToolbarArrow"
                                            IsVisible="{Binding HasSubActions}"
                                            ToolTip.Tip="Pick what this button does (click the button to run it)"
                                            Click="OnToolbarSubActionsClick">
                                        <Path Data="M1 3 L4 6 L7 3" Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="8" Height="8" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ============ Terminal canvas ============ -->
        <ScrollViewer x:Name="TerminalScroll"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ChromeBgSunkenBrush}">
            <ctl:TerminalControl x:Name="Terminal"
                                 Emulator="{Binding Emulator}"
                                 SplashActive="{Binding ShowSplash}"
                                 SplashAnimate="{Binding SplashAnimate}"
                                 FontFamily="{Binding TerminalFontFamily}"
                                 FontSize="{Binding TerminalFontSize}"
                                 ScaleToFit="{Binding ScaleTerminalToWindow}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <ctl:TerminalControl.ContextMenu>
                    <ContextMenu x:Name="TerminalContextMenu">
                        <ContextMenu.Resources>
                            <!-- Shared item theme for the walk-to flyouts (Favorites +
                                 Recent destinations). Header = the item itself, rendered
                                 by the template so only the name gets the per-kind accent
                                 (room=blue, loop=green, lair=amber); the "N)" prefix stays
                                 default. Items are self-contained (each carries its own
                                 Walk command), so ItemsSource binding works without
                                 reaching the parent VM; ReflectionBinding sidesteps the
                                 compiled-binding DataType on the generated child items. -->
                            <ControlTheme x:Key="WalkFlyoutItemTheme" TargetType="MenuItem"
                                          BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header"    Value="{ReflectionBinding}"/>
                                <Setter Property="Command"   Value="{ReflectionBinding Command}"/>
                                <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}"/>
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{ReflectionBinding Prefix}"/>
                                                <TextBlock Text="{ReflectionBinding Name}"
                                                           Foreground="{ReflectionBinding NameBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </ControlTheme>
                        </ContextMenu.Resources>
                        <!-- The whole menu is user-customizable (Settings → Toolbar +
                             Shortcuts → Terminal right-click menu) and built in
                             code-behind from AppServices.ContextMenu.Layout — see
                             RebuildTerminalContextMenu. That includes the GOTO
                             Favorites / Recent-destinations fly-outs (a WalkFlyout
                             catalogue entry the builder renders with the
                             WalkFlyoutItemTheme above); nothing is pinned here. -->
                    </ContextMenu>
                </ctl:TerminalControl.ContextMenu>
            </ctl:TerminalControl>
        </ScrollViewer>

    </DockPanel>

        <!-- Visual Guides — ring the control the current step points at, non-blocking. -->
        <views:GuideOverlay DataContext="{Binding Guide}"/>

    </Panel>

</Window>
