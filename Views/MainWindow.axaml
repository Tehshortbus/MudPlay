<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctl="using:FujinTerm.Controls"
        xmlns:svc="using:FujinTerm.Services"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="560"
        x:Class="FujinTerm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle, FallbackValue=FujinTerm}"
        Width="660" Height="560">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- KeyBindings are wired in code-behind from KeybindingStore so the
         per-character rebind UI takes effect at runtime — see
         GlobalHotkeys.AttachMain in MainWindow.axaml.cs. -->


    <DockPanel LastChildFill="True">

        <!-- ============ Menu bar (chrome-styled, unchanged surface) ============ -->
        <Menu DockPanel.Dock="Top" Classes="Chrome">

            <MenuItem Header="_File">
                <MenuItem Header="{Binding ConnectionLabel}"
                          Command="{Binding ToggleConnectionCommand}"
                          InputGesture="{Binding ToggleConnectionGesture}"/>
                <MenuItem Header="_Quick Connect…" Command="{Binding OpenQuickConnectCommand}"/>
                <MenuItem Header="BBS list"      Command="{Binding OpenBbsSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="_New profile…"  InputGesture="{Binding NewProfileGesture}"       Command="{Binding NewProfileCommand}"/>
                <MenuItem Header="_Open profile…" InputGesture="{Binding OpenProfileGesture}"       Command="{Binding OpenProfileCommand}"/>
                <MenuItem Header="{Binding SaveProfileLabel}"  InputGesture="{Binding SaveProfileGesture}"
                          Command="{Binding SaveProfileCommand}"/>
                <MenuItem Header="Save profile as…" InputGesture="{Binding SaveProfileAsGesture}"
                          Command="{Binding SaveProfileAsCommand}"/>
                <Separator IsVisible="{Binding HasRecents}"/>
                <MenuItem Header="{Binding Recent0, StringFormat='_1)  {0}'}"
                          IsVisible="{Binding Recent0, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding Recent0}"/>
                <MenuItem Header="{Binding Recent1, StringFormat='_2)  {0}'}"
                          IsVisible="{Binding Recent1, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding Recent1}"/>
                <MenuItem Header="{Binding Recent2, StringFormat='_3)  {0}'}"
                          IsVisible="{Binding Recent2, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding Recent2}"/>
                <MenuItem Header="{Binding Recent3, StringFormat='_4)  {0}'}"
                          IsVisible="{Binding Recent3, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding Recent3}"/>
                <MenuItem Header="{Binding Recent4, StringFormat='_5)  {0}'}"
                          IsVisible="{Binding Recent4, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                          Command="{Binding OpenRecentProfileCommand}"
                          CommandParameter="{Binding Recent4}"/>
                <Separator/>
                <MenuItem Header="_Quit" Command="{Binding QuitCommand}" InputGesture="{Binding QuitGesture}"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Settings…"     InputGesture="{Binding SettingsGesture}" Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Conversation"  InputGesture="{Binding ConversationGesture}"  Command="{Binding OpenConversationCommand}"/>
                <MenuItem Header="Party"         InputGesture="{Binding PartyGesture}"  Command="{Binding OpenPartyCommand}"/>
                <MenuItem Header="Player Workshop" InputGesture="{Binding WorkshopGesture}" Command="{Binding OpenWorkshopCommand}"/>
                <MenuItem Header="Navigation"      InputGesture="{Binding NavigationGesture}" Command="{Binding OpenNavigationCommand}"/>
                <MenuItem Header="Spell Book"    InputGesture="{Binding SpellBookGesture}"  Command="{Binding OpenSpellBookCommand}"/>
                <MenuItem Header="Backscroll"    InputGesture="{Binding BackscrollGesture}" Command="{Binding OpenBackscrollCommand}"/>
                <MenuItem Header="Session Stats" InputGesture="{Binding SessionStatsGesture}" Command="{Binding OpenSessionStatsCommand}"/>
                <Separator/>
                <MenuItem Header="Players"  Command="{Binding OpenGameDataPlayersCommand}"/>
                <MenuItem Header="Macros"   Command="{Binding OpenGameDataMacrosCommand}"/>
                <MenuItem Header="Triggers" Command="{Binding OpenGameDataTriggersCommand}"/>
                <MenuItem Header="Aliases"  Command="{Binding OpenGameDataAliasesCommand}"/>
                <Separator/>
                <MenuItem Header="Reset layout" Command="{Binding ResetLayoutCommand}"/>
            </MenuItem>

            <MenuItem Header="_Action">
                <!-- Bulk one-shot commands. Wired progressively as the
                     owning phases ship; Action menu's job is the surface,
                     not the engines. -->
                <MenuItem Header="Get All"     IsEnabled="False" ToolTip.Tip="Wired in Phase 12 PR 12.4 (Quick Tools)"/>
                <MenuItem Header="Drop All"    IsEnabled="False" ToolTip.Tip="Wired in Phase 12 PR 12.4 (Quick Tools)"/>
                <MenuItem Header="Equip All"   IsEnabled="False" ToolTip.Tip="Wired in Phase 9 PR 9.11 (Workshop EQUIP → apply active set)"/>
                <MenuItem Header="Deposit All" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.E (CashManager)"/>
                <Separator/>

                <MenuItem Header="All Auto-Responses Off"
                          IsEnabled="False"
                          ToolTip.Tip="Master kill-switch — wired in Phase 13 (clears every auto-toggle below)"/>
                <Separator/>

                <!-- Master auto-engine toggles. Per-item / per-spell tuning
                     for these lives in the matching Settings tab; the menu
                     is the on / off surface during play. -->
                <MenuItem Header="Auto Combat"      ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.A (CombatManager)"/>
                <MenuItem Header="Auto Nuke"        ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.A (multi-attack room spells)"/>
                <MenuItem Header="Auto Rest / Heal" ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PRs 13.B + 13.D"/>
                <MenuItem Header="Auto Bless"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.D (CastingDirector)"/>
                <MenuItem Header="Auto Light"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 — dark-room detection + light-source use"/>
                <MenuItem Header="Auto Get Items"   ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 — uses Phase 5 Items.auto-collect + max-to-get flags"/>
                <MenuItem Header="Auto Get Cash"    ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.E (CashManager)"/>
                <MenuItem Header="Auto Sneak"       ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.F (StealthManager)"/>
                <MenuItem Header="Auto Hide"        ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 13 PR 13.F (StealthManager)"/>
                <MenuItem Header="Auto Search"      ToggleType="CheckBox" IsEnabled="False" ToolTip.Tip="Wired in Phase 7 (AutoWalkManager) — search rooms while running"/>

                <!-- Corpse-recovery actions land here when Phase 9 DEATH ships. -->
            </MenuItem>

            <!-- Game Data: dynamic set list at the top (rebuilt from
                 code-behind whenever GameDataSets changes), then the
                 static actions. Inline sets + inline static items can't
                 coexist via XAML binding on a single MenuItem, so the
                 items collection is composed in code. -->
            <MenuItem x:Name="GameDataMenu" Header="_Game Data"/>

            <MenuItem Header="_Tools">
                <MenuItem Header="{Binding CaptureMenuLabel}"  Command="{Binding ToggleDumpCommand}"/>
                <Separator/>
                <MenuItem Header="Program Log…" InputGesture="{Binding LogPaneGesture}" Command="{Binding OpenLogPaneCommand}"/>
                <MenuItem Header="Wire Inspector…"             Command="{Binding OpenWireInspectorCommand}"/>
                <Separator/>
                <MenuItem Header="Export chatlog…"             Command="{Binding ExportChatlogCommand}"/>
                <MenuItem Header="Clear chatlog"               Command="{Binding ClearChatlogCommand}"/>
                <MenuItem Header="Open Logs folder…"           Command="{Binding OpenLogsFolderCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Help topics…"
                          IsEnabled="False"
                          ToolTip.Tip="Old-school help browser lands in a later phase."/>
                <Separator/>
                <MenuItem Header="MajorMUD wiki ↗"     Command="{Binding OpenMajorMudWikiCommand}"/>
                <MenuItem Header="MajorMUD subreddit ↗" Command="{Binding OpenMajorMudRedditCommand}"/>
                <MenuItem Header="MudInfo.net ↗"        Command="{Binding OpenMudInfoCommand}"/>
                <MenuItem Header="BBS site ↗"
                          Command="{Binding OpenBbsWebsiteCommand}"
                          IsEnabled="{Binding HasBbsWebsite}"
                          ToolTip.Tip="{Binding BbsWebsiteUrl, FallbackValue='Set a Website URL on the active BBS (Settings → BBS) to enable.', TargetNullValue='Set a Website URL on the active BBS (Settings → BBS) to enable.'}"/>
                <Separator/>
                <MenuItem Header="Report an issue…"    Command="{Binding ReportIssueCommand}"/>
                <Separator/>
                <MenuItem Header="License…"            Command="{Binding OpenLicenseCommand}"/>
                <MenuItem Header="About FujinTerm"     Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar (dynamic — built from ToolbarItems) ============ -->
        <!-- Layout comes from the active character's ToolbarSettings.Layout
             via the catalogue. Each row is rendered by the kind-switching
             template below: button rows resolve their icon / command /
             tooltip from ToolbarButtonItem; separator rows render as a
             vertical hairline. -->
        <Border DockPanel.Dock="Top" Classes="Toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding ToolbarItems}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:ToolbarButtonItem">
                            <Panel>
                                <!-- Separator row. -->
                                <Border Classes="ToolbarSeparator"
                                        IsVisible="{Binding IsSeparator}"/>

                                <!-- Button row. The connect button is the
                                     only entry that swaps between two
                                     icons (plug ↔ unplug) — controlled by
                                     ShowAlternate, which the VM flips when
                                     IsConnected changes. Rebinding the
                                     keybind lives in Settings → Toolbar
                                     (per-row "Change keybind…" button). -->
                                <Button Classes="ToolbarBtn"
                                        Classes.Active="{Binding IsActive}"
                                        Classes.Danger="{Binding IsDanger}"
                                        IsVisible="{Binding IsButton}"
                                        Command="{Binding Command}"
                                        ToolTip.Tip="{Binding Tooltip}">
                                    <Panel>
                                        <Path Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                              IsVisible="{Binding !ShowAlternate}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"/>
                                        <Path Data="{Binding AlternateIconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                              IsVisible="{Binding ShowAlternate}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"/>
                                    </Panel>
                                </Button>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>

        <!-- ============ Status bar (two slots) ============ -->
        <!-- Left  : room + confidence dot (Phase 7 wires the live values).
             Mid   : tick countdowns — combat tick + HP (natural / rest) +
                     MA (natural / medi). Source-of-truth: TickEngine +
                     RegenTracker. -->
        <Border DockPanel.Dock="Bottom" Classes="StatusBar">
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBlock Classes="StatusSlot StatusMuted"
                               Text="Unknown location"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Cycle countdowns as plain text. Natural HP / MA are always
                     visible once observed; rest / medi are appended only while
                     Position=Resting / Position=Meditating. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock x:Name="CombatTickLabel"
                               Classes="StatusSlot StatusMono"
                               Text="{Binding CombatTickText}"/>
                    <TextBlock Classes="StatusSlot StatusMono" Text="{Binding HpTickText}"/>
                    <TextBlock Classes="StatusSlot StatusMono" Text="{Binding MaTickText}"/>
                </StackPanel>

                <!-- Connection stoplight: red disconnected · yellow connecting · green connected. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentRedBrush}"
                             IsVisible="{Binding IsIdle}"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentYellowBrush}"
                             IsVisible="{Binding IsConnecting}"/>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource AccentGreenBrush}"
                             IsVisible="{Binding IsConnected}"/>
                    <TextBlock Classes="StatusSlot" Text="{Binding ConnectionStatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Terminal canvas ============ -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ChromeBgSunkenBrush}">
            <ctl:TerminalControl x:Name="Terminal"
                                 Emulator="{Binding Emulator}"
                                 FontSize="{Binding TerminalFontSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <ctl:TerminalControl.ContextMenu>
                    <ContextMenu>
                        <!-- Edit group — terminal-specific selection operations. -->
                        <MenuItem Header="Copy"                 InputGesture="Ctrl+Shift+C" IsEnabled="False" ToolTip.Tip="Selection support lands with the chrome polish"/>
                        <MenuItem Header="Paste"                InputGesture="Ctrl+Shift+V" IsEnabled="False" ToolTip.Tip="Paste lands with the chrome polish"/>
                        <MenuItem Header="Select all"           IsEnabled="False" ToolTip.Tip="Selection support lands with the chrome polish"/>
                        <MenuItem Header="Find in scrollback…"  Command="{Binding FindInScrollbackCommand}"/>
                        <MenuItem Header="Clear screen"         IsEnabled="False" ToolTip.Tip="Screen-clear command lands with the chrome polish"/>
                        <Separator/>
                        <!-- View group — the panel quick-opens that make
                             sense from a right-click on the canvas. The full
                             six-group mirror of the menu bar can land later
                             alongside selection support. -->
                        <MenuItem Header="Open Player Workshop" InputGesture="{Binding WorkshopGesture}"  Command="{Binding OpenWorkshopCommand}"/>
                        <MenuItem Header="Open Log pane"        InputGesture="{Binding LogPaneGesture}"  Command="{Binding OpenLogPaneCommand}"/>
                        <MenuItem Header="Open Backscroll"      InputGesture="{Binding BackscrollGesture}" Command="{Binding OpenBackscrollCommand}"/>
                    </ContextMenu>
                </ctl:TerminalControl.ContextMenu>
            </ctl:TerminalControl>
        </ScrollViewer>

    </DockPanel>

</Window>
