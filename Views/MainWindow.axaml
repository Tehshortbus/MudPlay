<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctl="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="FujinTerm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FujinTerm"
        Width="960" Height="640">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding ConnectCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DisconnectCommand}"/>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding QuitCommand}"/>
        <KeyBinding Gesture="F1"     Command="{Binding OpenHelpTopicsCommand}"/>
        <KeyBinding Gesture="F2"     Command="{Binding OpenConversationCommand}"/>
        <KeyBinding Gesture="F3"     Command="{Binding OpenPartyCommand}"/>
        <KeyBinding Gesture="F4"     Command="{Binding OpenWorkshopCommand}"/>
        <KeyBinding Gesture="F5"     Command="{Binding OpenNavigationCommand}"/>
        <KeyBinding Gesture="F6"     Command="{Binding OpenWorkshopCommand}"/>
        <KeyBinding Gesture="F7"     Command="{Binding OpenSpellBookCommand}"/>
        <KeyBinding Gesture="F9"     Command="{Binding OpenLogPaneCommand}"/>
        <KeyBinding Gesture="F10"    Command="{Binding OpenBackscrollCommand}"/>
        <KeyBinding Gesture="F11"    Command="{Binding OpenSessionStatsCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGameDataBrowserCommand}"/>
    </Window.KeyBindings>

    <DockPanel LastChildFill="True">

        <!-- ============ Menu bar (chrome-styled, unchanged surface) ============ -->
        <Menu DockPanel.Dock="Top" Classes="Chrome">

            <MenuItem Header="_File">
                <MenuItem Header="_Connect"      Command="{Binding ConnectCommand}"     InputGesture="Ctrl+K"/>
                <MenuItem Header="_Disconnect"   Command="{Binding DisconnectCommand}"  InputGesture="Ctrl+D"/>
                <MenuItem Header="BBS list"      IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <Separator/>
                <MenuItem Header="_New profile…"  InputGesture="Ctrl+N" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <MenuItem Header="_Open profile…" InputGesture="Ctrl+O" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <MenuItem Header="_Save profile"  InputGesture="Ctrl+S" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <Separator/>
                <MenuItem Header="Recent profiles" IsEnabled="False" ToolTip.Tip="Wired in Phase 4"/>
                <Separator/>
                <MenuItem Header="_Quit" Command="{Binding QuitCommand}" InputGesture="Ctrl+Q"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Conversation"  InputGesture="F2"  Command="{Binding OpenConversationCommand}"/>
                <MenuItem Header="Party"         InputGesture="F3"  Command="{Binding OpenPartyCommand}"/>
                <MenuItem Header="Player Status" InputGesture="F4"  Command="{Binding OpenWorkshopCommand}"/>
                <MenuItem Header="Map"           InputGesture="F5"  Command="{Binding OpenNavigationCommand}"/>
                <MenuItem Header="Workshop"      InputGesture="F6"  Command="{Binding OpenWorkshopCommand}"/>
                <MenuItem Header="Spell Book"    InputGesture="F7"  Command="{Binding OpenSpellBookCommand}"/>
                <MenuItem Header="Log"           InputGesture="F9"  Command="{Binding OpenLogPaneCommand}"/>
                <MenuItem Header="Backscroll"    InputGesture="F10" Command="{Binding OpenBackscrollCommand}"/>
                <MenuItem Header="Session Stats" InputGesture="F11" Command="{Binding OpenSessionStatsCommand}"/>
                <Separator/>
                <MenuItem Header="Reset layout" Command="{Binding ResetLayoutCommand}"/>
            </MenuItem>

            <MenuItem Header="_Settings">
                <MenuItem Header="Open Settings…"        InputGesture="Ctrl+," Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="Open Events…"          Command="{Binding OpenSettingsCommand}"
                          ToolTip.Tip="Opens Settings on the Events tab when wired in Phase 11"/>
                <MenuItem Header="Open Statline Editor…" Command="{Binding OpenSettingsCommand}"
                          ToolTip.Tip="Opens Settings on the Statline tab when wired in Phase 12"/>
            </MenuItem>

            <MenuItem Header="_Game Data">
                <MenuItem Header="Active set"             IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
                <Separator/>
                <MenuItem Header="Open Browser…"          InputGesture="Ctrl+G" Command="{Binding OpenGameDataBrowserCommand}"/>
                <MenuItem Header="Open Macros…"           Command="{Binding OpenGameDataBrowserCommand}"
                          ToolTip.Tip="Opens Browser on the Macros tab when wired in Phase 5 / 10"/>
                <Separator/>
                <MenuItem Header="Import .mdb…"           IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
                <MenuItem Header="Import Spell Messages…" IsEnabled="False" ToolTip.Tip="Wired in Phase 5"/>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="{Binding CaptureMenuLabel}" Command="{Binding ToggleDumpCommand}"/>
                <MenuItem Header="Replay capture file…"       Command="{Binding ReplayCaptureFileCommand}"/>
                <Separator/>
                <MenuItem Header="Wire Inspector…"            Command="{Binding OpenWireInspectorCommand}"/>
                <Separator/>
                <MenuItem Header="Export chatlog…"            IsEnabled="False" ToolTip.Tip="Wired in Phase 2"/>
                <MenuItem Header="Open Logs folder…"          Command="{Binding OpenLogsFolderCommand}"/>
                <Separator/>
                <!-- Dev-facing entrypoint to inspect every edit-dialog
                     placeholder. Once each owning phase ships a real list
                     row that opens its editor, this submenu can go away. -->
                <MenuItem Header="Preview placeholder dialogs">
                    <MenuItem Header="Spell — Edit…"              Command="{Binding PreviewSpellEditDialogCommand}"/>
                    <MenuItem Header="Trigger — Edit…"            Command="{Binding PreviewTriggerEditDialogCommand}"/>
                    <MenuItem Header="Alias — Edit…"              Command="{Binding PreviewAliasEditDialogCommand}"/>
                    <MenuItem Header="Condition — Edit…"          Command="{Binding PreviewConditionEditDialogCommand}"/>
                    <MenuItem Header="Macro — Edit…"              Command="{Binding PreviewMacroEditDialogCommand}"/>
                    <MenuItem Header="Event — Edit…"              Command="{Binding PreviewEventEditDialogCommand}"/>
                    <MenuItem Header="Ambiguous Location…"        Command="{Binding PreviewAmbiguousLocationDialogCommand}"/>
                    <MenuItem Header="Import Conflict…"           Command="{Binding PreviewImportConflictDialogCommand}"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Help topics…"        InputGesture="F1" Command="{Binding OpenHelpTopicsCommand}"/>
                <MenuItem Header="Keyboard shortcuts…" Command="{Binding OpenKeyboardShortcutsCommand}"/>
                <Separator/>
                <MenuItem Header="MajorMUD wiki ↗"     Command="{Binding OpenMajorMudWikiCommand}"/>
                <MenuItem Header="MajorMUD subreddit ↗" Command="{Binding OpenMajorMudRedditCommand}"/>
                <MenuItem Header="BBS site ↗" IsEnabled="False" ToolTip.Tip="Wired in Phase 4 (BBS profile field)"/>
                <Separator/>
                <MenuItem Header="Open Logs folder…"   Command="{Binding OpenLogsFolderCommand}"/>
                <MenuItem Header="Report an issue…"    Command="{Binding ReportIssueCommand}"/>
                <Separator/>
                <MenuItem Header="License…"            Command="{Binding OpenLicenseCommand}"/>
                <MenuItem Header="About FujinTerm"     Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar (icon groups + char picker + BBS badge) ============ -->
        <Border DockPanel.Dock="Top" Classes="Toolbar">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <!-- Icon button groups -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    <!-- Group 1: connection -->
                    <Button Classes="ToolbarBtn" Command="{Binding ConnectCommand}" ToolTip.Tip="Connect (Ctrl+K)">
                        <Path Data="{StaticResource IconPlug}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn Danger" Command="{Binding DisconnectCommand}" ToolTip.Tip="Disconnect (Ctrl+D)">
                        <Path Data="{StaticResource IconUnplug}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 2: settings -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)">
                        <Path Data="{StaticResource IconGear}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 3: navigation / capture / wire -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenNavigationCommand}" ToolTip.Tip="Map (F5)">
                        <Path Data="{StaticResource IconMap}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenNavigationCommand}" ToolTip.Tip="Loops — opens Navigation; the loops pane wires in Phase 7">
                        <Path Data="{StaticResource IconLoop}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenBackscrollCommand}" ToolTip.Tip="Backscroll (F10)">
                        <Path Data="{StaticResource IconHistory}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding ToggleDumpCommand}"
                            Classes.Active="{Binding IsDumping}" ToolTip.Tip="Capture — toggle session capture">
                        <Path Data="{StaticResource IconRecord}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenWireInspectorCommand}"
                            ToolTip.Tip="Wire Inspector — view raw + stripped byte streams">
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Border Classes="ToolbarSeparator"/>

                    <!-- Group 4: panel toggles (stubbed) -->
                    <Button Classes="ToolbarBtn" Command="{Binding OpenConversationCommand}" ToolTip.Tip="Conversation (F2)">
                        <Path Data="{StaticResource IconChat}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenPartyCommand}" ToolTip.Tip="Party (F3)">
                        <Path Data="{StaticResource IconParty}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenWorkshopCommand}" ToolTip.Tip="Player Status / Workshop (F4 / F6)">
                        <Path Data="{StaticResource IconUser}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenSpellBookCommand}" ToolTip.Tip="Spell Book (F7)">
                        <Path Data="{StaticResource IconBook}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="ToolbarBtn" Command="{Binding OpenLogPaneCommand}" ToolTip.Tip="Log (F9)">
                        <Path Data="{StaticResource IconLog}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Char picker + BBS badge — pushed right by the spacer column. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="CharPicker" IsEnabled="False" ToolTip.Tip="Character picker — wired in Phase 4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Char" Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                            <TextBlock Text="—" Foreground="{StaticResource ChromeFgBrush}"/>
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{StaticResource ChromeFgMutedBrush}"
                                  StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Height="{StaticResource BbsBadgeHeight}">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsConnected}"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource ChromeFgMutedBrush}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsDisconnected}"/>
                        <TextBlock Text="{Binding BbsBadgeText}"
                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Secondary strip (transitional Host / Port editor) ============ -->
        <!-- Phase 4 PR 4.5 BBS-profile editor will absorb these; until then the
             toolbar BBS badge displays the values and this strip lets the user
             edit them. -->
        <Border DockPanel.Dock="Top" Classes="SecondaryStrip">
            <Grid ColumnDefinitions="Auto,*,Auto,80" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="{StaticResource FontSizeSm}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Host}" MinWidth="220"
                         Background="{StaticResource ChromeBgBrush}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
                <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="{StaticResource FontSizeSm}" Margin="12,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding Port}"
                         Background="{StaticResource ChromeBgBrush}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
            </Grid>
        </Border>

        <!-- ============ Status bar (three slots) ============ -->
        <!-- Left  : room + confidence dot (Phase 7 wires the live values).
             Mid   : tick countdowns (Phase 3 wires HP / MA / combat tick).
             Right : latest LogService line + exp rate + clock (Phase 1 PR 1.5 wires log;
                     exp rate / clock are Phase 8 / polish wirings). -->
        <Border DockPanel.Dock="Bottom" Classes="StatusBar">
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBlock Classes="StatusSlot StatusMuted" Text="No room — RoomTracker wires in Phase 7"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Classes="StatusSlot StatusMono StatusMuted" Text="Tick —"/>
                    <TextBlock Classes="StatusSlot StatusMono StatusMuted" Text="HP —"/>
                    <TextBlock Classes="StatusSlot StatusMono StatusMuted" Text="MA —"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Classes="StatusSlot"
                           HorizontalAlignment="Right"
                           Text="{Binding StatusText}"/>
            </Grid>
        </Border>

        <!-- ============ Terminal canvas ============ -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ChromeBgSunkenBrush}">
            <ctl:TerminalControl x:Name="Terminal"
                                 Emulator="{Binding Emulator}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                <ctl:TerminalControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy"                 InputGesture="Ctrl+Shift+C" IsEnabled="False" ToolTip.Tip="Wired in Phase 1"/>
                        <MenuItem Header="Paste"                InputGesture="Ctrl+Shift+V" IsEnabled="False" ToolTip.Tip="Wired in Phase 1"/>
                        <MenuItem Header="Select all"           IsEnabled="False" ToolTip.Tip="Wired in Phase 1"/>
                        <MenuItem Header="Find in scrollback…"  IsEnabled="False" ToolTip.Tip="Wired in Phase 1"/>
                        <MenuItem Header="Clear screen"         IsEnabled="False" ToolTip.Tip="Wired in Phase 1"/>
                    </ContextMenu>
                </ctl:TerminalControl.ContextMenu>
            </ctl:TerminalControl>
        </ScrollViewer>

    </DockPanel>

</Window>
