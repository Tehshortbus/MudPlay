<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.GameData.Edit"
        xmlns:spells="using:MudPlay.Game.Spells"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="840"
        x:Class="MudPlay.Views.GameData.Edit.MessageEditDialog"
        x:DataType="vm:MessageEditDialogViewModel"
        Title="{Binding Title}"
        Width="660" Height="840" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <!-- Clickable record link in the Game Data tab — matches the other Game
             Data edit dialogs' MdbLink (blue, opens the target's record). -->
        <Style Selector="Button.MdbLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MdbLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="*,Auto" RowSpacing="10">

          <TabControl Grid.Row="0" SelectedIndex="{Binding InitialTabIndex, Mode=OneTime}">
            <TabItem Header="User Definitions">
              <!-- Scrollable so the fields + Effects never truncate on a short window
                   (the Confuse-fumble row makes this tab tall); rows are all Auto so the
                   grid measures to natural height inside the ScrollViewer. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="0,8,8,0">

            <!-- ===== Header fields (Name / Use / 4 perspective lines + EndsWith pair) ===== -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="6">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Use"/>
                <ComboBox  Grid.Row="1" Grid.Column="1"
                           ItemsSource="{Binding AvailableTiers}"
                           SelectedValue="{Binding UseTier, Mode=TwoWay}"
                           SelectedValueBinding="{Binding Value}"
                           DisplayMemberBinding="{Binding Label}"
                           HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Caster"
                           ToolTip.Tip="Line YOU see when YOU cast / use / proc this."/>
                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding CasterMessage, Mode=TwoWay}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Target"
                           ToolTip.Tip="Line YOU see when the spell hits / is cast on YOU."/>
                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding TargetMessage, Mode=TwoWay}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Witness"
                           ToolTip.Tip="Line YOU see when someone else casts on someone else."/>
                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding WitnessMessage, Mode=TwoWay}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="Applied"
                           ToolTip.Tip="Buff/debuff begin line YOU see when the effect starts on you."/>
                <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding AppliedMessage, Mode=TwoWay}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Classes="FieldLabel" Text="Wears off"
                           ToolTip.Tip="Wear-off line YOU see when the buff/debuff above expires."/>
                <TextBox   Grid.Row="6" Grid.Column="1" Text="{Binding AppliedEndsWith, Mode=TwoWay}"/>

                <!-- Confuse fumble: only shown when the Confused effect is checked. The
                     wire line(s) this confuse source emits when it fumbles a just-sent
                     command (one wording per line) — a fumbled MOVE reverts on any of them.
                     Defaults to the generic "You fumble in confusion!"; add a spell's own
                     wording here instead of hardcoding it. -->
                <TextBlock Grid.Row="7" Grid.Column="0" Classes="FieldLabel" Text="Confuse fumble"
                           IsVisible="{Binding FlagConfused}"
                           ToolTip.Tip="Line(s) this confuse source emits when it fumbles a command — one per line. A fumbled move reverts on a match. Defaults to 'You fumble in confusion!'."/>
                <TextBox   Grid.Row="7" Grid.Column="1" Text="{Binding ConfuseFumbleLine, Mode=TwoWay}"
                           IsVisible="{Binding FlagConfused}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46"
                           PlaceholderText="You fumble in confusion!"/>

                <!-- Cast response: an engine-driven response sent when this record's spell
                     is detected cast — the one exception to messages being recognition-only.
                     Its use case is the silent "…temp" death-spells: a monster whose
                     DeathSpell is a temp spell fires this on death, seeded "^M^M" (two
                     carriage returns) to nudge the game engine past its stall. '^M' = a
                     carriage return, like the Triggers table. -->
                <TextBlock Grid.Row="8" Grid.Column="0" Classes="FieldLabel" Text="Cast response"
                           ToolTip.Tip="Sent to the server when this spell is detected cast (e.g. a temp death-spell). '^M' = carriage return; temp spells default to '^M^M' (two CRs) to unstick the engine."/>
                <TextBox   Grid.Row="8" Grid.Column="1" Text="{Binding CastResponse, Mode=TwoWay}"/>
            </Grid>

            <!-- Below the line fields: when the record is valid, show the
                 placeholder-token legend so an author knows which bracket pins
                 which capture slot (meaning on hover). When validation fails,
                 the red error replaces it. -->
            <StackPanel Grid.Row="1" Margin="108,0,0,0" Spacing="3"
                        IsVisible="{Binding !HasError}">
                <TextBlock Text="Placeholders for any line above (hover for meaning):"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11"/>
                <ItemsControl ItemsSource="{Binding Placeholders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="spells:MessagePlaceholder">
                            <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,6,4"
                                    ToolTip.Tip="{Binding Meaning}">
                                <TextBlock Text="{Binding Token}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11"
                                           Foreground="{StaticResource ChromeFgBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No wording for a line this spell simply doesn't have? Type {null}, {void}, or {empty} — it counts as filled, so the record clears the Incomplete Messages list."
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Grid.Row="1"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Foreground="#FFE06D6D" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <!-- ===== Links (top, full width) + Effects (two columns) ===== -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="10">

                <!-- Links stretch across the top: the game-data row(s) this message
                     is anchored to. Always visible so the first link can be added on
                     a brand-new record. A message is recognition only — it identifies
                     a line and, via the Effects flags below, the condition it means;
                     player responses to a seen line live in the Triggers table. -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Links"/>
                        <TextBlock Text="The spell record(s) this message provides text for."
                                   Classes="FieldLabel"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- Existing links — each row has its own X button. -->
                        <ItemsControl ItemsSource="{Binding LinkRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,1">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Foreground="{StaticResource ChromeFgBrush}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="×"
                                                Padding="6,0"
                                                MinWidth="22" MinHeight="22"
                                                ToolTip.Tip="Remove this link"
                                                Command="{Binding $parent[Window].((vm:MessageEditDialogViewModel)DataContext).RemoveLinkCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add-link row: a message always attributes to a Spells row,
                             so there's no table picker — just the spell Number + Add. -->
                        <Border Height="1" Margin="0,8"
                                Background="{StaticResource ChromeBorderBrush}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox  Grid.Column="0"
                                      Text="{Binding AddLinkNumber, Mode=TwoWay}"
                                      PlaceholderText="Spell number"
                                      FontFamily="{StaticResource FontMono}"/>
                            <Button   Grid.Column="1"
                                      Content="Add"
                                      Command="{Binding AddLinkCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding AddLinkStatus}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <!-- Inline collision resolver: appears when the linked spell's
                             record already has text that differs from the line being
                             committed. Per field, keep the record's value (checked) or
                             use the unrecognized line (unchecked), then Apply. -->
                        <Border IsVisible="{Binding HasLinkFillConflicts}"
                                Margin="0,10,0,0" Padding="10"
                                Background="{StaticResource ChromeBgElevBrush}"
                                BorderBrush="{StaticResource ChromeBorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <StackPanel Spacing="6">
                                <TextBlock Text="This spell's record already has different text. Pick which to keep for each field:"
                                           Classes="FieldLabel" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding LinkFillConflicts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LinkFillConflict">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock Text="{Binding FieldLabel}"
                                                           FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="{Binding RecordValue, StringFormat='Record: {0}'}"
                                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding UnrecognizedValue, StringFormat='Unrecognized: {0}'}"
                                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <CheckBox IsChecked="{Binding UseRecord, Mode=TwoWay}"
                                                          FontSize="11"
                                                          Content="Keep the record's value (uncheck to use the unrecognized line)"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Apply choices"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ApplyLinkFillCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Effects: the condition this line means, as flag checkboxes. Two
                     columns. The MegaMUD find-mode flags (FindInText /
                     FindInConversations / UseWhenChasing) and the four retired inert
                     effect bits (LosingHp / HpRegenerating / ManaRegenerating /
                     EndsCombat) are not shown; their bits round-trip as "reserved" via
                     RawFlagsHex so a legacy re-save keeps them. -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Effects" Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Blinded"             IsChecked="{Binding FlagBlinded, Mode=TwoWay}"/>
                                <CheckBox Content="Confused"            IsChecked="{Binding FlagConfused, Mode=TwoWay}"/>
                                <CheckBox Content="Poisoned"            IsChecked="{Binding FlagPoisoned, Mode=TwoWay}"/>
                                <CheckBox Content="Diseased"            IsChecked="{Binding FlagDiseased, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Movement prevented"  IsChecked="{Binding FlagMovementPrevented, Mode=TwoWay}"/>
                                <CheckBox Content="Attack prevented"    IsChecked="{Binding FlagAttackPrevented, Mode=TwoWay}"/>
                                <CheckBox Content="Last action failed"  IsChecked="{Binding FlagLastActionFailed, Mode=TwoWay}"/>
                                <CheckBox Content="Disabled (don't use)" IsChecked="{Binding FlagDisabled, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

              </Grid>
              </ScrollViewer>
            </TabItem>

            <!-- ===== Game Data (read-only source-row fields) ===== -->
            <TabItem Header="Game Data" IsVisible="{Binding HasGameData}">
              <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                <!-- Damage calculator (damage spells only): live min/max vs a
                     Level picker, plus Magic-Resist / elemental-resist pickers
                     where they bear on the spell. -->
                <Border IsVisible="{Binding HasDamageCalc}"
                        Background="{StaticResource ChromeBgSunkenBrush}"
                        BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Damage calculator" Classes="FieldLabel"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="Damage" Foreground="{StaticResource ChromeFgMutedBrush}"
                                 FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding DamageCalc.DamageText}"
                                 Foreground="{StaticResource AccentGreenBrush}"
                                 FontFamily="{StaticResource FontMono}" FontSize="16"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Level" Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                        <NumericUpDown Value="{Binding DamageCalc.Level, Mode=TwoWay}"
                                       Minimum="{Binding DamageCalc.MinLevel}"
                                       Maximum="{Binding DamageCalc.MaxLevel}"
                                       Increment="1" FormatString="0" Width="120"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,16,0" IsVisible="{Binding DamageCalc.ShowMagicResist}">
                        <TextBlock Text="Magic resist" Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                        <NumericUpDown Value="{Binding DamageCalc.MagicResist, Mode=TwoWay}"
                                       Minimum="0" Maximum="300" Increment="5" FormatString="0" Width="120"/>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding DamageCalc.ShowElementalResist}">
                        <TextBlock Text="{Binding DamageCalc.ElementalResistLabel}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                        <!-- Elemental resist is signed: negative = vulnerability
                             (the element deals EXTRA damage), 100 = no damage. -->
                        <NumericUpDown Value="{Binding DamageCalc.ElementalResist, Mode=TwoWay}"
                                       Minimum="-200" Maximum="200" Increment="5" FormatString="0" Width="120"
                                       ToolTip.Tip="Negative = the target is vulnerable (extra damage); 100 = immune, above 100 heals it."/>
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding DamageCalc.GrowthText}"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"/>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding GameDataInfo}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameDataInfoRow">
                      <Grid ColumnDefinitions="160,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   Classes="FieldLabel" TextWrapping="Wrap"
                                   VerticalAlignment="Top"/>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                   IsVisible="{Binding !HasLinks}"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontFamily="{StaticResource FontMono}" FontSize="11"
                                   TextWrapping="Wrap"/>
                        <!-- Record-reference rows (Summons / Casts / Casted By /
                             Negated by / …): each name a blue link to its record. -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Links}"
                                      IsVisible="{Binding HasLinks}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameDataRecordLink">
                              <StackPanel Orientation="Horizontal">
                                <Button Classes="MdbLink" Content="{Binding Name}"
                                        Command="{Binding Open}"
                                        IsVisible="{Binding IsLinked}"
                                        ToolTip.Tip="Open this record in the Game Data browser"/>
                                <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsLinked}"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Trailing}"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Save"   Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True"  MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"   MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
