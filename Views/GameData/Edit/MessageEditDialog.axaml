<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="560"
        x:Class="FujinTerm.Views.GameData.Edit.MessageEditDialog"
        x:DataType="vm:MessageEditDialogViewModel"
        Title="{Binding Title}"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

            <!-- ===== Header fields (Name / Use / Message / EndsWith / Response) ===== -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="6">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Use"/>
                <ComboBox  Grid.Row="1" Grid.Column="1"
                           ItemsSource="{Binding AvailableTiers}"
                           SelectedItem="{Binding UseTier, Mode=TwoWay}"
                           HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Message"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Message, Mode=TwoWay}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Ends with"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding EndsWith, Mode=TwoWay}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Response"
                           VerticalAlignment="Top" Margin="0,6,0,0"/>
                <TextBox   Grid.Row="4" Grid.Column="1"
                           Text="{Binding Response, Mode=TwoWay}"
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                           FontFamily="{StaticResource FontMono}"
                           ToolTip.Tip="Verbatim response — exactly as MegaMUD would display it. Use literal ^M (two characters) to separate commands; the runtime sends each as its own CR-terminated line."/>
            </Grid>

            <!-- Live status / error line under the header block.
                 Muted hint when valid (shows the projected Id);
                 red when validation fails (missing Name / Message /
                 duplicate identity). -->
            <TextBlock Grid.Row="1"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding !HasError}"/>
            <TextBlock Grid.Row="1"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Foreground="#FFE06D6D" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <!-- ===== Effects + Action ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">

                <!-- Left: Effects checkboxes -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Classes="SectionHeader" Text="Effects"/>
                        <CheckBox Content="Blinded"             IsChecked="{Binding FlagBlinded, Mode=TwoWay}"/>
                        <CheckBox Content="Confused"            IsChecked="{Binding FlagConfused, Mode=TwoWay}"/>
                        <CheckBox Content="Poisoned"            IsChecked="{Binding FlagPoisoned, Mode=TwoWay}"/>
                        <CheckBox Content="Diseased"            IsChecked="{Binding FlagDiseased, Mode=TwoWay}"/>
                        <CheckBox Content="Losing HP's (on fire, etc.)" IsChecked="{Binding FlagLosingHp, Mode=TwoWay}"/>
                        <CheckBox Content="HP regenerating"     IsChecked="{Binding FlagHpRegenerating, Mode=TwoWay}"/>
                        <CheckBox Content="Mana regenerating"   IsChecked="{Binding FlagManaRegenerating, Mode=TwoWay}"/>
                        <CheckBox Content="Movement prevented"  IsChecked="{Binding FlagMovementPrevented, Mode=TwoWay}"/>
                        <CheckBox Content="Attack prevented"    IsChecked="{Binding FlagAttackPrevented, Mode=TwoWay}"/>
                        <CheckBox Content="Ends combat"         IsChecked="{Binding FlagEndsCombat, Mode=TwoWay}"/>
                        <CheckBox Content="Last action failed"  IsChecked="{Binding FlagLastActionFailed, Mode=TwoWay}"/>
                        <Border Height="1" Margin="0,8" Background="{StaticResource ChromeBorderBrush}"/>
                        <CheckBox Content="Find anywhere in text" IsChecked="{Binding FlagFindInText, Mode=TwoWay}"/>
                        <CheckBox Content="Find in conversations" IsChecked="{Binding FlagFindInConversations, Mode=TwoWay}"/>
                        <CheckBox Content="Use when chasing"      IsChecked="{Binding FlagUseWhenChasing, Mode=TwoWay}"/>
                        <CheckBox Content="Disabled (don't use)"  IsChecked="{Binding FlagDisabled, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Right: Action picker + Links panel -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="10">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Action"/>
                            <TextBlock Text="What the engine does when this message fires."
                                       Classes="FieldLabel"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding AvailableActions}"
                                      SelectedItem="{Binding Action, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Read-only back-references to the game-data row(s)
                         this message is associated with. Hidden when the
                         record has no Links (most user-authored entries). -->
                    <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="10"
                            IsVisible="{Binding HasLinks}">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Links"/>
                            <TextBlock Text="Game-data rows that fire this message."
                                       Classes="FieldLabel"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding LinkRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LinkRow">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource ChromeFgBrush}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Save"   Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True"  MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"   MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
