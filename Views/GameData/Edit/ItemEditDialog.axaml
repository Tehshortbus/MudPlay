<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.GameData.Edit"
        xmlns:conv="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
        x:Class="MudPlay.Views.GameData.Edit.ItemEditDialog"
        x:DataType="vm:ItemEditDialogViewModel"
        Title="{Binding Title}"
        Width="1000" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style Selector="Border.Group">
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.MdbKey">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.MdbValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
        <!-- Clickable item link — matches the room-detail popup's shop rows;
             sized to the MdbValue rows it sits beside. -->
        <Style Selector="Button.MdbLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MdbLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="*,Auto" RowSpacing="10">

            <!-- ===== Two panes: editable left + read-only MDB right =====
                 The editable side is a fixed width that fits its groups side by
                 side, so it needs no splitter and no scrolling at the default
                 size; the read-only MDB pane takes whatever width is left.
                 WindowLayouts remembers the window's size and place. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">

                <!-- Editable -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Width="540">

                            <!-- Name + Use tier on one row. -->
                            <Grid ColumnDefinitions="Auto,*,Auto,190" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                                <TextBox   Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Use" Margin="6,0,0,0"/>
                                <ComboBox  Grid.Column="3"
                                           ItemsSource="{Binding AvailableTiers}"
                                           SelectedItem="{Binding UseTier, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           ToolTip.Tip="Where this override is stored. 'Installed defaults' resets the record — it wipes your Global, BBS, and Character edits for it.">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Converter={x:Static conv:SettingsTierLabelConverter.Instance}}"/>
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- The options, grouped by what they do with the item, each
                                 beside the number it uses. -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <StackPanel Grid.Column="0" Spacing="10">
                                    <Border Classes="Group">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="GroupHeader" Text="Getting it"/>
                                            <CheckBox Content="Auto-collect" IsChecked="{Binding AutoCollect, Mode=TwoWay}"
                                                      ToolTip.Tip="Pick it up from rooms during walks and loops."/>
                                            <CheckBox Content="Auto-buy" IsChecked="{Binding AutoBuy, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanBuySell}"
                                                      ToolTip.Tip="{Binding AutoBuyTooltip}"/>
                                            <Grid ColumnDefinitions="*,80" Margin="0,2">
                                                <TextBlock Classes="FieldLabel" Text="Max to get"
                                                           ToolTip.Tip="Stop collecting or buying at this many. Blank = All."/>
                                                <TextBox Grid.Column="1" Text="{Binding MaxToGet, Mode=TwoWay}"
                                                         PlaceholderText="All"
                                                         ToolTip.Tip="Stop collecting or buying at this many. Blank = All."/>
                                            </Grid>
                                            <CheckBox Content="Cannot be taken" IsChecked="{Binding CannotBeTaken, Mode=TwoWay}"
                                                      ToolTip.Tip="Never pick it up, even with Auto-collect on."/>
                                            <CheckBox Content="Carry only one" IsChecked="{Binding CarryOnlyOne, Mode=TwoWay}"
                                                      ToolTip.Tip="The game lets you hold only one at a time. Roomba moves it one copy a trip, and Auto-collect and Auto-buy stop at one. Ticked to start with for an item the game data puts in a Unique Pool."/>
                                            <CheckBox Content="Auto-open" IsChecked="{Binding AutoOpen, Mode=TwoWay}"
                                                      IsVisible="{Binding CanAutoOpen}"
                                                      ToolTip.Tip="Open this container when one comes into your pack (Auto Get Items must be on). It waits out a fight, and what it gives is listed on Workshop → Chest Offload. One you already carry isn't opened."/>
                                            <CheckBox Content="Auto-obtain for path" IsChecked="{Binding AutoObtainForPath, Mode=TwoWay}"
                                                      ToolTip.Tip="When a route needs this item, go get it (party redistribute, shop buy via bank withdraw, or drop reroute) instead of failing the only route or asking in the route picker. Min. to keep / Max to get set how many per person."/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="Group">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="GroupHeader" Text="Keeping it"/>
                                            <CheckBox Content="Must have minimum" IsChecked="{Binding MustHaveMinimum, Mode=TwoWay}"
                                                      ToolTip.Tip="Always keep at least Min. to keep of it."/>
                                            <Grid ColumnDefinitions="*,80" Margin="0,2">
                                                <TextBlock Classes="FieldLabel" Text="Min. to keep"
                                                           ToolTip.Tip="Engines won't drop, discard or sell below this many. Blank = none."/>
                                                <TextBox Grid.Column="1" Text="{Binding MinToKeep, Mode=TwoWay}"
                                                         PlaceholderText="None"
                                                         ToolTip.Tip="Engines won't drop, discard or sell below this many. Blank = none."/>
                                            </Grid>
                                            <CheckBox Content="Loyal item" IsChecked="{Binding LoyalItem, Mode=TwoWay}"
                                                      ToolTip.Tip="Never drop or discard it."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Border Classes="Group">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="GroupHeader" Text="Getting rid of it"/>
                                            <CheckBox Content="Auto-sell" IsChecked="{Binding AutoSell, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanBuySell}"
                                                      ToolTip.Tip="{Binding AutoSellTooltip}"/>
                                            <StackPanel Margin="22,0,0,0" Spacing="2" IsVisible="{Binding CanSellDetour}">
                                                <CheckBox Content="Make detours to sell it"
                                                          IsChecked="{Binding SellDetour, Mode=TwoWay}"
                                                          ToolTip.Tip="Once you carry more than the count below, a walk, loop or Auto-Lair turns aside to a shop that trades this item, sells it, then carries on."/>
                                                <StackPanel Spacing="2" IsVisible="{Binding SellDetour}">
                                                    <Grid ColumnDefinitions="*,70" Margin="0,2">
                                                        <TextBlock Classes="FieldLabel" Text="when carrying more than"
                                                                   ToolTip.Tip="A detour goes once you carry more than this many, and more than Min. to keep. 0 = as soon as you carry more than Min. to keep (the first copy when that's blank or 0). Blank = no detour."/>
                                                        <TextBox Grid.Column="1" Text="{Binding SellDetourAbove, Mode=TwoWay}"
                                                                 PlaceholderText="None"/>
                                                    </Grid>
                                                    <TextBlock Foreground="{StaticResource AccentRedBrush}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Text="⚠ Set a number — blank means no detour"
                                                               IsVisible="{Binding NeedsSellDetourAbove}"/>
                                                    <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                                               Text="Tick 'Sell here' on the shops at right to choose where (none = any)."/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Content="Auto-stash" IsChecked="{Binding AutoStash, Mode=TwoWay}"
                                                      ToolTip.Tip="Hide it in a stash room as you pass through. With Must have minimum ticked, Min. to keep stays with you and only the copies above it are stashed; otherwise every copy goes. Works for keys on your key ring too."/>
                                            <CheckBox Content="Auto-discard" IsChecked="{Binding AutoDiscard, Mode=TwoWay}"
                                                      ToolTip.Tip="Drop it as soon as it's picked up. With Must have minimum ticked, Min. to keep copies stay with you and only the ones above that are dropped; otherwise every copy goes. A copy you are wearing counts as one you keep and is never the one dropped. A lit light is not protected: the game picks which copy goes, and it can be the lit one. Hidden instead of dropped when Settings → Other → Hide items when discarding is ticked."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- On-use / proc message — an item-claimed message record
                                         (its "use <item>" buff line, or a weapon-proc line) is
                                         authored / edited here, not from the Messages tab, mirroring
                                         how a spell's message is edited from the Spells tab. Hidden
                                         when the dialog was built with no message-editing surface. -->
                                    <Border Classes="Group" IsVisible="{Binding CanEditAttachedMessage}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="GroupHeader" Text="On-use message"/>
                                            <TextBlock Text="{Binding AttachedMessageDisplay}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                            <Button Content="{Binding AttachedMessageButtonText}"
                                                    Command="{Binding EditAttachedMessageCommand}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Read-only MDB info -->
                <Border Grid.Column="1"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Background="{StaticResource ChromeBgSunkenBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Other Info (from MDB)"/>
                            <ItemsControl ItemsSource="{Binding MdbInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey"   Text="{Binding Key}"/>
                                            <TextBlock Grid.Column="1" Classes="MdbValue" Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Casts — spells this item delivers (use-cast / proc). Each
                                 links to that spell's record, where its on-use / proc wording
                                 lives (shared across every item casting the same spell).
                                 Hidden for an item that casts nothing. -->
                            <ItemsControl ItemsSource="{Binding CastsSpells}" IsVisible="{Binding HasCastsSpells}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CastsSpellRow">
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey" Text="{Binding Label}"/>
                                            <StackPanel Grid.Column="1">
                                                <Button Classes="MdbLink"
                                                        Content="{Binding SpellName}"
                                                        Command="{Binding Open}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this spell's record — its on-use / proc messages live here"/>
                                                <TextBlock Classes="MdbValue" Text="{Binding Effect}"
                                                           IsVisible="{Binding HasEffect}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Teleports to — the room this item's action sends you to, a
                                 clickable link to the Rooms-tab record with a Queue-Walk
                                 action. Hidden when the action doesn't teleport. -->
                            <ItemsControl ItemsSource="{Binding TeleportsTo}" IsVisible="{Binding HasTeleportsTo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PlacedInRow">
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey" Text="Teleports To"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Classes="MdbLink"
                                                        Content="{Binding Location}"
                                                        Command="{Binding Open}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this room in the Game Data browser"/>
                                                <Button Classes="MdbLink"
                                                        Content="Queue Walking here →"
                                                        Command="{Binding QueueWalk}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Arm a walk to this room (opens the map; then click Run)"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Summons — monsters this item's action spawns, each a clickable
                                 link to its Game Data record. Hidden when it summons nothing. -->
                            <ItemsControl ItemsSource="{Binding Summons}" IsVisible="{Binding HasSummons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DroppedByRow">
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey" Text="Summons"/>
                                            <Button Grid.Column="1" Classes="MdbLink"
                                                    Content="{Binding Label}"
                                                    Command="{Binding Open}"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="Open this monster in the Game Data browser"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bought / sold — one row per shop that trades this
                                 item. The location links to the host room's Rooms-tab
                                 record; the charm-priced buy/sell line sits beneath.
                                 Hidden for an item sold at no shop. -->
                            <StackPanel IsVisible="{Binding HasShopSales}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Bought / sold"/>
                                <!-- Charm picker — re-prices the buy/sell figures below
                                     live. Default 50 (neutral retail); adjust to compare,
                                     e.g. a higher-charm party member selling. -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,6">
                                    <TextBlock Classes="MdbKey" Text="Charm" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding Charm, Mode=TwoWay}"
                                                   Minimum="1" Maximum="255" Increment="1"
                                                   FormatString="0" ShowButtonSpinner="True"
                                                   Width="120" MinWidth="120"
                                                   ToolTip.Tip="Buy/sell below are shown at this charm — adjust to compare (e.g. a higher-charm party member selling)"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ShopSales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ShopSaleRow">
                                            <StackPanel Margin="0,1,0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Classes="MdbLink"
                                                            Content="{Binding Location}"
                                                            Command="{Binding Open}"
                                                            IsEnabled="{Binding CanOpen}"
                                                            HorizontalAlignment="Left"
                                                            ToolTip.Tip="Open this room in the Game Data browser"/>
                                                    <CheckBox Content="Sell here"
                                                              IsChecked="{Binding SellHere, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanOpen}"
                                                              IsVisible="{Binding $parent[Window].((vm:ItemEditDialogViewModel)DataContext).SellDetour}"
                                                              ToolTip.Tip="A sell detour may use this shop. With none ticked, it uses whichever shop that trades the item adds the fewest steps."/>
                                                    <Button Classes="MdbLink"
                                                            Content="Queue Walking here →"
                                                            Command="{Binding QueueWalk}"
                                                            IsEnabled="{Binding CanOpen}"
                                                            HorizontalAlignment="Left"
                                                            ToolTip.Tip="Arm a walk to this shop's room (opens the map; then click Run)"/>
                                                </StackPanel>
                                                <TextBlock Classes="MdbValue" Text="{Binding Price}"
                                                           IsVisible="{Binding HasPrice}"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Dropped by — monsters that drop this item (with drop-rate),
                                 each a clickable link to its Game Data record. Hidden when
                                 nothing drops it. -->
                            <StackPanel IsVisible="{Binding HasDroppedBy}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Dropped by"/>
                                <ItemsControl ItemsSource="{Binding DroppedBy}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DroppedByRow">
                                            <Button Classes="MdbLink"
                                                    Content="{Binding Label}"
                                                    Command="{Binding Open}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,1"
                                                    ToolTip.Tip="Open this monster in the Game Data browser"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Found in — containers that can yield this item (the
                                 reverse of Chest Contents). Each links to the container's
                                 Items-tab record with its per-open drop chance. Hidden
                                 when no chest drops the item. -->
                            <StackPanel IsVisible="{Binding HasFoundInContainers}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Found in"/>
                                <ItemsControl ItemsSource="{Binding FoundInContainers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ChestDropRow">
                                            <Grid ColumnDefinitions="200,10,46" Margin="0,1">
                                                <Button Grid.Column="0" Classes="MdbLink"
                                                        Content="{Binding Name}"
                                                        Command="{Binding Open}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this container in the Game Data browser"/>
                                                <Border Grid.Column="1" Width="1"
                                                        Background="{StaticResource ChromeBorderBrush}"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="MdbValue" Text="{Binding Chance}"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Given by — monsters / rooms that hand this item over via
                                 a textblock giveitem (quest turn-ins, room CMD rewards,
                                 merchant gives). The name links to that Monsters/Rooms-tab
                                 record; a requirement note (turn in … / purchase / quest
                                 reward) sits beneath. Hidden when nothing gives the item. -->
                            <StackPanel IsVisible="{Binding HasGivers}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Given by"/>
                                <ItemsControl ItemsSource="{Binding Givers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ItemGiverRow">
                                            <StackPanel Margin="0,1,0,4">
                                                <Button Classes="MdbLink"
                                                        Content="{Binding Name}"
                                                        Command="{Binding Open}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this source in the Game Data browser"/>
                                                <TextBlock Classes="MdbValue" Text="{Binding Requirement}"
                                                           IsVisible="{Binding HasRequirement}"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Placed in — rooms whose static Placed list drops this
                                 item on the floor. Each links to the room's Rooms-tab
                                 record, with a Queue-Walk action. Hidden when the item is
                                 never floor-placed. -->
                            <StackPanel IsVisible="{Binding HasPlacedIn}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Placed in"/>
                                <ItemsControl ItemsSource="{Binding PlacedIn}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:PlacedInRow">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1,0,4">
                                                <Button Classes="MdbLink"
                                                        Content="{Binding Location}"
                                                        Command="{Binding Open}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this room in the Game Data browser"/>
                                                <Button Classes="MdbLink"
                                                        Content="Queue Walking here →"
                                                        Command="{Binding QueueWalk}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Arm a walk to this room (opens the map; then click Run)"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Room command — commands that hand the item over when
                                 typed in a room, with the rooms each works in. Not floor
                                 placements. Hidden when the export lists none. -->
                            <StackPanel IsVisible="{Binding HasRoomCommands}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Room command"
                                           ToolTip.Tip="Typing the command in one of these rooms can give this item. The chance is per use, an estimate from the game data; what else the command needs (an item, a level, a price) is in the room's command record."/>
                                <ItemsControl ItemsSource="{Binding RoomCommands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:RoomCommandRow">
                                            <StackPanel Margin="0,1,0,6">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding ShownRooms}" Margin="10,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:PlacedInRow">
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1,0,1">
                                                                <Button Classes="MdbLink"
                                                                        Content="{Binding Location}"
                                                                        Command="{Binding Open}"
                                                                        IsEnabled="{Binding CanOpen}"
                                                                        HorizontalAlignment="Left"
                                                                        ToolTip.Tip="Open this room in the Game Data browser"/>
                                                                <Button Classes="MdbLink"
                                                                        Content="Queue Walking here →"
                                                                        Command="{Binding QueueWalk}"
                                                                        IsEnabled="{Binding CanOpen}"
                                                                        HorizontalAlignment="Left"
                                                                        ToolTip.Tip="Arm a walk to this room (opens the map; then click Run)"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Classes="MdbLink" Margin="10,2,0,0"
                                                        Content="{Binding ToggleLabel}"
                                                        Command="{Binding ToggleCommand}"
                                                        IsVisible="{Binding CanExpand}"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Used on — the exits whose game data names this item as the
                                 one needed to pass (a key, an item to carry, a ticket), one
                                 room link per exit with a Queue-Walk action. A long list shows
                                 the first few with a toggle, like Room command. Hidden when no
                                 exit names the item. -->
                            <StackPanel IsVisible="{Binding HasExitUses}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Used on"
                                           ToolTip.Tip="Exits whose game data names this item as the one needed to pass, then the rooms where a command needs this item held to work an exit (marked Action; the exit it opens is named when the data names one). Both sides of a door that names it are listed apart."/>
                                <ItemsControl ItemsSource="{Binding ExitUses.ShownRooms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:PlacedInRow">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1,0,1">
                                                <Button Classes="MdbLink"
                                                        Content="{Binding Location}"
                                                        Command="{Binding Open}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this room in the Game Data browser"/>
                                                <Button Classes="MdbLink"
                                                        Content="Queue Walking here →"
                                                        Command="{Binding QueueWalk}"
                                                        IsEnabled="{Binding CanOpen}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Arm a walk to this room (opens the map; then click Run)"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="MdbLink" Margin="0,2,0,0"
                                        Content="{Binding ExitUses.ToggleLabel}"
                                        Command="{Binding ExitUses.ToggleCommand}"
                                        IsVisible="{Binding ExitUses.CanExpand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Chest Contents — containers only. Decoded loot table:
                                 item · at-least-once drop chance for one `open`, plus a
                                 yield summary. Read-only; hidden for non-containers. -->
                            <StackPanel IsVisible="{Binding HasChestContents}" Margin="0,10,0,0">
                                <TextBlock Classes="SectionHeader" Text="Chest Contents"/>
                                <TextBlock Classes="MdbKey" Foreground="{StaticResource ChromeFgBrush}"
                                           Text="{Binding ChestSummary}" Margin="0,0,0,3"/>
                                <ItemsControl ItemsSource="{Binding ChestDrops}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ChestDropRow">
                                            <Grid ColumnDefinitions="200,10,46" Margin="0,1">
                                                <Button Grid.Column="0" Classes="MdbLink"
                                                        Content="{Binding Name}"
                                                        Command="{Binding Open}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Open this item in the Game Data browser"/>
                                                <Border Grid.Column="1" Width="1"
                                                        Background="{StaticResource ChromeBorderBrush}"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="MdbValue" Text="{Binding Chance}"
                                                           TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="OK"     Command="{Binding SaveCommand}"   IsDefault="True" MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"  MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
