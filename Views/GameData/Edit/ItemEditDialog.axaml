<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="740"
        x:Class="FujinTerm.Views.GameData.Edit.ItemEditDialog"
        x:DataType="vm:ItemEditDialogViewModel"
        Title="{Binding Title}"
        Width="920" Height="740"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style Selector="TextBlock.MdbKey">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.MdbValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="*,Auto" RowSpacing="10">

            <!-- ===== Two panes: editable left + read-only MDB right =====
                 Same shape as MonsterEditDialog — GridSplitter persists
                 the column ratio per profile via SplitterLayoutStore
                 (id = "ItemEditDialog"). The initial split is skewed
                 toward the left (1.3* / 1*) because the editable side
                 carries the Item / Options / Details boxes which need
                 ~460px to render without clipping; a true 50/50 starts
                 the dialog with the left content overlaying the
                 splitter on first open. SplitterLayoutStore restores
                 the user's last-dragged ratio over this default. -->
            <Grid Grid.Row="0" x:Name="PanesGrid" ColumnDefinitions="1.3*,6,*">

                <!-- Editable -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">

                            <!-- Item Name + Use tier — kept narrow and left-aligned
                                 so they don't reach the splitter. -->
                            <Grid ColumnDefinitions="110,280" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6"
                                  HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Use"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1"
                                           ItemsSource="{Binding AvailableTiers}"
                                           SelectedItem="{Binding UseTier, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Options — 9 checkboxes laid out in two columns.
                                 Auto-equip + Can use to backstab dropped (auto-equip
                                 is owned by the Equipment Manager section; backstab
                                 eligibility is derived from ability code 116 at
                                 combat time, not user-overridable here). -->
                            <TextBlock Classes="SectionHeader" Text="Options" Margin="0,10,0,4"/>
                            <Border BorderBrush="{StaticResource ChromeBorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="8"
                                    HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="Auto,16,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <CheckBox Content="Auto-collect"         IsChecked="{Binding AutoCollect,     Mode=TwoWay}"/>
                                        <CheckBox Content="Auto-discard"         IsChecked="{Binding AutoDiscard,     Mode=TwoWay}"/>
                                        <CheckBox Content="Auto-find"            IsChecked="{Binding AutoFind,        Mode=TwoWay}"/>
                                        <CheckBox Content="Auto-open"            IsChecked="{Binding AutoOpen,        Mode=TwoWay}"/>
                                        <CheckBox Content="Auto-buy"             IsChecked="{Binding AutoBuy,         Mode=TwoWay}"
                                                  IsEnabled="{Binding CanBuySell}"
                                                  ToolTip.Tip="{Binding BuySellTooltip}"/>
                                        <CheckBox Content="Auto-sell"            IsChecked="{Binding AutoSell,        Mode=TwoWay}"
                                                  IsEnabled="{Binding CanBuySell}"
                                                  ToolTip.Tip="{Binding BuySellTooltip}"/>
                                        <CheckBox Content="Auto-stash"           IsChecked="{Binding AutoStash,       Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <CheckBox Content="Cannot be taken"      IsChecked="{Binding CannotBeTaken,   Mode=TwoWay}"/>
                                        <CheckBox Content="Must have minimum"    IsChecked="{Binding MustHaveMinimum, Mode=TwoWay}"/>
                                        <CheckBox Content="Loyal item"           IsChecked="{Binding LoyalItem,       Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Details — overlay-editable carry policy only. The
                                 read-only MDB facts (weight, item type, body slot,
                                 bought/sold) live in the right-pane "Other Info".
                                 Constrained to HorizontalAlignment=Left + fixed column
                                 widths so the controls don't stretch toward the splitter. -->
                            <TextBlock Classes="SectionHeader" Text="Details" Margin="0,10,0,4"/>
                            <Grid ColumnDefinitions="110,80"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6"
                                  HorizontalAlignment="Left">

                                <!-- Row 0: Min. to keep -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Min. to keep"
                                           ToolTip.Tip="Engines will not drop / discard below this count. Leave blank for none."/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding MinToKeep, Mode=TwoWay}"
                                           PlaceholderText="None"/>

                                <!-- Row 1: Max to get -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Max to get"
                                           ToolTip.Tip="Stop auto-acquiring at this count. Leave blank for 'All'."/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MaxToGet, Mode=TwoWay}"
                                           PlaceholderText="All"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Drag handle. -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource ChromeBorderBrush}"
                              ShowsPreview="False"/>

                <!-- Read-only MDB info -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="8,0,0,0"
                        Background="{StaticResource ChromeBgSunkenBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Other Info (from MDB)"/>
                            <ItemsControl ItemsSource="{Binding MdbInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey"   Text="{Binding Key}"/>
                                            <TextBlock Grid.Column="1" Classes="MdbValue" Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Chest Contents — containers only. Decoded loot table:
                                 item · at-least-once drop chance for one `open`, plus a
                                 yield summary. Read-only; hidden for non-containers. -->
                            <StackPanel IsVisible="{Binding HasChestContents}">
                                <TextBlock Classes="SectionHeader" Text="Chest Contents"/>
                                <TextBlock Classes="MdbKey" Text="{Binding ChestSummary}" Margin="0,0,0,3"/>
                                <ItemsControl ItemsSource="{Binding ChestDrops}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ChestDropRow">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                <TextBlock Grid.Column="0" Classes="MdbValue" Text="{Binding Name}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Classes="MdbValue" Text="{Binding Chance}"
                                                           TextAlignment="Right" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="OK"     Command="{Binding SaveCommand}"   IsDefault="True" MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"  MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
