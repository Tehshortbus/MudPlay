<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="220"
        x:Class="FujinTerm.Views.GameData.Edit.PlayerAddDialog"
        x:DataType="vm:PlayerAddDialogViewModel"
        Title="{Binding Title}"
        Width="460" Height="220"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.MutedHint">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

            <!-- Given name -->
            <Grid Grid.Row="0" ColumnDefinitions="100,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Given name"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding GivenName, Mode=TwoWay}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"
                           ToolTip.Tip="The first-name token. Case-insensitive; whitespace not allowed."/>
            </Grid>

            <!-- Family name -->
            <Grid Grid.Row="1" ColumnDefinitions="100,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Family name"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding FamilyName, Mode=TwoWay}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"
                           ToolTip.Tip="Optional. Players who change family names at train-stats will overwrite this on the next `who`."/>
            </Grid>

            <!-- Live status / error line -->
            <TextBlock Grid.Row="2"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Classes="MutedHint"
                       IsVisible="{Binding !HasError}"/>
            <TextBlock Grid.Row="2"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Foreground="#FFE06D6D" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <!-- Spacer / breathing room -->
            <Border Grid.Row="3"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Save"   Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True" MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsCancel="True"  MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
