<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.GameData.Edit"
        xmlns:conv="using:MudPlay.ViewModels"
        xmlns:spells="using:MudPlay.Game.Spells"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="780"
        x:Class="MudPlay.Views.GameData.Edit.MonsterEditDialog"
        x:DataType="vm:MonsterEditDialogViewModel"
        Title="{Binding Title}"
        Width="920" Height="780"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Override spell-picker dropdown row: "code — name". The box commits the
             Short cast-code (ValueMemberBinding); this only shapes the list display,
             mirroring the Settings → Combat spell slots. -->
        <DataTemplate x:Key="SpellPickItem" x:DataType="spells:SpellPick">
            <TextBlock Text="{Binding Display}"/>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Right-aligned so the label hugs its input regardless of column
             width — a short label ("Name", "Relationship") sits next to its box
             instead of stranding dead space between them. -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>
        <Style Selector="TextBlock.MdbKey">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.MdbValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
        <!-- A full-width attack-name header (spans both MDB columns so a long
             attack sentence wraps in full); its stat sub-rows follow indented. -->
        <Style Selector="TextBlock.MdbAttackName">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
        <!-- A record / room link inside the MDB pane. Styled to read as a link,
             not a chrome button. -->
        <Style Selector="Button.MdbLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MdbLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
        <!-- Small muted text button beside the Greet row (expand all / collapse all). -->
        <Style Selector="Button.TreeToolBtn">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="Background" Value="{StaticResource ChromeBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TreeToolBtn:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="*,Auto" RowSpacing="10">

            <!-- ===== Two panes: editable left + read-only MDB right =====
                 The middle column hosts a GridSplitter — drag to rebalance the
                 two side widths. The ratio persists per character profile via
                 SplitterLayoutStore (id = "MonsterEditDialog"). Initial split
                 is skewed toward the left (1.3* / 1*) — the editable side
                 carries the Monster / Details / Attack-Priority + Options /
                 Combat-Messages stack which needs more room than a true
                 50/50 split would give it. -->
            <Grid Grid.Row="0" x:Name="PanesGrid" ColumnDefinitions="1.3*,6,*">

                <!-- Editable -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <!-- Name + Use — left-aligned, value column fixed
                                 so they don't track the splitter. 240 comfortably
                                 fits the longest monster names + the Use-tier
                                 labels without the old excess width. -->
                            <TextBlock Classes="SectionHeader" Text="Monster"/>
                            <Grid ColumnDefinitions="68,240" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="6" RowSpacing="4"
                                  HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>
                                <!-- Where it lives. Blank = not set; pick an existing label or type a
                                     new one. A box still showing the installed label saves nothing. -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Landmass"
                                           ToolTip.Tip="The big walkable landmass this monster lives on (e.g. Mainland). Blank = not set. Pick an existing label or type a new one."/>
                                <AutoCompleteBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding Landmass, Mode=TwoWay}"
                                                 ItemsSource="{Binding LocationSuggestions.Landmasses}"
                                                 FilterMode="Contains" MinimumPrefixLength="0"
                                                 PlaceholderText="not set"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Region"
                                           ToolTip.Tip="The region you walk through to reach it (e.g. Volcano). Blank = not set."/>
                                <AutoCompleteBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding Region, Mode=TwoWay}"
                                                 ItemsSource="{Binding LocationSuggestions.Regions}"
                                                 FilterMode="Contains" MinimumPrefixLength="0"
                                                 PlaceholderText="not set"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Area"
                                           ToolTip.Tip="The named place inside the region (e.g. a lair or a cave). Blank = not set."/>
                                <AutoCompleteBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding Area, Mode=TwoWay}"
                                                 ItemsSource="{Binding LocationSuggestions.Areas}"
                                                 FilterMode="Contains" MinimumPrefixLength="0"
                                                 PlaceholderText="not set"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Use"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1"
                                           ItemsSource="{Binding AvailableTiers}"
                                           SelectedItem="{Binding UseTier, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           ToolTip.Tip="Where this override is stored. 'Installed defaults' resets the record — it wipes your Global, BBS, and Character edits for it.">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Converter={x:Static conv:SettingsTierLabelConverter.Instance}}"/>
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Details — left-aligned grid, fixed value
                                 column widths so the Relationship dropdown
                                 + Override spell rows don't stretch with
                                 the splitter. The value column is 140: the
                                 relationship options + override spell ids /
                                 cast-codes are all short, so the old 280 was
                                 wasted width. -->
                            <TextBlock Classes="SectionHeader" Text="Details"/>
                            <!-- Per-monster single-target combat overrides mirror the
                                 Settings → Combat spell grid rung-for-rung: three spell
                                 pickers (Debuff / Normal / Alternate) each with a per-room
                                 "Max casts" cap + a "Min mana to cast" floor stacked beneath
                                 it (same NumericUpDown + %↔value label as the Combat tab),
                                 plus a Physical-attack command box. A configured slot
                                 substitutes its spell into the matching rung of the same
                                 gated cascade for this species. Narrow two-column layout;
                                 the sub-rows span both columns, indented under the picker. -->
                            <Grid ColumnDefinitions="130,210"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="6" RowSpacing="4"
                                  HorizontalAlignment="Left">

                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Relationship"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1"
                                           ItemsSource="{Binding AvailableRelationships}"
                                           SelectedItem="{Binding Relationship, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Debuff (single target)"
                                           ToolTip.Tip="Single-target debuff to cast on this monster, over the global Combat-tab debuff. Pick from the list (or type a cast-code / Spell.Number). Max casts caps casts per room (blank = unlimited); Min mana to cast is read as % or absolute per the Combat tab's mana mode. Runs the same gates as the Combat-tab slot — a debuff the target's level blocks is skipped."/>
                                <AutoCompleteBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding PreAttackSpellId, Mode=TwoWay}"
                                                 ItemsSource="{Binding SpellSuggestions}"
                                                 ValueMemberBinding="{ReflectionBinding Short}"
                                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                                 ItemTemplate="{StaticResource SpellPickItem}"
                                                 PlaceholderText="code or name…"/>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                    <TextBlock Classes="FieldLabel" Text="Max casts"/>
                                    <NumericUpDown Value="{Binding PreAttackCount, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" FormatString="0" Increment="1" Width="100"
                                                   ToolTip.Tip="Casts per room — blank = no limit, 0 = never, N = at most N."/>
                                    <TextBlock Classes="FieldLabel" Text="Min mana to cast" Margin="8,0,0,0"/>
                                    <NumericUpDown Value="{Binding PreAttackMinMana, Mode=TwoWay}"
                                                   Minimum="0" Maximum="{Binding SpellManaMax}"
                                                   FormatString="0" Increment="1" Width="108"/>
                                    <TextBlock Classes="FieldLabel" Text="{Binding PreAttackMinManaConverted}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Normal attack spell"
                                           ToolTip.Tip="Spell that replaces the global Combat-tab Normal-attack spell on this monster, occupying the normal rung of the same gated cascade. Pick from the list (or type a cast-code / Spell.Number). Max casts caps casts per room (blank = unlimited); Min mana to cast is the floor (% or absolute). Spell-only — a raw attack verb goes in the Physical attack box below. Runs all the same gates: a spell the target is immune / level / element-resist blocked from is skipped down the cascade."/>
                                <AutoCompleteBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding NormalSpellId, Mode=TwoWay}"
                                                 ItemsSource="{Binding SpellSuggestions}"
                                                 ValueMemberBinding="{ReflectionBinding Short}"
                                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                                 ItemTemplate="{StaticResource SpellPickItem}"
                                                 PlaceholderText="code or name…"/>
                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                    <TextBlock Classes="FieldLabel" Text="Max casts"/>
                                    <NumericUpDown Value="{Binding NormalCount, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" FormatString="0" Increment="1" Width="100"
                                                   ToolTip.Tip="Casts per room — blank = no limit, 0 = never, N = at most N."/>
                                    <TextBlock Classes="FieldLabel" Text="Min mana to cast" Margin="8,0,0,0"/>
                                    <NumericUpDown Value="{Binding NormalMinMana, Mode=TwoWay}"
                                                   Minimum="0" Maximum="{Binding SpellManaMax}"
                                                   FormatString="0" Increment="1" Width="108"/>
                                    <TextBlock Classes="FieldLabel" Text="{Binding NormalMinManaConverted}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="Alternate attack spell"
                                           ToolTip.Tip="Spell that replaces the global Combat-tab Alternate-attack spell on this monster, the alternate rung of the same cascade (fired when the normal rung can't). Pick from the list (or type a cast-code / Spell.Number). Max casts / Min mana to cast as above. Spell-only."/>
                                <AutoCompleteBox Grid.Row="5" Grid.Column="1"
                                                 Text="{Binding AltSpellId, Mode=TwoWay}"
                                                 ItemsSource="{Binding SpellSuggestions}"
                                                 ValueMemberBinding="{ReflectionBinding Short}"
                                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                                 ItemTemplate="{StaticResource SpellPickItem}"
                                                 PlaceholderText="code or name…"/>
                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                                    <TextBlock Classes="FieldLabel" Text="Max casts"/>
                                    <NumericUpDown Value="{Binding AltCount, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" FormatString="0" Increment="1" Width="100"
                                                   ToolTip.Tip="Casts per room — blank = no limit, 0 = never, N = at most N."/>
                                    <TextBlock Classes="FieldLabel" Text="Min mana to cast" Margin="8,0,0,0"/>
                                    <NumericUpDown Value="{Binding AltMinMana, Mode=TwoWay}"
                                                   Minimum="0" Maximum="{Binding SpellManaMax}"
                                                   FormatString="0" Increment="1" Width="108"/>
                                    <TextBlock Classes="FieldLabel" Text="{Binding AltMinManaConverted}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" Grid.Column="0" Classes="FieldLabel" Text="Physical attack"
                                           ToolTip.Tip="Raw attack verb (attack, bash, kick…) that replaces the weapon command on this monster — but only on a round the engine already chose physical. It does NOT force physical or suppress the spell rungs, and carries no mana / cap gating. Blank = use the Combat-tab attack command."/>
                                <TextBox Grid.Row="7" Grid.Column="1"
                                         Text="{Binding PhysicalCommand, Mode=TwoWay}"
                                         PlaceholderText="verb (attack, bash…)"/>
                            </Grid>

                            <!-- Attack Priority + Options border boxes —
                                 fixed widths + left-aligned so they sit
                                 cleanly inside the pane instead of
                                 stretching all the way to the splitter. -->
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="14"
                                  HorizontalAlignment="Left" Margin="0,4,0,0">
                                <Border Grid.Column="0" Width="220"
                                        BorderBrush="{StaticResource ChromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel>
                                        <TextBlock Classes="SectionHeader" Text="Attack Priority"/>
                                        <ComboBox ItemsSource="{Binding AvailablePriorities}"
                                                  SelectedItem="{Binding Priority, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Width="220"
                                        BorderBrush="{StaticResource ChromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel>
                                        <TextBlock Classes="SectionHeader" Text="Options"/>
                                        <CheckBox Content="Don't backstab" IsChecked="{Binding DontBackstab, Mode=TwoWay}"/>
                                        <CheckBox Content="Kill on sight"
                                                  IsChecked="{Binding KillOnSight, Mode=TwoWay}"
                                                  IsVisible="{Binding ShowKillOnSight}"
                                                  ToolTip.Tip="Engage this neutral monster like an enemy. Neutrals never attack first, so other passive neutrals stay safe to rest among between kills."/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Drag handle. Width fixed by the column's GridLength; the
                     ResizeBehavior keeps the operation scoped to the two
                     star-width neighbours so the dialog overall stays the
                     same width while only the split moves. -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource ChromeBorderBrush}"
                              ShowsPreview="False"/>

                <!-- Read-only MDB info -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="8,0,0,0"
                        Background="{StaticResource ChromeBgSunkenBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Other Info (from MDB)"/>
                            <ItemsControl ItemsSource="{Binding MdbInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MdbInfoRow">
                                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey"
                                                       Text="{Binding Key}"
                                                       VerticalAlignment="Top"
                                                       IsVisible="{Binding ShowKeyCell}"/>

                                            <!-- Attack-name headers span both columns so a
                                                 long attack sentence wraps in full instead of
                                                 being clipped in the key column. -->
                                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                                       Classes="MdbAttackName"
                                                       Text="{Binding Key}" TextWrapping="Wrap"
                                                       IsVisible="{Binding FullWidth}"/>

                                            <!-- Plain rows render the value as text. -->
                                            <TextBlock Grid.Column="1" Classes="MdbValue"
                                                       Text="{Binding Value}" TextWrapping="Wrap"
                                                       IsVisible="{Binding IsPlain}"/>

                                            <!-- Room-list rows (Spawns In / Placed In / Summoned
                                                 In) render each map/room as a clickable chip that
                                                 opens the room-detail popup. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Rooms}"
                                                          IsVisible="{Binding HasRooms}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RoomLink">
                                                        <Button Classes="MdbLink"
                                                                Content="{Binding Label}"
                                                                Command="{Binding Open}"
                                                                Margin="0,0,10,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Item-drop rows render each dropped item as a
                                                 clickable chip that jumps to the Items tab. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}"
                                                          IsVisible="{Binding HasItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ItemLink">
                                                        <Button Classes="MdbLink"
                                                                Content="{Binding Label}"
                                                                Command="{Binding Open}"
                                                                Margin="0,0,10,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Mixed inline rows (Between Rounds / Summons) read
                                                 as running text with a single embedded link: the
                                                 summon spell opens its Spell record, the summoned
                                                 NPC opens its Monster record. Plain runs render as
                                                 text; a link run renders as a cyan MdbLink chip. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Inlines}"
                                                          IsVisible="{Binding HasInlines}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MdbInline">
                                                        <Panel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Text}"
                                                                       IsVisible="{Binding IsPlainRun}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontFamily="{StaticResource FontMono}"
                                                                       Foreground="{StaticResource ChromeFgBrush}"/>
                                                            <Button Classes="MdbLink"
                                                                    Content="{Binding Text}"
                                                                    Command="{Binding Open}"
                                                                    IsVisible="{Binding IsLink}"
                                                                    VerticalAlignment="Center"/>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Textblock-backed rows (Greet): the value names the
                                                 textblock, with the tree's expand / collapse buttons
                                                 beside it; the keyword tree itself spans the pane
                                                 below, since the value column is too narrow for it. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                        IsVisible="{Binding HasGreet}">
                                                <TextBlock Classes="MdbValue" Text="{Binding Value}"
                                                           VerticalAlignment="Center"/>
                                                <Button Classes="TreeToolBtn" Content="expand all"
                                                        Command="{Binding Greet.ExpandAllCommand, FallbackValue={x:Null}}"/>
                                                <Button Classes="TreeToolBtn" Content="collapse all"
                                                        Command="{Binding Greet.CollapseAllCommand, FallbackValue={x:Null}}"/>
                                            </StackPanel>

                                            <!-- The same collapsible tree a room spell's conditional
                                                 effects use: keyword branches (tinted when asking one
                                                 teleports you) over the effects they fire, a teleport
                                                 line linking to its map room. Runs wrap to the pane
                                                 width instead of running off the edge. -->
                                            <TreeView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                      IsVisible="{Binding HasGreet}"
                                                      ItemsSource="{Binding Greet.Keywords, FallbackValue={x:Null}}"
                                                      Background="Transparent" BorderThickness="0"
                                                      Margin="0,2,0,4"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <TreeView.Styles>
                                                    <Style Selector="TreeViewItem" x:DataType="vm:SpellEffectNode">
                                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                    </Style>
                                                    <Style Selector="Border.node">
                                                        <Setter Property="Padding" Value="4,1"/>
                                                        <Setter Property="CornerRadius" Value="3"/>
                                                    </Style>
                                                    <Style Selector="Border.branch">
                                                        <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                        <Setter Property="Padding" Value="6,3"/>
                                                        <Setter Property="Background" Value="{StaticResource ChromeBgBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderSoftBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.branch.accent">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    </Style>
                                                </TreeView.Styles>
                                                <TreeView.ItemTemplate>
                                                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:SpellEffectNode">
                                                        <Border Classes="node" Classes.branch="{Binding IsBranch}"
                                                                Classes.accent="{Binding IsAccent}"
                                                                HorizontalAlignment="Stretch">
                                                            <ItemsControl ItemsSource="{Binding Runs}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:MdbInline">
                                                                        <Panel>
                                                                            <TextBlock Text="{Binding Text}" IsVisible="{Binding IsPlainRun}"
                                                                                       Classes="MdbValue" TextWrapping="Wrap"/>
                                                                            <Button Classes="MdbLink" Command="{Binding Open}"
                                                                                    IsVisible="{Binding IsLink}"
                                                                                    ToolTip.Tip="Open the map on this room">
                                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                            </Button>
                                                                        </Panel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </TreeDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Save"   Command="{Binding SaveCommand}"   IsDefault="True"  MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"   MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
