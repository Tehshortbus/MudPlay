<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="780"
        x:Class="MudPlay.Views.GameData.Edit.MonsterEditDialog"
        x:DataType="vm:MonsterEditDialogViewModel"
        Title="{Binding Title}"
        Width="920" Height="780"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style Selector="TextBlock.MdbKey">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.MdbValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
        <!-- A textblock-backed value (Greet) that pops its command keywords on
             click. Styled to read as a link, not a chrome button. -->
        <Style Selector="Button.MdbLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MdbLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="*,Auto" RowSpacing="10">

            <!-- ===== Two panes: editable left + read-only MDB right =====
                 The middle column hosts a GridSplitter — drag to rebalance the
                 two side widths. The ratio persists per character profile via
                 SplitterLayoutStore (id = "MonsterEditDialog"). Initial split
                 is skewed toward the left (1.3* / 1*) — the editable side
                 carries the Monster / Details / Attack-Priority + Options /
                 Combat-Messages stack which needs more room than a true
                 50/50 split would give it. -->
            <Grid Grid.Row="0" x:Name="PanesGrid" ColumnDefinitions="1.3*,6,*">

                <!-- Editable -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <!-- Name + Use — left-aligned, value column fixed
                                 at 280 so they don't track the splitter. -->
                            <TextBlock Classes="SectionHeader" Text="Monster"/>
                            <Grid ColumnDefinitions="110,280" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6"
                                  HorizontalAlignment="Left">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Use"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1"
                                           ItemsSource="{Binding AvailableTiers}"
                                           SelectedItem="{Binding UseTier, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Details — left-aligned grid, fixed value
                                 column widths so the Relationship dropdown
                                 + Override spell rows don't stretch with
                                 the splitter. -->
                            <TextBlock Classes="SectionHeader" Text="Details"/>
                            <Grid ColumnDefinitions="160,280,8,Auto,64"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6"
                                  HorizontalAlignment="Left">

                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Relationship"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                           ItemsSource="{Binding AvailableRelationships}"
                                           SelectedItem="{Binding Relationship, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Override Pre-attack"
                                           ToolTip.Tip="Spell.Number to cast on this monster before melee — takes priority over the global Combat-tab pre-attack."/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding PreAttackSpellId, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Classes="FieldLabel" Text="Max"/>
                                <TextBox   Grid.Row="1" Grid.Column="4" Text="{Binding PreAttackCount, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Override Attack"
                                           ToolTip.Tip="Force a specific attack on this monster, over the global Combat-tab flow. A Spell.Number OR a spell's cast-code (e.g. &quot;turn&quot;) both cast through the mana-gated attack-spell rung (set Max) — a typed cast-code auto-resolves to its number. Anything else (e.g. &quot;attack&quot;, &quot;bash&quot;) is sent verbatim as a raw command every round, with no mana/cap gating."/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding AttackOverride, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Classes="FieldLabel" Text="Max"/>
                                <TextBox   Grid.Row="2" Grid.Column="4" Text="{Binding AttackCount, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Attack Priority + Options border boxes —
                                 fixed widths + left-aligned so they sit
                                 cleanly inside the pane instead of
                                 stretching all the way to the splitter. -->
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="14"
                                  HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Border Grid.Column="0" Width="220"
                                        BorderBrush="{StaticResource ChromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel>
                                        <TextBlock Classes="SectionHeader" Text="Attack Priority"/>
                                        <ComboBox ItemsSource="{Binding AvailablePriorities}"
                                                  SelectedItem="{Binding Priority, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Width="220"
                                        BorderBrush="{StaticResource ChromeBorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel>
                                        <TextBlock Classes="SectionHeader" Text="Options"/>
                                        <CheckBox Content="Don't backstab" IsChecked="{Binding DontBackstab, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ===== Messages section =====
                                 One multi-line textbox per perspective slot — each
                                 non-empty line is a separate variant pattern the
                                 combat manager will OR-match. Most monsters carry
                                 one line per field; multi-attack monsters (e.g.
                                 guardsman slash + all-out slash, dragon's four
                                 body-part attacks) carry several lines per field. -->
                            <TextBlock Classes="SectionHeader" Text="Combat Messages"
                                       Margin="0,12,0,4"/>
                            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                       Text="One variant per line. Use {s} for any %s placeholder, {d} for damage. Leave a field empty when the monster doesn't produce that line (e.g. unkillable NPCs have no Death line)."/>

                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6" Margin="0,8,0,0">

                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Hit (you)"
                                           ToolTip.Tip="Line YOU see when the monster successfully hits YOU."/>
                                <TextBox   Grid.Row="0" Grid.Column="1"
                                           Text="{Binding HitYouText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Hit (other)"
                                           ToolTip.Tip="Line you see when the monster hits SOMEONE ELSE."/>
                                <TextBox   Grid.Row="1" Grid.Column="1"
                                           Text="{Binding HitOtherText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Death"
                                           ToolTip.Tip="Line shown when the monster dies. Empty for unkillable NPCs (shopkeepers, quest-givers, etc.)."/>
                                <TextBox   Grid.Row="2" Grid.Column="1"
                                           Text="{Binding DeathLineText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Armor block (you)"
                                           ToolTip.Tip="Line YOU see when the monster's swing hits YOU but YOUR armor deflects."/>
                                <TextBox   Grid.Row="3" Grid.Column="1"
                                           Text="{Binding ArmorBlockYouText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Armor block (other)"
                                           ToolTip.Tip="Line you see when SOMEONE ELSE's armor deflects."/>
                                <TextBox   Grid.Row="4" Grid.Column="1"
                                           Text="{Binding ArmorBlockOtherText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="Dodge (you)"
                                           ToolTip.Tip="Line YOU see when YOU evade the monster's swing."/>
                                <TextBox   Grid.Row="5" Grid.Column="1"
                                           Text="{Binding DodgeYouText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Classes="FieldLabel" Text="Dodge (other)"
                                           ToolTip.Tip="Line you see when SOMEONE ELSE evades."/>
                                <TextBox   Grid.Row="6" Grid.Column="1"
                                           Text="{Binding DodgeOtherText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Classes="FieldLabel" Text="Miss (you)"
                                           ToolTip.Tip="Line YOU see when the monster swings at YOU and misses."/>
                                <TextBox   Grid.Row="7" Grid.Column="1"
                                           Text="{Binding MissYouText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Classes="FieldLabel" Text="Miss (other)"
                                           ToolTip.Tip="Line you see when the monster swings at SOMEONE ELSE and misses."/>
                                <TextBox   Grid.Row="8" Grid.Column="1"
                                           Text="{Binding MissOtherText, Mode=TwoWay}"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                            </Grid>

                            <!-- Flavor prefixes — comma-separated, with the literal
                                 token "(no prefix)" representing the AllowNoPrefix flag. -->
                            <TextBlock Classes="SectionHeader" Text="Flavor Prefixes"
                                       Margin="0,12,0,4"/>
                            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                       Text="Comma-separated adjectives the game may insert before the monster's name. Include the literal token (no prefix) to allow the bare name with no adjective."/>
                            <TextBox Text="{Binding FlavorPrefixesCsv, Mode=TwoWay}"
                                     TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Drag handle. Width fixed by the column's GridLength; the
                     ResizeBehavior keeps the operation scoped to the two
                     star-width neighbours so the dialog overall stays the
                     same width while only the split moves. -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource ChromeBorderBrush}"
                              ShowsPreview="False"/>

                <!-- Read-only MDB info -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10"
                        Margin="8,0,0,0"
                        Background="{StaticResource ChromeBgSunkenBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Classes="SectionHeader" Text="Other Info (from MDB)"/>
                            <ItemsControl ItemsSource="{Binding MdbInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MdbInfoRow">
                                        <Grid ColumnDefinitions="140,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Classes="MdbKey" Text="{Binding Key}"/>

                                            <!-- Plain rows render the value as text. -->
                                            <TextBlock Grid.Column="1" Classes="MdbValue"
                                                       Text="{Binding Value}" TextWrapping="Wrap"
                                                       IsVisible="{Binding IsPlain}"/>

                                            <!-- Room-list rows (Spawns In / Placed In / Summoned
                                                 In) render each map/room as a clickable chip that
                                                 opens the room-detail popup. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Rooms}"
                                                          IsVisible="{Binding HasRooms}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RoomLink">
                                                        <Button Classes="MdbLink"
                                                                Content="{Binding Label}"
                                                                Command="{Binding Open}"
                                                                Margin="0,0,10,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Item-drop rows render each dropped item as a
                                                 clickable chip that jumps to the Items tab. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}"
                                                          IsVisible="{Binding HasItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ItemLink">
                                                        <Button Classes="MdbLink"
                                                                Content="{Binding Label}"
                                                                Command="{Binding Open}"
                                                                Margin="0,0,10,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Textblock-backed rows (Greet) render a clickable
                                                 value that pops the command keywords the block
                                                 responds to. -->
                                            <Button Grid.Column="1" Classes="MdbLink"
                                                    Content="{Binding Value}"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding HasActions}">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel MaxWidth="560">
                                                            <TextBlock Classes="SectionHeader"
                                                                       Text="Responds to (indented lines are the effects that fire)"/>
                                                            <!-- Right padding reserves a gutter so the overlay
                                                                 vertical scrollbar doesn't sit on top of the text. -->
                                                            <ScrollViewer MaxHeight="360"
                                                                          Padding="0,0,16,0"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontFamily="{StaticResource FontMono}"
                                                                                       FontSize="11"
                                                                                       TextWrapping="NoWrap" Margin="0,1"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Save"   Command="{Binding SaveCommand}"   IsDefault="True"  MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"   MinWidth="80"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
