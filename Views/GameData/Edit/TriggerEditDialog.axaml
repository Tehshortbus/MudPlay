<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="680"
        x:Class="FujinTerm.Views.GameData.Edit.TriggerEditDialog"
        x:DataType="vm:TriggerEditDialogViewModel"
        Title="{Binding Title}"
        Width="640" Height="680"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>
        <Style Selector="TextBlock.MutedHint">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">

            <!-- ===== Name + Enabled ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="100,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                <TextBox   Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"/>
                <CheckBox  Grid.Column="2" Content="Enabled"
                           IsChecked="{Binding Enabled, Mode=TwoWay}"
                           Margin="12,0,0,0"/>
            </Grid>

            <!-- ===== Location ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="100,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Location"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding LocationOptions}"
                           SelectedValue="{Binding Location, Mode=TwoWay}"
                           SelectedValueBinding="{Binding Value}"
                           DisplayMemberBinding="{Binding Label}"
                           HorizontalAlignment="Stretch"
                           ToolTip.Tip="Where this trigger saves to. 'Game data' lives in the active set's triggers.json and travels with the realm; 'Profile' lives on the character and follows them across realms."/>
            </Grid>

            <!-- ===== Scope + Match Type ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="100,*,100,180" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Scope"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding ScopeOptions}"
                           SelectedValue="{Binding Scope, Mode=TwoWay}"
                           SelectedValueBinding="{Binding Value}"
                           DisplayMemberBinding="{Binding Label}"
                           HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Match type"
                           HorizontalAlignment="Right" Margin="8,0,0,0"/>
                <ComboBox  Grid.Column="3"
                           ItemsSource="{Binding MatchOptions}"
                           SelectedValue="{Binding MatchType, Mode=TwoWay}"
                           SelectedValueBinding="{Binding Value}"
                           DisplayMemberBinding="{Binding Label}"
                           HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- ===== Pattern ===== -->
            <Grid Grid.Row="3" ColumnDefinitions="100,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Pattern"
                           VerticalAlignment="Top" Margin="0,6,0,0"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Pattern, Mode=TwoWay}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"/>
            </Grid>

            <!-- Status line — muted hint when valid, red when not.
                 Two TextBlocks share the same row, gated by HasError. -->
            <TextBlock Grid.Row="4"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Classes="MutedHint"
                       IsVisible="{Binding !HasError}"/>
            <TextBlock Grid.Row="4"
                       Margin="108,0,0,0"
                       Text="{Binding StatusMessage}"
                       Foreground="#FFE06D6D" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>

            <!-- Capture-hints panel — collapses when pattern has none. -->
            <Grid Grid.Row="5" ColumnDefinitions="100,*" ColumnSpacing="8"
                  IsVisible="{Binding CaptureHints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Captures"/>
                <TextBlock Grid.Column="1" Text="{Binding CaptureHints}"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="11"
                           ToolTip.Tip="These names are available inside Response / Notify via {name}. They populate from each match."/>
            </Grid>

            <!-- ===== Response (multi-line) ===== -->
            <Grid Grid.Row="6" RowDefinitions="Auto,*,Auto" RowSpacing="3">
                <TextBlock Grid.Row="0" Classes="SectionHeader" Text="Response"/>
                <TextBox   Grid.Row="1"
                           Text="{Binding Response, Mode=TwoWay}"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"
                           MinHeight="100"
                           ToolTip.Tip="Sent to the game on match. {name} substitutes from the capture cache. Use ^M or ; to split into multiple lines. Leave blank to send a bare CR."/>
                <TextBlock Grid.Row="2"
                           Classes="MutedHint"
                           Text="{}{name} substitutes from the capture cache.  ^M or ; splits multi-line.  Blank = bare CR."/>
            </Grid>

            <!-- ===== Optional sidecars ===== -->
            <TextBlock Grid.Row="7" Classes="SectionHeader" Text="Optional"/>

            <Grid Grid.Row="8" ColumnDefinitions="100,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Sound"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding SoundFile, Mode=TwoWay}"
                           ToolTip.Tip="Path to a sound file to play on match. Phase 13 wires actual playback; today it's a no-op + log line."/>
                <Button    Grid.Column="2"
                           Content="Browse…"
                           Command="{Binding BrowseSoundCommand}"
                           CommandParameter="{Binding $parent[Window]}"/>
            </Grid>

            <!-- ===== Buttons ===== -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Save"   Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True" MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsCancel="True"  MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
