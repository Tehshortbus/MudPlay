<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData.Edit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="540"
        x:Class="FujinTerm.Views.GameData.Edit.RoomDetailDialog"
        x:DataType="vm:RoomDetailDialogViewModel"
        Title="{Binding Title}"
        Width="560" Height="560"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Clickable room title — reads as a heading link. -->
        <Style Selector="Button.TitleLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TitleLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>

        <!-- Muted map/room caption that is itself clickable (centres the map). -->
        <Style Selector="Button.SubLink">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SubLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>

        <!-- Monster / exit clickable link — matches the Game Data edit dialogs. -->
        <Style Selector="Button.MdbLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.MdbLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>

        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Sub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.Note">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.Body">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>

        <!-- Shop stock table cell — a touch smaller than Body so a wide row fits. -->
        <Style Selector="TextBlock.ShopCell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header: clickable title + map/room caption. -->
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
                <Button Classes="TitleLink"
                        Content="{Binding Title}"
                        Command="{Binding OpenInNavigationCommand}"
                        ToolTip.Tip="Open the Navigation map centred on this room"/>
                <Button Classes="SubLink"
                        Content="{Binding KeyLabel}"
                        Command="{Binding OpenInNavigationCommand}"/>
            </StackPanel>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- Monsters -->
                    <StackPanel IsVisible="{Binding HasMonsters}" Spacing="3">
                        <TextBlock Classes="SectionHeader" Text="{Binding MonsterHeader}"/>
                        <ItemsControl ItemsSource="{Binding Monsters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RoomDetailLink">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                        <Button Classes="MdbLink" Content="{Binding Text}"
                                                Command="{Binding Open}"/>
                                        <TextBlock Classes="Note" Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Exits -->
                    <StackPanel IsVisible="{Binding HasExits}" Spacing="3">
                        <TextBlock Classes="SectionHeader" Text="Obvious exits:"/>
                        <ItemsControl ItemsSource="{Binding Exits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RoomDetailLink">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                        <Button Classes="MdbLink" Content="{Binding Text}"
                                                Command="{Binding Open}"/>
                                        <TextBlock Classes="Note" Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Shop section — merchant stock table (item · max · regen ·
                         buy · sell, modelled on the in-game `list` readout) or, for
                         a training room, a level band. The name/subtitle header is
                         shared; the stock table shows only when there's stock. -->
                    <StackPanel IsVisible="{Binding HasShopSection}" Spacing="4"
                                Grid.IsSharedSizeScope="True">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="SectionHeader" Text="{Binding ShopName}"/>
                            <TextBlock Classes="Sub" Text="{Binding ShopSubtitle}"/>
                        </StackPanel>

                        <!-- Trainer level band (training rooms only). -->
                        <TextBlock Classes="Body" Margin="8,0,0,0"
                                   IsVisible="{Binding HasTrainer}"
                                   Text="{Binding TrainerBand}"/>

                        <!-- Per-level training cost (training rooms only). -->
                        <StackPanel IsVisible="{Binding HasTrainerCosts}" Spacing="1">
                            <Grid Margin="8,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TrainLevel"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TrainCost"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Classes="SectionHeader" Text="Level"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="1" Classes="SectionHeader" Text="Cost"
                                           TextAlignment="Right" Margin="16,0,0,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TrainerCosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TrainerCostRow">
                                        <Grid Margin="8,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TrainLevel"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="TrainCost"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="ShopCell" Text="{Binding Level}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="1" Classes="ShopCell" Text="{Binding Cost}"
                                                       TextAlignment="Right" Margin="16,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="Note" Margin="8,1,0,0"
                                       IsVisible="{Binding TrainerCostsTruncated}"
                                       Text="… higher levels omitted"/>
                        </StackPanel>

                        <!-- Column headers -->
                        <Grid Margin="8,2,0,0" IsVisible="{Binding HasShop}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShopMax"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShopRegen"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShopBuy"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ShopSell"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="SectionHeader" Text="Item"/>
                            <TextBlock Grid.Column="1" Classes="SectionHeader" Text="Max"
                                       TextAlignment="Right" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="2" Classes="SectionHeader" Text="Regen"
                                       Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="SectionHeader" Text="Buy"
                                       TextAlignment="Right" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="4" Classes="SectionHeader" Text="Sell"
                                       TextAlignment="Right" Margin="12,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ShopStock}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ShopStockRow">
                                    <Grid Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShopMax"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShopRegen"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShopBuy"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ShopSell"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Classes="MdbLink"
                                                Content="{Binding Name}" Command="{Binding Open}"/>
                                        <TextBlock Grid.Column="1" Classes="ShopCell" Text="{Binding Max}"
                                                   TextAlignment="Right" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Classes="ShopCell" Text="{Binding Regen}"
                                                   Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="3" Classes="ShopCell" Text="{Binding Buy}"
                                                   TextAlignment="Right" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="4" Classes="ShopCell" Text="{Binding Sell}"
                                                   TextAlignment="Right" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Descriptive tail (shop / room spell / room commands / light / regen). -->
                    <TextBlock IsVisible="{Binding HasExtras}"
                               Classes="Body"
                               Text="{Binding ExtrasText}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom actions -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
                <Button Grid.Column="0" Content="Add to blacklist"
                        Command="{Binding AddToBlacklistCommand}"
                        IsEnabled="{Binding CanAddToBlacklist}"/>
                <Button Grid.Column="1" Content="Remove from blacklist"
                        Command="{Binding RemoveFromBlacklistCommand}"
                        IsEnabled="{Binding CanRemoveFromBlacklist}"
                        Margin="6,0,0,0"/>
                <Button Grid.Column="3" Content="Close"
                        Command="{Binding CloseCommand}" MinWidth="80"/>
            </Grid>
        </Grid>
    </Border>
</Window>
