<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.GameData.Tables"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="480"
             x:Class="MudPlay.Views.GameData.Tables.GameDataTableSectionView"
             x:DataType="vm:GameDataTableSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.Header">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        </Style>
        <!-- Range boxes sit two-across (min / max). Plain text boxes (not spinners)
             so the user can freely type any value, including a leading minus for a
             negative resist — a NumericUpDown refuses that in an empty box. -->
        <Style Selector="TextBox.rangebox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.FilterLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Styles>

    <!-- Table content, a drag handle, and the filter sidebar. Tables that expose
         no filters (everything but Monsters today) have HasFilterPanel = false, so
         the splitter and sidebar collapse (their Auto/0 columns shrink to nothing)
         and the layout looks exactly as before. The sidebar column's width is set
         in code-behind and the GridSplitter resizes it. -->
    <Grid Margin="22" x:Name="OuterGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

            <!-- Tab header. -->
            <TextBlock Grid.Row="0" Classes="Header" Text="{Binding Title}"/>

            <!-- Optional muted banner — collapses when the VM doesn't set BannerText. -->
            <Border Grid.Row="1"
                    Padding="10,6"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    IsVisible="{Binding BannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding BannerText}"
                           Classes="StatusText"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Search box + Add/Remove buttons (Add/Remove only render
                 when the section implements IEditableTableSectionViewModel
                 with non-null AddCommand / RemoveCommand — wired in
                 code-behind via FindControl). The optional Export button
                 (e.g. Incomplete Messages' "Upload edits") docks far right. -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button x:Name="ExportButton" DockPanel.Dock="Right" IsVisible="False"/>
                <!-- Test-only "Simulate entry" (Unrecognized Lines tab); visibility
                     follows the section's live ShowSimulate flag, wired in code-behind. -->
                <Button x:Name="SimulateButton" DockPanel.Dock="Right" Margin="0,0,6,0" IsVisible="False"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
                    <TextBox Classes="clearable" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="Filter…"
                             ToolTip.Tip="{Binding FilterHint}"
                             Width="320"/>
                    <Button x:Name="AddButton"    Content="Add"    IsVisible="False"/>
                    <Button x:Name="RemoveButton" Content="Remove" IsVisible="False"/>
                    <!-- Optional soft "Dismiss" (Unrecognized Lines tab); wired in code-behind. -->
                    <Button x:Name="DismissButton" Content="Dismiss" IsVisible="False"/>
                </StackPanel>
            </DockPanel>

            <!-- Tabular row grid. Columns are populated in code-behind from
                 the VM's Columns list so they auto-size and align with their
                 headers. -->
            <DataGrid Grid.Row="3"
                      x:Name="RowsGrid"
                      ItemsSource="{Binding FilteredRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"/>

            <!-- Footer status -->
            <TextBlock Grid.Row="4" Classes="StatusText" Text="{Binding StatusText}"/>

        </Grid>

        <!-- Drag handle: resizes the sidebar. Hidden (and its Auto column collapses)
             on tables with no filter panel. -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      Margin="8,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource ChromeBorderBrush}"
                      ShowsPreview="False"
                      IsVisible="{Binding HasFilterPanel}"/>

        <!-- Filter sidebar: labelled groups of min/max ranges, checkboxes, and
             dropdowns that live-curate the list. Scrolls when the list is long. -->
        <Border Grid.Column="2"
                MinWidth="248"
                Padding="12"
                IsVisible="{Binding HasFilterPanel}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <DockPanel LastChildFill="True">
                <!-- The panel CURATES the list (which rows qualify) as a deliberate
                     act — edit the controls, then press Apply. The top search box
                     FINDS a monster within the curated list. -->
                <TextBlock DockPanel.Dock="Top" Text="Filters"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,0,0,10">
                    <Button Grid.Column="0" Content="Apply"
                            Command="{Binding ApplyFiltersCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Apply the filter boxes below to curate the list"/>
                    <Button Grid.Column="1" Content="Reset"
                            Command="{Binding ResetFiltersCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Clear every filter (and the search box)"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- Right margin keeps the max boxes clear of the overlay scrollbar. -->
                    <ItemsControl ItemsSource="{Binding FilterGroups}" Margin="0,0,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FilterGroup">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Header}"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               FontWeight="SemiBold" Margin="0,6,0,4"/>
                                    <!-- Min / max range boxes (either blank = no limit on that side). -->
                                    <ItemsControl ItemsSource="{Binding Ranges}" IsVisible="{Binding HasRanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RangeFilter">
                                                <StackPanel Margin="0,0,0,5">
                                                    <TextBlock Classes="FilterLabel" Text="{Binding Label}"
                                                               ToolTip.Tip="{Binding Hint}"/>
                                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                                                        <TextBox Grid.Column="0" Classes="rangebox"
                                                                 PlaceholderText="min"
                                                                 Text="{Binding Min, Converter={x:Static vm:NullableIntConverter.Instance}, Mode=TwoWay}"
                                                                 ToolTip.Tip="Minimum (blank = no lower limit; negatives allowed)"/>
                                                        <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                        <TextBox Grid.Column="2" Classes="rangebox"
                                                                 PlaceholderText="max"
                                                                 Text="{Binding Max, Converter={x:Static vm:NullableIntConverter.Instance}, Mode=TwoWay}"
                                                                 ToolTip.Tip="Maximum (blank = no upper limit; negatives allowed)"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Bools}" IsVisible="{Binding HasBools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BoolFilter">
                                                <CheckBox Margin="0,2"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding Hint}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryFilter">
                                                <StackPanel Margin="0,2,0,4">
                                                    <TextBlock Classes="FilterLabel" Text="{Binding Label}"
                                                               ToolTip.Tip="{Binding Hint}"/>
                                                    <ComboBox HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Selected, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
