<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.GameData.Tables"
             xmlns:m="using:FujinTerm.Models.GameData"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="480"
             x:Class="FujinTerm.Views.GameData.Tables.TriggersSectionView"
             x:DataType="vm:TriggersSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.Header">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.Cell">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">

        <TextBlock Grid.Row="0" Classes="Header" Text="{Binding Title}"/>

        <TextBox  Grid.Row="1"
                  Text="{Binding SearchText, Mode=TwoWay}"
                  PlaceholderText="Filter by name or pattern…"
                  Width="320" HorizontalAlignment="Left"/>

        <!-- Column headers -->
        <Grid Grid.Row="2" ColumnDefinitions="160,60,100,160,*">
            <TextBlock Grid.Column="0" Classes="ColumnHeader" Text="Name"/>
            <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="Enabled"/>
            <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="Match"/>
            <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="Scope"/>
            <TextBlock Grid.Column="4" Classes="ColumnHeader" Text="Pattern"/>
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1"
                Background="{StaticResource ChromeBgSunkenBrush}">
            <ScrollViewer>
                <ListBox ItemsSource="{Binding FilteredTriggers}"
                         SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Trigger">
                            <Grid ColumnDefinitions="160,60,100,160,*">
                                <TextBlock Grid.Column="0" Classes="Cell" Text="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Classes="Cell" Text="{Binding Enabled}"/>
                                <TextBlock Grid.Column="2" Classes="Cell" Text="{Binding MatchType}"/>
                                <TextBlock Grid.Column="3" Classes="Cell" Text="{Binding Scope}"/>
                                <TextBlock Grid.Column="4" Classes="Cell" Text="{Binding Pattern}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4" Classes="StatusText" Text="{Binding StatusText}"/>

    </Grid>
</UserControl>
