<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.GameData"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="FujinTerm.Views.GameData.GameDataBrowserWindow"
        x:DataType="vm:GameDataBrowserViewModel"
        Title="Game Data Browser"
        Width="960" Height="640"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.SidebarHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,12,8,4"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.StatusText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}">
        <Grid RowDefinitions="*,Auto">

            <!-- ===== Main: sidebar + content ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="220,*">

                <!-- Sidebar: two ListBoxes (engine-backed on top, MDB
                     tables below) separated by a thin rule. Both
                     bind their SelectedItem to the same VM property,
                     so clicking in one clears the other automatically. -->
                <Border Grid.Column="0"
                        Background="{StaticResource ChromeBgSunkenBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                        <TextBlock Grid.Row="0" Classes="SidebarHeader" Text="Tables + editors"/>
                        <TextBox  Grid.Row="1"
                                  Margin="8,0,8,6"
                                  PlaceholderText="Search…"
                                  Text="{Binding SearchText, Mode=TwoWay}"/>

                        <!-- Engine-backed sections (user-defined / observation). -->
                        <ListBox  Grid.Row="2"
                                  ItemsSource="{Binding EngineSections}"
                                  SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameDataSectionViewModel">
                                    <TextBlock Classes="SectionTitle" Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Group separator. -->
                        <Border Grid.Row="3"
                                Height="1"
                                Margin="12,8"
                                Background="{StaticResource ChromeBorderBrush}"/>

                        <TextBlock Grid.Row="4" Classes="SidebarHeader" Text="Imported tables"/>

                        <!-- MDB-derived JSON tables. -->
                        <ListBox  Grid.Row="5"
                                  ItemsSource="{Binding TableSections}"
                                  SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameDataSectionViewModel">
                                    <TextBlock Classes="SectionTitle" Text="{Binding Title}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Content pane — hosts the selected section's View. -->
                <ContentControl Grid.Column="1"
                                Content="{Binding SelectedSection.View}"/>
            </Grid>

            <!-- ===== Status bar ===== -->
            <Border Grid.Row="1"
                    Padding="8,4"
                    Background="{StaticResource ChromeBgSunkenBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Classes="StatusText" Text="{Binding StatusText}"/>
            </Border>

        </Grid>
    </Border>
</Window>
