<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:combat="using:MudPlay.Game.Combat"
        xmlns:controls="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="600"
        x:Class="MudPlay.Views.SessionStatsWindow"
        x:DataType="vm:SessionStatsViewModel"
        Title="Session Stats"
        Width="390" Height="480"
        MinWidth="390" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Dense label / value rows shared by every section. -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Right-aligned muted numeric (count / min–max / avg columns). -->
        <Style Selector="TextBlock.dimr">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <!-- Tiny column header for the combat table. -->
        <Style Selector="TextBlock.colhdr">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <!-- Right-aligned numeric value (rate column). -->
        <Style Selector="TextBlock.valr">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Sparkline y-axis tick (peak / floor labels). -->
        <Style Selector="TextBlock.scale">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Time-to-level countdown under the Exp/hour graph. -->
        <Style Selector="TextBlock.ttl">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Each panel's title is its drag handle (see SessionStatsWindow.axaml.cs).
             Press-and-drag a title to reorder; a plain click on a section title
             still toggles its expander (the 4px move threshold tells them apart). -->
        <Style Selector="TextBlock.draghandle">
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>
        <!-- Uniform panel width: every graph and section stretches to fill the
             scroll column so they all share one width and line up. Left-anchoring
             with a cap made each panel shrink to its own content, leaving the
             graphs a header's-width sliver and Player Statistics narrower than
             its siblings. -->
        <Style Selector="Expander.panel">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- The I / II column picker: the active choice reads as pressed. -->
        <Style Selector="Button.colpick">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.colpick.active">
            <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <!-- Compact action-bar buttons (Reset session / Transaction history). -->
        <Style Selector="Button.topaction">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <!-- Per-section reset button living in each panel's header, right of the
             title. Muted and borderless so it reads as a secondary affordance and
             doesn't compete with the section title. -->
        <Style Selector="Button.sectionreset">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

    <!-- ===== Compact action bar ===== -->
    <!-- Session-wide actions live in one tidy strip up top: a full "Reset
         session" (every counter) and the transaction-history opener. The
         per-section resets sit in each panel's own header below. -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource ChromeBgElevBrush}"
            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
        <DockPanel LastChildFill="False">
        <!-- Column count: one tall column, or two side by side so every panel open
             still fits a screen. Saved per character. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="topaction colpick" Content="I"
                    Classes.active="{Binding IsOneColumn}"
                    Command="{Binding SetColumnsCommand}" CommandParameter="1"
                    ToolTip.Tip="One column"/>
            <Button Classes="topaction colpick" Content="II"
                    Classes.active="{Binding IsTwoColumns}"
                    Command="{Binding SetColumnsCommand}" CommandParameter="2"
                    ToolTip.Tip="Two columns side by side"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="topaction"
                    Content="Reset session"
                    Command="{Binding ResetCommand}"
                    ToolTip.Tip="Wipe every session counter and restart the clocks. Counters also reset automatically on connect."/>
            <Button Classes="topaction"
                    Content="Transaction history"
                    Command="{Binding OpenTransactionHistoryCommand}"
                    ToolTip.Tip="Bank deposits and stash-room hides recorded this session — the time, the store, and what was put away."/>
            <Button Classes="topaction"
                    Content="Players Seen"
                    Command="{Binding OpenPlayersSeenCommand}"
                    ToolTip.Tip="Players this character has encountered — the last time and room each was seen, and how many times total. Persists across sessions."/>
        </StackPanel>
        </DockPanel>
    </Border>

    <!-- One or two scrollable columns of reorderable panels: the three graphs and
         the three stat sections. Each panel carries a stable Tag id matching
         SessionStatsLayoutStore.DefaultOrder; the code-behind reorders these
         children by Tag on open and on drop (drawing an insertion line as a drop
         preview), and the VM persists the order + hidden set per character.
         Right-click anywhere → per-panel show/hide. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource ChromeBgBrush}"
                  Padding="8,6">
        <!-- The drag's drop line is drawn on DropOverlay above the panels rather than
             slotted between them, so nothing shifts (or re-fits the window) while a
             panel is dragged. -->
        <Grid x:Name="PanelGrid" ColumnDefinitions="*,0,0" Background="Transparent"
              DragDrop.AllowDrop="True">
        <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Kills/hour graph" ToggleType="CheckBox"
                              IsChecked="{Binding IsKillsGraphVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Exp/hour graph" ToggleType="CheckBox"
                              IsChecked="{Binding IsExpGraphVisible, Mode=TwoWay}"/>
                    <MenuItem Header="HP/MA History graph" ToggleType="CheckBox"
                              IsChecked="{Binding IsHpMaGraphVisible, Mode=TwoWay}"/>
                    <Separator/>
                    <MenuItem Header="Player Statistics" ToggleType="CheckBox"
                              IsChecked="{Binding IsPlayerStatsVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Time Analysis" ToggleType="CheckBox"
                              IsChecked="{Binding IsTimeAnalysisVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Session Statistics" ToggleType="CheckBox"
                              IsChecked="{Binding IsSessionStatsVisible, Mode=TwoWay}"/>
                </ContextMenu>
        </Grid.ContextMenu>
        <!-- Column one; in two-column mode PanelHost2 holds the panels after the
             split, and the code-behind moves panels between the two. -->
        <StackPanel x:Name="PanelHost" Grid.Column="0" Spacing="6" Background="Transparent">

            <!-- ===== Kills/hour graph ===== -->
            <Expander Tag="KillsGraph" Classes="panel"
                      IsExpanded="{Binding IsKillsGraphExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsKillsGraphVisible}">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Classes="lbl draghandle" Text="Kills/hour"/>
                        <TextBlock Grid.Column="1" Classes="valr"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   Text="{Binding KillsRateText}"
                                   ToolTip.Tip="{Binding DurationText}"/>
                    </Grid>
                </Expander.Header>
                <Border Background="{StaticResource ChromeBgSunkenBrush}"
                        BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="4"
                        Height="60">
                    <Grid ColumnDefinitions="*,34">
                        <controls:SparklineControl Grid.Column="0"
                                                   Samples="{Binding KillsPerHour}"
                                                   Stroke="{StaticResource AccentGreenBrush}"
                                                   StrokeThickness="1.5"/>
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock VerticalAlignment="Top" Classes="scale"
                                       Text="{Binding KillsPeakText}"/>
                            <TextBlock VerticalAlignment="Bottom" Classes="scale"
                                       Text="{Binding KillsFloorText}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Expander>

            <!-- ===== Exp/hour graph ===== -->
            <Expander Tag="ExpGraph" Classes="panel"
                      IsExpanded="{Binding IsExpGraphExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsExpGraphVisible}">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Classes="lbl draghandle" Text="Exp/hour"/>
                        <TextBlock Grid.Column="1" Classes="valr"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   Text="{Binding ExpRateText}"
                                   ToolTip.Tip="{Binding DurationText}"/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="3">
                <Border Background="{StaticResource ChromeBgSunkenBrush}"
                        BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="4"
                        Height="60">
                    <Grid ColumnDefinitions="*,34">
                        <controls:SparklineControl Grid.Column="0"
                                                   Samples="{Binding ExperiencePerHour}"
                                                   Stroke="{StaticResource AccentCyanBrush}"
                                                   StrokeThickness="1.5"/>
                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock VerticalAlignment="Top" Classes="scale"
                                       Text="{Binding ExpPeakText}"/>
                            <TextBlock VerticalAlignment="Bottom" Classes="scale"
                                       Text="{Binding ExpFloorText}"/>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Classes="ttl" Text="{Binding TimeToLevelText}"/>
                </StackPanel>
            </Expander>

            <!-- ===== HP/MA History graph ===== -->
            <!-- Stock-chart view: one vertical high-low bar per loop step on a fixed
                 0–100% axis — HP (red) and mana (cyan) grouped side by side — so a
                 glance shows the min/max range each step drove the vitals through,
                 and which steps of the circuit dip lowest. Records only while a loop
                 is stepping; resets at each new loop start. Mana bars vanish for a
                 no-mana class. -->
            <Expander Tag="HpMaGraph" Classes="panel"
                      IsExpanded="{Binding IsHpMaGraphExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsHpMaGraphVisible}">
                <Expander.Header>
                    <TextBlock Classes="lbl draghandle" Text="HP/MA per loop step"/>
                </Expander.Header>
                <StackPanel Spacing="3">
                <Border Background="{StaticResource ChromeBgSunkenBrush}"
                        BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="4"
                        Height="120">
                    <Grid ColumnDefinitions="*,34">
                        <controls:RangeBarChart Grid.Column="0"
                                                Low="{Binding HpLow}" High="{Binding HpHigh}" PrimaryTrend="{Binding HpAvg}"
                                                SecondaryLow="{Binding MaLow}" SecondaryHigh="{Binding MaHigh}" SecondaryTrend="{Binding MaAvg}"
                                                PrimaryBrush="{StaticResource AccentRedBrush}"
                                                SecondaryBrush="{StaticResource AccentCyanBrush}"
                                                CursorBrush="{StaticResource ChromeFgBrush}"
                                                ShowCursor="{Binding IsScrubbing}"
                                                CursorIndex="{Binding CursorIndex}"
                                                Min="{Binding AxisMin}" Max="100"
                                                Offset="{Binding WindowOffset}"
                                                WindowSize="15"/>
                        <!-- Anchored-step readout overlaid at the bottom of the plot;
                             the scrub cursor above marks this step while dragging. -->
                        <Border Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Margin="0,0,0,2" Padding="4,0" CornerRadius="2"
                                Background="{StaticResource ChromeBgElevBrush}"
                                IsHitTestVisible="False"
                                IsVisible="{Binding IsStepSliderVisible}">
                            <TextBlock Classes="scale" HorizontalAlignment="Center" Text="{Binding CenterStepText}"/>
                        </Border>
                        <!-- Y-axis ticks: 100% top, adaptive floor bottom, plus three
                             evenly-spaced marks between (four equal rows put them at
                             0 / ¼ / ½ / ¾ / full height). Each label is nudged so its
                             centre — not its top or bottom edge — sits on its tick
                             line, so the five read as evenly spaced. -->
                        <Grid Grid.Column="1" Margin="4,0,0,0" RowDefinitions="*,*,*,*">
                            <TextBlock Grid.Row="0" VerticalAlignment="Top"    Margin="0,-6,0,0" Classes="scale" Text="100%"/>
                            <TextBlock Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,-6" Classes="scale" Text="{Binding AxisQ3Text}"/>
                            <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,-6" Classes="scale" Text="{Binding AxisMidText}"/>
                            <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,-6" Classes="scale" Text="{Binding AxisQ1Text}"/>
                            <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,-6" Classes="scale" Text="{Binding AxisMinText}"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- X-axis caption: which loop steps the window shows, of the total. -->
                <TextBlock Classes="ttl" Text="{Binding StepRangeText}"/>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Classes="scale" HorizontalAlignment="Left"
                               Foreground="{StaticResource AccentRedBrush}" Text="{Binding HpLegendText}"
                               ToolTip.Tip="Lowest HP % seen across the loop's steps."/>
                    <TextBlock Classes="scale" HorizontalAlignment="Left"
                               Foreground="{StaticResource AccentCyanBrush}" Text="{Binding MaLegendText}"
                               IsVisible="{Binding HasManaHistory}"
                               ToolTip.Tip="Lowest mana % seen across the loop's steps."/>
                </StackPanel>
                <!-- Pan slider — below the legend; compact + centred; shown only once
                     the loop is longer than the 15-step window. -->
                <Slider x:Name="StepSlider"
                        IsVisible="{Binding IsStepSliderVisible}"
                        Minimum="0" Maximum="{Binding StepViewMax}"
                        Value="{Binding FocusStep, Mode=TwoWay}"
                        SmallChange="1" LargeChange="5"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        HorizontalAlignment="Stretch" Margin="19,0,19,0" Height="22" MinHeight="0"
                        ToolTip.Tip="Slide to anchor any loop step; the view pans to follow."/>
                </StackPanel>
            </Expander>

            <!-- ===== Player Statistics ===== -->
            <Expander Tag="PlayerStatistics" Classes="panel" IsExpanded="{Binding IsPlayerStatsExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsPlayerStatsVisible}">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Classes="draghandle" Text="Player Statistics"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                        <Button Grid.Column="1" Classes="sectionreset" Content="Reset"
                                Command="{Binding ResetPlayerStatsCommand}"
                                ToolTip.Tip="Reset just the combat statistics."/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="1" Margin="4,2">
                    <!-- Column headers (shared widths align every data row).
                         "#" is the occurrence count; "rate" is a percentage
                         and only shown where one is meaningful: hit / miss /
                         crit over regular attacks, backstab / BS miss over
                         backstabs, and defense. Per-round rows leave it blank
                         since a count, not a rate, is what describes them. -->
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="sub" Text="Offense" Margin="0,0,0,0"/>
                        <TextBlock Grid.Column="1" Classes="colhdr" Text="#" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Classes="colhdr" Text="min–max" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Classes="colhdr" Text="avg" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Classes="colhdr" Text="rate" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Hit"/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.Hits, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding HitRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.HitAvgDamage, StringFormat='{}{0:F0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.HitPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Miss"/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.Misses, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.MissPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Crit"/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.Crits, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding CritRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.CritAvgDamage, StringFormat='{}{0:F0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.CritPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Backstab"/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.Backstabs, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding BackstabRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.BackstabAvgDamage, StringFormat='{}{0:F0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.BackstabPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="BS miss"
                                   ToolTip.Tip="Backstabs that failed: a miss, or the sneak broke and the round swung as a normal attack."/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.BackstabFails, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.BackstabFailPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Round"
                                   ToolTip.Tip="Damage dealt per combat round, across rounds where we dealt damage."/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.RoundsWithDamage, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding RoundRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.RoundAvgDamage, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Rounds/kill"
                                   ToolTip.Tip="Combat rounds each monster took to die, counted from the start of the fight or the previous kill: how many kills, the fewest and most rounds, and the average."/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.TimedKills, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding RoundsToKillRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding RoundsToKillAvgText}"/>
                    </Grid>

                    <!-- Proc / spell rows — surface only once recognised. -->
                    <Grid ColumnDefinitions="*,30,52,28,44" IsVisible="{Binding HasProcs}">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Proc"/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.ProcHits, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding ProcRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.ProcAvgDamage, StringFormat='{}{0:F0}'}"/>
                    </Grid>
                    <!-- One row per spell of ours: name · casts · damage range · avg ·
                         accuracy. A spell only appears once it's been cast. Accuracy is landed / (landed + resisted casts) — ~100%
                         for most Paradigm combat spells, which rarely fail to land. -->
                    <ItemsControl ItemsSource="{Binding Combat.Spells}" IsVisible="{Binding HasSpells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="combat:SpellCombatStat">
                                <Grid ColumnDefinitions="*,30,52,28,44">
                                    <TextBlock Grid.Column="0" Classes="lbl" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Casts, StringFormat='{}×{0}'}"/>
                                    <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding RangeText}"/>
                                    <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding AvgDamage, StringFormat='{}{0:F0}'}"/>
                                    <TextBlock Grid.Column="4" Classes="valr" Text="{Binding AccuracyPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Defense — the blows that hit us, and dodge and miss folded into
                         one "avoided" rate. -->
                    <Grid ColumnDefinitions="*,30,52,28,44" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Classes="sub" Text="Defense" Margin="0,0,0,0"/>
                        <TextBlock Grid.Column="4" Classes="colhdr" Text="rate" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Hit by"
                                   ToolTip.Tip="Blows that hit us: how many, their damage range and average, and the share of incoming attacks that landed."/>
                        <TextBlock Grid.Column="1" Classes="dimr" Text="{Binding Combat.MobHits, StringFormat='{}×{0}'}"/>
                        <TextBlock Grid.Column="2" Classes="dimr" Text="{Binding HitTakenRangeText}"/>
                        <TextBlock Grid.Column="3" Classes="dimr" Text="{Binding Combat.HitTakenAvgDamage, StringFormat='{}{0:F0}'}"/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.HitTakenPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,30,52,28,44">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Dodge/Miss"
                                   ToolTip.Tip="Incoming attacks avoided — the mob missed or we dodged."/>
                        <TextBlock Grid.Column="4" Classes="valr" Text="{Binding Combat.AvoidPercent, Converter={x:Static vm:PercentTextConverter.Instance}}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== Time Analysis ===== -->
            <Expander Tag="TimeAnalysis" Classes="panel" IsExpanded="{Binding IsTimeAnalysisExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsTimeAnalysisVisible}">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Classes="draghandle" Text="Time Analysis"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                        <Button Grid.Column="1" Classes="sectionreset" Content="Reset"
                                Command="{Binding ResetTimeAnalysisCommand}"
                                ToolTip.Tip="Reset everything in this section: the time breakdown, Sneak, Disarm Trap, Walk and the loop laps."/>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="2" Margin="4,2">
                    <TextBlock Classes="sub" Text="Totals"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Duration"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding DurationText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Moving"
                                   ToolTip.Tip="Time travelling: from a move going out until the next room shows, and the few seconds after."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding MovingText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Attacking"
                                   ToolTip.Tip="Time in combat, from the first swing or hit until the room is clear."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding AttackingText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Resting"
                                   ToolTip.Tip="Time resting or meditating; the breakdown below splits it into HP and mana."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Waiting"
                                   ToolTip.Tip="{Binding WaitingTip}"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding WaitingText}"
                                   ToolTip.Tip="{Binding WaitingTip}"/>
                    </Grid>

                    <TextBlock Classes="sub" Text="Breakdown"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Resting HPs"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingHpText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Resting Mana"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingMaText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Blinded"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding BlindedText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Poisoned"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding PoisonedText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Diseased"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding DiseasedText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Confused"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding ConfusedText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Held"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding HeldText}"/>
                    </Grid>

                    <TextBlock Classes="sub" Text="Other"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Sneak"
                                   ToolTip.Tip="Share of rooms you entered while sneaking where the sneak held."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding SneakText}"
                                   ToolTip.Tip="{Binding SneakTip}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Disarm Trap"
                                   ToolTip.Tip="Traps you disarmed this session, and the share of disarm attempts that succeeded."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding DisarmText}"
                                   ToolTip.Tip="{Binding DisarmTip}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Walk Latency"
                                   ToolTip.Tip="Average time per walk or loop step, from the move going out to the new room showing. Time stopped between steps doesn't count."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding WalkText}"
                                   ToolTip.Tip="{Binding WalkTip}"/>
                    </Grid>

                    <!-- Loop laps — one lap = a full completion of the running loop.
                         Live while a loop runs (current lap ticks up), — when idle. -->
                    <TextBlock Classes="sub" Text="{Binding LapLoopName, StringFormat='Loop laps — {0}'}"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Laps completed"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding LapCount}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Last lap"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding LastLapText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Average lap"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding AverageLapText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Current lap"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding CurrentLapText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Starts at"/>
                        <TextBlock Grid.Column="1" Classes="val" Margin="8,0,0,0"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding LapStartRoomText}"
                                   ToolTip.Tip="{Binding LapStartRoomText}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ===== Session Statistics ===== -->
            <Expander Tag="SessionStatistics" Classes="panel" IsExpanded="{Binding IsSessionStatsExpanded, Mode=TwoWay}"
                      IsVisible="{Binding IsSessionStatsVisible}">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Classes="draghandle" Text="Session Statistics"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                        <Button Grid.Column="1" Classes="sectionreset" Content="Reset"
                                Command="{Binding ResetSessionStatsCommand}"
                                ToolTip.Tip="Reset the session totals and their per-hour rates."/>
                    </Grid>
                </Expander.Header>
                <!-- Grouped label → value rows, the same shape as Time Analysis. The
                     bottom margin keeps the last row clear of the panel edge. -->
                <StackPanel Spacing="2" Margin="4,2,4,8">
                    <TextBlock Classes="sub" Text="Kills &amp; experience"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Kills"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.MonstersKilled, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Kills / hour"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.KillsPerHour, StringFormat='{}{0:F1}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Experience"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ExperienceEarned, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Exp / hour"/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ExperiencePerHour, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Exp needed"
                                   ToolTip.Tip="Experience still to earn for the level the countdown is heading for — the first level your exp hasn't reached yet."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding ExpNeededText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Will level in"
                                   ToolTip.Tip="Time to that level at this session's exp rate — the same countdown as the status bar's TNL."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding WillLevelInText}"/>
                    </Grid>

                    <!-- Coin: its value in denominations, then the coin count. A deposit /
                         sale reports only its value. -->
                    <TextBlock Classes="sub" Text="Coin"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Collected"
                                   ToolTip.Tip="Coin picked up this session: its value, and how many coins."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding CurrencyCollectedText}"
                                   ToolTip.Tip="{Binding CurrencyCollectedTip}"/>
                        <TextBlock Grid.Column="2" Classes="valr" Opacity="0.65"
                                   Text="{Binding Activity.CoinsCollected, StringFormat=' ({0:N0} coins)'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Deposited / sold"
                                   ToolTip.Tip="Coin you banked (by hand or auto-deposit) plus coin from items sold."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding CurrencyDepositedText}"
                                   ToolTip.Tip="{Binding CurrencyDepositedTip}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Stashed"
                                   ToolTip.Tip="Coin you hid this session, by hand or by the stash automation."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding CurrencyStashedText}"
                                   ToolTip.Tip="{Binding CurrencyStashedTip}"/>
                        <TextBlock Grid.Column="2" Classes="valr" Opacity="0.65"
                                   Text="{Binding Activity.CoinsStashed, StringFormat=' ({0:N0} coins)'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Income / hour"
                                   ToolTip.Tip="Coin picked up per hour, by value and by coin count, over the same window as the other per-hour rates."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding CurrencyPerHourText}"/>
                        <TextBlock Grid.Column="2" Classes="valr" Opacity="0.65"
                                   Text="{Binding Activity.CoinsPerHour, StringFormat=' ({0:N0} coins)'}"/>
                    </Grid>

                    <TextBlock Classes="sub" Text="Items"/>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Collected"
                                   ToolTip.Tip="Items picked up this session."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ItemsCollected, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Sold"
                                   ToolTip.Tip="Items sold this session."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ItemsSold, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,148">
                        <TextBlock Grid.Column="0" Classes="lbl" Text="Stashed"
                                   ToolTip.Tip="Items you hid this session, by hand or by the stash automation."/>
                        <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ItemsStashed, StringFormat='{}{0:N0}'}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Drop room below the last panel, so a dragged panel can be released
                 into the last slot without hunting for the bottom edge. -->
            <Border Height="24" Background="Transparent"/>
        </StackPanel>
        <StackPanel x:Name="PanelHost2" Grid.Column="2" Spacing="6" Background="Transparent"
                    IsVisible="{Binding IsTwoColumns}">
            <Border Height="24" Background="Transparent"/>
        </StackPanel>
        <Canvas x:Name="DropOverlay" Grid.ColumnSpan="3" IsHitTestVisible="False"/>
        </Grid>
    </ScrollViewer>

    </DockPanel>
</Window>
