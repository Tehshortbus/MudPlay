<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:controls="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="600"
        x:Class="FujinTerm.Views.SessionStatsWindow"
        x:DataType="vm:SessionStatsViewModel"
        Title="Session Stats"
        Width="280" Height="600"
        MinWidth="240" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Dense label / value rows shared by every section. -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <!-- Tiny column header for the combat table. -->
        <Style Selector="TextBlock.colhdr">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <!-- Right-aligned numeric value (rate column). -->
        <Style Selector="TextBlock.valr">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ============ Rate sparklines (footer) ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <StackPanel Spacing="6">

                <!-- Kills/hour: toggle + session duration + chart. -->
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                        <CheckBox Grid.Column="0" Content="Kills/hour"
                                  IsChecked="{Binding ShowKillsGraph}"
                                  Foreground="{StaticResource ChromeFgSecBrush}"
                                  FontSize="11" Padding="4,0,0,0" MinHeight="0"/>
                        <TextBlock Grid.Column="1" Classes="dim" Text="{Binding DurationText}"/>
                    </Grid>
                    <Border Background="{StaticResource ChromeBgSunkenBrush}"
                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4"
                            Height="40"
                            IsVisible="{Binding ShowKillsGraph}">
                        <controls:SparklineControl Samples="{Binding KillsPerHour}"
                                                   Stroke="{StaticResource AccentGreenBrush}"
                                                   StrokeThickness="1.5"/>
                    </Border>
                </StackPanel>

                <!-- Exp/hour: toggle + session duration + chart. -->
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                        <CheckBox Grid.Column="0" Content="Exp/hour"
                                  IsChecked="{Binding ShowExpGraph}"
                                  Foreground="{StaticResource ChromeFgSecBrush}"
                                  FontSize="11" Padding="4,0,0,0" MinHeight="0"/>
                        <TextBlock Grid.Column="1" Classes="dim" Text="{Binding DurationText}"/>
                    </Grid>
                    <Border Background="{StaticResource ChromeBgSunkenBrush}"
                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4"
                            Height="40"
                            IsVisible="{Binding ShowExpGraph}">
                        <controls:SparklineControl Samples="{Binding ExperiencePerHour}"
                                                   Stroke="{StaticResource AccentCyanBrush}"
                                                   StrokeThickness="1.5"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ============ Three collapsible sections ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ChromeBgBrush}"
                      Padding="8,6">
            <StackPanel Spacing="2">

                <!-- ===== Player Statistics ===== -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Player Statistics"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                    </Expander.Header>
                    <StackPanel Spacing="1" Margin="4,2">
                        <!-- Column headers (shared widths align every data row). -->
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="sub" Text="Offense" Margin="0,0,0,0"/>
                            <TextBlock Grid.Column="1" Classes="colhdr" Text="min–max"/>
                            <TextBlock Grid.Column="2" Classes="colhdr" Text="avg"/>
                            <TextBlock Grid.Column="3" Classes="colhdr" Text="rate" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Hit"/>
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding PhysicalRangeText}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Combat.PhysicalAvgDamage, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.HitPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Miss"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.MissPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Crit"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.CritPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Backstab"/>
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding BackstabRangeText}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Combat.BackstabAvgDamage, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.Backstabs, StringFormat='{}×{0}'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Round"/>
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding RoundRangeText}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Combat.RoundAvgDamage, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.RoundsWithDamage, StringFormat='{}×{0}'}"/>
                        </Grid>

                        <!-- Proc / spell rows — surface only once recognised. -->
                        <Grid ColumnDefinitions="70,72,46,*" IsVisible="{Binding HasProcs}">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Proc"/>
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding ProcRangeText}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Combat.ProcAvgDamage, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.ProcHits, StringFormat='{}×{0}'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*" IsVisible="{Binding HasSpells}">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Spell"/>
                            <TextBlock Grid.Column="1" Classes="dim" Text="{Binding SpellRangeText}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Combat.SpellAvgDamage, StringFormat='{}{0:F0}'}"/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.SpellHits, StringFormat='{}×{0}'}"/>
                        </Grid>

                        <!-- Defense — dodge and miss folded into one "avoided" rate. -->
                        <Grid ColumnDefinitions="70,72,46,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Classes="sub" Text="Defense" Margin="0,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="colhdr" Text="rate" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,72,46,*">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Dodge/Miss"
                                       ToolTip.Tip="Incoming attacks avoided — the mob missed or we dodged."/>
                            <TextBlock Grid.Column="3" Classes="valr" Text="{Binding Combat.AvoidPercent, StringFormat='{}{0:F0}%'}"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== Time Analysis ===== -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Time Analysis"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                    </Expander.Header>
                    <StackPanel Spacing="2" Margin="4,2">
                        <TextBlock Classes="sub" Text="Totals"/>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Duration"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding DurationText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Moving"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding MovingText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Attacking"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding AttackingText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Resting"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Waiting"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding WaitingText}"/>
                        </Grid>

                        <TextBlock Classes="sub" Text="Breakdown"/>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Resting HPs"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingHpText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Resting Mana"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding RestingMaText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Blinded"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding BlindedText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Poisoned"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding PoisonedText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Diseased"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding DiseasedText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Confused"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding ConfusedText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,148">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Held"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding HeldText}"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ===== Session Statistics ===== -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Session Statistics"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="12"/>
                    </Expander.Header>
                    <StackPanel Spacing="1" Margin="4,2">
                        <!-- total | per-hour table (shared widths align every row). -->
                        <Grid ColumnDefinitions="*,76,72">
                            <TextBlock Grid.Column="1" Classes="colhdr" Text="total" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Classes="colhdr" Text="/ hr" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,76,72">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Kills"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.MonstersKilled, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Grid.Column="2" Classes="valr" Text="{Binding Activity.KillsPerHour, StringFormat='{}{0:F1}'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,76,72">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Experience"/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.ExperienceEarned, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Grid.Column="2" Classes="valr" Text="{Binding Activity.ExperiencePerHour, StringFormat='{}{0:N0}'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,76,72">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Currency"
                                       ToolTip.Tip="Currency picked up this session, in copper value."/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.CurrencyCollected, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Grid.Column="2" Classes="valr" Text="{Binding Activity.CurrencyPerHour, StringFormat='{}{0:N0}'}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,76,72">
                            <TextBlock Grid.Column="0" Classes="lbl" Text="Stashed"
                                       ToolTip.Tip="Currency stashed or bank-deposited this session, in copper value."/>
                            <TextBlock Grid.Column="1" Classes="valr" Text="{Binding Activity.CurrencyStashed, StringFormat='{}{0:N0}'}"/>
                            <TextBlock Grid.Column="2" Classes="dim" Text="—" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button Content="Reset session"
                                Command="{Binding ResetCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                FontSize="11"
                                ToolTip.Tip="Wipe every session counter and restart the clocks. Counters also reset automatically on connect."/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
