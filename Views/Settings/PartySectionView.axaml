<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:spells="using:FujinTerm.Game.Spells"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="720"
             x:Class="FujinTerm.Views.Settings.PartySectionView"
             x:DataType="vm:PartySectionViewModel">

    <UserControl.Resources>
        <!-- Dropdown row: "code — name". The box commits the Short cast-code
             (ValueMemberBinding); this template only shapes the list display. -->
        <DataTemplate x:Key="SpellPickItem" x:DataType="spells:SpellPick">
            <TextBlock Text="{Binding Display}"/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="4"
                    MaxWidth="780" HorizontalAlignment="Left">



            <!-- ============ Party behavior ============ -->
            <!-- Target order / attack priority / attack order are owned by the
                 Combat tab; they're not duplicated here. -->
            <Grid ColumnDefinitions="140,Auto,Auto,Auto,*" RowDefinitions="Auto" Margin="0,2,0,0">

                <!-- Rank: Front / Mid / Back. Persisted; not yet consumed
                     (Phase 12 CombatManager will read it for target ordering). -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Rank"/>
                <RadioButton Grid.Row="0" Grid.Column="1" GroupName="Rank" Content="Front"
                             IsChecked="{Binding RankFront, Mode=TwoWay}"
                             Margin="0,0,16,0"
                             ToolTip.Tip="Front rank — defaults the target order to attack-first."/>
                <RadioButton Grid.Row="0" Grid.Column="2" GroupName="Rank" Content="Mid"
                             IsChecked="{Binding RankMid, Mode=TwoWay}"
                             Margin="0,0,16,0"
                             ToolTip.Tip="Mid rank — balanced default."/>
                <RadioButton Grid.Row="0" Grid.Column="3" GroupName="Rank" Content="Back"
                             IsChecked="{Binding RankBack, Mode=TwoWay}"
                             ToolTip.Tip="Back rank — caster / healer position."/>
            </Grid>

            <!-- ============ Party heal (inline spell + threshold) ============ -->
            <!-- Each Minor / Major slot owns BOTH a single-target spell and an
                 AOE / party spell sharing one threshold; CastingDirector picks
                 single vs AOE at cast time based on how many members are below
                 it (see "Use party (AOE) heal when" below). -->
            <!-- Column header. Extra top margin sets the heal block apart from
                 the Rank row above now that the "Party heal" label is gone. -->
            <Grid ColumnDefinitions="120,230,12,230,*" Margin="0,20,0,0">
                <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Single-target"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="3" Classes="FieldLabel" Text="Party (AOE)"
                           Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11"/>
            </Grid>

            <!-- Minor: single + AOE pickers sharing the Minor threshold. -->
            <Grid ColumnDefinitions="120,230,12,230,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Minor"/>
                <AutoCompleteBox Grid.Row="0" Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                 Text="{Binding MinorPartyHealSpell, Mode=TwoWay}"
                                 ItemsSource="{Binding SpellSuggestions}"
                                 ValueMemberBinding="{ReflectionBinding Short}"
                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                 ItemTemplate="{StaticResource SpellPickItem}"
                                 PlaceholderText="Type code or name…"
                                 ToolTip.Tip="Cheap single-target heal cast when one member drops below the Minor threshold."/>
                <AutoCompleteBox Grid.Row="0" Grid.Column="3" Width="230" HorizontalAlignment="Left"
                                 Text="{Binding MinorPartyHealAoeSpell, Mode=TwoWay}"
                                 ItemsSource="{Binding SpellSuggestions}"
                                 ValueMemberBinding="{ReflectionBinding Short}"
                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                 ItemTemplate="{StaticResource SpellPickItem}"
                                 PlaceholderText="Type code or name…"
                                 ToolTip.Tip="Cheap AOE party-heal — hits every member at once when enough fall below the Minor threshold."/>
                <!-- Threshold sits under the label, left-aligned, with room to render. -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Classes="FieldLabel" Text="Cast when a member is below"/>
                    <NumericUpDown Width="120" MinWidth="120" Minimum="0" Maximum="100"
                                   Value="{Binding MinorHealMemberThresholdPercent, Mode=TwoWay}"
                                   ToolTip.Tip="Cast a Minor party heal when any member drops below this percentage of MaxHp."/>
                    <TextBlock Classes="FieldLabel" Text="%"/>
                </StackPanel>
            </Grid>

            <!-- Major: single + AOE pickers sharing the Major threshold. -->
            <Grid ColumnDefinitions="120,230,12,230,*" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Major"/>
                <AutoCompleteBox Grid.Row="0" Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                 Text="{Binding MajorPartyHealSpell, Mode=TwoWay}"
                                 ItemsSource="{Binding SpellSuggestions}"
                                 ValueMemberBinding="{ReflectionBinding Short}"
                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                 ItemTemplate="{StaticResource SpellPickItem}"
                                 PlaceholderText="Type code or name…"
                                 ToolTip.Tip="Expensive single-target heal cast when one member drops below the Major threshold (overrides Minor)."/>
                <AutoCompleteBox Grid.Row="0" Grid.Column="3" Width="230" HorizontalAlignment="Left"
                                 Text="{Binding MajorPartyHealAoeSpell, Mode=TwoWay}"
                                 ItemsSource="{Binding SpellSuggestions}"
                                 ValueMemberBinding="{ReflectionBinding Short}"
                                 ItemFilter="{Binding SpellSuggestionFilter}"
                                 ItemTemplate="{StaticResource SpellPickItem}"
                                 PlaceholderText="Type code or name…"
                                 ToolTip.Tip="Expensive AOE party-heal — hits every member at once when enough fall below the Major threshold (overrides Minor)."/>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Classes="FieldLabel" Text="Cast when a member is below"/>
                    <NumericUpDown Width="120" MinWidth="120" Minimum="0" Maximum="100"
                                   Value="{Binding MajorHealMemberThresholdPercent, Mode=TwoWay}"
                                   ToolTip.Tip="Cast a Major party heal when any member drops below this percentage of MaxHp."/>
                    <TextBlock Classes="FieldLabel" Text="%"/>
                </StackPanel>
            </Grid>

            <!-- Single vs AOE selector: how many hurt members flip to the AOE pick. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <TextBlock Classes="FieldLabel" Text="Use party healing spells when"/>
                <NumericUpDown Width="120" MinWidth="120" Minimum="2" Maximum="6"
                               Value="{Binding AoeMinMembers, Mode=TwoWay}"
                               ToolTip.Tip="Minimum number of members below threshold for the engine to switch from the single-target heal to the party (AOE) heal. Applies to both the Minor and Major tiers. Minimum 2."/>
                <TextBlock Classes="FieldLabel" Text="or more members meet threshold (Minor + Major)"/>
            </StackPanel>

            <!-- Request healing: just threshold, no spell. Stub — no DTO field yet. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <TextBlock Classes="FieldLabel" Text="Request healing"/>
                <TextBlock Classes="FieldLabel" Text="(send @heal) at"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontStyle="Italic"/>
                <NumericUpDown IsEnabled="False" Value="50" Minimum="0" Maximum="100"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Broadcast @heal at this HP %. (@health is a different command — it requests party-member health status.)"/>
                <TextBlock Classes="FieldLabel" Text="%"/>
            </StackPanel>

            <!-- ============ Party bless (10 slots) ============ -->
            <!-- Each row = a spell short-code picker + a checkbox per loaded
                 class. A member receives the buff only when their class is
                 ticked. Row order is priority order. Class checkboxes come
                 live from the active set's Classes.json (rebuilt on set swap),
                 so the list grows / shrinks with whatever gamedata is loaded. -->
            <!-- Compact rows: a number badge + spell picker. The class toggles
                 only appear once a spell is chosen, so empty slots stay a
                 single tidy line and the "who gets it" choice surfaces exactly
                 when it becomes relevant. -->
            <TextBlock Classes="SectionHeader" Text="Party bless (10 slots)" Margin="0,28,0,2"/>
            <TextBlock Classes="FieldLabel" Text="Pick a spell, then tick the classes that receive it. Row order is cast priority."
                       Foreground="{StaticResource ChromeFgMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding BlessSlots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PartyBlessSlotViewModel">
                        <Grid ColumnDefinitions="26,220,*" ColumnSpacing="10" Margin="0,0,0,4">
                            <Border Grid.Column="0" Width="26" Height="26"
                                    Background="{StaticResource ChromeBgElevBrush}"
                                    CornerRadius="3" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Label}">
                                <TextBlock Text="{Binding Index}"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <AutoCompleteBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Text="{Binding Spell, Mode=TwoWay}"
                                             ItemsSource="{Binding $parent[ItemsControl].((vm:PartySectionViewModel)DataContext).SpellSuggestions}"
                                             ValueMemberBinding="{ReflectionBinding Short}"
                                             ItemFilter="{Binding $parent[ItemsControl].((vm:PartySectionViewModel)DataContext).SpellSuggestionFilter}"
                                             ItemTemplate="{StaticResource SpellPickItem}"
                                             PlaceholderText="Type code or name…"
                                             ToolTip.Tip="Beneficial spell cast on party members whose class is ticked to the right. Cast as `&lt;code&gt; &lt;member-name&gt;`."/>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Classes}"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding Spell, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PartyBlessClassToggle">
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  MinHeight="0" Margin="0,0,10,2"
                                                  ToolTip.Tip="Cast this slot's bless on party members of this class."/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bless gating: coarse on/off conditions the party-bless path
                 honors before casting. Both default ON. -->
            <StackPanel Spacing="2" Margin="0,8,0,0">
                <CheckBox Content="Bless party while resting"
                          IsChecked="{Binding BlessWhileResting, Mode=TwoWay}"
                          ToolTip.Tip="When checked (default): the party-bless engine may cast beneficial spells on party members while you're resting."/>
                <CheckBox Content="Bless party during combat"
                          IsChecked="{Binding BlessDuringCombat, Mode=TwoWay}"
                          ToolTip.Tip="When checked (default): the party-bless engine may cast beneficial spells on party members during combat rounds."/>
            </StackPanel>

            <!-- ============ Options ============ -->
            <TextBlock Classes="SectionHeader" Text="Options"/>
            <StackPanel Spacing="2">
                <CheckBox Content="Help leader open doors"
                          IsChecked="{Binding HelpLeaderOpenDoors, Mode=TwoWay}"
                          ToolTip.Tip="Pitch in when the leader is forcing a door — bashes or picks the lock depending on the Other → 'Pick locks instead of bashing' toggle."/>
                <CheckBox Content="Ignore @wait when leading"
                          IsChecked="{Binding IgnoreWaitWhenLeading, Mode=TwoWay}"
                          ToolTip.Tip="When leading, drop incoming @wait broadcasts from party members — use this character's own Wait-if-members-below threshold instead of pausing on every member's personal wait setting."/>
                <CheckBox Content="Reset statistics on loop start"
                          IsChecked="{Binding ResetStatisticsOnLoopStart, Mode=TwoWay}"
                          ToolTip.Tip="Sends `@Reset` so the party EXP / kill counters zero at the start of every loop run."/>
                <CheckBox Content="Re-invite lost party members"
                          IsChecked="{Binding AutoInviteReconnecting, Mode=TwoWay}"
                          ToolTip.Tip="Leader-only — auto-invite a member who returns inside the &quot;If leading, wait only&quot; window after they hung up or dropped connection."/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <CheckBox Content="send @join nags to invited members"
                              IsChecked="{Binding SendJoinToInvited, Mode=TwoWay}"
                              ToolTip.Tip="On (default): after inviting a player, follow up with `/given @join` once the initial delay elapses, then re-nag per the resend cadence until they join or the attempt window expires. Off: send the invite only — no @join follow-up."/>
                    <TextBlock Classes="FieldLabel" Text="— first nag after"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <NumericUpDown Value="{Binding JoinNagInitialDelaySec, Mode=TwoWay}"
                                   Minimum="1" Maximum="60" Increment="1"
                                   FormatString="0" ShowButtonSpinner="True"
                                   Width="100" MinWidth="100"
                                   IsEnabled="{Binding NagInitialDelayEditable}"
                                   ToolTip.Tip="Whole seconds to wait before the first nag fires — the shared initial delay for both @join (after inviting) and @health (after a member joins). Resend cadence + attempt cap live under '@join/@health nag settings' below. Default 5."/>
                    <TextBlock Classes="FieldLabel" Text="seconds"/>
                </StackPanel>
                <CheckBox Content="send @health nags to party members"
                          IsChecked="{Binding SendHealthToMembers, Mode=TwoWay}"
                          ToolTip.Tip="On (default): when a member joins, telepath `/given @health` to capture their HP/MP baseline, retried per the shared nag cadence until real values arrive. Off: never send @health to party members."/>
            </StackPanel>

            <!-- ============ Capacity + cadence ============ -->
            <TextBlock Classes="SectionHeader" Text="Capacity + cadence"/>
            <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Max. monsters when partying"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding MaxMonstersWhenPartying, Mode=TwoWay}"
                               Minimum="1" Maximum="20" Width="120" MinWidth="120" HorizontalAlignment="Left"
                               ToolTip.Tip="Cap on hostiles to engage as a party (overrides Combat-tab cap)."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Wait if members are below"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <NumericUpDown Value="{Binding WaitIfMemberBelowPercent, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="120"
                                   ToolTip.Tip="Pause the party action loop while any member is below this HP %. 0 disables."/>
                    <TextBlock Classes="FieldLabel" Text="%"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="If leading, wait only (s)"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1"
                               Value="{Binding IfLeadingWaitTotalSec, Mode=TwoWay}"
                               Minimum="0" Maximum="3600" Increment="10"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120" HorizontalAlignment="Left"
                               ToolTip.Tip="Grace window in seconds for a lost party member to re-enter the realm before we stop watching for them. Used by the Re-invite lost party members flow. Arrows step by 10; type a value directly for finer control (e.g. 94 for 1 m 34 s). Default 90."/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Return distance (rooms)"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1"
                               Value="{Binding ReturnDistanceRooms, Mode=TwoWay}"
                               Minimum="1" Maximum="500" Width="120" MinWidth="120" HorizontalAlignment="Left"
                               ToolTip.Tip="Leader-side recovery reach: the farthest, in map room-hops from where we are, we'll walk to re-collect a reconnecting party member before declining (telepathing @forget instead). Gates both the follower @comeback pickup and the leader-initiated @where probe. Default 30."/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="`par` poll frequency (s)"/>
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Value="{Binding ParPollFrequencySec, Mode=TwoWay}"
                               Minimum="1" Maximum="60" Width="120" HorizontalAlignment="Left"
                               ToolTip.Tip="Cadence for the par poll — MegaMUD default is 5."/>
            </Grid>

            <!-- ============ @join/@health nag settings ============ -->
            <!-- Shared cadence for two nag flows: (1) AutoPartyManager's
                 `@join` follow-up after the initial `invite`, and
                 (2) PartyPoller's `/given @health` retry when a newly
                 joined member's HP/MP comes back as percent-only. The
                 shared initial delay lives up in Options next to the
                 @join toggle; the resend cadence + attempt cap live here. -->
            <TextBlock Classes="SectionHeader" Text="@join/@health nag settings"/>
            <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Resend frequency (s)"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding JoinNagFrequencySec, Mode=TwoWay}"
                               Minimum="1" Maximum="60" Width="120" HorizontalAlignment="Left"
                               ToolTip.Tip="How often a nag re-fires after the first send. `@join` stops on join / non-{Ok} reply / cap; `@health` stops once absolute HP/MP values arrive. Default 10."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Max attempt window (s)"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding JoinNagMaxTotalSec, Mode=TwoWay}"
                               Minimum="5" Maximum="600" Width="120" HorizontalAlignment="Left"
                               ToolTip.Tip="Hard cap on the nag window measured from the first attempt. Past this, give up. Default 55."/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
