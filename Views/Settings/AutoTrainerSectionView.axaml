<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="620"
             x:Class="MudPlay.Views.Settings.AutoTrainerSectionView"
             x:DataType="vm:AutoTrainerSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,*" IsVisible="{Binding HasProfile}">

        <!-- How auto-train behaves once it runs: when to make the trip, what to hold
             back, where to stop, and whether to announce. -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="SettingsSectionBanner first" Text="Character profile settings"/>
            <TextBlock Classes="SettingsSectionSub"
                       Text="Everything on this tab saves to the loaded character — each character keeps its own copy."/>
            <Border Classes="SettingsSectionRule" Margin="0,6,0,4"/>
            <!-- The Auto-train / Auto-train stats toggles deliberately live ONLY on
                 the Player Workshop's CP Allocation tab, next to the plan they act
                 on. They used to appear here as well, which was both a duplicate and
                 a hazard: this tab writes the whole AutoTrainerSettings DTO on Apply,
                 so an Apply here would overwrite whatever the CP tab had just set. -->

            <!-- Fire threshold: stack this many trainable levels before making the
                 trip, so one detour trains several levels instead of one each. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Train once this many levels are stacked" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="60" Increment="1"
                               FormatString="0"
                               Value="{Binding FireAtBankedLevels, Mode=TwoWay}"
                               ToolTip.Tip="Wait until this many levels are trainable before auto-train makes a trip, so one detour trains them all instead of one trip per level. 0 or 1 goes as soon as a single level is available. Works with 'Levels to keep banked', which decides how many stay banked once the trip happens — a threshold at or below that reserve behaves as if it were one above it."/>
            </StackPanel>

            <!-- Levels to keep banked: auto-train (and Train Now) stops once this
                 many trainable levels are still reachable, so a reserve is kept. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Levels to keep banked" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="60" Increment="1"
                               FormatString="0"
                               Value="{Binding LevelsToKeep, Mode=TwoWay}"
                               ToolTip.Tip="Always keep this many trainable levels banked. Auto-train and Train Now stop once only this many levels remain reachable. 0 trains every banked level."/>
            </StackPanel>

            <!-- Do not train above: a level ceiling. Auto-train reaches this level
                 but never trains above it (reach N, then stop) — no over-levelling. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Do not train above level" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="200" Increment="1"
                               FormatString="0"
                               Value="{Binding DoNotTrainAbove, Mode=TwoWay}"
                               ToolTip.Tip="Auto-train will train up to this level but never above it (reach it, then stop) — a guard against over-levelling once the exp and level-buffer gates would otherwise keep training. 0 = no ceiling."/>
            </StackPanel>

            <!-- Stock only: how long a train run waits at the trainer for an
                 altered stat to clear. Greyed out on a Paradigm realm, which
                 trains through one. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center"
                        IsEnabled="{Binding IsStockRealm}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="Stock won't open `train stats` while a spell or item is altering one of your stats (&quot;Your stats are unnaturally altered!&quot;). When a train trip reaches the trainer and finds one altered, it waits there this long, reading `stat` again every 20 seconds, and applies your CP plan as soon as the stats are back to normal. If they haven't cleared by then the plan row is left for a later trip. 0 = don't wait.&#10;&#10;Stock realms only: Paradigm lets you train with a stat altered, so nothing waits there and this is greyed out.">
                <TextBlock Text="Wait for altered stats at the trainer (Stock)" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="600" Increment="10"
                               FormatString="0"
                               Value="{Binding AlteredStatsWaitSeconds, Mode=TwoWay}"/>
                <TextBlock Text="seconds" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Announce level-ups: when a live exp gain makes a new level
                 trainable, broadcast "I can now train to level: N" on the
                 selected channel. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <CheckBox Content="Announce level-ups over"
                          VerticalAlignment="Center"
                          IsChecked="{Binding AnnounceLevelUps, Mode=TwoWay}"
                          ToolTip.Tip="When a live experience gain makes a new level trainable, broadcast 'I can now train to level: N' on the selected channel."/>
                <ComboBox MinWidth="120" VerticalAlignment="Center"
                          ItemsSource="{Binding AnnounceChannels}"
                          SelectedItem="{Binding AnnounceChannel, Mode=TwoWay}"
                          IsEnabled="{Binding AnnounceLevelUps}"/>
            </StackPanel>

            <!-- Which trainer a run walks to when more than one can teach the level. -->
            <TextBlock Classes="SectionHeader" Text="WHICH TRAINER"/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="When several trainers can teach the level, go to the" VerticalAlignment="Center"/>
                <ComboBox MinWidth="300" VerticalAlignment="Center"
                          ItemsSource="{Binding TrainerChoiceOptions}"
                          SelectedItem="{Binding SelectedTrainerChoice, Mode=TwoWay}"
                          ToolTip.Tip="Closest: the fewest steps away, the lower markup breaking a tie. Cheapest: the lowest markup (the fee scales with it), the nearer breaking a tie, however far it is. Only the trainers ticked Use? below are considered. Applying stat points alone always goes to the closest: it costs nothing."/>
            </StackPanel>

            <!-- When short on cash: where a run may fetch the difference. Saved per
                 character like the rest of this tab; the bank / stash pickers only
                 apply while the chosen source includes them. -->
            <TextBlock Classes="SectionHeader" Text="WHEN SHORT ON CASH"/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Fetch the difference from" VerticalAlignment="Center"/>
                <ComboBox MinWidth="300" VerticalAlignment="Center"
                          ItemsSource="{Binding FundingModeOptions}"
                          SelectedItem="{Binding SelectedFundingMode, Mode=TwoWay}"
                          ToolTip.Tip="When your purse (above keep-on-hand) can't pay for the training, where auto-train may collect the rest before walking to the trainer. 'Don't fetch' leaves it armed and looping until your purse covers it."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Bank" VerticalAlignment="Center" MinWidth="44"/>
                <ComboBox MinWidth="300" VerticalAlignment="Center"
                          ItemsSource="{Binding FundingBankOptions}"
                          SelectedItem="{Binding SelectedFundingBank, Mode=TwoWay}"
                          IsEnabled="{Binding FundingUsesBank}"
                          ToolTip.Tip="Withdraw only at this bank room, or at any bank that holds enough. A bank with two branches (Bank of Godfrey in Silvermere and Khazarad) is listed once per branch; the branches share one balance. Only a bank you've deposited at has a balance to draw on."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Stash" VerticalAlignment="Center" MinWidth="44"/>
                <ComboBox MinWidth="300" VerticalAlignment="Center"
                          ItemsSource="{Binding FundingStashOptions}"
                          SelectedItem="{Binding SelectedFundingStash, Mode=TwoWay}"
                          IsEnabled="{Binding FundingUsesStash}"
                          ToolTip.Tip="Collect only from this stash room, or from any of your flagged stash rooms that holds coin."/>
            </StackPanel>

            <!-- Party auto-train options. The on/off switch is the "Auto-train party"
                 box on the CP Allocation tab; these shape how the leader runs it. -->
            <TextBlock Classes="SectionHeader" Text="PARTY (Auto-train party on the CP Allocation tab)"/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Go once at least" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="1" Maximum="6" Increment="1"
                               FormatString="0"
                               Value="{Binding PartyMinReady, Mode=TwoWay}"
                               ToolTip.Tip="Leader only. How many party members must be ready to train before the trip goes — you count as one. Whoever isn't ready yet stays banked and follows along. If everyone who counts is ready, the trip goes even when that's fewer than this."/>
                <TextBlock Text="party members are ready to train" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Don't wait for anyone more than" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="200" Increment="1"
                               FormatString="0"
                               Value="{Binding PartyLevelGap, Mode=TwoWay}"
                               ToolTip.Tip="Leader only. A member who isn't ready and is more than this many levels above the rest of the party (a power-leveler, the leader included) is never waited for. 0 = no level-gap rule."/>
                <TextBlock Text="levels above the party" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Stop first at" VerticalAlignment="Center"/>
                <ComboBox MinWidth="300" VerticalAlignment="Center"
                          ItemsSource="{Binding PartyStopChoiceOptions}"
                          SelectedItem="{Binding SelectedPartyStopChoice, Mode=TwoWay}"
                          ToolTip.Tip="Leader only. How a party trip picks the trainer its members train at next. The one that trains the most of them makes the fewest stops, the trainer choice above breaking a tie. The other option goes by the trainer choice alone, to any trainer that trains at least one member."/>
            </StackPanel>
            <CheckBox Content="Leave the level 11 train to a solo trip" Margin="0,8,0,0"
                      IsChecked="{Binding PartySkipLevel11, Mode=TwoWay}"
                      ToolTip.Tip="In party mode, train no higher than level 10: the level-11 trainer is a solo effort, so take that step on your own."/>
        </StackPanel>

        <!-- The two lists share the space under the options: the trainers auto-train
             may walk to, and the spells it may go on to buy once the levels are trained. -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Trainers">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header + right-aligned view filter. Unchecked = all discovered
                         trainers; checked = only the trainers usable at your current level. -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="DISCOVERED TRAINERS"/>
                        <CheckBox Grid.Column="1" Content="Usable at my level" VerticalAlignment="Center"
                                  IsChecked="{Binding OnlyUsableLevel, Mode=TwoWay}"
                                  ToolTip.Tip="Show only trainers whose level range covers your current level."/>
                    </Grid>

                    <!-- Discovered trainers (ShopType 8, MaxLVL != 999), with a per-trainer
                         Allow toggle gating whether auto-train may route to it. -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Trainers}"
                              IsVisible="{Binding HasTrainers}"
                              Background="{StaticResource ChromeBgSunkenBrush}"
                              BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}"
                              IsReadOnly="False"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- Single-click toggle: a template column with a plain CheckBox,
                                 not DataGridCheckBoxColumn, so one click flips it (the built-in
                                 column needs a click to enter edit mode first). -->
                            <DataGridTemplateColumn Header="Use?" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:AutoTrainerRowViewModel">
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Trainer" Width="*"
                                                Binding="{ReflectionBinding TrainerLabel}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Map/Room" Width="110"
                                                Binding="{ReflectionBinding MapRoom}" IsReadOnly="True"
                                                FontFamily="{StaticResource FontMono}"/>
                            <DataGridTextColumn Header="Levels" Width="90"
                                                Binding="{ReflectionBinding LevelRange}" IsReadOnly="True"
                                                FontFamily="{StaticResource FontMono}"/>
                            <DataGridTextColumn Header="Markup" Width="80"
                                                Binding="{ReflectionBinding Markup}" IsReadOnly="True"
                                                FontFamily="{StaticResource FontMono}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty-state: no game-data set loaded, or it has no usable trainers. -->
                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding !HasTrainers}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               Text="No trainers found in the active game-data set. Load a set with a Shops table to see discovered trainers here."/>
                </Grid>
            </TabItem>
            <TabItem Header="Spells from shops">
                <Grid RowDefinitions="Auto,Auto,*">
                    <CheckBox Grid.Row="0" Content="Auto-obtain spells from shops" Margin="0,6,0,0"
                              IsChecked="{Binding AutoObtainShopSpells, Mode=TwoWay}"
                              ToolTip.Tip="After a solo auto-train or Train Now trip has trained its levels, walk on to the shops that sell the scrolls for spells you can now learn and haven't, buy them, read them, and then go back to the loop. The trip's funding fetches the scroll money along with the training fee; if it can't cover both, it trains anyway and buys what the purse stretches to, lowest level first. A shop you can't route to (a level-gated area, an avoided room) is skipped."/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="SPELLS SOLD IN SHOPS"/>
                        <CheckBox Grid.Column="1" Content="Hide learned" VerticalAlignment="Center"
                                  IsChecked="{Binding HideLearnedSpells, Mode=TwoWay}"
                                  ToolTip.Tip="Leave out the spells already in your spellbook."/>
                    </Grid>

                    <!-- Every spell the class can learn from a scroll some shop restocks.
                         Untick Get? for one the trip should never go after. -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ShopSpells}"
                              IsVisible="{Binding HasShopSpells}"
                              Background="{StaticResource ChromeBgSunkenBrush}"
                              BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}"
                              IsReadOnly="False"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              CanUserResizeColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Get?" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ShopSpellRowViewModel">
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding Wanted, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Level" Width="60"
                                                Binding="{ReflectionBinding Level}" IsReadOnly="True"
                                                FontFamily="{StaticResource FontMono}"/>
                            <DataGridTextColumn Header="Spell" Width="170"
                                                Binding="{ReflectionBinding Spell}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Scroll" Width="190"
                                                Binding="{ReflectionBinding Scroll}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sold at" Width="*"
                                                Binding="{ReflectionBinding SoldAt}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Price" Width="100"
                                                Binding="{ReflectionBinding Price}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Learned" Width="70"
                                                Binding="{ReflectionBinding Learned}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               IsVisible="{Binding !HasShopSpells}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               Text="No shop sells a spell scroll your class can learn. The list fills in once your class is known (type stat) and a game-data set with Shops and Items is loaded."/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
