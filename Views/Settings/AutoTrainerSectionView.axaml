<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="620"
             x:Class="FujinTerm.Views.Settings.AutoTrainerSectionView"
             x:DataType="vm:AutoTrainerSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasProfile}">

        <!-- Toggles: master Auto-train then the cascading Auto-train stats on one row. -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <CheckBox Content="Auto-train"
                          IsChecked="{Binding AutoTrain, Mode=TwoWay}"
                          ToolTip.Tip="When running a loop / auto-lair and a level-up is available, detour to an allowed trainer and train."/>
                <CheckBox Content="Auto-train stats"
                          IsChecked="{Binding AutoTrainStats, Mode=TwoWay}"
                          IsEnabled="{Binding AutoTrain}"
                          ToolTip.Tip="After training a level, apply the CP plan's row for the new level via the train-stats screen."/>
            </StackPanel>
            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="540"
                       IsVisible="{Binding HasAutoTrainStatsWarning}"
                       Text="{Binding AutoTrainStatsWarning}"
                       Foreground="{StaticResource AccentAmberBrush}"/>

            <!-- Levels to keep banked: auto-train (and Train Now) stops once this
                 many trainable levels are still reachable, so a reserve is kept. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="Levels to keep banked" VerticalAlignment="Center"/>
                <NumericUpDown MinWidth="110" VerticalAlignment="Center"
                               Minimum="0" Maximum="60" Increment="1"
                               FormatString="0"
                               Value="{Binding LevelsToKeep, Mode=TwoWay}"
                               ToolTip.Tip="Always keep this many trainable levels banked. Auto-train and Train Now stop once only this many levels remain reachable. 0 trains every banked level."/>
            </StackPanel>

            <!-- Announce level-ups: when a live exp gain makes a new level
                 trainable, broadcast "I can now train to level: N" on the
                 selected channel. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <CheckBox Content="Announce level-ups over"
                          VerticalAlignment="Center"
                          IsChecked="{Binding AnnounceLevelUps, Mode=TwoWay}"
                          ToolTip.Tip="When a live experience gain makes a new level trainable, broadcast 'I can now train to level: N' on the selected channel."/>
                <ComboBox MinWidth="120" VerticalAlignment="Center"
                          ItemsSource="{Binding AnnounceChannels}"
                          SelectedItem="{Binding AnnounceChannel, Mode=TwoWay}"
                          IsEnabled="{Binding AnnounceLevelUps}"/>
            </StackPanel>
        </StackPanel>

        <!-- Header + right-aligned view filter. Unchecked = all discovered
             trainers; checked = only the trainers usable at your current level. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <TextBlock Grid.Column="0" Classes="SectionHeader" Text="DISCOVERED TRAINERS"/>
            <CheckBox Grid.Column="1" Content="Usable at my level" VerticalAlignment="Center"
                      IsChecked="{Binding OnlyUsableLevel, Mode=TwoWay}"
                      ToolTip.Tip="Show only trainers whose level range covers your current level."/>
        </Grid>

        <!-- Discovered trainers (ShopType 8, MaxLVL != 999), with a per-trainer
             Allow toggle gating whether auto-train may route to it. -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Trainers}"
                  IsVisible="{Binding HasTrainers}"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="False"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <!-- Single-click toggle: a template column with a plain CheckBox,
                     not DataGridCheckBoxColumn, so one click flips it (the built-in
                     column needs a click to enter edit mode first). -->
                <DataGridTemplateColumn Header="Use?" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:AutoTrainerRowViewModel">
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding Allowed, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Trainer" Width="*"
                                    Binding="{ReflectionBinding TrainerLabel}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Map/Room" Width="110"
                                    Binding="{ReflectionBinding MapRoom}" IsReadOnly="True"
                                    FontFamily="{StaticResource FontMono}"/>
                <DataGridTextColumn Header="Levels" Width="90"
                                    Binding="{ReflectionBinding LevelRange}" IsReadOnly="True"
                                    FontFamily="{StaticResource FontMono}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty-state: no game-data set loaded, or it has no usable trainers. -->
        <TextBlock Grid.Row="2"
                   IsVisible="{Binding !HasTrainers}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Text="No trainers found in the active game-data set. Load a set with a Shops table to see discovered trainers here."/>
    </Grid>
</UserControl>
