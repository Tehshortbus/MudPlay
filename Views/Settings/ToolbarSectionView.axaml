<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:svc="using:FujinTerm.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="500"
             x:Class="FujinTerm.Views.Settings.ToolbarSectionView"
             x:DataType="vm:ToolbarSectionViewModel">

    <UserControl.Styles>
        <Style Selector="Path.ToolbarRowIcon">
            <Setter Property="Stroke" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style Selector="TextBlock.RowShortcut">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.SeparatorRow">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- "No profile loaded" banner — shows when HasProfile is false. -->
        <Border IsVisible="{Binding !HasProfile}"
                Padding="22"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
            <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Toolbar"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Load or create a character profile to edit Toolbar settings — every settings tab lives on the active character."
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Editor — visible when a profile is loaded. -->
        <Grid IsVisible="{Binding HasProfile}"
              Margin="22"
              RowDefinitions="Auto,Auto,*,Auto"
              ColumnDefinitions="*,180">

            <!-- Global toolbar options (Phase 4 PR 4.8 stubs).
                 Show / Vertical / per-item custom command land in a later
                 PR; surface visible here so the eventual knobs are
                 advertised on day one. -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Spacing="2" Margin="0,0,0,10">
                <TextBlock Classes="SectionHeader" Text="Toolbar options"/>
                <CheckBox Content="Show toolbar" IsEnabled="False"
                          ToolTip.Tip="Stub (Phase 4 PR 4.8). Wires to MainWindow toolbar visibility in a later PR."/>
                <CheckBox Content="Vertical toolbar" IsEnabled="False"
                          ToolTip.Tip="Stub (Phase 4 PR 4.8). Rotates the toolbar to the left edge — needs MainWindow layout work."/>
                <Grid ColumnDefinitions="180,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="Custom command (per item):"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" IsEnabled="False"
                             PlaceholderText="e.g. peer^M"
                             ToolTip.Tip="Stub (Phase 4 PR 4.8). Future — selected toolbar row gets an arbitrary command override here."/>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="SectionHeader"
                       Text="Toolbar layout — top to bottom here ≡ left to right on the toolbar"/>

            <!-- Row list. SelectionMode=Single drives the Move/Delete commands. -->
            <Border Grid.Row="2" Grid.Column="0"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource ChromeBgSunkenBrush}">
                <ListBox ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolbarRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                                <!-- Button row: icon -->
                                <Path Grid.Column="0"
                                      Classes="ToolbarRowIcon"
                                      Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                                      IsVisible="{Binding IsButton}"
                                      Margin="2,0,8,0"/>

                                <!-- Button row: label / separator row: dashed text -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayLabel}"
                                           VerticalAlignment="Center"
                                           Classes.SeparatorRow="{Binding IsSeparator}"/>

                                <!-- Button row: shortcut hint -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ShortcutHint}"
                                           Classes="RowShortcut"
                                           IsVisible="{Binding IsButton}"
                                           Margin="8,0,2,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right rail: row actions + add controls + reset. -->
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Margin="12,0,0,0"
                        Spacing="6">

                <Button Content="Move up"
                        Command="{Binding MoveUpCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Move down"
                        Command="{Binding MoveDownCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Delete"
                        Command="{Binding DeleteSelectedCommand}"
                        HorizontalAlignment="Stretch"/>

                <Border Height="1"
                        Background="{StaticResource ChromeBorderBrush}"
                        Margin="0,8"/>

                <TextBlock Text="Add button"
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeSm}"/>
                <ComboBox ItemsSource="{Binding AvailableActions}"
                          SelectedItem="{Binding SelectedAvailable, Mode=TwoWay}"
                          PlaceholderText="Pick an action"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ToolbarItemCatalogue+Entry">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Add"
                        Command="{Binding AddButtonCommand}"
                        HorizontalAlignment="Stretch"/>

                <Border Height="1"
                        Background="{StaticResource ChromeBorderBrush}"
                        Margin="0,8"/>

                <Button Content="Add separator"
                        Command="{Binding AddSeparatorCommand}"
                        HorizontalAlignment="Stretch"/>

                <Border Height="1"
                        Background="{StaticResource ChromeBorderBrush}"
                        Margin="0,8"/>

                <Button Content="Reset to defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
