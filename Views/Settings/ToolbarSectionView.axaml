<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:svc="using:FujinTerm.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="620"
             x:Class="FujinTerm.Views.Settings.ToolbarSectionView"
             x:DataType="vm:ToolbarSectionViewModel">

    <UserControl.Styles>
        <Style Selector="Path.ToolbarRowIcon">
            <Setter Property="Stroke" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style Selector="TextBlock.RowShortcut">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.SeparatorRow">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Fixed-height rows so each list shows exactly 8 at a time
             (28px × 8 = 224 → the Border height below). Predictable
             height keeps the rail buttons from overlapping the way the
             old proportional (2*/3*) sizing did when the window shrank. -->
        <Style Selector="ListBox.RowList">
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="ListBox.RowList ListBoxItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Shared row template — both the toolbar list and the shortcuts
             list render [icon] [label] [(shortcut)]. Separators only appear
             in the toolbar list. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ToolbarRowViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2">
                <Path Grid.Column="0"
                      Classes="ToolbarRowIcon"
                      Data="{Binding IconResourceKey, Converter={x:Static svc:IconResourceConverter.Instance}}"
                      IsVisible="{Binding IsButton}"
                      Margin="2,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayLabel}"
                           VerticalAlignment="Center"
                           Classes.SeparatorRow="{Binding IsSeparator}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding ShortcutHint}"
                           Classes="RowShortcut"
                           IsVisible="{Binding IsButton}"
                           Margin="8,0,2,0"/>
            </Grid>
        </DataTemplate>

        <!-- Help-menu website row — an editable [label] [url] pair. -->
        <DataTemplate x:Key="WebsiteRowTemplate" x:DataType="vm:HelpWebsiteRowViewModel">
            <Grid ColumnDefinitions="200,*" Margin="2" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="Label"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="https://…"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One outer scroller for the whole tab. The Help-websites block up top
         is a Global setting so it stays visible with no profile loaded; the
         toolbar/shortcuts editor below it is character-scoped and swaps to a
         "load a profile" banner when none is loaded. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22" Spacing="10">

        <!-- Help-menu websites (Global tier) — always editable. -->
        <TextBlock Classes="SectionHeader"
                   Text="Help menu websites — shown under Help ↗ (shared across all characters)"/>

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,180">
            <!-- Editable label/URL list. -->
            <Border Grid.Row="0" Grid.Column="0"
                    Height="196" VerticalAlignment="Top"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource ChromeBgSunkenBrush}">
                <ListBox ItemsSource="{Binding WebsiteRows}"
                         SelectedItem="{Binding SelectedWebsiteRow, Mode=TwoWay}"
                         ItemTemplate="{StaticResource WebsiteRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <!-- Website rail: add / remove / reorder / reset. -->
            <StackPanel Grid.Row="0" Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Spacing="6">
                <Button Content="Add link"
                        Command="{Binding AddWebsiteCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Add a new website link to the Help menu."/>
                <Button Content="Remove"
                        Command="{Binding RemoveWebsiteCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Delete the selected link."/>
                <Button Content="Move up"
                        Command="{Binding MoveWebsiteUpCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Move down"
                        Command="{Binding MoveWebsiteDownCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Reset to default"
                        Command="{Binding ResetWebsitesToDefaultCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Restore the built-in reference links (wiki, subreddit, MudInfo, Facebook group)."/>
            </StackPanel>

            <!-- Active BBS's own site — a per-BBS value edited here as a
                 special row tied to whichever BBS is active. -->
            <Grid Grid.Row="1" Grid.Column="0"
                  Margin="0,10,0,0"
                  ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  IsVisible="{Binding HasActiveBbs}">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           Text="{Binding ActiveBbsName, StringFormat='{}{0} site:'}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BbsWebsiteUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="https://… (optional)"
                         ToolTip.Tip="This BBS's website — appears as the 'BBS site ↗' entry under Help. Stored per-BBS."/>
            </Grid>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Margin="0,10,0,0"
                       IsVisible="{Binding !HasActiveBbs}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap"
                       Text="Configure a BBS (Settings → BBS + Display) to attach its website to the Help menu."/>
        </Grid>

        <Separator Margin="0,4"/>

        <!-- "No profile loaded" banner — shown when HasProfile is false.
             Only the toolbar/shortcuts editor below needs a character; the
             websites above are global. -->
        <Border IsVisible="{Binding !HasProfile}"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Toolbar + Shortcuts"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Load or create a character profile to edit the toolbar layout + shortcuts — those live on the active character."
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Editor — visible when a profile is loaded. Fixed (Auto) row
             heights with 8-row lists. -->
        <Grid IsVisible="{Binding HasProfile}"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,180">

            <!-- Visibility + position. ShowToolbar is the master gate; the
                 four edge radios share one group and stay live only while
                 Show toolbar is checked. Top / Bottom mount horizontally,
                 Left / Right vertically. Top is the default. -->
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Spacing="2" Margin="0,0,0,10">
                <TextBlock Classes="SectionHeader" Text="Toolbar options"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Show toolbar"
                              IsChecked="{Binding ShowToolbar, Mode=TwoWay}"
                              ToolTip.Tip="Master visibility — uncheck to hide the toolbar entirely."/>
                    <RadioButton GroupName="ToolbarPosition" Content="Top"
                                 IsChecked="{Binding IsTop, Mode=TwoWay}"
                                 IsEnabled="{Binding ShowToolbar}"
                                 ToolTip.Tip="Dock the toolbar to the top edge (default)."/>
                    <RadioButton GroupName="ToolbarPosition" Content="Bottom"
                                 IsChecked="{Binding IsBottom, Mode=TwoWay}"
                                 IsEnabled="{Binding ShowToolbar}"
                                 ToolTip.Tip="Dock the toolbar to the bottom edge, above the status bar."/>
                    <RadioButton GroupName="ToolbarPosition" Content="Left"
                                 IsChecked="{Binding IsLeft, Mode=TwoWay}"
                                 IsEnabled="{Binding ShowToolbar}"
                                 ToolTip.Tip="Dock the toolbar vertically to the left edge."/>
                    <RadioButton GroupName="ToolbarPosition" Content="Right"
                                 IsChecked="{Binding IsRight, Mode=TwoWay}"
                                 IsEnabled="{Binding ShowToolbar}"
                                 ToolTip.Tip="Dock the toolbar vertically to the right edge."/>
                </StackPanel>

                <!-- Import another character's toolbar layout + keybinds,
                     alongside the two default-reset actions. Layout changes
                     stage into the pending list (Apply to keep); keybind
                     changes apply live. -->
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Import toolbar + Keybinds"
                                Command="{Binding CopyFromProfileCommand}"
                                ToolTip.Tip="Replace this character's toolbar layout + keybinds with another character's. The layout stages here (Apply to keep); keybinds apply immediately. Chords that clash with this profile's macros are skipped."/>
                        <Button Content="Reset Toolbar to Default"
                                Command="{Binding ResetToDefaultsCommand}"
                                ToolTip.Tip="Restore the default set of toolbar buttons (which actions sit on the toolbar). Doesn't touch keybinds."/>
                        <Button Content="Reset Keybinds to Default"
                                Command="{Binding ResetAllKeybindsCommand}"
                                ToolTip.Tip="Restore every keybind — across both the toolbar and shortcuts lists — to its default chord. Doesn't touch which buttons are on the toolbar."/>
                    </StackPanel>
                    <TextBlock Text="{Binding CopyStatus}"
                               IsVisible="{Binding CopyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap"
                               MaxWidth="520"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="SectionHeader"
                       Text="Toolbar layout — top to bottom here ≡ left to right on the toolbar"/>

            <!-- Toolbar row list — fixed height for 8 rows; scrolls past that. -->
            <Border Grid.Row="2" Grid.Column="0"
                    Height="234" VerticalAlignment="Top"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource ChromeBgSunkenBrush}">
                <ListBox Classes="RowList"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemTemplate="{StaticResource RowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <!-- Toolbar rail: reorder / add separator / remove / keybind. -->
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Spacing="6">
                <Button Content="Move up"
                        Command="{Binding MoveUpCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Move down"
                        Command="{Binding MoveDownCommand}"
                        HorizontalAlignment="Stretch"/>
                <Button Content="Add separator"
                        Command="{Binding AddSeparatorCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Append a visual divider to the toolbar."/>
                <Button Content="Remove"
                        Command="{Binding RemoveFromToolbarCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Take the selected button off the toolbar (it stays available below as a shortcut). Separators are simply deleted."/>
                <Button Content="Change keybind…"
                        Command="{Binding ChangeToolbarKeybindCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Rebind the shortcut for the selected toolbar action, or clear it. Disabled for separators and non-rebindable rows."/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="SectionHeader"
                       Text="Shortcuts — every action not on the toolbar; each can still hold a keybind"/>

            <!-- Shortcuts list: the full pool of off-toolbar actions —
                 fixed height for 8 rows; scrolls past that. -->
            <Border Grid.Row="4" Grid.Column="0"
                    Height="234" VerticalAlignment="Top"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource ChromeBgSunkenBrush}">
                <ListBox Classes="RowList"
                         ItemsSource="{Binding ShortcutRows}"
                         SelectedItem="{Binding SelectedShortcutRow, Mode=TwoWay}"
                         ItemTemplate="{StaticResource RowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <!-- Shortcuts rail: promote to toolbar / keybind. -->
            <StackPanel Grid.Row="4" Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Spacing="6">
                <Button Content="Add to toolbar"
                        Command="{Binding AddToToolbarCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Promote the selected action to a toolbar button."/>
                <Button Content="Change keybind…"
                        Command="{Binding ChangeShortcutKeybindCommand}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="Rebind the shortcut for the selected action, or clear it."/>
            </StackPanel>
        </Grid>

    </StackPanel>
    </ScrollViewer>
</UserControl>
