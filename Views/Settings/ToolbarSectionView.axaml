<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="500"
             x:Class="FujinTerm.Views.Settings.ToolbarSectionView"
             x:DataType="vm:ToolbarSectionViewModel">

    <UserControl.Styles>
        <!-- Icon glyph next to each checkbox content. Strokes the cell with
             ChromeFgBrush so visibility matches the surrounding text. -->
        <Style Selector="Path.ToolbarRowIcon">
            <Setter Property="Stroke" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="6"
                    MaxWidth="540" HorizontalAlignment="Left">

            <TextBlock Text="Toolbar"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontSize="{StaticResource FontSizeLg}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Pick which icons appear on the main window's toolbar. Hidden icons are still reachable via the View / File / Help menus and their hotkeys."
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12"/>

            <CheckBox IsChecked="{Binding ShowConnect, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconPlug}"/>
                    <TextBlock Text="Connect / Disconnect (Ctrl+K)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowSettings, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconGear}"/>
                    <TextBlock Text="Settings (Ctrl+,)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowNavigation, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconMap}"/>
                    <TextBlock Text="Navigation (F5)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowBackscroll, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconHistory}"/>
                    <TextBlock Text="Backscroll (F10)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowCapture, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconRecord}"/>
                    <TextBlock Text="Capture" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowWireInspector, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconSearch}"/>
                    <TextBlock Text="Wire Inspector" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowConversation, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconChat}"/>
                    <TextBlock Text="Conversation (F2)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowParty, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconParty}"/>
                    <TextBlock Text="Party (F3)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowWorkshop, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconUser}"/>
                    <TextBlock Text="Player Workshop (F4)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowSpellBook, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconBook}"/>
                    <TextBlock Text="Spell Book (F7)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowSessionStats, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconStats}"/>
                    <TextBlock Text="Session Stats (F11)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowGameDataBrowser, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconDatabase}"/>
                    <TextBlock Text="Game Data Browser (Ctrl+G)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding ShowLog, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Classes="ToolbarRowIcon" Data="{StaticResource IconLog}"/>
                    <TextBlock Text="Log (F9)" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
