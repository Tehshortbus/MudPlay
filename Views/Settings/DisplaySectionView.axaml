<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="360"
             x:Class="FujinTerm.Views.Settings.DisplaySectionView"
             x:DataType="vm:DisplaySectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>

            <!-- No-profile banner. -->
            <Border IsVisible="{Binding !HasProfile}"
                    Padding="22" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Display"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit Display settings."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22" Spacing="6" MaxWidth="640"
                        HorizontalAlignment="Left">

                <TextBlock Classes="SectionHeader" Text="Font"/>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Size:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding FontSize, Mode=TwoWay}"
                                   Minimum="8" Maximum="32" Increment="1"
                                   FormatString="0"
                                   Width="140" HorizontalAlignment="Left"
                                   ToolTip.Tip="Changes apply to the terminal canvas live."/>
                </Grid>

                <TextBlock Classes="SectionHeader" Text="Scrollback"/>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Buffer (lines):"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                        <NumericUpDown Value="{Binding ScrollbackLines, Mode=TwoWay}"
                                       Minimum="100" Maximum="100000" Increment="500"
                                       FormatString="0"
                                       Width="140" HorizontalAlignment="Left"/>
                        <TextBlock Text="Takes effect on next launch — the live ring isn't resized."
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontSize="{StaticResource FontSizeSm}"/>
                    </StackPanel>
                </Grid>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
