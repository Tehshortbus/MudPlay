<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="FujinTerm.Views.Settings.EventEditDialog"
        x:DataType="vm:EventEditDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector="TextBlock.Error">
            <Setter Property="Foreground" Value="#E55353"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <!-- Header: Name + flags. -->
            <Grid Grid.Row="0" ColumnDefinitions="60,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Grid.Column="2" Content="Disabled" Margin="14,0,0,0"
                          IsChecked="{Binding DisabledFlag, Mode=TwoWay}"/>
                <CheckBox Grid.Column="3" Content="AFK only" Margin="8,0,0,0"
                          IsChecked="{Binding AfkOnlyFlag, Mode=TwoWay}"
                          ToolTip.Tip="Fires only while AFK — wires when the AFK engine ships in PR 8.6."/>
            </Grid>

            <!-- WHEN section. -->
            <StackPanel Grid.Row="1" Spacing="3" Margin="0,12,0,0">
                <TextBlock Classes="SectionHeader" Text="WHEN (trigger)"/>
                <RadioButton GroupName="When" Content="Logon"
                             IsChecked="{Binding IsTriggerLogon, Mode=TwoWay}"/>
                <RadioButton GroupName="When" Content="Logoff"
                             IsChecked="{Binding IsTriggerLogoff, Mode=TwoWay}"/>
                <RadioButton GroupName="When" Content="Re-log"
                             IsChecked="{Binding IsTriggerRelog, Mode=TwoWay}"/>

                <!-- At time row. -->
                <Grid ColumnDefinitions="Auto,140,Auto,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="When" Content="At time"
                                 IsChecked="{Binding IsTriggerAtTime, Mode=TwoWay}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AtTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsTriggerAtTime}"
                             PlaceholderText="HH:mm (24-hour)"/>
                    <TextBlock Grid.Column="2" Classes="Hint" Text="wall-clock local"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="3" Classes="Error"
                               Text="{Binding AtTimeError}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Every row. -->
                <Grid ColumnDefinitions="Auto,80,100,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="When" Content="Every"
                                 IsChecked="{Binding IsTriggerEvery, Mode=TwoWay}"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding EveryAmount, Mode=TwoWay}"
                                   Minimum="1" Maximum="86400"
                                   IsEnabled="{Binding IsTriggerEvery}"
                                   FormatString="0"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding EveryUnits}"
                              SelectedItem="{Binding EveryUnit, Mode=TwoWay}"
                              IsEnabled="{Binding IsTriggerEvery}"/>
                    <TextBlock Grid.Column="3" Classes="Error"
                               Text="{Binding EveryError}"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- WHAT section. -->
            <StackPanel Grid.Row="2" Spacing="3" Margin="0,12,0,0">
                <TextBlock Classes="SectionHeader" Text="WHAT (action)"/>

                <!-- Walk to row. -->
                <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="What" Content="Walk to"
                                 IsChecked="{Binding IsActionWalkTo, Mode=TwoWay}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding WalkToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsActionWalkTo}"
                             PlaceholderText="coord (1/297) or room name"/>
                    <TextBlock Grid.Column="2" Classes="Error"
                               Text="{Binding WalkToError}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Loop row. -->
                <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="What" Content="Start loop"
                                 IsChecked="{Binding IsActionLoop, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableLoopNames}"
                              SelectedItem="{Binding LoopName, Mode=TwoWay}"
                              IsEnabled="{Binding IsActionLoop}"
                              PlaceholderText="(select a saved loop)"/>
                    <TextBlock Grid.Column="2" Classes="Error"
                               Text="{Binding LoopError}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Auto-lair row. -->
                <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="What" Content="Auto-lair"
                                 IsChecked="{Binding IsActionAutoLair, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableAutoLairNames}"
                              SelectedItem="{Binding AutoLairSetupName, Mode=TwoWay}"
                              IsEnabled="{Binding IsActionAutoLair}"
                              PlaceholderText="(select a saved auto-lair setup)"/>
                    <TextBlock Grid.Column="2" Classes="Error"
                               Text="{Binding AutoLairError}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Command row. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <RadioButton Grid.Column="0" GroupName="What" Content="Command"
                                 VerticalAlignment="Top" Margin="0,4,0,0"
                                 IsChecked="{Binding IsActionCommand, Mode=TwoWay}"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBox Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsActionCommand}"
                                 AcceptsReturn="False"
                                 PlaceholderText="stat; who; abil 145^M" />
                        <TextBlock Classes="Hint"
                                   Text="Supports ^M and ; for multi-fire (each chunk sent as its own line)."/>
                        <TextBlock Classes="Error" Text="{Binding CommandError}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Spacer. -->
            <Border Grid.Row="3" Height="0"/>
            <Border Grid.Row="4" Height="0"/>

            <!-- Save / Cancel. -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Save" Width="100"
                        IsEnabled="{Binding CanSave}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True"/>
                <Button Content="Cancel" Width="100"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
