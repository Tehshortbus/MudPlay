<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="900"
             x:Class="FujinTerm.Views.Settings.CombatSectionView"
             x:DataType="vm:CombatSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <!-- No-profile banner. -->
            <Border IsVisible="{Binding !HasProfile}" Padding="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Combat"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit combat settings."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22" Spacing="4"
                        MaxWidth="800" HorizontalAlignment="Left">

                <!-- ============ Tab header ============ -->
                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="Wired now: target-selection, weapon-swap matrix (normal / alternate / backstab end-of-combat re-equip), min/max monsters gate. Spell-combat slots + BS attack path + polite-mode dispatch persist now; their engines land in follow-ups."/>

                <!-- The master on/off for auto-attack lives on
                     Settings → General → Auto-Combat (mirrored by the
                     toolbar Toggle button). This tab configures HOW
                     to attack, not WHETHER to. -->

                <Grid ColumnDefinitions="180,*" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Normal attack command"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding NormalAttackCommand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="220" HorizontalAlignment="Left"
                             ToolTip.Tip="Command sent each round to swing — default `a` (the canonical MajorMUD attack alias)."/>
                </Grid>

                <!-- ============ Weapon Combat ============ -->
                <TextBlock Classes="SectionHeader" Text="Weapon combat"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Normal weapon"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding NormalWeapon, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Primary weapon — main-hand. Item name from game data."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Normal off-hand"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding NormalOffHand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Off-hand pairing for the normal weapon (shield or weapon)."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Alternate weapon"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding AlternateWeapon, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Swap target — equipped when CombatManager decides to switch."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Alternate off-hand"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding AlternateOffHand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Off-hand pairing for the alternate weapon."/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="BS weapon"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding BackstabWeapon, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Equipped for the BS attempt round."/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="BS weapon off-hand"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding BackstabOffHand, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Off-hand worn alongside the BS weapon (often a shield, but any off-hand works)."/>
                </Grid>

                <!-- ============ Targeting ============ -->
                <TextBlock Classes="SectionHeader" Text="Targeting"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Target order"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <RadioButton GroupName="TargetOrder" Content="Normal"
                                     IsChecked="{Binding TargetOrderNormal, Mode=TwoWay}"
                                     ToolTip.Tip="Swing at the highest-priority monster first (priority from Monsters.json AttackPriority)."/>
                        <RadioButton GroupName="TargetOrder" Content="Reverse"
                                     IsChecked="{Binding TargetOrderReverse, Mode=TwoWay}"
                                     ToolTip.Tip="Swing at the lowest-priority monster first."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Attack timing"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding AttackTimingOptions}"
                              SelectedItem="{Binding AttackTiming, Mode=TwoWay}"
                              Width="220" HorizontalAlignment="Left"
                              ToolTip.Tip="Re-fire mechanism. Default = own cadence. Attack Last Party re-fires after every party member's announce; Attack Last Room drops the party filter (re-fire on anyone's announce); Attack After defers first swing until the named player announces."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel"
                               Text="Attack-after player name"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding AttackAfterPlayerName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding AttackAfterEnabled}"
                             Width="220" HorizontalAlignment="Left"
                             ToolTip.Tip="Only used when Attack Timing is Attack After. Defer first swing until this player announces; mirror their target."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Polite mode"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding PoliteModeOptions}"
                              SelectedItem="{Binding PoliteMode, Mode=TwoWay}"
                              Width="220" HorizontalAlignment="Left"
                              ToolTip.Tip="Behavior when a non-party player is fighting a monster we'd target. Off = attack regardless; WaitForOthers = pause; SkipRoom = continue walking; AttackDifferent = pick a different monster in the room."/>
                </Grid>

                <!-- ============ Backstab options ============ -->
                <TextBlock Classes="SectionHeader" Text="Backstab"/>
                <StackPanel Spacing="2">
                    <CheckBox Content="Do BS attacks"
                              IsChecked="{Binding DoBackstab, Mode=TwoWay}"
                              ToolTip.Tip="Off by default. Stealth-window gating handled by StealthManager (PR 9.F) once it lands."/>
                    <CheckBox Content="Don't BS if multi-attack room spell is firing"
                              IsChecked="{Binding SkipBackstabIfMultiAttack, Mode=TwoWay}"
                              ToolTip.Tip="Skip the BS attempt when the multi-attack room spell is going off this round."/>
                    <CheckBox Content="Run if BS fails"
                              IsChecked="{Binding RunIfBackstabFails, Mode=TwoWay}"
                              ToolTip.Tip="Trigger flee behaviour on a failed BS roll."/>
                </StackPanel>

                <!-- ============ Room-skip + failure ============ -->
                <TextBlock Classes="SectionHeader" Text="Room thresholds"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Min. monsters"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding MinMonstersInRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="20" Width="120" HorizontalAlignment="Left"
                                   ToolTip.Tip="Skip the room if fewer than this many hostiles are present. Range 0–20."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Max. monsters"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding MaxMonstersInRoom, Mode=TwoWay}"
                                   Minimum="1" Maximum="20" Width="120" HorizontalAlignment="Left"
                                   ToolTip.Tip="Skip the room if more than this many hostiles are present. Range 1–20."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Run distance"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding RunDistance, Mode=TwoWay}"
                                   Minimum="1" Maximum="100" Width="120" HorizontalAlignment="Left"
                                   ToolTip.Tip="Rooms to flee before re-evaluating. Range 1–100."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="No-effect threshold"/>
                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                   Value="{Binding NoEffectFailureThreshold, Mode=TwoWay}"
                                   Minimum="1" Maximum="20" Width="120" HorizontalAlignment="Left"
                                   ToolTip.Tip="Consecutive 'no effect' lines that move a target to the room-scoped unhittable set. Canonical-species dedup applies (nasty giant rat and giant rat share)."/>
                </Grid>

                <!-- ============ Spell Combat ============ -->
                <TextBlock Classes="SectionHeader" Text="Spell combat"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <TextBlock Classes="FieldLabel" Text="Minimum mana per cast:"/>
                    <RadioButton GroupName="SpellManaUnit" Content="Percentage"
                                 IsChecked="{Binding SpellManaModePercentage, Mode=TwoWay}"
                                 ToolTip.Tip="Min mana columns below are read as % of MaxMa / MaxKai."/>
                    <RadioButton GroupName="SpellManaUnit" Content="Value"
                                 IsChecked="{Binding SpellManaModeAbsolute, Mode=TwoWay}"
                                 ToolTip.Tip="Min mana columns below are read as absolute MA / KAI."/>
                </StackPanel>

                <!-- Spell-row column headers. -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0"/>
                    <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="Spell"/>
                    <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="Min enemies"/>
                    <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="Max casts"/>
                    <TextBlock Grid.Column="4" Classes="ColumnHeader" Text="Min mana per cast"/>
                </Grid>

                <!-- Multi-attack (room spell). -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Multi-attack"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding MultiAttackSpellName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Multi-target room spell to fire."/>
                    <NumericUpDown Grid.Column="2"
                                   Value="{Binding MultiAttackMinEnemies, Mode=TwoWay}"
                                   Minimum="0" Maximum="20" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Only cast when at least this many hostiles are present."/>
                    <NumericUpDown Grid.Column="3"
                                   Value="{Binding MultiAttackMaxCastsPerRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Cap on back-to-back fires."/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding MultiAttackMinManaPerCast, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000" Width="130" HorizontalAlignment="Left"
                                   ToolTip.Tip="Minimum mana required to cast — % or absolute per the toggle above."/>
                </Grid>

                <!-- Debuff (AOE). -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Debuff (AOE)"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AreaDebuffSpellName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Area-effect debuff (e.g. blind-room, curse-room)."/>
                    <NumericUpDown Grid.Column="2"
                                   Value="{Binding AreaDebuffMinEnemies, Mode=TwoWay}"
                                   Minimum="0" Maximum="20" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Only cast when at least this many hostiles are present."/>
                    <NumericUpDown Grid.Column="3"
                                   Value="{Binding AreaDebuffMaxCastsPerRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Cap on back-to-back fires."/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding AreaDebuffMinManaPerCast, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000" Width="130" HorizontalAlignment="Left"
                                   ToolTip.Tip="Minimum mana required to cast."/>
                </Grid>

                <!-- Debuff (single target — no Min enemies). -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Debuff (single target)"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SingleTargetDebuffSpellName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Single-target debuff (e.g. weakness, slow)."/>
                    <TextBlock Grid.Column="2" Classes="FieldLabel" Text="—" HorizontalAlignment="Center"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               ToolTip.Tip="Single-target — Min enemies doesn't apply."/>
                    <NumericUpDown Grid.Column="3"
                                   Value="{Binding SingleTargetDebuffMaxCastsPerRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Re-cast cap for the active fight."/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding SingleTargetDebuffMinManaPerCast, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000" Width="130" HorizontalAlignment="Left"
                                   ToolTip.Tip="Minimum mana required to cast."/>
                </Grid>

                <!-- Normal attack spell (single-target — no Min enemies). -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Normal attack spell"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding NormalAttackSpellName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Primary single-target damage spell."/>
                    <TextBlock Grid.Column="2" Classes="FieldLabel" Text="—" HorizontalAlignment="Center"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               ToolTip.Tip="Single-target — Min enemies doesn't apply."/>
                    <NumericUpDown Grid.Column="3"
                                   Value="{Binding NormalAttackSpellMaxCastsPerRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Cap on back-to-back fires."/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding NormalAttackSpellMinManaPerCast, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000" Width="130" HorizontalAlignment="Left"
                                   ToolTip.Tip="Minimum mana required to cast."/>
                </Grid>

                <!-- Alternate attack spell (single-target — no Min enemies). -->
                <Grid ColumnDefinitions="160,260,110,110,140" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Alternate attack spell"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AlternateAttackSpellName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Width="260" HorizontalAlignment="Left"
                             ToolTip.Tip="Fallback / second-choice damage spell — used when the normal pick can't fire."/>
                    <TextBlock Grid.Column="2" Classes="FieldLabel" Text="—" HorizontalAlignment="Center"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               ToolTip.Tip="Single-target — Min enemies doesn't apply."/>
                    <NumericUpDown Grid.Column="3"
                                   Value="{Binding AlternateAttackSpellMaxCastsPerRoom, Mode=TwoWay}"
                                   Minimum="0" Maximum="100" Width="100" HorizontalAlignment="Left"
                                   ToolTip.Tip="Cap on back-to-back fires."/>
                    <NumericUpDown Grid.Column="4"
                                   Value="{Binding AlternateAttackSpellMinManaPerCast, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000" Width="130" HorizontalAlignment="Left"
                                   ToolTip.Tip="Minimum mana required to cast."/>
                </Grid>

                <!-- ============ Display ============ -->
                <TextBlock Classes="SectionHeader" Text="Display"/>
                <CheckBox Content="Show combat round totals"
                          IsChecked="{Binding ShowCombatRoundTotals, Mode=TwoWay}"
                          ToolTip.Tip="Append the per-round damage roll-up to the terminal canvas after each round. CombatManager (PR 9.A)."/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
