<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="FujinTerm.Views.Settings.CashSectionView"
             x:DataType="vm:CashSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <Grid>
            <!-- No-profile banner. -->
            <Border IsVisible="{Binding !HasProfile}" Padding="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Cash"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit cash policy."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22" Spacing="4"
                        MaxWidth="720" HorizontalAlignment="Left">

                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- ============ Per-currency policy ============ -->
                <TextBlock Classes="SectionHeader" Text="Per-currency policy"/>
                <TextBlock Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="Collect → CashManager sends `get all &lt;coin&gt;` on every cash-on-ground line. Ignore → leave it. Discard → don't pick up; held-cash drop logic ships with the discard handler follow-up."/>

                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Copper"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding CopperPolicy, Mode=TwoWay}"
                              Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Silver"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding SilverPolicy, Mode=TwoWay}"
                              Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Gold"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding GoldPolicy, Mode=TwoWay}"
                              Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Platinum"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding PlatinumPolicy, Mode=TwoWay}"
                              Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Runic"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              ItemsSource="{Binding PolicyChoices}"
                              SelectedItem="{Binding RunicPolicy, Mode=TwoWay}"
                              Width="180" HorizontalAlignment="Left"/>
                </Grid>

                <!-- ============ Auto-deposit ============ -->
                <TextBlock Classes="SectionHeader" Text="Auto-deposit"/>
                <TextBlock Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="When held wealth (gold-equivalent) exceeds the threshold, CashManager fires the AutoDepositRequested event. 0 disables the trigger. Walker-driven reroute to the bank ships as a follow-up; v1 only signals."/>

                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel"
                               Text="Auto-deposit if wealth exceeds"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding AutoDepositIfWealthExceeds, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="200" HorizontalAlignment="Left"
                                   ToolTip.Tip="0 = disabled. Triggers AutoDepositRequested once per crossing; re-arms when wealth drops back below."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel"
                               Text="Minimum cash on hand"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding MinimumCashOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="200" HorizontalAlignment="Left"
                                   ToolTip.Tip="Don't deposit below this floor. Honoured by the (follow-up) auto-deposit walker reroute."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel"
                               Text="Bank room key"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding BankRoomKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             PlaceholderText="(picked from Phase 5 Shops where ShopType == 7)"
                             Width="320" HorizontalAlignment="Left"
                             ToolTip.Tip="Map/room reference for the bank. v1 stores it; the reroute that uses it ships as a follow-up."/>
                </Grid>

                <!-- ============ Stash rooms — per-currency keep ============ -->
                <TextBlock Classes="SectionHeader" Text="Stash rooms — keep on hand"/>
                <TextBlock Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Text="At any room marked as a stash (right-click on the Navigation map → Toggle: Stash room), StashRoomManager dumps the excess of each currency above the floor below via `hide N &lt;coin&gt;`. 0 means dump all of that currency at every stash."/>

                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Keep copper"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                   Value="{Binding KeepCopperOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Keep silver"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding KeepSilverOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Keep gold"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1"
                                   Value="{Binding KeepGoldOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Keep platinum"/>
                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                   Value="{Binding KeepPlatinumOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="180" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Keep runic"/>
                    <NumericUpDown Grid.Row="4" Grid.Column="1"
                                   Value="{Binding KeepRunicOnHand, Mode=TwoWay}"
                                   Minimum="0" Maximum="100000000" Width="180" HorizontalAlignment="Left"/>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
