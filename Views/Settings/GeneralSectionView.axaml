<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="440"
             x:Class="MudPlay.Views.Settings.GeneralSectionView"
             x:DataType="vm:GeneralSectionViewModel">

    <UserControl.Resources>
        <!-- One of the 16 terminal colours: its name, a swatch that opens a picker
             under the Custom scheme, a sample of text in it on the terminal's
             black, and (Custom only) a Reset back to the standard colour. Kept
             narrow enough that two of these, Reset included, sit side by side in
             the section's 640 width. -->
        <DataTemplate x:Key="TerminalColorRow" x:DataType="vm:TerminalColorRowViewModel">
            <Grid ColumnDefinitions="104,Auto,Auto,Auto" Margin="0,3">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="{Binding Label}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Padding="2" VerticalAlignment="Center"
                        IsEnabled="{Binding CanEdit}"
                        ToolTip.Tip="This colour as it is drawn. Under Custom, click to pick another.">
                    <Border Width="38" Height="18"
                            Background="{Binding Brush}"
                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerSm}"/>
                    <Button.Flyout>
                        <Flyout>
                            <LayoutTransformControl>
                                <LayoutTransformControl.LayoutTransform>
                                    <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                </LayoutTransformControl.LayoutTransform>
                                <ColorView Color="{Binding Color, Mode=TwoWay}"
                                           IsAlphaEnabled="False"/>
                            </LayoutTransformControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border Grid.Column="2" Background="Black" Margin="6,0,0,0" Padding="6,2"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource CornerSm}">
                    <TextBlock Text="Sample" Foreground="{Binding Brush}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Button Grid.Column="3" Content="Reset" Margin="6,0,0,0" Padding="8,3"
                        VerticalAlignment="Center"
                        IsVisible="{Binding CanEdit}"
                        Command="{Binding ResetCommand}"
                        ToolTip.Tip="Put this colour back to the standard one."/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style Selector="TextBlock.ColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>

            <!-- "No profile loaded" banner — shows when HasProfile is false. -->
            <Border IsVisible="{Binding !HasProfile}"
                    Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="General"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit General settings — the character-scoped settings here live on the active character."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Editor — visible when a profile is loaded. Grouped by persistence
                 tier: everything under "Character profile settings" saves to the
                 loaded character; the "Global client settings" block at the bottom
                 is app-wide, shared by every character on this install. -->
            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22"
                        Spacing="6"
                        MaxWidth="640"
                        HorizontalAlignment="Left">

                <!-- ============================================================
                     Character profile settings (per-character).
                     ============================================================ -->
                <TextBlock Classes="SettingsSectionBanner first" Text="Character profile settings"/>
                <TextBlock Classes="SettingsSectionSub"
                           Text="Saved to the loaded character — each character keeps its own copy."/>
                <Border Classes="SettingsSectionRule"/>

                <TextBlock Classes="SectionHeader" Text="Terminal font"/>

                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontFamilyOptions}"
                              SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                              ToolTip.Tip="Font the terminal canvas renders with. MX437 is the bundled CP437 bitmap font that matches classic BBS output; JetBrains Mono is a modern monospace with box-drawing coverage. Every monospace font installed on your system is listed below them. Applies on Save.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontFamilyOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Font size:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontSizeOptions}"
                              SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"
                              ToolTip.Tip="Terminal canvas font size in points. Applies on Save.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontSizeOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Classes="SectionHeader" Text="Navigation tooltip font"/>

                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Font:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontFamilyOptions}"
                              SelectedItem="{Binding SelectedNavTooltipFontFamily, Mode=TwoWay}"
                              ToolTip.Tip="Font the Navigation map's room hover-tooltip renders with. Defaults to the same MX437 bitmap face the tooltip has always used. Applies to the next hover after Save.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontFamilyOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Font size:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding NavTooltipFontSizeOptions}"
                              SelectedItem="{Binding SelectedNavTooltipFontSize, Mode=TwoWay}"
                              ToolTip.Tip="Point size of the Navigation map's room hover-tooltip text. Applies to the next hover after Save.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontSizeOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding ScaleTerminalToWindow, Mode=TwoWay}"
                          Content="Scale terminal output to fill the window"
                          ToolTip.Tip="When checked, the terminal font grows to fill the window while keeping the fixed 80×25 (or configured) cell grid — no extra rows or columns, just a larger, still-crisp picture. Capped so it never becomes absurdly large. When unchecked, the grid renders at its configured font size and sits centred with empty margin in a larger window."/>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding TypeToTerminalFromOtherWindows, Mode=TwoWay}"
                          Content="Keep typing directed at the terminal when other windows are open"
                          ToolTip.Tip="When checked (default), keystrokes typed while another window (settings, editors, etc.) is focused fall through to the terminal — so you can keep sending commands with a window open — UNLESS you're editing a text field in that window, or the key is one the window needs (Tab, Escape, menu shortcuts). When unchecked, keys go only to the focused window (classic behaviour)."/>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding InventoryTabCompleteEnabled, Mode=TwoWay}"
                          Content="Tab-complete inventory item names while typing"
                          ToolTip.Tip="When checked (default), pressing Tab while composing a command in the terminal or the Conversation window completes the word under the caret against your carried, worn, and key-ring item names — press Tab again (or Shift+Tab) to cycle through the other matches. When unchecked, Tab keeps its old behaviour in both places. Never active while a full-screen form (e.g. the trainer stats screen) owns the keyboard."/>

                <TextBlock Classes="SectionHeader" Text="Buff Watchdog layout"/>
                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Config panel:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              Width="240"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding BuffWatchdogLayoutOptions}"
                              SelectedItem="{Binding SelectedBuffWatchdogLayout, Mode=TwoWay}"
                              ToolTip.Tip="Where the buff-config table sits in the Buff Watchdog window relative to the live timer bars — on top, on the bottom, or docked to the left / right. Applies on Save; an open Buff Watchdog reflows immediately.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuffLayoutOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Classes="SectionHeader" Text="Initial"/>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Default task:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Top" Margin="0,2,0,0"/>

                    <!-- Shared-column inner Grid so the two pickers line up at the
                         same X regardless of radio-label width. Column 0 sizes to
                         the widest radio + label across all three rows. -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="Auto,*">
                        <RadioButton Grid.Row="0" Grid.Column="0"
                                     GroupName="DefaultTask"
                                     IsChecked="{Binding IsTaskDoNothing, Mode=TwoWay}"
                                     Content="Do nothing"
                                     ToolTip.Tip="Leave the client idle once you enter the game — the classic behaviour. Nothing starts automatically."
                                     Margin="0,0,8,4"/>

                        <RadioButton Grid.Row="1" Grid.Column="0"
                                     GroupName="DefaultTask"
                                     IsChecked="{Binding IsTaskBeginLoop, Mode=TwoWay}"
                                     Content="Begin looping"
                                     ToolTip.Tip="On entering the game, start the selected loop — same as hitting Run on it in the Navigation window (it routes to the nearest waypoint first if you're not already on the loop). If you were in a party before a reconnect, it waits your &quot;if leading, wait&quot; window first to give the party time to reform."
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding LoopNames}"
                                  SelectedItem="{Binding DefaultLoopName, Mode=TwoWay}"
                                  PlaceholderText="Pick a saved loop"
                                  IsEnabled="{Binding IsTaskBeginLoop}"
                                  ToolTip.Tip="Saved loops from the active game-data set. Loops are shared across characters on the set; the one picked here starts on game entry."
                                  Margin="0,0,0,4"/>

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     GroupName="DefaultTask"
                                     IsChecked="{Binding IsTaskBeginAutoLair, Mode=TwoWay}"
                                     Content="Begin Auto-Lair"
                                     ToolTip.Tip="On entering the game, start the selected Auto-Lair setup — same as Run on it in the Navigation window. Honours the same party-reform wait on a reconnect as Begin looping."
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding AutoLairNames}"
                                  SelectedItem="{Binding DefaultAutoLairName, Mode=TwoWay}"
                                  PlaceholderText="Pick a saved Auto-Lair"
                                  IsEnabled="{Binding IsTaskBeginAutoLair}"
                                  ToolTip.Tip="Saved Auto-Lair setups from the active game-data set. The one picked here starts on game entry."/>
                    </Grid>
                </Grid>

                <CheckBox Margin="0,8,0,0"
                          IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                          Content="Auto-connect when profile loads"
                          ToolTip.Tip="When checked, MudPlay dials the profile's pinned BBS immediately after the profile loads (skipped if you're already connected or there's no BBS pinned yet)."/>

                <CheckBox IsChecked="{Binding LoadLastRanLoop, Mode=TwoWay}"
                          Content="Load last ran loop into the Loop builder"
                          ToolTip.Tip="When checked (the default), hitting the Navigation window's Loop button pre-loads the last loop you ran this session — ready to Run again or re-Save, or wipe with Clear all to build a fresh one. Unchecked, the Loop button opens an empty builder. The @loop last remote command re-runs the last loop either way."/>

                <CheckBox IsChecked="{Binding AutoSyncQuestFlagsOnLogin, Mode=TwoWay}"
                          Content="Auto-detect completed quests from flags on login"
                          ToolTip.Tip="When checked, MudPlay reads your live quest-flag values right after login and auto-marks any quest whose flag has reached its complete value (in the Player Workshop → Quest Status tab), then sends the availability announce so freshly-completed quests drop off it. It only ever MARKS complete, never un-marks. Paradigm queries each incomplete quest's flag with `abil`; Stock uses the one-shot `sys god &lt;name&gt; abil`, which needs sys-god powers granted for the BBS (Settings → BBS + Display). Off by default because it sends commands on connect. The complete value the sync looks for is shown (and editable) per quest in the Quest editor."/>

                <CheckBox IsChecked="{Binding BackupOnSave, Mode=TwoWay}"
                          Content="Backup profile when making changes"
                          ToolTip.Tip="Copy the existing profile JSON to {name}.json.bak before each save."/>

                <!-- Player auto-delete window moved to Settings → Other per user direction. -->

                <!-- Auto-engine master switches: one checkbox per automation engine,
                     each the character's default on/off state for it. The IsXxxWired
                     flag on the VM gates the checkbox; all engines are wired today. -->
                <StackPanel Margin="0,16,0,0" Spacing="2">
                    <TextBlock Classes="ColumnHeader" Text="Auto-Engines base modes"
                               ToolTip.Tip="Your character's default engine states. Applied to the live toolbar toggles on profile load and once at the first start of a loop / auto-lair circuit — so you can flip toggles live to travel to a circuit (e.g. combat off to sprint there) and settle into it with these defaults restored, toolbar badges and all. Independent of the toolbar: flipping a toolbar toggle never changes these boxes."/>
                    <CheckBox IsChecked="{Binding AmAutoCombat,   Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoCombatWired}"
                              Content="Auto-Combat"
                              ToolTip.Tip="Master switch for auto-attack — target picking, swings, and attack-order re-fire."/>
                    <CheckBox IsChecked="{Binding AmAutoNuke,     Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoNukeWired}"
                              Content="Auto-Nuke"
                              ToolTip.Tip="Master switch for combat damage spells (the attack-spell cascade)."/>
                    <CheckBox IsChecked="{Binding AmAutoHeal,     Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoHealWired}"
                              Content="Auto-Heal"
                              ToolTip.Tip="Master switch for healing: heal and cure casts on yourself and your party, between-round debuffs, and aiding a downed party member."/>
                    <CheckBox IsChecked="{Binding AmAutoRest,     Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoRestWired}"
                              Content="Auto-Rest"
                              ToolTip.Tip="Master switch for resting: stopping to rest or meditate when HP or mana drops below your rest thresholds. Fleeing keeps working while either Auto-Heal or Auto-Rest is on; the emergency hangup needs Auto-Rest."/>
                    <CheckBox IsChecked="{Binding AmAutoBless,    Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoBlessWired}"
                              Content="Auto-Bless"
                              ToolTip.Tip="Master switch for buff casting."/>
                    <CheckBox IsChecked="{Binding AmAutoLight,    Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoLightWired}"
                              Content="Auto-Light"
                              ToolTip.Tip="Keep a light ready for dark rooms on your route: ready a carried light, buy one (Auto-Light tab), or cast your room-light spell."/>
                    <CheckBox IsChecked="{Binding AmAutoGetItems, Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoGetItemsWired}"
                              Content="Auto-Get Items"
                              ToolTip.Tip="Auto-collect loot dropped on the ground."/>
                    <CheckBox IsChecked="{Binding AmAutoGetCash,  Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoGetCashWired}"
                              Content="Auto-Get Cash"
                              ToolTip.Tip="Master switch for cash handling — runic / coin pickup and deposit reroute."/>
                    <CheckBox IsChecked="{Binding AmAutoSneak,    Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoSneakWired}"
                              Content="Auto-Sneak"
                              ToolTip.Tip="Auto-sneak between moves."/>
                    <CheckBox IsChecked="{Binding AmAutoHide,     Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoHideWired}"
                              Content="Auto-Hide"
                              ToolTip.Tip="Auto-hide while stationary."/>
                    <CheckBox IsChecked="{Binding AmAutoSearch,   Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoSearchWired}"
                              Content="Auto-Search"
                              ToolTip.Tip="Walker auto-search for hidden exits (a bare `sea` on room entry)."/>
                    <CheckBox IsChecked="{Binding AmAutoTrain,    Mode=TwoWay}"
                              IsEnabled="{Binding IsAutoTrainWired}"
                              Content="Auto-Train"
                              ToolTip.Tip="Detour to a trainer and train when a level-up is available during a loop/auto-lair. Mirrors the Auto-train toggle on the Player Workshop's CP Allocation tab."/>
                </StackPanel>

                <!-- Hang-up carve-out for the master switch. With the switch
                     off nothing automatic responds; this opt-in keeps the
                     automatic hang-ups (low HP, a received @panic, the PvP
                     hang-up actions, a Hangup-relationship monster) live.
                     Consumed live via GeneralSettings.AllowHangupInAllOffMode. -->
                <CheckBox Margin="0,12,0,0"
                          IsChecked="{Binding AllowHangupInAllOffMode, Mode=TwoWay}"
                          Content="Allow hangup in all-off mode"
                          ToolTip.Tip="All-off mode is the master switch (Auto-All) being off; unticking the auto toggles one by one is not it. When checked, the automatic hang-ups still fire with the master switch off: low HP, a received @panic, the PvP hang-up actions and a Hangup-relationship monster. Unchecked (default), nothing hangs up on its own while the switch is off. Disable Hangups still stops them all."/>

                <!-- Re-enable auto-actions on reconnect. One checkbox per
                     auto-action (1-to-1 with the auto-engine switches above).
                     On a reconnect — a TCP connect that follows a prior
                     in-session disconnect — each ticked action is flipped
                     back ON. Default all unchecked: the redial respects
                     whatever state the engines were left in unless the user
                     opts a specific action into auto-revival. First connect
                     of an app session is never a reconnect. -->
                <StackPanel Margin="0,16,0,0" Spacing="2">
                    <TextBlock Classes="ColumnHeader" Text="Re-enable on reconnect"/>
                    <CheckBox IsChecked="{Binding ReEnableAutoCombatOnReconnect, Mode=TwoWay}"
                              Content="Auto-Combat"
                              ToolTip.Tip="When checked: if you disabled Auto-Combat during a session and then reconnect, it's flipped back on automatically."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoNukeOnReconnect, Mode=TwoWay}"
                              Content="Auto-Nuke"
                              ToolTip.Tip="When checked: Auto-Nuke is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoHealRestOnReconnect, Mode=TwoWay}"
                              Content="Auto-Heal and Auto-Rest"
                              ToolTip.Tip="When checked: Auto-Heal and Auto-Rest are both re-enabled on reconnect if either was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoBlessOnReconnect, Mode=TwoWay}"
                              Content="Auto-Bless"
                              ToolTip.Tip="When checked: Auto-Bless is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoLightOnReconnect, Mode=TwoWay}"
                              Content="Auto-Light"
                              ToolTip.Tip="When checked: Auto-Light is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoGetItemsOnReconnect, Mode=TwoWay}"
                              Content="Auto-Get-Items"
                              ToolTip.Tip="When checked: Auto-Get-Items is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoGetCashOnReconnect, Mode=TwoWay}"
                              Content="Auto-Get-Cash"
                              ToolTip.Tip="When checked: Auto-Get-Cash is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoSneakOnReconnect, Mode=TwoWay}"
                              Content="Auto-Sneak"
                              ToolTip.Tip="When checked: Auto-Sneak is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoHideOnReconnect, Mode=TwoWay}"
                              Content="Auto-Hide"
                              ToolTip.Tip="When checked: Auto-Hide is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoSearchOnReconnect, Mode=TwoWay}"
                              Content="Auto-Search"
                              ToolTip.Tip="When checked: Auto-Search is re-enabled on reconnect if it was disabled during the session."/>
                    <CheckBox IsChecked="{Binding ReEnableAutoTrainOnReconnect, Mode=TwoWay}"
                              Content="Auto-Train"
                              ToolTip.Tip="When checked: Auto-Train is re-enabled on reconnect if it was disabled during the session."/>
                </StackPanel>

                <!-- ============================================================
                     Global client settings (app-wide, not per-character).
                     Nav-line appearance + the startup-animation / snap-windows
                     toggles persist to GlobalSettings; the data-folder location
                     is a machine-level install pointer (closest to app-wide, so
                     it lives here too).
                     ============================================================ -->
                <TextBlock Classes="SettingsSectionBanner" Text="Global client settings"/>
                <TextBlock Classes="SettingsSectionSub"
                           Text="Apply to the whole app / this install, regardless of which BBS or character is active."/>
                <Border Classes="SettingsSectionRule"/>

                <TextBlock Classes="SectionHeader" Text="Directories"/>

                <Grid ColumnDefinitions="120,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Data files:"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DataFilesPath, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="{StaticResource FontSizeSm}"
                             VerticalAlignment="Center"
                             ToolTip.Tip="Defaults to the platform user-data path (XDG on Linux, %AppData% on Windows, Application Support on macOS). Use Change… to move the folder elsewhere — a tiny pointer file at the platform-config location remembers the new path on next launch. This is a machine-level location, not a per-character/BBS setting."/>
                    <Button Grid.Column="2"
                            Content="Open Data folder…"
                            Command="{Binding OpenDataFolderCommand}"
                            Margin="8,0,0,0"/>
                    <Button Grid.Column="3"
                            Content="Change…"
                            Command="{Binding ChangeDataFolderCommand}"
                            Margin="8,0,0,0"
                            ToolTip.Tip="Move every file under the data folder to a different location; the app restarts at the new path."/>
                </Grid>

                <CheckBox Margin="0,8,0,0"
                          IsChecked="{Binding ShowStartupMudAnimation, Mode=TwoWay}"
                          Content="Show the mud-throwing startup animation"
                          ToolTip.Tip="When checked (default), an animated scene plays on the terminal at startup until you connect or load a profile. When unchecked, only the static startup header (the MudPlay title and byline) shows. This is an install-wide preference — it's saved to the default profile and read at startup regardless of which character auto-loads, so turning it off stays off across launches and profiles. Applies immediately on Apply — a splash that's currently playing stops on the spot."/>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding SnapWindows, Mode=TwoWay}"
                          Content="Snap windows together"
                          ToolTip.Tip="When checked (default), MudPlay's panel windows — Conversation, Party, Buff Watchdog, Player Workshop, Navigation, Spell Book, Session Stats — snap flush to each other's edges as you drag them near, and dragging the main window carries the whole snapped cluster with it. Grab any other panel to pull it off freely. When unchecked, every window floats independently. Install-wide preference; applies on Apply."/>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding DrawWithGraphicsCard, Mode=TwoWay}"
                          Content="Draw windows with the graphics card (after a restart)"
                          ToolTip.Tip="When unchecked (default), MudPlay draws its windows with the CPU, which costs a few percent of one core and saves the roughly 120 MB of memory the graphics driver takes in every running client. When checked, the graphics card draws them, falling back to the CPU if its driver won't start. The renderer is picked as MudPlay starts, so a change takes effect the next time each client launches. Install-wide preference."/>

                <CheckBox Margin="0,2,0,0"
                          IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"
                          Content="Check for updates automatically"
                          ToolTip.Tip="When checked (default), MudPlay asks GitHub whether a newer build has been published — each time it launches, and again at 9am and 9pm so a client left running for days doesn't sit on a stale answer. It only NOTIFIES — a red 'UPDATE AVAILABLE!!!' banner flanks the title on the startup splash, the same message scrolls across the window's title bar for as long as the update is waiting, and Help / Tools → Update the Client shows what's new. Nothing is ever downloaded or installed without you choosing Download &amp; Restart there. When unchecked, no check runs on its own and you can still check manually any time from the Help or Tools menu. Install-wide preference; applies on Apply."/>

                <CheckBox Margin="0,10,0,0"
                          IsChecked="{Binding LocalApiEnabled, Mode=TwoWay}"
                          Content="Local control API (for diagnostics / automation)"
                          ToolTip.Tip="When checked, MudPlay serves a small HTTP API on 127.0.0.1 exposing live client state, the program log, the terminal scrollback, and the same sections a bug report captures — plus a live event stream — so a stuck or misbehaving client can be inspected while it's happening instead of reconstructed from a log tail afterwards. Bound to loopback ONLY: nothing outside this machine can reach it. A bearer token is required as well, because any local program (or a web page you're visiting) can otherwise reach 127.0.0.1. Off by default; install-wide; applies on Apply."/>

                <StackPanel Margin="22,4,0,0" Spacing="4" IsEnabled="{Binding LocalApiEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Port" VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                        <NumericUpDown Value="{Binding LocalApiPort}" Minimum="1024" Maximum="65535"
                                       Increment="1" FormatString="0" Width="120"
                                       ToolTip.Tip="Default 6683 (MMUD on a phone keypad). Change it only if something else already has the port — the status line below says so if the bind failed."/>
                        <Button Content="Show token" Command="{Binding ShowLocalApiTokenCommand}"
                                ToolTip.Tip="Reveal the bearer token to paste into a client (Authorization: Bearer &lt;token&gt;). It also lives in .apitoken inside the app data folder, owner-readable only. Revealed on request rather than shown here by default, since merely opening Settings shouldn't create or display a credential."/>
                        <Button Content="Regenerate" Command="{Binding RegenerateLocalApiTokenCommand}"
                                ToolTip.Tip="Replace the token, immediately invalidating anything still using the old one. Use this if it has been pasted somewhere it shouldn't have been."/>
                    </StackPanel>
                    <TextBox Text="{Binding LocalApiToken, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="{StaticResource FontMono}"
                             IsVisible="{Binding LocalApiToken, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             ToolTip.Tip="Select and copy this into your client's Authorization header."/>
                    <CheckBox Margin="0,4,0,0"
                              IsChecked="{Binding LocalApiAllowDestructive, Mode=TwoWay}"
                              Content="Allow destructive commands"
                              ToolTip.Tip="Off by default. While off, the API can read everything and drive ordinary things (walk somewhere, start a loop, flip an auto-toggle) but is refused anything that ends the session or can't be undone — @suicide, @hangup, @relog — and is refused the raw-line passthrough entirely, since a raw line can carry any command the game accepts. Turn this on only if you want an automated caller to be able to disconnect or kill your character. Which commands count is derived from their permission category, so a newly added command is classified automatically rather than defaulting to allowed."/>
                    <TextBlock Text="{Binding LocalApiStatus}" TextWrapping="Wrap"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               IsVisible="{Binding LocalApiStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"
                            ToolTip.Tip="How many recently-loaded characters the File menu lists (0–10). The client always remembers the last ten; this just controls how many show. Install-wide; applies on Apply.">
                    <TextBlock Text="Recent profiles shown in File menu"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding RecentProfilesShown, Mode=TwoWay}"
                                   Minimum="0" Maximum="{Binding MaxRecentProfilesShown}"
                                   Increment="1" FormatString="0" Width="120"/>
                </StackPanel>

                <TextBlock Classes="SectionHeader" Text="Navigation map: other floors"/>
                <TextBlock Text="How far the map's shadowed floors reach. Which floors are drawn (all, up only, down only, off) is the map's Overlays → Other floors chip."
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                ToolTip.Tip="How many floors up and down are drawn, counted in up/down steps from the floor shown (1–99, default 10). A mountain path climbs one step per floor (the Barren Hills climb is over 40), so raise this to see a long climb end to end; lower it to keep the map quiet.">
                        <TextBlock Text="Floors drawn up and down" VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                        <NumericUpDown Value="{Binding MapOtherFloorsLevels, Mode=TwoWay}"
                                       Minimum="1" Maximum="{Binding MaxMapOtherFloorsLevels}"
                                       Increment="1" FormatString="0" Width="120"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                ToolTip.Tip="Leave out a floor when more than this share of it would land on rooms already drawn (0–100%, default 50%). A floor stacked right over or under the one shown, such as a cave beneath a trail, is a different place, and drawing it only clutters the map. A floor with three or fewer rooms covered is always drawn, so a mountain path's small landings aren't lost. 100% draws every floor.">
                        <TextBlock Text="Leave out a floor that overlaps more than (%)" VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeFgSecBrush}"/>
                        <NumericUpDown Value="{Binding MapOtherFloorsMaxOverlapPercent, Mode=TwoWay}"
                                       Minimum="0" Maximum="100"
                                       Increment="5" FormatString="0" Width="120"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding MapRouteLinesOnOtherFloors, Mode=TwoWay}"
                              Content="Draw route lines on other floors"
                              ToolTip.Tip="When checked (default), a route line runs on through the shadowed floors' rooms. The game doesn't always lay two floors out so they line up, so a route crossing between them can draw as a long diagonal; uncheck this to keep route lines to the floor shown, broken off where the route leaves it. Install-wide; applies on Apply."/>
                </StackPanel>

                <TextBlock Classes="SectionHeader" Text="Navigation line appearance"/>
                <TextBlock Text="Colour and thickness for each route line drawn on the map. Applies to every character."
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding NavLineRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavLineStyleRowViewModel">
                            <Grid ColumnDefinitions="210,Auto,Auto,Auto" Margin="0,3">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="{Binding Label}"
                                           VerticalAlignment="Center"/>

                                <!-- Colour picker: swatch button opens a ColorView flyout. -->
                                <Button Grid.Column="1" Padding="2" VerticalAlignment="Center"
                                        ToolTip.Tip="Line colour. Click to pick.">
                                    <Border Width="46" Height="18"
                                            Background="{Binding Swatch}"
                                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSm}"/>
                                    <Button.Flyout>
                                        <Flyout>
                                            <LayoutTransformControl>
                                                <LayoutTransformControl.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                </LayoutTransformControl.LayoutTransform>
                                                <ColorView Color="{Binding Color, Mode=TwoWay}"
                                                           IsAlphaEnabled="False"/>
                                            </LayoutTransformControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Thickness -->
                                <NumericUpDown Grid.Column="2" Width="120" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Minimum="{Binding MinThickness}"
                                               Maximum="{Binding MaxThickness}"
                                               Increment="0.5"
                                               FormatString="0.0"
                                               Value="{Binding Thickness, Mode=TwoWay}"
                                               ToolTip.Tip="Line thickness in pixels."/>

                                <Button Grid.Column="3" Content="Reset" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ResetCommand}"
                                        ToolTip.Tip="Reset this line's colour and thickness to the default."/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Restore Defaults" Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding RestoreNavLineDefaultsCommand}"
                        ToolTip.Tip="Reset every navigation line's colour and thickness to the factory defaults."/>

                <!-- ============================================================
                     Visual impairment: how the 16 base ANSI colours are drawn.
                     Global tier; pushed to the terminal's palette on Apply.
                     ============================================================ -->
                <TextBlock Classes="SectionHeader" Text="Visual impairment: terminal colours"/>
                <TextBlock Text="How the 16 colours the game uses are drawn in the terminal and the backscroll. Pick the choice made for a kind of colour blindness, or Custom to set each colour yourself. Only how a colour looks changes; nothing the client reads from the game is affected. Applies to every character."
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ContentControl Content="{Binding TerminalColors}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:TerminalColorsEditorViewModel">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton GroupName="TerminalColorScheme" Margin="0,0,18,4"
                                                 IsChecked="{Binding IsStandard, Mode=TwoWay}"
                                                 Content="Default"
                                                 ToolTip.Tip="The standard colours, as the terminal has always drawn them."/>
                                    <RadioButton GroupName="TerminalColorScheme" Margin="0,0,18,4"
                                                 IsChecked="{Binding IsDeuteranopia, Mode=TwoWay}"
                                                 Content="Deuteranopia"
                                                 ToolTip.Tip="Red-green colour blindness of the green-weak kind, the most common. Under the standard colours green and yellow, and yellow and bright red, are hard to tell apart."/>
                                    <RadioButton GroupName="TerminalColorScheme" Margin="0,0,18,4"
                                                 IsChecked="{Binding IsProtanopia, Mode=TwoWay}"
                                                 Content="Protanopia"
                                                 ToolTip.Tip="Red-green colour blindness of the red-weak kind. Under the standard colours green and yellow look the same, and red is very dim."/>
                                    <RadioButton GroupName="TerminalColorScheme" Margin="0,0,18,4"
                                                 IsChecked="{Binding IsTritanopia, Mode=TwoWay}"
                                                 Content="Tritanopia"
                                                 ToolTip.Tip="Blue-yellow colour blindness. Under the standard colours green and cyan are hard to tell apart."/>
                                    <RadioButton GroupName="TerminalColorScheme" Margin="0,0,18,4"
                                                 IsChecked="{Binding IsCustom, Mode=TwoWay}"
                                                 Content="Custom"
                                                 ToolTip.Tip="Your own colours. Starts from the choice you were looking at, and is kept if you pick another choice and come back."/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Hint}"
                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <!-- Normal colours on the left, bright on the right, for
                                     every choice. A Grid, not a wrapping panel: the
                                     Reset buttons Custom adds must not drop the bright
                                     column underneath. -->
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding NormalRows}"
                                                  Margin="0,0,20,0"
                                                  ItemTemplate="{StaticResource TerminalColorRow}"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding BrightRows}"
                                                  ItemTemplate="{StaticResource TerminalColorRow}"/>
                                </Grid>
                                <Button Content="Restore standard colours" Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding IsCustom}"
                                        Command="{Binding RestoreStandardColorsCommand}"
                                        ToolTip.Tip="Put every one of your own colours back to the standard colour."/>
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
