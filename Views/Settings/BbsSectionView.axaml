<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.Settings"
             xmlns:settings="using:MudPlay.Views.Settings"
             xmlns:gmcp="using:MudPlay.Game.Gmcp"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="420"
             x:Class="MudPlay.Views.Settings.BbsSectionView"
             x:DataType="vm:BbsSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.GroupHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <!-- Section-tier banners (SettingsSectionBanner / …Sub / …Rule) are shared
             app-wide in Themes/Controls.axaml so every Settings tab reads the same. -->
        <Style Selector="TextBlock.CredHint">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.CredHint.HintWarning">
            <Setter Property="Foreground" Value="#E55353"/>
        </Style>
        <!-- First-run tour: outline the host/port fields when the tour points here. -->
        <Style Selector="TextBox.tutTarget">
            <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="NumericUpDown.tutTarget">
            <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,1,*">

        <!-- ============ Left rail: BBS list ============ -->
        <DockPanel Grid.Column="0" Margin="12,12,8,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
                <TextBlock Text="Saved BBSes"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="Select a BBS to edit its details. Adding, removing, renaming, and reassigning a character's BBS now live in Profile Management."
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
                <Button Content="Open Profile Management"
                        HorizontalAlignment="Stretch"
                        Command="{Binding OpenProfileManagerCommand}"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding AvailableBbsNames}"
                     SelectedItem="{Binding SelectedBbsName, Mode=TwoWay}"
                     Margin="0,8,0,0"
                     Background="{StaticResource ChromeBgSunkenBrush}"
                     BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                     BorderThickness="1"/>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource ChromeBorderSoftBrush}"/>

        <!-- ============ Right pane: field editor ============ -->
        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- "Select or add a BBS" banner. -->
                <Border IsVisible="{Binding !HasSelection}" Padding="22"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="BBS"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Add a BBS in Profile Management (View → Profile Management), then select it on the left to fill in its connection details."
                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                   FontSize="{StaticResource FontSizeMd}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding HasSelection}"
                            Margin="22" Spacing="4"
                            MaxWidth="620" HorizontalAlignment="Left">

                    <!-- ============================================================
                         SECTION 1 — BBS settings (per-BBS, on BbsProfile).
                         Shared by every character that connects to this board.
                         ============================================================ -->
                    <TextBlock Classes="SettingsSectionBanner first" Text="BBS settings"/>
                    <TextBlock Classes="SettingsSectionSub"
                               Text="Stored with this BBS and shared by every character that connects to it."/>
                    <Border Classes="SettingsSectionRule"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="GroupHeader" Text="Connection"/>
                        <!-- A setup is filled in on its own only where nothing is set yet;
                             this puts one in over what's there. -->
                        <DropDownButton Content="Apply setup" Padding="8,1" FontSize="11"
                                        VerticalAlignment="Bottom" Margin="0,0,0,4"
                                        ToolTip.Tip="Put a board's setup in over what's here: Anomaly and Paradigm fill in the host, port and logon steps, Stock only the logon steps. Nothing is saved until you press OK.">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuItem Header="Anomaly — host, port and logon steps"
                                              Command="{Binding ApplyLogonSetupCommand}" CommandParameter="Anomaly"/>
                                    <MenuItem Header="Paradigm — host, port and logon steps"
                                              Command="{Binding ApplyLogonSetupCommand}" CommandParameter="Paradigm"/>
                                    <MenuItem Header="Stock — logon steps only"
                                              Command="{Binding ApplyLogonSetupCommand}" CommandParameter="Stock"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name:"/>
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="My BBS" Width="280"
                                   HorizontalAlignment="Left"
                                   ToolTip.Tip="Display name and on-disk folder name. Renaming moves the BBS's folder, characters included, when applied."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Host:"/>
                        <TextBox   Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   PlaceholderText="bbs.example.com" Width="280"
                                   Classes.tutTarget="{Binding HighlightHostPort}"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Port:"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="1" Maximum="65535" Increment="1"
                                       FormatString="0" Width="140"
                                       Classes.tutTarget="{Binding HighlightHostPort}"
                                       HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Classes="GroupHeader" Text="Retry behaviour"/>

                    <CheckBox IsChecked="{Binding InfiniteRetries, Mode=TwoWay}"
                              Content="Infinite retries w/ 3 second pause"
                              Margin="0,0,0,4"
                              ToolTip.Tip="Retry forever at a fixed 3-second pause, ignoring the Max redials / Redial pause values below. Does not change which events trigger a reconnect — those stay under 'Reconnect when'."/>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Max redials:"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       IsEnabled="{Binding RedialTickersEnabled}"
                                       Value="{Binding MaxRedials, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="1" Maximum="9999" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Redial pause (s):"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       IsEnabled="{Binding RedialTickersEnabled}"
                                       Value="{Binding RedialPauseSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="1" Maximum="300" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Cleanup wait (m):"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding CleanupPeriodMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="0" Maximum="600" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="Minutes the BBS is offline during its nightly auto-cleanup. After a cleanup-warning disconnect we re-dial at warning_observed + N + this. 0 = dial back as soon as shutdown time passes."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="No-response (s):"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="1"
                                       Value="{Binding NoResponseTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="0" Maximum="3600" Increment="10"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="How long a dead connection may go unnoticed before the socket is torn down and 'Server stops responding' / 'Carrier is lost' reconnect fires. Seconds of wire silence before TCP keepalive probes start (idle case; declared dead ~30s later), and it also caps the case where you're actively sending into a server that has vanished — so a lost carrier is caught within about this window (+30s) instead of the kernel's ~13-minute retransmit default. 0 skips the idle keepalive probing but still caps dead-connection detection at ~60s."/>
                    </Grid>

                    <StackPanel IsVisible="{Binding GmcpOffered}">
                    <TextBlock Classes="GroupHeader" Text="Live server data (GMCP)"/>
                    <TextBlock Text="{Binding GmcpStatus}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Off: text only · Shadow: compare · Active: use server data. Applies on next connection."
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid ColumnDefinitions="160,*" Margin="0,2,0,6">
                        <TextBlock Classes="FieldLabel" Text="All packages"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="All Off" Command="{Binding SetAllGmcpModesCommand}"
                                    CommandParameter="{x:Static gmcp:GmcpMode.Off}"/>
                            <Button Content="All Shadow" Command="{Binding SetAllGmcpModesCommand}"
                                    CommandParameter="{x:Static gmcp:GmcpMode.Shadow}"/>
                            <Button Content="All Active" Command="{Binding SetAllGmcpModesCommand}"
                                    CommandParameter="{x:Static gmcp:GmcpMode.Active}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding GmcpPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GmcpPackageOption">
                                <Grid ColumnDefinitions="160,*" Margin="0,2">
                                    <TextBlock Classes="FieldLabel" Text="{Binding Label}"/>
                                    <ComboBox Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                              ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6">
                        <Button Content="Refresh current server data" Command="{Binding RefreshGmcpCommand}"/>
                        <Button Content="Inspect current server data" Command="{Binding InspectGmcpCommand}"/>
                    </StackPanel>
                    </StackPanel>

                    <TextBlock Classes="GroupHeader" Text="Reconnect when"/>

                    <StackPanel Spacing="2" Margin="0,0,0,4">
                        <CheckBox IsChecked="{Binding ReconnectOnFailedConnect, Mode=TwoWay}" Content="Connect attempt fails"/>
                        <CheckBox IsChecked="{Binding ReconnectOnCarrierLost,   Mode=TwoWay}" Content="Carrier is lost mid-session"/>
                        <CheckBox IsChecked="{Binding ReconnectOnNoResponse,    Mode=TwoWay}" Content="Server stops responding"/>
                        <CheckBox IsChecked="{Binding ReconnectAfterCleanup,    Mode=TwoWay}" Content="After Cleanup"/>
                    </StackPanel>

                    <TextBlock Classes="GroupHeader" Text="Display"/>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Columns:"/>
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding TerminalCols, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="40" Maximum="200" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Rows:"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding TerminalRows, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="20" Maximum="100" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Scrollback (lines):"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding ScrollbackLines, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="100" Maximum="100000" Increment="500"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="Lines the scrollback keeps. Applied on OK / Apply: the live buffer resizes, dropping the oldest lines when it shrinks."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Wheel scroll (lines):"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="1"
                                       Value="{Binding BackscrollWheelLines, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                       Minimum="1" Maximum="50" Increment="1"
                                       FormatString="0" Width="140"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="Rows the Backscroll window advances per mouse-wheel notch."/>
                    </Grid>

                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap"
                               Text="Columns / rows are advertised via Telnet NAWS. MajorMUD renders against a fixed 80×25 grid and won't reflow if you push higher; non-game BBS doors usually do reflow."/>

                    <!-- ===== Board disconnect line (per-BBS) =====
                         Additive to the built-in "X just disconnected!!!" /
                         "X just hung up!!!" forms. Some boards (Playpen) emit a
                         custom BBS-level logoff line keyed on the ACCOUNT name,
                         not the character name — this teaches the client that
                         line so a party member's drop is caught. {name} captures
                         the disconnecting player (matched against a player's
                         account-name override, else their character name); *
                         swallows a varying run (e.g. a trailing user count). -->
                    <TextBlock Classes="GroupHeader" Text="Board disconnect line"/>
                    <TextBlock Classes="FieldLabel"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Extra logoff line to watch, on top of the built-in &quot;just disconnected&quot; / &quot;just hung up&quot; forms. Use {name} for the player and * for a varying run. Leave blank on boards that use the standard lines."/>
                    <TextBox Text="{Binding DisconnectPattern, Mode=TwoWay}"
                             Margin="0,6,0,0" MaxWidth="420" HorizontalAlignment="Left"
                             FontFamily="{StaticResource FontMono}"
                             PlaceholderText="e.g.  ►►► [{name}] logs OFF*"
                             ToolTip.Tip="Optional board-specific disconnect line. {name} captures the disconnecting player — matched against each party member's account-name override (Game Data → Players) if set, else their character name. * matches any varying text (like Playpen's trailing 'Lines in Use: N'). Empty = only the built-in disconnect/hang-up lines are watched."/>

                    <!-- ===== Realms =====
                         A board can host several versions of the game, picked from
                         its menu, and each usually differs (often its own MDB
                         export). Each realm has the settings below and its own
                         store of collected data (players seen, blacklist,
                         leaderboard, roomba, quests, realm game-data edits, boss
                         timers), shared by the characters assigned to it. -->
                    <TextBlock Classes="GroupHeader" Text="Realms"/>
                    <TextBlock Classes="FieldLabel" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="The versions of the game this BBS hosts. Each realm has its own game data and settings, and keeps its own players, blacklist, leaderboard, roomba, quests and boss timers, shared by the characters playing it. Assign a character to a realm below (or in Profile Management)."/>
                    <Grid ColumnDefinitions="200,Auto" Margin="0,6,0,0" ColumnSpacing="8">
                        <ListBox Grid.Column="0" ItemsSource="{Binding RealmNames}"
                                 SelectedItem="{Binding SelectedRealmName, Mode=TwoWay}"
                                 MaxHeight="120"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                            <Button Content="Add realm" Command="{Binding AddRealmCommand}"
                                    ToolTip.Tip="Add a realm to this BBS. It starts with default settings and no collected data."/>
                            <Button Content="Remove realm" Command="{Binding RemoveRealmCommand}"
                                    ToolTip.Tip="Remove the selected realm (a BBS keeps at least one). This DELETES every character on it and its collected data when you press OK — you're asked to confirm first, with the characters named. The realm your loaded character plays can't be removed here."/>
                        </StackPanel>
                    </Grid>

                    <!-- The selected realm's settings, framed in that realm's own colour
                         (the way combat-profile groups are framed in their profile's) so
                         it's clear everything inside belongs to that one realm, and
                         switching realms visibly switches the frame. -->
                    <Panel Classes="ProfileFrame">
                        <Border Classes="ProfileGroup"
                                Background="{Binding RealmAccentSoftBrush}"
                                BorderBrush="{Binding RealmAccentBrush}"/>
                        <StackPanel Classes="ProfileBody">
                            <TextBlock Classes="ProfileGroupHeader" HorizontalAlignment="Left" Margin="0,2,0,2"
                                       Foreground="{Binding RealmAccentBrush}"
                                       Text="{Binding SelectedRealmName, StringFormat='Realm: {0}'}"/>
                            <TextBlock Classes="FieldLabel" TextWrapping="Wrap" Margin="0,4,0,2"
                                       Foreground="{StaticResource ChromeFgBrush}" FontWeight="SemiBold"
                                       Text="{Binding RealmCharactersText}"
                                       ToolTip.Tip="The characters playing this realm. Change a character's realm with Plays on realm below (the loaded one) or Move to realm in Profile Management."/>
                            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto"
                                  Margin="0,10,0,0" ColumnSpacing="8" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Realm name"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Width="220"
                                           Text="{Binding RealmName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                           ToolTip.Tip="The selected realm's name (also its data folder's). Renaming it keeps its data and its characters."/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Game data"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1" Width="260"
                                           ItemsSource="{Binding GameDataSetOptions}"
                                           SelectedItem="{Binding RealmGameDataSet, Mode=TwoWay}"
                                           ToolTip.Tip="The imported game data (MDB) this realm uses. Global default follows the set picked in the Game Data menu while no realm is active."/>
                            </Grid>

                            <TextBlock Classes="FieldLabel" FontWeight="SemiBold" Margin="0,12,0,0" Text="Game-menu commands"/>

                            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto"
                                  Margin="0,6,0,0" ColumnSpacing="8" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Game entry command"/>
                                <TextBox   Grid.Row="0" Grid.Column="1"
                                           Text="{Binding GameEntryCommand, Mode=TwoWay}"
                                           Width="120" FontFamily="{StaticResource FontMono}"
                                           ToolTip.Tip="Sent at the MajorMUD main menu to enter this realm. Default 'E'."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Game exit command"/>
                                <TextBox   Grid.Row="1" Grid.Column="1"
                                           Text="{Binding GameExitCommand, Mode=TwoWay}"
                                           Width="120" FontFamily="{StaticResource FontMono}"
                                           ToolTip.Tip="Sent at the MajorMUD main menu to log off. Default '=x'. Also sent when a permitted player telepaths @hangup and by the cleanup log-off."/>
                            </Grid>

                            <!-- The negative-HP death floor. 0 HP only drops a character
                                 into a revivable bleed-out; death happens at this value.
                                 The emergency auto-hangup reads it so the disconnect keeps
                                 firing all the way through the bleeding-out window. -->
                            <TextBlock Classes="FieldLabel" FontWeight="SemiBold" Margin="0,12,0,0" Text="Realm mechanics"/>

                            <Grid ColumnDefinitions="180,Auto,*" Margin="0,6,0,0" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Player dies at (HP):"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding PlayerDiesAtHp, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                               Minimum="-999" Maximum="0" Increment="1"
                                               FormatString="0" Width="140"
                                               HorizontalAlignment="Left"
                                               ToolTip.Tip="Negative-HP floor at which a character actually dies. 0 HP only drops you into a revivable bleed-out — death happens here. The emergency auto-hangup keeps firing through the whole bleeding-out window down to this floor. Default -25."/>
                            </Grid>

                            <!-- Auto-refine traces the true floor from slow deaths: a
                                 bleed-out crosses the floor one tick at a time and lands
                                 right at it, so its HP reading measures the real value.
                                 The seed above is only a guess; a single big overkill hit
                                 over-negatives the floor and is discarded. Off pins the
                                 manual value. -->
                            <CheckBox IsChecked="{Binding AutoRefineDeathFloor, Mode=TwoWay}"
                                      Margin="0,6,0,0"
                                      Content="Auto-refine the floor from slow deaths"
                                      ToolTip.Tip="Learn the realm's true death floor from deaths where you bled out gradually (which land right at the floor). A single big overkill hit blows past the floor and is ignored. Turn off to keep the value you set above."/>

                            <!-- Nothing in the game's output says whether players can attack
                                 one another on a realm, so the user tells us. -->
                            <CheckBox IsChecked="{Binding PvpEnabled, Mode=TwoWay}"
                                      Margin="0,6,0,0"
                                      Content="PvP is enabled on this realm"
                                      ToolTip.Tip="Tick this when players can attack one another on this realm. The PvP settings, and the care taken not to hit other players with room attacks, only apply on a realm where it is ticked."/>

                            <!-- What the board takes for a hang-up in a fight. The board
                                 sets it and the game never prints it, so the user records
                                 it here; the program log and the bug report show it, and
                                 an item figure above 0 makes the client look for dropped
                                 items on the way back in. No hang-up is sent, held or
                                 skipped because of it. -->
                            <TextBlock Classes="FieldLabel" FontWeight="SemiBold" Margin="0,12,0,0" Text="Hang-up penalties on this realm"/>

                            <CheckBox IsChecked="{Binding HangupPenaltyEnabled, Mode=TwoWay}"
                                      Margin="0,6,0,0"
                                      Content="Does the BBS have hang-up penalties?"
                                      ToolTip.Tip="Tick this when the board penalises a character who hangs up in a fight. A hang-up in PvP combat is then penalised; tick the box below when a fight with a monster is too. The HP figures are a record of the board's rule, shown in the program log when a hang-up goes out and in bug reports. An Items dropped figure above 0 also makes MudPlay look for the dropped items when you come back into the game. None of it changes when or whether MudPlay hangs up, which stays with Disable hangups, the Health settings, the PvP actions and @panic."/>

                            <StackPanel IsEnabled="{Binding HangupPenaltyEnabled}">
                                <TextBlock Classes="FieldLabel" Margin="0,6,0,0" Text="A hang-up in PvP combat:"/>
                                <Grid ColumnDefinitions="180,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto"
                                      Margin="0,4,0,0" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="HP lost (%):"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding HangupPvpHpFromPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The least the board takes for a hang-up in PvP combat, as a percentage of your maximum HP. The board takes a share somewhere between this figure and the one after it. Default 25."/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="FieldLabel" Text="to"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="3"
                                                   Value="{Binding HangupPvpHpToPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The most the board takes for a hang-up in PvP combat, as a percentage of your maximum HP. Never less than the figure before it; set both the same when the board takes a fixed share. Default 50."/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Items dropped (up to):"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding HangupPvpItemsDropped, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The most items the board drops on the floor of the room for a hang-up in PvP combat. Leave it at 0 when the board takes HP only, as most do. Above 0, MudPlay looks for dropped items when you come back into the game: what you held before and are missing is picked up from the floor of the room, never more copies than the larger of this figure and the PvE one when that side is ticked (that many again for each earlier check the link cut short). It does not change when or whether MudPlay hangs up. Default 0."/>
                                </Grid>

                                <CheckBox IsChecked="{Binding HangupPvePenaltyEnabled, Mode=TwoWay}"
                                          Margin="0,6,0,0"
                                          Content="Also penalised in combat with monsters (PvE)"
                                          ToolTip.Tip="Tick this when the board also penalises a hang-up in a fight with a monster. Unticked, only a hang-up in PvP combat is penalised."/>
                                <Grid ColumnDefinitions="180,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto"
                                      Margin="0,4,0,0" ColumnSpacing="8" RowSpacing="4"
                                      IsEnabled="{Binding HangupPvePenaltyEnabled}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="HP lost (%):"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding HangupPveHpFromPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The least the board takes for a hang-up in a fight with a monster, as a percentage of your maximum HP. The board takes a share somewhere between this figure and the one after it. Default 25."/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="FieldLabel" Text="to"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="3"
                                                   Value="{Binding HangupPveHpToPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The most the board takes for a hang-up in a fight with a monster, as a percentage of your maximum HP. Never less than the figure before it; set both the same when the board takes a fixed share. Default 50."/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Items dropped (up to):"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                   Value="{Binding HangupPveItemsDropped, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                   Minimum="0" Maximum="100" Increment="1"
                                                   FormatString="0" Width="140"
                                                   HorizontalAlignment="Left"
                                                   ToolTip.Tip="The most items the board drops on the floor of the room for a hang-up in a fight with a monster. Leave it at 0 when the board takes HP only, as most do. Above 0, MudPlay looks for dropped items when you come back into the game: what you held before and are missing is picked up from the floor of the room, never more copies than the larger of this figure and the PvP one (that many again for each earlier check the link cut short). It does not change when or whether MudPlay hangs up. Default 0."/>
                                </Grid>

                                <CheckBox IsChecked="{Binding HangupOutsideFightPenaltyEnabled, Mode=TwoWay}"
                                          Margin="0,6,0,0"
                                          IsEnabled="{Binding HangupPvePenaltyEnabled}"
                                          Content="Also penalised outside a fight (every hang-up)"
                                          ToolTip.Tip="Tick this when the board penalises every hang-up made in the game, whether or not you were in a fight, at the PvE figures above. Unticked, a hang-up outside a fight is taken as free. It decides one thing: whether MudPlay checks for a death by the penalty after a hang-up made while dropped or low on HP with no fight on (movement is held for the second the check takes, and one stat is sent if none was read). It does not change when or whether MudPlay hangs up. Default off."/>
                            </StackPanel>

                            <!-- Nightly boss cleanup: "Respawns @ Cleanup" bosses on the
                                 Bosses tab read DEAD once marked and flip back to ALIVE at
                                 this daily wall-clock time (in the chosen zone). -->
                            <Grid ColumnDefinitions="180,Auto,Auto,*" Margin="0,12,0,0" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Boss cleanup time:"/>
                                <TextBox Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                         FontFamily="{StaticResource FontMono}"
                                         Text="{Binding CleanupTimeOfDay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         PlaceholderText="21:00"
                                         ToolTip.Tip="Daily server-cleanup time as HH:mm (24-hour) in the time zone at right. Cleanup-only bosses flip from DEAD back to ALIVE at this time. Blank disables cleanup-boss timers."/>
                                <ComboBox Grid.Column="2" Width="240" HorizontalAlignment="Left"
                                          FontFamily="{StaticResource FontMono}"
                                          ItemsSource="{Binding TimeZoneIds}"
                                          SelectedItem="{Binding CleanupTimeZoneId, Mode=TwoWay}"
                                          ToolTip.Tip="Time zone the cleanup time is in. Defaults to your computer's own zone; change it to override (e.g. if the board's cleanup runs on a different zone)."/>
                            </Grid>

                            <!-- The realm's label for the runic currency. Some realms
                                 relabel "runic", which changes the coin wording the server
                                 sends — so the pickup/drop/hide parsers have to match the
                                 custom name, not the literal "runic". -->
                            <Grid ColumnDefinitions="180,Auto,*" Margin="0,12,0,0" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Runic currency name"/>
                                <TextBox Grid.Column="1" Text="{Binding RunicCurrencyName, Mode=TwoWay}"
                                         Width="220" HorizontalAlignment="Left"
                                         ToolTip.Tip="What this realm calls the runic currency, if it relabels it. Blank falls back to 'runic'."/>
                            </Grid>
                        </StackPanel>
                    </Panel>

                    <!-- ============================================================
                         SECTION 2 — Character profile settings (per-character).
                         Written onto the loaded character's per-BBS credential
                         slice (BbsSectionViewModel.WriteCredentials) — every
                         character on this BBS keeps its own.
                         ============================================================ -->
                    <TextBlock Classes="SettingsSectionBanner" Text="Character profile settings"/>
                    <TextBlock Classes="SettingsSectionSub"
                               Text="Only for the character you have loaded — each character on this BBS keeps its own copy."/>
                    <Border Classes="SettingsSectionRule"/>

                    <!-- The loaded character's realm on its own BBS (shown only while
                         that BBS is the one selected above). Committed on OK. -->
                    <Grid ColumnDefinitions="180,Auto,*" Margin="0,10,0,0" ColumnSpacing="8"
                          IsVisible="{Binding CanPickCharacterRealm}">
                        <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Plays on realm"/>
                        <ComboBox  Grid.Column="1" Width="220"
                                   ItemsSource="{Binding RealmNames}"
                                   SelectedItem="{Binding CharacterRealm, Mode=TwoWay}"
                                   ToolTip.Tip="Which of this BBS's realms the loaded character plays. It picks the realm's game data and settings, and where what you collect while playing is kept (shared with the realm's other characters)."/>
                    </Grid>

                    <TextBlock Classes="GroupHeader" Text="Credentials"/>

                    <TextBlock Classes="CredHint"
                               Classes.HintWarning="{Binding IsCredentialsHintWarning}"
                               FontSize="{StaticResource FontSizeSm}"
                               TextWrapping="Wrap"
                               Text="{Binding CredentialsHint}"/>

                    <Grid Margin="0,6,0,0" IsEnabled="{Binding HasProfile}"
                          ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Username:"/>
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   Width="280" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Password:"/>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="280,6,Auto"
                              HorizontalAlignment="Left">
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PasswordChar="{Binding ShowPassword, Converter={x:Static vm:PasswordCharConverter.Instance}}"
                                     PlaceholderText="(leave empty to keep the existing password)"/>
                            <ToggleButton Grid.Column="2"
                                          IsChecked="{Binding ShowPassword, Mode=TwoWay}"
                                          Content="Show"
                                          MinWidth="60"/>
                        </Grid>

                        <!-- Suicide password — read-only display.
                             The value is captured passively by
                             SuicidePasswordTracker when the user runs
                             `set suicide` in-game; this row just
                             exposes the stored value so the user can
                             confirm what we have. Hidden when nothing
                             is stored (per user spec: "show only if
                             one is set"). -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel"
                                   Text="Suicide Password:"
                                   IsVisible="{Binding HasSuicidePassword}"/>
                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="280,6,Auto"
                              HorizontalAlignment="Left"
                              IsVisible="{Binding HasSuicidePassword}">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SuicidePassword, Mode=OneWay}"
                                     IsReadOnly="True"
                                     PasswordChar="{Binding ShowSuicidePassword, Converter={x:Static vm:PasswordCharConverter.Instance}}"
                                     ToolTip.Tip="Captured from in-game `set suicide` flow. Run `set suicide` again to change; run `pro` and observe 'You do not have a suicide password set.' to wipe."/>
                            <ToggleButton Grid.Column="2"
                                          IsChecked="{Binding ShowSuicidePassword, Mode=TwoWay}"
                                          Content="Show"
                                          MinWidth="60"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="I have the following SYSOP powers:"
                               IsEnabled="{Binding HasProfile}"
                               Margin="0,12,0,2"/>
                    <StackPanel Margin="12,0,0,0" Spacing="2" IsEnabled="{Binding HasProfile}">
                        <CheckBox IsChecked="{Binding SysopStatus, Mode=TwoWay}"
                                  Content="Sysop status"
                                  ToolTip.Tip="`sys st` (SYSOP STATUS) — lets the client read the game's own room dump to recover its location when the walker gets lost. Per-character, per-BBS."/>
                        <CheckBox IsChecked="{Binding SysopGodLives, Mode=TwoWay}"
                                  Content="Sysop god lives / abil"
                                  ToolTip.Tip="Grants the client sys-god commands for this character. `sys god &lt;name&gt; add life` restores a life on death; the same access also lets the quest-flag sync read all your flags in one shot via `sys god &lt;name&gt; abil` (Settings → General → &quot;Auto-detect completed quests from flags on login&quot;). Per-character, per-BBS."/>
                        <CheckBox IsChecked="{Binding SysopGoto, Mode=TwoWay}"
                                  Content="Sysop goto"
                                  ToolTip.Tip="`sys goto &lt;name&gt;` — jump to a curated location from the table below. Independent of the other powers (a board can grant this alone) and unrelated to the party @goto command. Per-character, per-BBS."/>
                    </StackPanel>

                    <!-- The `sys goto` location table, shown only when the power is on.
                         Location is the board keyword sent verbatim; Map/Room is where it
                         lands (so the client re-anchors); Min level 0 = ungated. -->
                    <TextBlock Classes="GroupHeader" Text="Sys Goto locations"
                               IsVisible="{Binding SysopGoto}"/>
                    <StackPanel IsEnabled="{Binding HasProfile}" IsVisible="{Binding SysopGoto}"
                                Spacing="4" Margin="0,6,0,0">
                        <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                   Text="Each Location keyword is sent verbatim after `sys goto`; Map/Room is where that location lands (used to re-anchor your position). Min level 0 means no gate."/>
                        <Grid ColumnDefinitions="*,64,64,80,*,Auto" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Location"/>
                            <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Map" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Classes="FieldLabel" Text="Room" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="FieldLabel" Text="Min level" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="4" Classes="FieldLabel" Text="Resolves to" Margin="6,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SysopGotos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SysopGotoRowViewModel">
                                    <Grid ColumnDefinitions="*,64,64,80,*,Auto" Margin="0,0,0,4">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="newhaven"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Map, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBox Grid.Column="2" Margin="6,0,0,0"
                                                 Text="{Binding Room, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBox Grid.Column="3" Margin="6,0,0,0"
                                                 Text="{Binding MinLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Classes="FieldLabel" TextWrapping="NoWrap"
                                                   Text="{Binding RoomNamePreview}"/>
                                        <Button Grid.Column="5" Margin="6,0,0,0" Content="Remove"
                                                Command="{Binding $parent[ItemsControl].((vm:BbsSectionViewModel)DataContext).RemoveSysopGotoCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Add location" Command="{Binding AddSysopGotoCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Classes="GroupHeader" Text="Automated Logon Menu Navigation"/>

                    <!-- Guidance: these steps drive the reconnect/login handshake only. A
                         MegaMUD-holdover "Are you sure you want to log off? (Y/N)" step (a
                         BBS quit-confirmation) never appears on the reconnect path, so the
                         automator stalls waiting for it and the character never re-enters. -->
                    <TextBlock Classes="FieldLabel" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Only add steps to LOG IN to the game — never log-out or quit steps (e.g. a &quot;log off? (Y/N)&quot; confirmation). A logout step will never match on reconnect and stalls the automatic re-entry."/>

                    <StackPanel IsEnabled="{Binding HasProfile}" Spacing="4" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,140,Auto,Auto,Auto" Margin="0,0,0,2">
                            <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Message"/>
                            <TextBlock Grid.Column="1" Classes="FieldLabel" Text="Response" Margin="6,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding MenuNavSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuStepEditorViewModel">
                                    <Grid ColumnDefinitions="*,140,Auto,Auto,Auto" Margin="0,0,0,4">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding WaitForPattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="Main Menu:"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Text="{Binding Send, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="G"/>
                                        <Button Grid.Column="2" Margin="6,0,0,0" Content="↑"
                                                Command="{Binding $parent[ItemsControl].((vm:BbsSectionViewModel)DataContext).MoveMenuStepUpCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Move step up"/>
                                        <Button Grid.Column="3" Margin="2,0,0,0" Content="↓"
                                                Command="{Binding $parent[ItemsControl].((vm:BbsSectionViewModel)DataContext).MoveMenuStepDownCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Move step down"/>
                                        <Button Grid.Column="4" Margin="6,0,0,0" Content="Remove"
                                                Command="{Binding $parent[ItemsControl].((vm:BbsSectionViewModel)DataContext).RemoveMenuStepCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Add step" Command="{Binding AddMenuStepCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0"/>

                        <!-- Credential-token legend for the Response field. -->
                        <TextBlock Classes="FieldLabel" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Response tokens:  {user} / {userid} / {username} → your username · {pass} / {pswd} / {passwd} / {password} → your password"
                                   ToolTip.Tip="Type any of these in a step's Response and it's replaced with the character's saved username / password at logon."/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0"
                              IsEnabled="{Binding HasImportSources}"
                              ToolTip.Tip="Copy the logon steps from another saved character. Replaces the steps above; usernames and passwords are never copied. Cancel the Settings window to undo.">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ImportSourceOptions}"
                                      SelectedItem="{Binding SelectedImportSource}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Import logon steps from another character…"/>
                            <Button Grid.Column="1" Margin="6,0,0,0" Content="Import"
                                    Command="{Binding ImportMenuNavCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ============================================================
                         SECTION 3 — Global client settings (Global tier).
                         Install-wide UX preferences persisted in
                         GlobalSettings.Settings["Confirm"], mirrored live onto
                         AppServices.Current.Confirm — not tied to this BBS or the
                         loaded character.
                         ============================================================ -->
                    <TextBlock Classes="SettingsSectionBanner" Text="Global client settings"/>
                    <TextBlock Classes="SettingsSectionSub"
                               Text="Apply to the whole app, regardless of which BBS or character is active."/>
                    <Border Classes="SettingsSectionRule"/>

                    <StackPanel Spacing="2" Margin="0,10,0,0">
                        <TextBlock Text="Show confirmations"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <CheckBox Content="Confirm exit"
                                  IsChecked="{Binding ConfirmExit, Mode=TwoWay}"
                                  ToolTip.Tip="Prompt 'Are you sure?' when closing MudPlay (window X / File → Quit / hotkey)."/>
                        <CheckBox Content="Confirm hangup"
                                  IsChecked="{Binding ConfirmHangup, Mode=TwoWay}"
                                  ToolTip.Tip="Prompt before user-initiated disconnects (toolbar / hotkey / menu). App-initiated disconnects (carrier-lost, @hangup, health drops) bypass the prompt."/>
                        <CheckBox Content="Confirm save settings"
                                  IsChecked="{Binding ConfirmSaveSettings, Mode=TwoWay}"
                                  ToolTip.Tip="Prompt before Settings → OK / Apply writes your changes. 'No' returns to the editor without saving or closing."/>
                        <CheckBox Content="Confirm deletes"
                                  IsChecked="{Binding ConfirmDeletes, Mode=TwoWay}"
                                  ToolTip.Tip="Prompt before destructive deletes: a BBS profile, a navigation favorite, a Game Data record and similar. Removing a toolbar button is not gated."/>
                    </StackPanel>

                    <settings:StatusBarEditorView Margin="0,16,0,0" DataContext="{Binding StatusBarEditor}"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
