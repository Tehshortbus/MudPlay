<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="360"
             x:Class="FujinTerm.Views.Settings.StatlineSectionView"
             x:DataType="vm:StatlineSectionViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>

            <!-- No-profile banner. -->
            <Border IsVisible="{Binding !HasProfile}" Padding="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Statline"
                               Foreground="{StaticResource ChromeFgBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Load or create a character profile to edit the statline wildcard."
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasProfile}"
                        Margin="22" Spacing="8"
                        MaxWidth="620" HorizontalAlignment="Left">

                <TextBlock Text="Statline"
                           Foreground="{StaticResource ChromeFgBrush}"
                           FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold"/>

                <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           TextWrapping="Wrap"
                           Text="The wildcard string the BBS uses for the prompt at the end of every server message. Sent as `set statline &lt;wildcard&gt;` when you click Send. The Phase 12 PR 12.1 token-builder dialog will replace this textbox; for now author the wildcard by hand or paste one you already use."/>

                <TextBlock Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           Margin="0,8,0,0"
                           Text="Wildcard:"/>

                <TextBox Text="{Binding Wildcard, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="[HP=%h/MA=%m]: "
                         AcceptsReturn="False"
                         Width="420"
                         HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="Send to BBS"
                            Command="{Binding SendToBbsCommand}"
                            IsEnabled="{Binding CanSend}"/>
                    <TextBlock Text="{Binding SendStatus}"
                               Foreground="{StaticResource ChromeFgSecBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
