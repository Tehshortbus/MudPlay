<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="760"
             x:Class="FujinTerm.Views.Settings.OtherSectionView"
             x:DataType="vm:OtherSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.FieldNote">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style Selector="TextBlock.FieldSuffix">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.HelpText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="4"
                    MaxWidth="780" HorizontalAlignment="Left">

            <!-- ============ Tab header ============ -->
            <TextBlock Text="{Binding Title}"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontSize="{StaticResource FontSizeLg}"
                       FontWeight="SemiBold"/>

            <Border Padding="4,2"
                    Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerSm}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,4">
                <TextBlock Text="{Binding PhaseTag}"
                           Foreground="{StaticResource AccentAmberBrush}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="11"/>
            </Border>

            <TextBlock Text="{Binding Description}"
                       Foreground="{StaticResource ChromeFgSecBrush}"
                       FontSize="{StaticResource FontSizeMd}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- ============ Remote-command safety (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Remote-command safety"/>

            <Grid ColumnDefinitions="280,Auto,Auto,*" Margin="0,2,0,0">
                <TextBlock Grid.Column="0" Classes="FieldLabel"
                           Text="Block @suicide commands when lives ≤"
                           ToolTip.Tip="Hard-blocks `@do suicide` and `@party suicide` while remaining lives are at or below this number. Default 3 — protects characters who haven't yet built up a lives buffer. Set to 0 to never block on lives (the engine still refuses when the live lives count is unknown)."/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding MaxSuicideLivesThreshold, Mode=TwoWay}"
                               Minimum="0" Maximum="20"
                               Increment="1"
                               Width="100"
                               ToolTip.Tip="Range 0..20. Threshold is inclusive — at exactly N lives the command is still blocked."/>
                <TextBlock Grid.Column="2" Classes="FieldSuffix" Text="lives"/>
            </Grid>

            <!-- ============ Ignored ailments (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Ignored ailments"/>
            <CheckBox Content="Ignore poison"    IsChecked="{Binding IgnorePoison, Mode=TwoWay}"
                      ToolTip.Tip="When checked: poison ticks don't trigger @wait. Always-on triggers (over-encumbered, MovementPrevented, Stunned) still pause regardless."/>
            <CheckBox Content="Ignore blindness" IsChecked="{Binding IgnoreBlindness, Mode=TwoWay}"
                      ToolTip.Tip="When checked: being blinded doesn't trigger @wait."/>
            <CheckBox Content="Ignore confusion" IsChecked="{Binding IgnoreConfusion, Mode=TwoWay}"
                      ToolTip.Tip="When checked: being confused doesn't trigger @wait. Caster parties often want to leave this UNCHECKED — confusion makes our cast fail randomly."/>
            <CheckBox Content="Ignore diseased"  IsChecked="{Binding IgnoreDiseased, Mode=TwoWay}"
                      ToolTip.Tip="When checked: being diseased doesn't trigger @wait."/>

            <!-- ============ Game-menu commands (wired) ============ -->
            <TextBlock Classes="SectionHeader" Text="Game-menu commands"/>
            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Game entry command"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           Text="{Binding GameEntryCommand, Mode=TwoWay}"
                           Width="120" FontFamily="{StaticResource FontMono}"
                           ToolTip.Tip="Sent at the MajorMUD main menu to enter the realm. Default 'E'."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Game exit command"/>
                <TextBox   Grid.Row="1" Grid.Column="1"
                           Text="{Binding GameExitCommand, Mode=TwoWay}"
                           Width="120" FontFamily="{StaticResource FontMono}"
                           ToolTip.Tip="Sent at the MajorMUD main menu to log off. Default '=x'. Fires immediately when a permitted player telepaths @hangup; full cleanup-warning automation ships in a follow-up PR."/>
            </Grid>

            <!-- ============ Player database (wired, Global tier) ============ -->
            <TextBlock Classes="SectionHeader" Text="Player database"/>
            <Grid ColumnDefinitions="180,90,Auto,*" Margin="0,2,0,0" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="FieldLabel" Text="Auto-delete after"/>
                <NumericUpDown Grid.Column="1"
                               Value="{Binding PlayerCleanupDays, Mode=TwoWay}"
                               Minimum="0" Maximum="3650" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               ToolTip.Tip="Stale Players-tab records get dropped at startup once they're older than this. 0 disables auto-cleanup. Per-player 'Don't auto-delete' opts records out individually. Global setting — applies to every character on this install."/>
                <TextBlock Grid.Column="2" Classes="FieldSuffix" Text="days"/>
            </Grid>

            <!-- ============ Inline stub catalog ============ -->
            <ItemsControl ItemsSource="{Binding StubGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StubGroup">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="SectionHeader"
                                       Text="{Binding Header}"
                                       IsVisible="{Binding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StubField">
                                        <Grid ColumnDefinitions="260,*,Auto"
                                              Margin="0,3,0,3"
                                              ToolTip.Tip="{Binding Tooltip}">

                                            <TextBlock Grid.Column="0"
                                                       Classes="FieldLabel"
                                                       Text="{Binding Label}"
                                                       IsVisible="{Binding HasLabel}"/>

                                            <CheckBox Grid.Column="0" Grid.ColumnSpan="3"
                                                      IsEnabled="False"
                                                      Content="{Binding Label}"
                                                      IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Check}}"/>
                                            <NumericUpDown Grid.Column="1" IsEnabled="False"
                                                           Value="0"
                                                           Minimum="{Binding Min}"
                                                           Maximum="{Binding Max}"
                                                           Width="120"
                                                           IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Numeric}}"/>
                                            <TextBox Grid.Column="1" IsEnabled="False"
                                                     Width="220"
                                                     IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Text}}"/>
                                            <TextBlock Grid.Column="1" Grid.ColumnSpan="2"
                                                       Classes="FieldNote"
                                                       Text="{Binding Label}"
                                                       IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Note}}"/>

                                            <TextBlock Grid.Column="2"
                                                       Classes="FieldSuffix"
                                                       Text="{Binding Suffix}"
                                                       IsVisible="{Binding Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
