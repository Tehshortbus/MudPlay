<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="760"
             x:Class="FujinTerm.Views.Settings.OtherSectionView"
             x:DataType="vm:OtherSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.FieldNote">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style Selector="TextBlock.FieldSuffix">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.HelpText">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" Spacing="4"
                    MaxWidth="780" HorizontalAlignment="Left">

            <!-- Title / phase tag / description deliberately omitted per
                 user direction — section headers throughout this tab
                 are removed too. The bound Title is still surfaced via
                 SettingsWindowViewModel's sidebar selection. -->

            <!-- Prose-style row matching the Player-Database row below.
                 Width="120" on the spinner so the value renders without
                 clipping (Avalonia's default NumericUpDown swallows
                 short widths and shows just the up/down arrows).
                 Range 0..9 with default 5 — small dial reflects the
                 realistic safety buffer at typical mid-game lives
                 counts. Subnote sits directly underneath the label. -->
            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="FieldLabel" Text="Block @suicide commands when lives ≤"/>
                    <NumericUpDown Value="{Binding MaxSuicideLivesThreshold, Mode=TwoWay}"
                                   Minimum="0" Maximum="9" Increment="1"
                                   FormatString="0" ShowButtonSpinner="True"
                                   Width="120" MinWidth="120"/>
                    <TextBlock Classes="FieldLabel" Text="lives"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                           FontSize="11" FontStyle="Italic"
                           Text="0 = disabled"/>
            </StackPanel>

            <!-- Master gate for walker trap-disarming. Off → the walker
                 steps straight through trapped exits. On → it disarms
                 first, but only when a disarm is actually possible (local
                 Traps skill today; party delegation in a follow-up). -->
            <TextBlock Classes="FieldLabel" Text="Traps:" Margin="0,12,0,0"/>
            <CheckBox Content="Utilize self or party members to disarm traps"
                      IsChecked="{Binding UtilizeDisarmTrapsIfAble, Mode=TwoWay}"
                      ToolTip.Tip="When checked (default): at a trapped exit the walker tries to disarm before moving — first yourself if you have the Traps skill, otherwise it delegates to a capable party member via @trap on say. When unchecked: the walker walks straight through trapped exits with no disarm attempt."/>

            <!-- @trap auto-disarm attempt caps. Search-attempts row sits
                 ABOVE disarm-attempts per user spec — the search runs
                 first, then disarm. -->
            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="@trap max searches"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding MaxTrapSearchAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `sea &lt;dir&gt;` retry loop when handling an @trap. After this many failed searches we give up and telepath the sender. Default 20."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="@trap max disarms"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding MaxTrapDisarmAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="50" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `disarm trap &lt;dir&gt;` retry loop after the trap has been spotted. Default 5. Damage-aware abort (stop early on HP loss) ships with the Phase 13 HealthManager wiring."/>
            </Grid>

            <!-- Walker door bash / pick caps (commit 2). Bash row above
                 pick row by default; the "Pick locks instead of bashing"
                 toggle below flips the walker's verb preference. -->
            <Grid ColumnDefinitions="180,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Door max bash"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding MaxBashAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `bash &lt;dir&gt;` retry loop when opening a door. Default 10. Hits when the player's strength is below the door requirement and the server replies with `attempts to bash through fail`."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Door max pick"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding MaxPickAttempts, Mode=TwoWay}"
                               Minimum="1" Maximum="100" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Caps the `pick &lt;dir&gt;` retry loop when opening a door. Default 10. Picking is probabilistic — the skill can fail even when the value meets the requirement."/>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Pick locks instead of bashing"
                          IsChecked="{Binding PicklocksOverBash, Mode=TwoWay}"
                          ToolTip.Tip="When checked, the walker prefers `pick &lt;dir&gt;` over `bash &lt;dir&gt;` on doors where both verbs are viable. Bash is louder and breaks stealth; thieves typically flip this on."/>
            </Grid>

            <!-- Demand-driven auto-search. When checked, travelling a route
                 that crosses an (Item: N) / (Ticket: N) exit whose item you
                 aren't carrying arms auto-search until that item turns up —
                 independent of the Auto-Search master toggle. Char-tier. -->
            <CheckBox Content="Search rooms if item needed"
                      IsChecked="{Binding SearchRoomsIfItemNeeded, Mode=TwoWay}"
                      Margin="0,12,0,0"
                      ToolTip.Tip="When checked: if the walker plans a route through an exit that requires an item you're not carrying (a boat for the Silver River, a rope-and-grapple for a climb, a ticket, etc.), FujinTerm searches every room you enter (`sea`) to reveal the missing item, and stops once it's found. Works even when the Auto-Search master toggle is off. Applies only for this character."/>

            <!-- Shop-source routing. When checked, a walk-to that needs an
                 item we're not carrying detours to the fewest-added-steps
                 shop that stocks it, buys it, then resumes. Aborts if the
                 item turns up first; falls back to search on a failed buy.
                 Only plain walk-to's detour (not loops / auto-lair). -->
            <CheckBox Content="Buy item if needed"
                      IsChecked="{Binding BuyNeededPathItems, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: if a walk-to crosses an exit that requires an item you're not carrying and a shop sells that item, FujinTerm detours to the shop that adds the fewest steps to your trip, buys the item, then continues to your original destination. If the item turns up first (e.g. from `Search rooms if item needed`) the detour is cancelled; if the buy fails (no gold, out of stock) it resumes and lets search keep hunting. Only detours for a direct walk-to — not for loops or auto-lair. Applies only for this character."/>

            <!-- Monster-drop reroute. When checked, a walk-to that needs an
                 item no shop sells prompts to reroute to the nearest room a
                 monster that drops it spawns in, then resumes once the drop
                 lands. Complements "Buy item if needed" (shop-sold items).
                 Only plain walk-to's reroute (not loops / auto-lair). -->
            <CheckBox Content="Hunt item if needed"
                      IsChecked="{Binding HuntNeededPathItems, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: if a walk-to crosses an exit that requires an item you're not carrying and NO shop sells it, but some monster drops it, FujinTerm asks whether to reroute to the nearest room that monster spawns in. If you confirm, it walks there so you can hunt the monster, then continues to your original destination once the item drops. If the item turns up first (e.g. from `Search rooms if item needed`) the reroute is cancelled. Only asks for a direct walk-to — not for loops or auto-lair. Applies only for this character."/>

            <!-- Party-inventory deferral. When checked, a walk-to that needs a
                 per-member item we lack asks the party (@have) before searching
                 / buying / hunting; if a member has a spare it's handed over
                 (give) and no demand need is posted. Only a shortfall (no one
                 has a spare) falls through to the search / shop / hunt sources.
                 No-op when solo. Runs ahead of the three sources above. -->
            <CheckBox Content="Defer to party inventory"
                      IsChecked="{Binding DeferToPartyInventory, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: if a walk-to crosses an exit that requires an item each party member needs (a rope-and-grapple, a boat, a ticket, etc.) and you're not carrying it, FujinTerm first asks the party `@have` for it. If a member is holding a spare (two or more), they're asked to `give` you one — a single holder via the permission-free `@party give`, or a specific holder via `@do give` when several have copies — and no search / shop / hunt is started. Only if no member has a spare does it fall through to `Search rooms if item needed` / `Buy item if needed` / `Hunt item if needed`. Does nothing when you're solo. Applies only for this character."/>

            <!-- Party level-gate avoidance. When checked and leading a party,
                 the walker routes AROUND (Level: MIN to MAX) gates the whole
                 party can't clear instead of walking the leader through and
                 leaving a member behind. Each member's level comes from an
                 @level probe (exact) or their title band until probed. -->
            <CheckBox Content="Avoid party-impassable level gates"
                      IsChecked="{Binding AvoidPartyImpassableLevelGates, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked and you're leading a party: if a planned route crosses a level-gated exit (Level: MIN to MAX) that a party member can't pass — too low for the floor or too high for the cap — FujinTerm plans a path AROUND it so the group stays together and still reaches the destination, rather than walking you through and stranding that member. Each member's level is learned from an `@level` probe (sent when the roster changes); until they answer, their `who` title's level band is used. If every route to the destination is level-blocked, the walker still tells 'blocked by a gate' apart from 'no path exists'. Does nothing when you're solo or just following. Applies only for this character."/>

            <!-- Party toll-affordability avoidance. When checked and leading a
                 party, the walker routes AROUND (Toll: N) exits a member can't
                 afford instead of walking the leader through and stranding
                 them at the gate. A toll is per-crosser — every member needs
                 N*100 copper-value on hand. Unlike level gates, wealth isn't
                 kept warm: an @wealth probe fires only when a planned route
                 actually crosses a toll. -->
            <CheckBox Content="Avoid party-unaffordable tolls"
                      IsChecked="{Binding AvoidPartyUnaffordableTolls, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked and you're leading a party: if a planned route crosses a toll exit (Toll: N) a party member can't pay — a toll is per-crosser, so every member needs its cost (N gold worth, in any coin mix) on hand — FujinTerm plans a path AROUND it so nobody is stranded at the gate. Wealth changes constantly, so it isn't cached: an `@wealth` probe is sent only when a route actually crosses a toll, and a member who can't cover it (or hasn't answered yet) makes the toll be avoided this pass. As their wealth comes in, a later lap or a retry can use the toll. Does nothing when you're solo or just following. Applies only for this character."/>

            <!-- Leader-side @comeback backtrack budget. When a stranded
                 follower sends a bare @comeback (no room), the leader
                 pauses its engine and walks backwards along the path
                 just taken up to this many rooms looking for them, then
                 goes idle if not found. Ignored when the follower
                 supplies an explicit room. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="@comeback backtrack up to"/>
                <NumericUpDown Value="{Binding MaxComebackBacktrackRooms, Mode=TwoWay}"
                               Minimum="1" Maximum="50" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="When a left-behind party follower sends a bare @comeback (no room), the leader pauses its active movement engine and walks backwards along the path just taken, room by room, up to this many rooms looking for them. If not recovered within the budget the leader goes idle and lets the player handle it. Ignored when the follower supplies an explicit room (@comeback 9/1012). Default 10."/>
                <TextBlock Classes="FieldLabel" Text="rooms."/>
            </StackPanel>

            <!-- Follower-side auto-@comeback. When checked (default), being
                 left behind by the leader (a movement-failure line right
                 before "You are no longer following X.") telepaths
                 @comeback to the leader automatically. Char-tier setting. -->
            <CheckBox Content="Auto-request @comeback when left behind"
                      IsChecked="{Binding AutoRequestComebackWhenLeftBehind, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: if a movement-blocking condition (a prevents-movement gamedata flag or over-encumbrance) strands you as your party leader walks off, FujinTerm telepaths @comeback &lt;your room&gt; to the leader so their recovery flow picks you back up. When unchecked, the strand is detected but no request is sent — you handle it manually. Applies only for this character."/>

            <!-- Cleanup-Player-Database row: prose-style "Cleanup Player
                 Database after [spinner] days." — spinner widened from
                 90→120 so 4-digit values (e.g. 3650-day max) render
                 without clipping. -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="Cleanup Player Database after"/>
                <NumericUpDown Value="{Binding PlayerCleanupDays, Mode=TwoWay}"
                               Minimum="0" Maximum="3650" Increment="1"
                               FormatString="0" ShowButtonSpinner="True"
                               Width="120" MinWidth="120"
                               ToolTip.Tip="Stale Players-tab records get dropped at startup once they're older than this. 0 disables auto-cleanup. Per-player 'Don't auto-delete' opts records out individually. Global setting — applies to every character on this install."/>
                <TextBlock Classes="FieldLabel" Text="days."/>
            </StackPanel>

            <!-- Calibration / debug toggle. Off by default; flip on for a
                 data-collection session, run around the realm, then flip
                 off. Log lines land in the Log pane at Info severity with
                 the measured hop time + current encumbrance. -->
            <CheckBox Content="Log movement hop timing (debug)"
                      IsChecked="{Binding LogMovementHopTiming, Mode=TwoWay}"
                      Margin="0,8,0,0"
                      ToolTip.Tip="When checked: each observed hop emits one Info log line with the measured wall-clock time + the current encumbrance level. Use it to tune the Auto-Lair travel-cost table against in-game truth, then turn off for normal play."/>

            <!-- Note: the run-away (flee) toggles (Go backwards if running /
                 Break combat before running) graduated to the Combat tab —
                 they sit next to the room thresholds + RunDistance they
                 coordinate with. HealthManager.TryFlee reads RunDirection /
                 BreakBeforeFleeing from CombatSettings now. -->

            <!-- Note: the per-category Verbose toggles + the round-trace
                 toggle moved to the Log pane menu as a single "Combat
                 diagnostics" umbrella switch. They were per-character
                 here but verbose tracing is a "while I'm debugging
                 right now" affordance, not a per-character preference. -->

            <!-- ============ Inline stub catalog ============
                 Section headers stripped per user direction — the
                 catalog renders as a flat list of rows. The numeric-
                 row template puts the picker INLINE between the
                 label and the suffix (e.g. "Attempt bash [120] times")
                 instead of using a fixed-width left column with the
                 picker pushed right. -->
            <ItemsControl ItemsSource="{Binding StubGroups}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StubGroup">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StubField">
                                    <Grid ColumnDefinitions="*"
                                          Margin="0,3,0,3"
                                          ToolTip.Tip="{Binding Tooltip}">
                                        <!-- Check rows: just the disabled checkbox spanning the row. -->
                                        <CheckBox IsEnabled="False"
                                                  Content="{Binding Label}"
                                                  IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Check}}"/>

                                        <!-- Numeric rows: prose-style with the picker inline.
                                             "Attempt bash [picker] times" — label + picker + suffix. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Numeric}}">
                                            <TextBlock Classes="FieldLabel" Text="{Binding Label}"/>
                                            <NumericUpDown IsEnabled="False"
                                                           Value="0"
                                                           Minimum="{Binding Min}"
                                                           Maximum="{Binding Max}"
                                                           Width="100"/>
                                            <TextBlock Classes="FieldLabel"
                                                       Text="{Binding Suffix}"
                                                       IsVisible="{Binding Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <!-- Text rows: label + textbox horizontally. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Text}}">
                                            <TextBlock Classes="FieldLabel" Text="{Binding Label}"/>
                                            <TextBox IsEnabled="False" Width="220"/>
                                        </StackPanel>

                                        <!-- Note rows: italic prose, no control. -->
                                        <TextBlock Classes="FieldNote"
                                                   Text="{Binding Label}"
                                                   IsVisible="{Binding Kind, Converter={x:Static vm:KindEqualsConverter.Note}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
