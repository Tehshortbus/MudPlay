<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:views="using:MudPlay.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="520"
        x:Class="MudPlay.Views.ConversationWindow"
        x:DataType="vm:ConversationViewModel"
        Title="Conversation"
        Width="780" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Inline web link inside a chat message: underlined accent hot-text that
             opens the URL in the OS default browser. Font is inherited from the
             message block so the link matches the user's message font size. -->
        <Style Selector="Button.ChatLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ChatLink /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock.ChatLinkText">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ============ Filter toolbar ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">

                <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4"
                           VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowGossip}"            Content="Gossip"
                              Foreground="{Binding GossipBrush}"    FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowLocal}"             Content="Say"
                              Foreground="{Binding LocalBrush}"     FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowTelepath}" Content="Telepath"
                              Foreground="{Binding TelepathBrush}" FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowGangpath}"          Content="Gang"
                              Foreground="{Binding GangpathBrush}"  FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowBroadcast}"         Content="Broadcast"
                              Foreground="{Binding BroadcastBrush}" FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowYell}"              Content="Yell"
                              Foreground="{Binding YellBrush}"      FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowRealmEvent}"        Content="Server"
                              Foreground="{Binding RealmBrush}"     FontSize="11"/>
                </WrapPanel>

                <!-- Search over auto-scroll in one fixed-width column: stacking
                     them keeps the box at its natural height (no vertical
                     stretch to match the wrapped checkbox rows) and reserves
                     only one column of width, so the filter checkboxes can wrap
                     freely as the window narrows without shoving these around. -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4"
                            VerticalAlignment="Top">
                    <TextBox Classes="clearable" MinWidth="200"
                             VerticalAlignment="Top"
                             PlaceholderText="Search speaker / message…"
                             Text="{Binding SearchText, Mode=TwoWay}"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding AutoScroll}"
                              Content="Auto-scroll"
                              Foreground="{StaticResource ChromeFgSecBrush}"
                              FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Input + Export row ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBox Grid.Column="0" x:Name="InputBox"
                         PlaceholderText="Type a command or chat line, press Enter to send (↑ / ↓ to recall)"
                         Text="{Binding InputText, Mode=TwoWay}"
                         MaxLength="{Binding MaxInputLength}"
                         KeyDown="OnInputKeyDown">
                    <TextBox.InnerRightContent>
                        <!-- Recall chevron lives inside the input box: it drops
                             the same newest-first history the ↑/↓ keys walk. -->
                        <Button x:Name="RecallButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                VerticalAlignment="Stretch"
                                IsEnabled="{Binding HasRecentCommands}"
                                ToolTip.Tip="Recall a recently sent command (or use ↑ / ↓ in the box)">
                            <PathIcon Width="10" Height="10"
                                      Data="M 0,0 L 8,0 L 4,5 Z"
                                      Foreground="{StaticResource ChromeFgSecBrush}"/>
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <ListBox x:Name="RecallList"
                                             ItemsSource="{Binding RecentCommands}"
                                             SelectionChanged="OnRecallSelected"
                                             MinWidth="240" MaxHeight="260"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="1" Margin="6,0,0,0"
                        Content="Send" Command="{Binding SendInputCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Rows list ============ -->
        <ListBox x:Name="RowsList"
                 ItemsSource="{Binding Rows}"
                 Background="{StaticResource ChromeBgSunkenBrush}"
                 BorderThickness="0"
                 Padding="4"
                 SelectionMode="Multiple,Toggle"
                 KeyDown="OnRowsKeyDown">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ConversationRowViewModel">
                    <Grid Margin="4,2">
                        <Grid.ContextMenu>
                            <!-- Right-click a line to copy the whole entry (time + who +
                                 message). Copies the selection when the clicked row is
                                 part of it, else just this row — see OnCopyRow. -->
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="OnCopyRow" InputGesture="Ctrl+C"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <!-- Day separator: horizontal rule with the date
                             centered. Other rows: timestamp + tag + speaker
                             + message in a single line. -->
                        <Border IsVisible="{Binding IsDaySeparator}"
                                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,8,0,4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontFamily="{Binding DataContext.RowFontFamily, ElementName=RowsList}"
                                       FontSize="{Binding DataContext.MetaFontSize, ElementName=RowsList}"
                                       Text="{Binding MessageText, StringFormat='─── {0} ───'}"/>
                        </Border>
                        <Grid IsVisible="{Binding !IsDaySeparator}"
                              ColumnDefinitions="Auto,Auto,Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimestampText}"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontFamily="{Binding DataContext.RowFontFamily, ElementName=RowsList}"
                                       FontSize="{Binding DataContext.MetaFontSize, ElementName=RowsList}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Border Grid.Column="1"
                                    Background="#0DFFFFFF"
                                    BorderBrush="{Binding ChannelBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding ChannelText}"
                                           Foreground="{Binding ChannelBrush}"
                                           FontFamily="{Binding DataContext.RowFontFamily, ElementName=RowsList}"
                                           FontSize="{Binding DataContext.MetaFontSize, ElementName=RowsList}"/>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SpeakerText}"
                                       IsVisible="{Binding HasSpeaker}"
                                       Foreground="{Binding ChannelBrush}"
                                       FontFamily="{Binding DataContext.RowFontFamily, ElementName=RowsList}"
                                       FontSize="{Binding DataContext.MetaFontSize, ElementName=RowsList}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <!-- Plain TextBlock (not SelectableTextBlock): row-level
                                 Copy / Ctrl+C handles the whole entry, and a built-in
                                 partial-text-selection menu here only copied empty
                                 unless you'd first dragged a selection. Inline web links
                                 still render + click via ConversationMessageInlines. -->
                            <TextBlock Grid.Column="3"
                                       views:ConversationMessageInlines.Message="{Binding MessageText}"
                                       Foreground="{Binding MessageBrush}"
                                       FontFamily="{Binding DataContext.RowFontFamily, ElementName=RowsList}"
                                       FontSize="{Binding DataContext.MessageFontSize, ElementName=RowsList}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
