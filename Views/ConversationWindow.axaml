<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:views="using:MudPlay.Views"
        xmlns:ctl="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="520"
        x:Class="MudPlay.Views.ConversationWindow"
        x:DataType="vm:ConversationViewModel"
        Title="Conversation"
        Width="780" Height="520"
        MinWidth="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- MinWidth: narrower than this, the header's pills squash and the ⋯ button
         runs off the window's edge. -->

    <Window.Styles>
        <!-- Inline web link inside a chat message: underlined accent hot-text that
             opens the URL in the OS default browser. Font is inherited from the
             message block so the link matches the user's message font size. -->
        <Style Selector="Run.ChatLinkText">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <!-- Channel filter pill: the channel's tag in its colour. On, it's outlined and
             tinted with that colour; off, it fades to a hollow outline. The tint is the
             channel brush at low opacity rather than a solid fill, so the label stays
             readable whatever colour a channel is given on the Talk tab. -->
        <Style Selector="ToggleButton.ChannelPill">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerLg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_Tint"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ChannelPill /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.25"/>
        </Style>
        <Style Selector="ToggleButton.ChannelPill:pointerover /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="ToggleButton.ChannelPill:unchecked">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="ToggleButton.ChannelPill:unchecked:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="ToggleButton.ChannelPill:unchecked /template/ Border#PART_Tint">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ============ Filter toolbar ============ -->
        <!-- One row: the channel pills, then search filling what's left, then the ⋯
             menu. When the window is too narrow, the pills wrap onto a second line and
             search + ⋯ keep their place at the end of the row. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <ctl:WrapThenFillPanel Spacing="8">

                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"
                           VerticalAlignment="Center">
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowGossip}"
                                  Content="{Binding GossipTag}"
                                  BorderBrush="{Binding GossipBrush}" Foreground="{Binding GossipBrush}"
                                  ToolTip.Tip="Gossip: click to show or hide gossip and auctions"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowLocal}"
                                  Content="{Binding LocalTag}"
                                  BorderBrush="{Binding LocalBrush}" Foreground="{Binding LocalBrush}"
                                  ToolTip.Tip="Say: click to show or hide says and actions"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowTelepath}"
                                  Content="{Binding TelepathTag}"
                                  BorderBrush="{Binding TelepathBrush}" Foreground="{Binding TelepathBrush}"
                                  ToolTip.Tip="Telepath: click to show or hide telepaths, received and sent"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowGangpath}"
                                  Content="{Binding GangpathTag}"
                                  BorderBrush="{Binding GangpathBrush}" Foreground="{Binding GangpathBrush}"
                                  ToolTip.Tip="Gang: click to show or hide gangpaths"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowBroadcast}"
                                  Content="{Binding BroadcastTag}"
                                  BorderBrush="{Binding BroadcastBrush}" Foreground="{Binding BroadcastBrush}"
                                  ToolTip.Tip="Broadcast: click to show or hide broadcasts"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowYell}"
                                  Content="{Binding YellTag}"
                                  BorderBrush="{Binding YellBrush}" Foreground="{Binding YellBrush}"
                                  ToolTip.Tip="Yell: click to show or hide yells"/>
                    <ToggleButton Classes="ChannelPill" IsChecked="{Binding ShowRealmEvent}"
                                  Content="{Binding RealmTag}"
                                  BorderBrush="{Binding RealmBrush}" Foreground="{Binding RealmBrush}"
                                  ToolTip.Tip="Server: click to show or hide realm notices and PvP messages"/>
                </WrapPanel>

                <!-- The panel holds this group's narrowest width (search's MinWidth plus
                     the ⋯ button) back from the pills, so the menu never leaves the window. -->
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBox Grid.Column="0" Classes="clearable"
                             MinWidth="120" MinHeight="24" Height="24"
                             Padding="6,2" FontSize="{StaticResource FontSizeMd}"
                             VerticalContentAlignment="Center"
                             PlaceholderText="Search…"
                             ToolTip.Tip="Show only lines whose speaker or message holds this text"
                             Text="{Binding SearchText, Mode=TwoWay}"/>
                    <Button Grid.Column="1" x:Name="MoreButton"
                            Margin="6,0,0,0" Width="26" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Auto-scroll and Clear All">
                        <Path Data="{StaticResource IconMore}"
                              Fill="{StaticResource ChromeFgSecBrush}"
                              Width="14" Height="4" Stretch="Uniform"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Auto-scroll" ToggleType="CheckBox"
                                          IsChecked="{Binding AutoScroll, Mode=TwoWay}"/>
                                <Separator/>
                                <MenuItem Header="Clear All…" Click="OnClearAllRequested"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <!-- Clear All wipes the history for good (the saved talk log
                             too), so its menu entry only opens this confirm: the wipe
                             itself is a second, deliberate click. -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8" MaxWidth="260">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Wipe the whole conversation log? This also empties the saved copy and can't be undone."/>
                                    <Button HorizontalAlignment="Right"
                                            Content="Clear All"
                                            Click="OnClearAllConfirmed"/>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                </Grid>
            </ctl:WrapThenFillPanel>
        </Border>

        <!-- ============ Input row ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBox Grid.Column="0" x:Name="InputBox"
                         PlaceholderText="Type a command or chat line, press Enter to send (↑ / ↓ to recall)"
                         Text="{Binding InputText, Mode=TwoWay}"
                         MaxLength="{Binding MaxInputLength}"
                         KeyDown="OnInputKeyDown"
                         TextChanged="OnInputTextChanged">
                    <TextBox.InnerRightContent>
                        <!-- Recall chevron lives inside the input box: it drops
                             the same newest-first history the ↑/↓ keys walk. -->
                        <Button x:Name="RecallButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,0"
                                VerticalAlignment="Stretch"
                                IsEnabled="{Binding HasRecentCommands}"
                                ToolTip.Tip="Recall a recently sent command (or use ↑ / ↓ in the box)">
                            <PathIcon Width="10" Height="10"
                                      Data="M 0,0 L 8,0 L 4,5 Z"
                                      Foreground="{StaticResource ChromeFgSecBrush}"/>
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <ListBox x:Name="RecallList"
                                             ItemsSource="{Binding RecentCommands}"
                                             SelectionChanged="OnRecallSelected"
                                             MinWidth="240" MaxHeight="260"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Grid.Column="1" Margin="6,0,0,0"
                        Content="Send" Command="{Binding SendInputCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Rows list ============ -->
        <!-- One Grid as the DockPanel's fill child, holding the list and the emote
             popup: with the popup as the panel's LAST child, LastChildFill gave it the
             fill and docked the list left at its content width, so the scrollbar sat
             where the longest line ended instead of at the window edge. -->
        <Grid>
        <!-- MaxHeight 0 until the window has opened: the first layout would otherwise
             build the rows at the TOP of the history, only for the open to jump
             straight to the newest line and build that end as well. OnOpened lifts
             it and scrolls to the last row in one step. -->
        <ListBox x:Name="RowsList"
                 ItemsSource="{Binding Rows}"
                 Background="{StaticResource ChromeBgSunkenBrush}"
                 BorderThickness="0"
                 Padding="4"
                 SelectionMode="Multiple,Toggle"
                 MaxHeight="0"
                 KeyDown="OnRowsKeyDown">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <!-- Rows wrap to different heights, and the virtualizing panel estimates the
                 extent from the rows it has realized; with only the visible handful, that
                 estimate swung as a thumb drag realized new rows and the thumb jumped
                 under the pointer. Realizing a couple of viewports either side steadies it. -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- Every binding in a row reads its own row (fonts too, via Look), never the
                 window's view-model: each realized row left a weak subscription on the
                 view-model, hundreds per chat line, and they were never swept. -->
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ConversationRowViewModel">
                    <Grid Margin="4,2">
                        <Grid.ContextMenu>
                            <!-- Right-click a line to copy the whole entry (time + who +
                                 message). Copies the selection when the clicked row is
                                 part of it, else just this row — see OnCopyRow. -->
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="OnCopyRow" InputGesture="Ctrl+C"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <!-- Day separator: horizontal rule with the date
                             centered. Other rows: timestamp + tag + speaker
                             + message in a single line. -->
                        <Border IsVisible="{Binding IsDaySeparator}"
                                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,8,0,4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontFamily="{Binding Look.FontFamily}"
                                       FontSize="{Binding Look.MetaFontSize}"
                                       Text="{Binding MessageText, StringFormat='─── {0} ───'}"/>
                        </Border>
                        <Grid IsVisible="{Binding !IsDaySeparator}"
                              ColumnDefinitions="Auto,Auto,Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimestampText}"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       FontFamily="{Binding Look.FontFamily}"
                                       FontSize="{Binding Look.MetaFontSize}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Border Grid.Column="1"
                                    Background="#0DFFFFFF"
                                    BorderBrush="{Binding ChannelBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerSm}"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding ChannelText}"
                                           Foreground="{Binding ChannelBrush}"
                                           FontFamily="{Binding Look.FontFamily}"
                                           FontSize="{Binding Look.MetaFontSize}"/>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SpeakerText}"
                                       IsVisible="{Binding HasSpeaker}"
                                       Foreground="{Binding ChannelBrush}"
                                       FontFamily="{Binding Look.FontFamily}"
                                       FontSize="{Binding Look.MetaFontSize}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <!-- Plain TextBlock (not SelectableTextBlock): row-level
                                 Copy / Ctrl+C handles the whole entry, and a built-in
                                 partial-text-selection menu here only copied empty
                                 unless you'd first dragged a selection. Inline web links
                                 still render + click via ConversationMessageInlines. -->
                            <TextBlock Grid.Column="3"
                                       views:ConversationMessageInlines.Message="{Binding MessageText}"
                                       views:ConversationMessageInlines.EmotesEnabled="{Binding Look.EmotesEnabled}"
                                       Foreground="{Binding MessageBrush}"
                                       FontFamily="{Binding Look.FontFamily}"
                                       FontSize="{Binding Look.MessageFontSize}"
                                       LineHeight="{Binding Look.MessageLineHeight}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ":" emote picker popup, anchored below the input box. -->
        <Popup PlacementTarget="{Binding #InputBox}" Placement="Bottom"
               IsOpen="{Binding IsEmotePickerOpen}" IsLightDismissEnabled="False">
            <Border Background="{StaticResource ChromeBgBrush}"
                    BorderBrush="{StaticResource ChromeBorderSoftBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerSm}" MinWidth="240" MaxHeight="200">
                <ListBox ItemsSource="{Binding EmoteSuggestions}"
                         SelectedIndex="{Binding SelectedEmoteIndex}"
                         PointerReleased="OnEmoteSuggestionClicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:EmoteSuggestionViewModel">
                            <Grid ColumnDefinitions="26,*" Margin="2">
                                <Image Grid.Column="0" Source="{Binding PreviewImage}" Height="18"
                                       IsVisible="{Binding IsImage}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="0" Text="{Binding PreviewText}" FontSize="15"
                                           IsVisible="{Binding IsText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Display}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        </Grid>

    </DockPanel>
</Window>
