<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:game="using:FujinTerm.Game"
        xmlns:profile="using:FujinTerm.Models.Profile"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="240"
        x:Class="FujinTerm.Views.PartyWindow"
        x:DataType="vm:PartyViewModel"
        Title="Party"
        Width="520" Height="240"
        MinWidth="380" MinHeight="80"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Rank chip (F/M/B) — shown only on the self row. -->
        <Style Selector="Border.RankChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="16"/>
        </Style>

        <!-- Status-flag chip (REST / PSN / WAIT / etc.). -->
        <Style Selector="Border.StatusChip">
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.StatusChip > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Compact HP/MA bar. -->
        <Style Selector="ProgressBar.HpBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="ProgressBar.MaBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <!-- ===== Header strip ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <TextBlock Text="{Binding HeaderText}"
                       Foreground="{StaticResource ChromeFgSecBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ===== Empty-state hint ===== -->
        <TextBlock DockPanel.Dock="Top"
                   Margin="10,12,10,0"
                   Text="No party active. Members appear here as soon as someone follows you (or you follow someone)."
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !State.IsInParty}"/>

        <!-- ===== Member rows ===== -->
        <ItemsControl ItemsSource="{Binding State.Members}"
                      Background="{StaticResource ChromeBgSunkenBrush}"
                      Padding="2"
                      IsVisible="{Binding State.IsInParty}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="game:PartyMember">
                    <Border BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <!-- Fixed-pixel widths on every column whose presence
                             varies per row (leader-star, rank-chip, HP, MA,
                             position). Auto columns wouldn't sync across
                             rows so a leaderless follower row had its HP bar
                             land at a different X than the leader's. Only the
                             name column (*) and the status-chip column (Auto)
                             vary — both come BEFORE/AFTER the bars so they
                             don't affect HP/MA alignment. -->
                        <Grid ColumnDefinitions="20,28,*,135,135,78,Auto,Auto"
                              VerticalAlignment="Center">

                            <!-- (0) Leader star — visible only on the leader -->
                            <TextBlock Grid.Column="0"
                                       Text="★"
                                       FontSize="13"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       IsVisible="{Binding IsLeader}"/>

                            <!-- (1) Rank chip — self only -->
                            <Border Grid.Column="1"
                                    Classes="RankChip"
                                    Background="{StaticResource AccentAmberSoftBrush}"
                                    IsVisible="{Binding IsSelf}">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="$parent[ItemsControl].DataContext.LocalRank"
                                                     Converter="{x:Static vm:RankChipConverter.Instance}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>

                            <!-- (2) Name + class -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgBrush}"/>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding Class, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="({0})">
                                            <Binding Path="Class"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!-- (3) HP bar + numeric — fixed slot width keeps the
                                 columns past this point aligned across rows. -->
                            <Grid Grid.Column="3" ColumnDefinitions="60,8,*"
                                  Margin="6,0,8,0" VerticalAlignment="Center" Width="135">
                                <ProgressBar Grid.Column="0"
                                             Classes="HpBar"
                                             Value="{Binding HpPercent}"
                                             Maximum="100"
                                             VerticalAlignment="Center"
                                             ToolTip.Tip="{Binding HpPercent, StringFormat='HP {0}%'}"/>
                                <!-- HpDisplay shows "current/max" once a baseline is
                                     known (on-join @health for foreign members; PromptParser
                                     mirror for self). Falls back to "percent%" until then. -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding HpDisplay}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           ToolTip.Tip="{Binding HpPercent, StringFormat='HP {0}%'}"/>
                            </Grid>

                            <!-- (4) MA bar + numeric. Always reserves layout space so
                                 the position + chips columns line up across rows; the
                                 visible bar / text just blank out when BaselineMp=0
                                 (warrior or pre-@health-exchange). -->
                            <Grid Grid.Column="4" ColumnDefinitions="60,8,*"
                                  Margin="0,0,8,0" VerticalAlignment="Center" Width="135"
                                  IsVisible="{Binding BaselineMp, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}">
                                <ProgressBar Grid.Column="0"
                                             Classes="MaBar"
                                             Value="{Binding MpPercent}"
                                             Maximum="100"
                                             VerticalAlignment="Center"
                                             ToolTip.Tip="{Binding MpPercent, StringFormat='MA {0}%'}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaDisplay}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           Foreground="{StaticResource ChromeFgBrush}"
                                           ToolTip.Tip="{Binding MpPercent, StringFormat='MA {0}%'}"/>
                            </Grid>
                            <!-- Empty placeholder when MA is hidden, so column 5 onwards
                                 still occupies the same horizontal slot on every row. -->
                            <Border Grid.Column="4" Width="135"
                                    IsVisible="{Binding BaselineMp, Converter={x:Static vm:LessThanOrEqualZeroConverter.Instance}}"/>

                            <!-- (5) Position chip — compact stance label. MinWidth so
                                 "Standing" / "Resting" / "Meditating" all reserve the
                                 same horizontal cell. -->
                            <TextBlock Grid.Column="5"
                                       Text="{Binding Position}"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       MinWidth="70"
                                       Margin="0,0,6,0"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>

                            <!-- (6) Status-flag chips. Each chip self-collapses when the
                                 corresponding flag is false. Order is roughly threat / cure /
                                 stealth / coordination. -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentGreenBrush}"
                                        IsVisible="{Binding Resting}">
                                    <TextBlock Text="REST" Foreground="{StaticResource AccentGreenBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentCyanBrush}"
                                        IsVisible="{Binding Meditating}">
                                    <TextBlock Text="MED" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentRedBrush}"
                                        IsVisible="{Binding Paralyzed}">
                                    <TextBlock Text="PARA" Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentRedBrush}"
                                        IsVisible="{Binding Held}">
                                    <TextBlock Text="HELD" Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Blinded}">
                                    <TextBlock Text="BLD" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Poisoned}">
                                    <TextBlock Text="PSN" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Diseased}">
                                    <TextBlock Text="DIS" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentAmberBrush}"
                                        IsVisible="{Binding Confused}">
                                    <TextBlock Text="CNF" Foreground="{StaticResource AccentAmberBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentMagentaBrush}"
                                        IsVisible="{Binding Hidden}">
                                    <TextBlock Text="HID" Foreground="{StaticResource AccentMagentaBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentMagentaBrush}"
                                        IsVisible="{Binding Sneaking}">
                                    <TextBlock Text="SNK" Foreground="{StaticResource AccentMagentaBrush}"/>
                                </Border>
                                <Border Classes="StatusChip"
                                        Background="{StaticResource ChromeBgElevBrush}"
                                        BorderBrush="{StaticResource AccentPrimaryBrush}"
                                        IsVisible="{Binding IsWaiting}">
                                    <TextBlock Text="WAIT" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- (7) Uninvite — only meaningful for the leader -->
                            <Button Grid.Column="7"
                                    Content="⨯"
                                    Width="22" Height="22"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    FontSize="13"
                                    ToolTip.Tip="Uninvite from party"
                                    Command="{Binding $parent[ItemsControl].DataContext.UninviteCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding $parent[ItemsControl].DataContext.State.SelfIsLeader}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
