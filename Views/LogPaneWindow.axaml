<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="520"
        x:Class="MudPlay.Views.LogPaneWindow"
        x:DataType="vm:LogPaneViewModel"
        Title="Log"
        Width="820" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Vertical" Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">

                <!-- Display filters for the always-on record levels. These
                     only hide/show rows that already exist. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowInfo}"  Content="INF"
                              Foreground="{StaticResource SeverityInfoBrush}" FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowWarn}"  Content="WRN"
                              Foreground="{StaticResource SeverityWarnBrush}" FontSize="11"/>
                    <CheckBox IsChecked="{Binding ShowError}" Content="ERR"
                              Foreground="{StaticResource SeverityErrorBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Generation toggles. Unlike the display filters, these
                     change what the program PRODUCES: flipping one on makes
                     the matching channel emit (and its rows appear); off
                     silences it at the source. Persisted per-character. -->
                <Border Grid.Column="1" Margin="14,0,0,0"
                        BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                        BorderThickness="1,0,0,0" Padding="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding DebugDiagnostics}"
                                  Content="Debug"
                                  Foreground="{StaticResource SeverityDebugBrush}"
                                  FontSize="11"
                                  ToolTip.Tip="Generate the verbose Debug channel across all engines and show its rows. Persisted per-character; on by default."/>
                        <CheckBox IsChecked="{Binding CombatDiagnostics}"
                                  Content="Combat"
                                  Foreground="{StaticResource SeverityCombatBrush}"
                                  FontSize="11"
                                  ToolTip.Tip="Generate the combat-decision channel and show its rows. Persisted per-character; on by default."/>
                    </StackPanel>
                </Border>

                <CheckBox Grid.Column="2" Margin="14,0,0,0"
                          IsChecked="{Binding AutoScroll}"
                          Content="Auto-scroll"
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11" VerticalAlignment="Center"/>

                <TextBox Grid.Column="4" Classes="clearable" MinWidth="220"
                         PlaceholderText="Search source / message…"
                         Text="{Binding SearchText, Mode=TwoWay}"/>

                <Button Grid.Column="5" Margin="8,0,0,0"
                        Content="Clear" Command="{Binding ClearCommand}"/>
            </Grid>

            <!-- On-disk / calibration toggles. Sit under the filter row.
                 Auto-collect gates whether the program / memory / combat-trace
                 files are written to Data/Logs at all; Hop timing gates the
                 navigation calibration trace. Both off by default so a normal
                 session leaves nothing extra behind. Persisted per-character. -->
            <StackPanel Orientation="Horizontal" Spacing="14">
                <CheckBox IsChecked="{Binding AutoCollectLogs}"
                          Content="Auto-collect logs"
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11"
                          ToolTip.Tip="Write the program, memory, and combat-trace diagnostic files to Data/Logs. Off by default; turning it on generates all three for the session. Persisted per-character."/>
                <CheckBox IsChecked="{Binding HopTiming}"
                          Content="Hop timing"
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11"
                          ToolTip.Tip="Log one Info line per confirmed room hop with the measured wall-clock time + current encumbrance. Use it to tune the Auto-Lair travel-cost table against in-game truth, then turn off for normal play. Persisted per-character."/>
                <CheckBox IsChecked="{Binding CaptureUnrecognizedMessages}"
                          Content="Capture unrecognized messages"
                          Foreground="{StaticResource ChromeFgSecBrush}"
                          FontSize="11"
                          ToolTip.Tip="Stage wire lines the Messages catalogue doesn't recognize as review candidates (Game Data → Unrecognized Lines), and log a Warn row on first sighting. On by default. Persisted per-character."/>

                <!-- The test-only "Simulate …" buttons all share one dropdown of
                     checkboxes rather than a checkbox each: each reveals a hidden
                     test button on its feature window. All off by default and
                     session-only (reset off every launch), so a normal session
                     never shows any of them. -->
                <DropDownButton Content="Simulate buttons"
                                FontSize="11"
                                Foreground="{StaticResource ChromeFgSecBrush}"
                                ToolTip.Tip="Reveal test-only 'Simulate …' buttons on their feature windows. All off by default and reset off every launch.">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Vertical" Spacing="8" Margin="4">
                                <CheckBox IsChecked="{Binding ShowSimulateDeath}"
                                          Content="Simulate Death button"
                                          FontSize="11"
                                          ToolTip.Tip="Reveal the 'Simulate Death' test button on the Character Workshop → Death Recovery tab."/>
                                <CheckBox IsChecked="{Binding ShowSimulateChest}"
                                          Content="Simulate Chest button"
                                          FontSize="11"
                                          ToolTip.Tip="Reveal the 'Simulate Chest' test button on the Chest Offload window (Bosses tab → Chest Offload)."/>
                                <CheckBox IsChecked="{Binding ShowSimulateUnrecognized}"
                                          Content="Simulate entry button"
                                          FontSize="11"
                                          ToolTip.Tip="Reveal the 'Simulate entry' test button on the Game Data → Unrecognized Lines tab — feeds a synthetic unrecognized line through the capture flow so a candidate appears."/>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Entries list ============ -->
        <ListBox x:Name="RowsList"
                 ItemsSource="{Binding Rows}"
                 Background="{StaticResource ChromeBgSunkenBrush}"
                 BorderThickness="0"
                 SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LogPaneRowViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="4,2">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TimestampText}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Grid.Column="1"
                                Background="#0DFFFFFF"
                                BorderBrush="{Binding SeverityBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerSm}"
                                Padding="4,1"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding SeverityText}"
                                       Foreground="{Binding SeverityBrush}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"/>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Source}"
                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   MinWidth="64"
                                   Margin="0,0,8,0"/>
                        <SelectableTextBlock Grid.Column="3"
                                             Text="{Binding Message}"
                                             Foreground="{StaticResource ChromeFgBrush}"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
