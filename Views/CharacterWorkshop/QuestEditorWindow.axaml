<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="FujinTerm.Views.CharacterWorkshop.QuestEditorWindow"
        x:DataType="vm:QuestEditorViewModel"
        Title="Quest Editor"
        Width="720" Height="560"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style Selector="Border.Pane">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="16">

        <!-- Empty state: the active set crawls no quests. -->
        <TextBlock Grid.Row="0"
                   IsVisible="{Binding !HasQuests}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Text="No quests crawl from the active game-data set. Load a set whose TBInfo grants quest flags to name and annotate them — or use &quot;+ Add Quest&quot; below to add one by hand."/>

        <!-- Master / detail. -->
        <Grid Grid.Row="0" ColumnDefinitions="240,*" ColumnSpacing="12"
              IsVisible="{Binding HasQuests}">

            <!-- Master list -->
            <Border Grid.Column="0" Classes="Pane">
                <ListBox ItemsSource="{Binding Quests}"
                         SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:QuestEditRowViewModel">
                            <TextBlock Text="{Binding ListLabel}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detail editor for the selected quest -->
            <Grid Grid.Column="1" IsVisible="{Binding HasSelection}"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

                <!-- Flag / level context + crawled class/race restriction -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SelectedQuest.FallbackLabel}"
                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                   FontFamily="{StaticResource FontMono}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedQuest.LevelText}"
                                   IsVisible="{Binding SelectedQuest.HasLevel}"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding SelectedQuest.HasRequirements}">
                        <TextBlock Text="Requires:" Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedQuest.RequirementsText}" TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Name -->
                <TextBlock Grid.Row="1" Classes="Label" Text="Display name"/>
                <TextBox Grid.Row="2"
                         Text="{Binding SelectedQuest.Name, Mode=TwoWay}"
                         PlaceholderText="(unnamed — shows the flag id)"/>

                <!-- Required level — pre-filled with the crawled minlevel (blank when the
                     crawl found none); override it when the gate lives in a chain the crawl
                     can't see, or clear it to fall back to the crawl. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10"
                            Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Classes="Label" Margin="0" Text="Required level"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding SelectedQuest.RequiredLevelInput, Mode=TwoWay}"
                                   Minimum="0" Maximum="1000" Increment="1" FormatString="0"
                                   Width="120" ShowButtonSpinner="True"
                                   ToolTip.Tip="The level gate shown on the quest card. Pre-filled with the crawled minlevel (blank when the crawl found none). Set a value to supply a missing gate, clear it to fall back to the crawl, or set 0 to mark the quest ungated."/>
                    <TextBlock Classes="Label" Margin="0" Text="(blank = use crawled gate)"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Visibility + class-resolved bonus -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding SelectedQuest.Visible, Mode=TwoWay}"
                              Content="Show in quest journal"
                              Foreground="{StaticResource ChromeFgBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                IsVisible="{Binding SelectedQuest.HasBonus}">
                        <TextBlock Text="Bonus:" Foreground="{StaticResource ChromeFgMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedQuest.BonusText}"
                                   Foreground="{StaticResource AccentAmberBrush}"
                                   FontFamily="{StaticResource FontMono}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Reward — pre-filled with the crawler's inferred award; edit freely
                     to correct awards the give-chain crawl can't see. -->
                <TextBlock Grid.Row="5" Classes="Label" Text="Reward (crawled award pre-filled; edit freely)"/>
                <TextBox Grid.Row="6"
                         Text="{Binding SelectedQuest.Rewards, Mode=TwoWay}"
                         PlaceholderText="(no reward)"/>

                <!-- Step markdown — pre-filled with the crawled steps; edit freely. -->
                <TextBlock Grid.Row="7" Classes="Label" Text="Steps (markdown — crawled steps pre-filled; edit freely)"/>
                <TextBox Grid.Row="8"
                         Text="{Binding SelectedQuest.Steps, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource FontMono}"
                         MinHeight="120"/>
            </Grid>
        </Grid>

        <!-- Add / contextual Block-or-Delete + Save / Cancel -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="+ Add Quest" Command="{Binding AddQuestCommand}"
                    MinWidth="110"
                    ToolTip.Tip="Add a custom quest the game-data crawl doesn't find."/>

            <!-- Contextual on the selected quest: block a crawled one, delete a manual one. -->
            <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                      Content="Block (hide as a false positive)"
                      IsChecked="{Binding SelectedQuest.Blocked, Mode=TwoWay}"
                      IsVisible="{Binding SelectedQuest.IsCrawled, FallbackValue=False}"
                      Foreground="{StaticResource ChromeFgMutedBrush}"
                      ToolTip.Tip="Suppress this crawled quest from the journal — for a flag a set surfaces spuriously. The row stays here so you can un-block it."/>
            <Button Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                    Content="Delete quest" Command="{Binding DeleteSelectedCommand}"
                    IsVisible="{Binding SelectedQuest.IsManual, FallbackValue=False}"
                    ToolTip.Tip="Remove this custom quest."/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80"/>
                <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="80" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
