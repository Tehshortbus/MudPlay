<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="FujinTerm.Views.CharacterWorkshop.ItemFinderWindow"
        x:DataType="vm:ItemFinderViewModel"
        Title="Item Finder"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Group">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.Group">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="NumericUpDown.filter">
            <Setter Property="Width" Value="112"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100000"/>
            <Setter Property="Increment" Value="1"/>
            <Setter Property="FormatString" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="12">
        <Grid ColumnDefinitions="280,*" ColumnSpacing="12">

            <!-- ===== Left: grouped, selectively-applied filters ===== -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0">

                        <!-- Character: class / level / alignment, deferred to the
                             same usable-by-char gate the slot suggestions use. -->
                        <Border Classes="Group">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Group" Text="Character"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Class"/>
                                    <ComboBox ItemsSource="{Binding ClassOptions}"
                                              SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Alignment"/>
                                    <ComboBox ItemsSource="{Binding AlignmentOptions}"
                                              SelectedItem="{Binding SelectedAlignment, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter"
                                                   Maximum="200"
                                                   Value="{Binding UsableLevel, Mode=TwoWay}"
                                                   ToolTip.Tip="Show only items a character of this level can wear (0 = any)."/>
                                    <TextBlock Classes="FieldLabel" Text="Usable at level"/>
                                </DockPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Attack type"/>
                                    <ComboBox ItemsSource="{Binding AttackTypeOptions}"
                                              SelectedItem="{Binding SelectedAttackType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="Which attack the Swings column models. Bash / Smash recompute each weapon; Punch / Kick / Jumpkick add a bare-handed row."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Slot &amp; type. -->
                        <Border Classes="Group">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="Group" Text="Slot &amp; type"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Weapon type"/>
                                    <ComboBox ItemsSource="{Binding WeaponTypeOptions}"
                                              SelectedItem="{Binding SelectedWeaponType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Armour type"/>
                                    <ComboBox ItemsSource="{Binding ArmourTypeOptions}"
                                              SelectedItem="{Binding SelectedArmourType, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Slot"/>
                                    <ComboBox ItemsSource="{Binding SlotOptions}"
                                              SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <CheckBox Content="Backstab-capable only"
                                          IsChecked="{Binding BackstabOnly, Mode=TwoWay}"
                                          Foreground="{StaticResource ChromeFgSecBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Filter by stats. 0 disables a row; bonus rows keep items at
                             or above the value, the requirement gates keep items at or
                             below it (a higher gate is less restrictive). -->
                        <Border Classes="Group">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="Group" Text="Filter by stats"/>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinHp, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Max HP"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinHpRegen, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="HP regen %"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinMana, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Max mana"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinManaRegen, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Mana regen %"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinMinDmg, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Min damage"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinMaxDmg, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Max damage"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinAccuracy, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Accuracy"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinCrits, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Crits"/>
                                </DockPanel>
                                <!-- Hit magic gates to a level range: the left ticker is the
                                     floor (≥), the right the ceiling (≤); 0 disables each. -->
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="FieldLabel" Text="Hit magic level (min / max)"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <NumericUpDown Classes="filter" Width="104"
                                                       Value="{Binding MinHitMagic, Mode=TwoWay}"
                                                       ToolTip.Tip="Lowest hit-magic level to show (0 = off)."/>
                                        <NumericUpDown Classes="filter" Width="104"
                                                       Value="{Binding MaxHitMagic, Mode=TwoWay}"
                                                       ToolTip.Tip="Highest hit-magic level to show (0 = off)."/>
                                    </StackPanel>
                                </StackPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinBsAccuracy, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="BS accuracy"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinBsMin, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="BS min damage"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinBsMax, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="BS max damage"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinAc, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Armour class"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter" Value="{Binding MinDr, Mode=TwoWay}"/>
                                    <TextBlock Classes="FieldLabel" Text="Damage resist"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter"
                                                   Maximum="200" Value="{Binding MaxStrReq, Mode=TwoWay}"
                                                   ToolTip.Tip="Show items whose required strength is this or lower (0 = off)."/>
                                    <TextBlock Classes="FieldLabel" Text="Strength req"/>
                                </DockPanel>
                                <DockPanel>
                                    <NumericUpDown DockPanel.Dock="Right" Classes="filter"
                                                   Maximum="200" Value="{Binding MaxLevelReq, Mode=TwoWay}"
                                                   ToolTip.Tip="Show items whose required level is this or lower (0 = off)."/>
                                    <TextBlock Classes="FieldLabel" Text="Level req"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Reset filters" Command="{Binding ResetCommand}" MinWidth="100"/>
                    <Button Content="Close" Command="{Binding CloseCommand}" MinWidth="80"/>
                </StackPanel>
            </Grid>

            <!-- ===== Right: the combined item list ===== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

                <TextBlock Grid.Row="0" Text="{Binding CountText}"
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeSm}"
                           VerticalAlignment="Center"/>

                <!-- ReflectionBinding: the non-generic DataGridCollectionView hides the
                     row item's type from the compiled-binding pass, so columns fall back
                     to reflection (matching the Game Data / Spell Coverage grids). -->
                <!-- Columns tagged with their binding path are auto-hidden by the
                     code-behind when no visible row carries a value for them (the
                     VM recomputes the set on every filter). Slot and Name are the
                     untagged anchors — always shown. -->
                <DataGrid Grid.Row="1" x:Name="ItemsGrid"
                          ItemsSource="{Binding RowsView}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          DoubleTapped="OnRowDoubleTapped">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot"       Binding="{ReflectionBinding SlotLabel}"      SortMemberPath="SlotOrder"  Width="100"/>
                        <DataGridTextColumn Header="Name"       Binding="{ReflectionBinding Name}"           SortMemberPath="Name"       Width="200"/>
                        <DataGridTextColumn Header="Type"       Binding="{ReflectionBinding TypeLabel}"      SortMemberPath="TypeLabel"  Width="96"  Tag="TypeLabel"/>
                        <DataGridTextColumn Header="Lvl"        Binding="{ReflectionBinding LevelReqText}"   SortMemberPath="LevelReq"   Width="58"  Tag="LevelReqText"/>
                        <DataGridTextColumn Header="Str"        Binding="{ReflectionBinding StrReqText}"     SortMemberPath="StrReq"     Width="58"  Tag="StrReqText"/>
                        <DataGridTextColumn Header="Enc"        Binding="{ReflectionBinding EncumText}"      SortMemberPath="Encum"      Width="58"  Tag="EncumText"/>
                        <DataGridTextColumn Header="Dmg"        Binding="{ReflectionBinding DamageText}"     SortMemberPath="MaxDmg"     Width="78"  Tag="DamageText"/>
                        <DataGridTextColumn Header="Swings"     Binding="{ReflectionBinding AvgSwingsText}"  SortMemberPath="AvgSwings"  Width="70"  Tag="AvgSwingsText"/>
                        <DataGridTextColumn Header="Accy"       Binding="{ReflectionBinding AccuracyText}"   SortMemberPath="Accuracy"   Width="66"  Tag="AccuracyText"/>
                        <DataGridTextColumn Header="Crit"       Binding="{ReflectionBinding CritsText}"      SortMemberPath="Crits"      Width="62"  Tag="CritsText"/>
                        <DataGridTextColumn Header="Hit Magic"  Binding="{ReflectionBinding HitMagicText}"   SortMemberPath="HitMagic"   Width="92"  Tag="HitMagicText"/>
                        <DataGridTextColumn Header="BS Acc"     Binding="{ReflectionBinding BsAccuracyText}" SortMemberPath="BsAccuracy" Width="78"  Tag="BsAccuracyText"/>
                        <DataGridTextColumn Header="BS Min-Max" Binding="{ReflectionBinding BsDamageText}"   SortMemberPath="BsMax"      Width="106" Tag="BsDamageText"/>
                        <DataGridTextColumn Header="AC"         Binding="{ReflectionBinding AcText}"         SortMemberPath="Ac"         Width="56"  Tag="AcText"/>
                        <DataGridTextColumn Header="DR"         Binding="{ReflectionBinding DrText}"         SortMemberPath="Dr"         Width="56"  Tag="DrText"/>
                        <DataGridTextColumn Header="HP"         Binding="{ReflectionBinding HpText}"         SortMemberPath="Hp"         Width="62"  Tag="HpText"/>
                        <DataGridTextColumn Header="HP Regen"   Binding="{ReflectionBinding HpRegenText}"    SortMemberPath="HpRegen"    Width="92"  Tag="HpRegenText"/>
                        <DataGridTextColumn Header="Mana"       Binding="{ReflectionBinding ManaText}"       SortMemberPath="Mana"       Width="66"  Tag="ManaText"/>
                        <DataGridTextColumn Header="MP Regen"   Binding="{ReflectionBinding ManaRegenText}"  SortMemberPath="ManaRegen"  Width="92"  Tag="ManaRegenText"/>
                        <DataGridTextColumn Header="Illu"       Binding="{ReflectionBinding IlluminateText}" SortMemberPath="Illuminate" Width="70"  Tag="IlluminateText"/>
                        <DataGridTextColumn Header="+Str"       Binding="{ReflectionBinding StrengthText}"   SortMemberPath="Strength"   Width="58"  Tag="StrengthText"/>
                        <DataGridTextColumn Header="+Int"       Binding="{ReflectionBinding IntellectText}"  SortMemberPath="Intellect"  Width="58"  Tag="IntellectText"/>
                        <DataGridTextColumn Header="+Wil"       Binding="{ReflectionBinding WillpowerText}"  SortMemberPath="Willpower"  Width="58"  Tag="WillpowerText"/>
                        <DataGridTextColumn Header="+Agi"       Binding="{ReflectionBinding AgilityText}"    SortMemberPath="Agility"    Width="58"  Tag="AgilityText"/>
                        <DataGridTextColumn Header="+Hlth"      Binding="{ReflectionBinding HealthText}"     SortMemberPath="Health"     Width="60"  Tag="HealthText"/>
                        <DataGridTextColumn Header="+Chrm"      Binding="{ReflectionBinding CharmText}"      SortMemberPath="Charm"      Width="60"  Tag="CharmText"/>
                        <DataGridTextColumn Header="+MinDmg"    Binding="{ReflectionBinding MinDamageBonusText}" SortMemberPath="MinDamageBonus" Width="76"  Tag="MinDamageBonusText"/>
                        <DataGridTextColumn Header="+MaxDmg"    Binding="{ReflectionBinding MaxDamageBonusText}" SortMemberPath="MaxDamageBonus" Width="78"  Tag="MaxDamageBonusText"/>
                        <DataGridTextColumn Header="Spell Dmg"  Binding="{ReflectionBinding SpellDamageText}" SortMemberPath="SpellDamage" Width="86"  Tag="SpellDamageText"/>
                        <DataGridTextColumn Header="+Enc"       Binding="{ReflectionBinding EncumBonusText}" SortMemberPath="EncumBonus" Width="62"  Tag="EncumBonusText"/>
                        <DataGridTextColumn Header="Stealth"    Binding="{ReflectionBinding StealthText}"    SortMemberPath="Stealth"    Width="72"  Tag="StealthText"/>
                        <DataGridTextColumn Header="Casting"    Binding="{ReflectionBinding SpellcastingText}" SortMemberPath="Spellcasting" Width="78"  Tag="SpellcastingText"/>
                        <DataGridTextColumn Header="Quick"      Binding="{ReflectionBinding QuicknessText}"  SortMemberPath="Quickness"  Width="64"  Tag="QuicknessText"/>
                        <DataGridTextColumn Header="Traps"      Binding="{ReflectionBinding TrapsText}"      SortMemberPath="Traps"      Width="64"  Tag="TrapsText"/>
                        <DataGridTextColumn Header="Locks"      Binding="{ReflectionBinding PicklocksText}"  SortMemberPath="Picklocks"  Width="64"  Tag="PicklocksText"/>
                        <DataGridTextColumn Header="Prot Evil"  Binding="{ReflectionBinding ProtEvilText}"   SortMemberPath="ProtEvil"   Width="82"  Tag="ProtEvilText"/>
                        <DataGridTextColumn Header="Prot Good"  Binding="{ReflectionBinding ProtGoodText}"   SortMemberPath="ProtGood"   Width="82"  Tag="ProtGoodText"/>
                        <DataGridTextColumn Header="Cold"       Binding="{ReflectionBinding ColdResistText}" SortMemberPath="ColdResist" Width="60"  Tag="ColdResistText"/>
                        <DataGridTextColumn Header="Fire"       Binding="{ReflectionBinding FireResistText}" SortMemberPath="FireResist" Width="60"  Tag="FireResistText"/>
                        <DataGridTextColumn Header="Stone"      Binding="{ReflectionBinding StoneResistText}" SortMemberPath="StoneResist" Width="62"  Tag="StoneResistText"/>
                        <DataGridTextColumn Header="Lightning"  Binding="{ReflectionBinding LightningResistText}" SortMemberPath="LightningResist" Width="86"  Tag="LightningResistText"/>
                        <DataGridTextColumn Header="Water"      Binding="{ReflectionBinding WaterResistText}" SortMemberPath="WaterResist" Width="62"  Tag="WaterResistText"/>
                        <DataGridTextColumn Header="Shadow"     Binding="{ReflectionBinding ShadowResistText}" SortMemberPath="ShadowResist" Width="68"  Tag="ShadowResistText"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
