<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="720"
        x:Class="MudPlay.Views.CharacterWorkshop.ChestOffloadSectionView"
        x:DataType="vm:ChestOffloadViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.Section">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.Box">
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <!-- Clickable text link — matches the item-record/room links (cyan-blue). -->
        <Style Selector="Button.Link">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Link:disabled">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="Button.Link:disabled /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <DockPanel LastChildFill="True">

            <!-- Top: containers to open + charm + coin gained -->
            <StackPanel DockPanel.Dock="Top" Spacing="10">
                <Border Classes="Box">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="Section" Text="Containers you're holding" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Simulate Chest" Command="{Binding SimulateChestCommand}"
                                    IsVisible="{Binding ShowSimulateChest}"
                                    ToolTip.Tip="Seed a few random containers whose loot is rolled from the chest's own table — test the tab without real chests. Shown only while the Log pane's 'Simulate Chest button' toggle is on."/>
                        </Grid>
                        <TextBlock Text="No containers in your inventory."
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   IsVisible="{Binding !HasContainers}"/>
                        <ItemsControl ItemsSource="{Binding Containers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChestContainerRow">
                                    <Button Content="{Binding Display}" Command="{Binding OpenCommand}"
                                            Margin="0,0,6,6"
                                            ToolTip.Tip="Read your inventory, send &quot;open&quot; for this container, then read it again — only what this open added is listed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <TextBlock Text="Charm" VerticalAlignment="Center"/>
                        <NumericUpDown Width="120" Minimum="0" Maximum="255" Increment="1" FormatString="0"
                                       Value="{Binding Charm, Mode=TwoWay}"/>
                        <Button Content="Sell Tour" Command="{Binding SellTourCommand}" Margin="12,0,0,0"
                                IsVisible="{Binding !IsTourRunning}"
                                ToolTip.Tip="Walk to every shop below in turn and sell each one's items. Shows exactly what will be sold first; only what the chests gave is ever sold, never more — anything you already had stays."/>
                        <Button Content="Cancel tour" Command="{Binding CancelTourCommand}" Margin="12,0,0,0"
                                IsVisible="{Binding IsTourRunning}"
                                ToolTip.Tip="Stop the sell tour. A walk already under way keeps going; nothing more is sold."/>
                        <CheckBox Content="Say loot to the room" IsChecked="{Binding SayLootToRoom, Mode=TwoWay}"
                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                  ToolTip.Tip="Ticked: after each chest is opened (from this tab or by typing), its items and coin are said to the room, so everyone there knows what came out. Off unless you tick it; saved with the character."/>
                        <Button Content="Clear list" Command="{Binding ClearListCommand}" Margin="6,0,0,0"
                                ToolTip.Tip="Empty the list and the coin tally — the items stay in your pack. The list otherwise keeps until each item is sold, dropped, hidden or taken off with ✕, even if you close the Workshop."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Top" Margin="0,4,28,0">
                        <TextBlock Text="Total to sell:"/>
                        <TextBlock Text="{Binding SellTotal}"
                                   Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"
                                   ToolTip.Tip="What you'll earn selling everything below at the quantities set"/>
                    </StackPanel>

                    <!-- Coin the chest gave, one denomination per line, most-expensive first. -->
                    <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Top" MinWidth="120">
                        <TextBlock Text="Coin gained:"/>
                        <TextBlock Text="—" Foreground="{StaticResource ChromeFgMutedBrush}"
                                   IsVisible="{Binding !HasCoinGain}"/>
                        <ItemsControl ItemsSource="{Binding CoinGains}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Scrollable shop groups -->
            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="Open a container above to see what's sellable."
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               IsVisible="{Binding !HasLoot}"/>
                    <TextBlock Text="{Binding SellStatus}" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentAmberBrush}"
                               IsVisible="{Binding HasSellStatus}"/>

                    <ItemsControl ItemsSource="{Binding ShopGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChestOffloadShopGroup">
                                <Border Classes="Box" Margin="0,0,0,2">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Classes="Link" Content="{Binding ShopName}"
                                                        Command="{Binding WalkCommand}"
                                                        IsEnabled="{Binding CanWalk}"
                                                        HorizontalAlignment="Left"
                                                        ToolTip.Tip="Walk to this shop"/>
                                                <TextBlock Text="{Binding LocationLine}" VerticalAlignment="Center"
                                                           IsVisible="{Binding HasLocation}"
                                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                                           ToolTip.Tip="Map/room and the steps to walk there from your current room"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Total}" VerticalAlignment="Center"
                                                       Margin="8,0,10,0"
                                                       Foreground="{StaticResource AccentAmberBrush}"/>
                                            <Button Grid.Column="2" Content="Sell All" Command="{Binding SellCommand}"
                                                    Margin="0,0,6,0"
                                                    ToolTip.Tip="Sell every item's quantity below at this shop — walks there first when you aren't standing in it. Never sells more than the chests gave."/>
                                            <Button Grid.Column="3" Content="Drop All" Command="{Binding DropAllCommand}"
                                                    ToolTip.Tip="Drop every item in this shop's listing and remove it from the sell plan. With Settings → Other → Hide items when discarding ticked, they are hidden in the room instead of dropped; one the room has no room for is tried again in the next room you enter."/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChestOffloadItemRow">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,2">
                                                        <Panel Grid.Column="0" VerticalAlignment="Center">
                                                            <Button x:Name="ShopBtn" Command="{Binding OpenShopMenuCommand}"
                                                                    IsEnabled="{Binding CanChangeShop}"
                                                                    Background="Transparent" BorderThickness="0" Padding="4,0"
                                                                    Cursor="Hand" Margin="0,0,6,0"
                                                                    ToolTip.Tip="Sell this item at a different shop">
                                                                <TextBlock Text="⇄" FontSize="14"
                                                                           Foreground="{StaticResource AccentCyanBrush}"/>
                                                            </Button>
                                                            <Popup PlacementTarget="{Binding #ShopBtn}"
                                                                   Placement="BottomEdgeAlignedLeft"
                                                                   IsLightDismissEnabled="True"
                                                                   IsOpen="{Binding ShopMenuOpen, Mode=TwoWay}">
                                                                <Border Background="{StaticResource ChromeBgBrush}"
                                                                        BorderBrush="{StaticResource ChromeBorderBrush}"
                                                                        BorderThickness="1" CornerRadius="3" Padding="10">
                                                                    <StackPanel Spacing="8" Width="320">
                                                                        <TextBlock Classes="Section" Text="Sell at a different shop"/>
                                                                        <TextBlock Text="No other shop buys this."
                                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                                                                   IsVisible="{Binding !HasShopChoices}"/>
                                                                        <ListBox ItemsSource="{Binding ShopChoices}"
                                                                                 SelectedItem="{Binding SelectedShopChoice, Mode=TwoWay}"
                                                                                 MaxHeight="220" IsVisible="{Binding HasShopChoices}">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ShopChoiceRow">
                                                                                    <StackPanel Spacing="1" Margin="0,2">
                                                                                        <TextBlock Text="{Binding ShopName}" FontWeight="SemiBold"/>
                                                                                        <TextBlock Text="{Binding Detail}"
                                                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                                            <Button Content="Change" Command="{Binding ConfirmShopChangeCommand}"
                                                                                    IsEnabled="{Binding HasShopChoices}"/>
                                                                            <Button Content="Cancel" Command="{Binding CancelShopChangeCommand}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Popup>
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        <NumericUpDown Grid.Column="2" Width="104"
                                                                       Minimum="0" Maximum="{Binding Gained}" Increment="1" FormatString="0"
                                                                       Value="{Binding SellQty, Mode=TwoWay}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Gained, StringFormat='of {0}'}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding LineValue}" VerticalAlignment="Center"
                                                                   Margin="10,0,8,0" MinWidth="90"/>
                                                        <Button Grid.Column="5" Content="Sell" Command="{Binding SellCommand}"
                                                                Margin="0,0,6,0"
                                                                ToolTip.Tip="Sell the quantity picked above at this item's shop — walks there first when you aren't standing in it. The row updates when the game confirms the sale — a refused sale changes nothing."/>
                                                        <Button Grid.Column="6" Content="Drop" Command="{Binding DropCommand}"
                                                                Margin="0,0,6,0"
                                                                ToolTip.Tip="Drop this item's whole held stack — hidden in the room instead when Settings → Other → Hide items when discarding is ticked. The row updates when the game confirms the drop or the hide. A hide the room has no room for keeps the item and is tried again in the next room you enter."/>
                                                        <Button Grid.Column="7" Content="✕" Command="{Binding RemoveCommand}"
                                                                ToolTip.Tip="Take this item off the list — it stays in your pack"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="Box" IsVisible="{Binding HasUnsellable}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="Section" Text="No shop buys these"/>
                            <ItemsControl ItemsSource="{Binding Unsellable}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChestOffloadItemRow">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                            <Button Content="Drop" Command="{Binding DropCommand}"
                                                    ToolTip.Tip="Drop this item's whole held stack — hidden in the room instead when Settings → Other → Hide items when discarding is ticked. The row updates when the game confirms the drop or the hide. A hide the room has no room for keeps the item and is tried again in the next room you enter."/>
                                            <Button Content="✕" Command="{Binding RemoveCommand}"
                                                    ToolTip.Tip="Take this item off the list — it stays in your pack"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
