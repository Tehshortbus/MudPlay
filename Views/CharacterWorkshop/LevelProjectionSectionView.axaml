<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="FujinTerm.Views.CharacterWorkshop.LevelProjectionSectionView"
             x:DataType="vm:LevelProjectionSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,*">

        <!-- What-if controls: target level range + race / class / realm. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Classes="FieldLabel" Text="Levels"/>
                <NumericUpDown Value="{Binding FromLevel}" Minimum="2" Maximum="1000" Increment="1"
                               Width="120" FormatString="0"/>
                <TextBlock Classes="FieldLabel" Text="to"/>
                <NumericUpDown Value="{Binding ToLevel}" Minimum="2" Maximum="1000" Increment="1"
                               Width="120" FormatString="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Classes="FieldLabel" Text="Race"/>
                <ComboBox ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding SelectedRace}" MinWidth="118"/>
                <TextBlock Classes="FieldLabel" Text="Class"/>
                <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" MinWidth="118"/>
            </StackPanel>
            <Button Content="Reset to current" Margin="0,0,0,6"
                    Command="{Binding ResetToCurrentCommand}"
                    ToolTip.Tip="Re-seed Race / Class / Realm and the level range from the live character."/>
        </WrapPanel>

        <!-- Projection grid. The live character's current level row is tinted
             by the code-behind LoadingRow handler. -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  LoadingRow="OnLoadingRow"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lvl" Binding="{ReflectionBinding Level}"
                                    Width="60" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Exp to level" Binding="{ReflectionBinding ExpToLevel}"
                                    Width="150" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Total XP" Binding="{ReflectionBinding TotalXp}"
                                    Width="150" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="HP" Binding="{ReflectionBinding HpRange}"
                                    Width="120" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="HP / tick" Binding="{ReflectionBinding HpRegen}"
                                    Width="90" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Mana / Kai" Binding="{ReflectionBinding Mana}"
                                    Width="100" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="MP / tick" Binding="{ReflectionBinding MpRegen}"
                                    Width="90" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty-state: no class/race resolved (no game data / no `stat` yet). -->
        <TextBlock Grid.Row="1"
                   IsVisible="{Binding !HasProjection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Text="Load a character and game-data set to project levels. Pick a Race and Class above to preview any build."/>
    </Grid>
</UserControl>
