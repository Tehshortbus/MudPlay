<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudPlay.ViewModels.CharacterWorkshop"
             xmlns:vmroot="using:MudPlay.ViewModels"
             xmlns:profile="using:MudPlay.Models.Profile"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="MudPlay.Views.CharacterWorkshop.DeathSectionView"
             x:DataType="vm:DeathSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <!-- MaxWidth keeps the tab from forcing the workshop window ultra-wide: the
         window sizes to its tab's width, so without a cap the wrapping handoff and
         detail text measure at infinite width and stretch to one line. 860 is the
         deathpile grid's own width. -->
    <Grid Margin="22" MaxWidth="860" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header: recovery toggles (current lives live on the Character Info tab). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Auto-Recover Deathpiles"
                      IsChecked="{Binding AutoRecover, Mode=TwoWay}"
                      ToolTip.Tip="On re-entering a room holding your deathpile, grab the recorded pile items (ignoring per-item auto-get policy)."/>
            <CheckBox Content="Auto-Equip After Recovery"
                      Margin="16,0,0,0"
                      IsChecked="{Binding AutoEquip, Mode=TwoWay}"
                      ToolTip.Tip="Re-equip items that were worn at death as they are recovered from the deathpile."/>
        </StackPanel>

        <!-- Action buttons -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="How did I Die?" Margin="0,0,6,6"
                    Command="{Binding HowDidIDieCommand}"
                    ToolTip.Tip="Replay the last ~200 lines of backscroll captured at the moment of this death — so you can see how you died even after the live scrollback has buffered out."/>
            <Button Content="Recover Now" Margin="0,0,6,6"
                    Command="{Binding RecoverNowCommand}"
                    ToolTip.Tip="Recover this deathpile: grab the recorded items in place if you're standing in the death room, otherwise walk there first and grab on arrival."/>
            <Button Content="Mark Recovered" Margin="0,0,6,6"
                    Command="{Binding MarkRecoveredCommand}"/>
            <Button Content="Clear Selected" Margin="0,0,6,6"
                    Command="{Binding ClearSelectedCommand}"/>
            <Button Content="Clear All Recovered" Margin="0,0,18,6"
                    Command="{Binding ClearAllRecoveredCommand}"/>
            <Button Content="Simulate Death" Margin="0,0,6,6"
                    IsVisible="{Binding ShowSimulateDeath}"
                    Command="{Binding SimulateDeathCommand}"
                    ToolTip.Tip="Append a synthetic death record to exercise the grid + recovery flow without dying in game. Shown only while the Log pane's 'Simulate Death button' toggle is on."/>
        </WrapPanel>

        <!-- Deathpile grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                  DoubleTapped="OnRecordDoubleTapped"
                  ToolTip.Tip="Double-click a death to centre the map on its map/room: the room of that number in the game data active now, which is where it died only when that is the death's game data."
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{ReflectionBinding RecordNumber}" SortMemberPath="RecordNumber"
                                    Width="50" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Room" Binding="{ReflectionBinding RoomName, TargetNullValue='—'}" SortMemberPath="RoomName"
                                    Width="240" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Map / Room #" Binding="{ReflectionBinding RoomKeyText}" SortMemberPath="RoomKeyText"
                                    Width="110" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Game data" Binding="{ReflectionBinding GameDataText}" SortMemberPath="GameData"
                                    Width="120" Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Died" Binding="{ReflectionBinding DiedText}" SortMemberPath="At"
                                    Width="180" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="profile:DeathRecord">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="●" VerticalAlignment="Center"
                                           Foreground="{ReflectionBinding Status, Converter={x:Static vmroot:DeathStatusBrushConverter.Instance}}"/>
                                <TextBlock Text="{ReflectionBinding Status}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Other players' corpses recovered with `recover corpse <name> <password>`
             and not yet handed back. Only shown once there is one. -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12"
                IsVisible="{Binding HasHandoffs}"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock Classes="SectionHeader" Text="Corpses to hand back" Margin="0"/>
                <ListBox ItemsSource="{Binding Handoffs}"
                         SelectedItem="{Binding SelectedHandoff, Mode=TwoWay}"
                         MaxHeight="120"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource ChromeBgSunkenBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="profile:CorpseHandoffRecord">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="FieldValue" FontWeight="Normal" TextWrapping="Wrap"
                                           Text="{Binding Summary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="FieldLabel" Text="{Binding RoomText}"/>
                                    <TextBlock Classes="FieldLabel" FontFamily="{StaticResource FontMono}"
                                               Text="{Binding RecoveredText}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" Text="Hand to:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <TextBox Width="180" Margin="0,0,6,6"
                             Text="{Binding HandoffRecipient, Mode=TwoWay}"
                             PlaceholderText="player name"
                             ToolTip.Tip="The player to give everything to. Filled with the corpse's owner when you pick a corpse."/>
                    <Button Content="Corpse handoff" Margin="0,0,6,6"
                            Command="{Binding CorpseHandoffCommand}"
                            ToolTip.Tip="Give that player every item and coin recovered from this corpse, one give at a time. Each one the game confirms comes off the list; anything refused or not answered stays listed."/>
                    <Button Content="Clear" Margin="0,0,6,6"
                            Command="{Binding ClearHandoffCommand}"
                            ToolTip.Tip="Take this corpse off the list without giving anything."/>
                </WrapPanel>
                <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                           IsVisible="{Binding HasHandoffStatus}"
                           Text="{Binding HandoffStatus}"/>
            </StackPanel>
        </Border>

        <!-- Detail panel — always visible, reflecting the selected grid
             row. Bounded height + scroll so long item lists don't stretch
             the section. -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer MaxHeight="200"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <!-- First line: room name + map / room number. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="FieldValue" VerticalAlignment="Center"
                                   Text="{Binding SelectedRecord.RoomName, FallbackValue='—', TargetNullValue='Unknown room'}"/>
                        <TextBlock Classes="FieldLabel" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontMono}"
                                   Text="{Binding SelectedRecord.RoomKeyText, FallbackValue='—'}"/>
                        <TextBlock Classes="FieldLabel" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontMono}"
                                   Text="{Binding SelectedRecord.DiedText, FallbackValue=''}"/>
                    </StackPanel>

                    <!-- Recovery status: for a Partial record, names the pile
                         items that weren't seen picked up, so the stoplight has a
                         reason instead of just a colour (report 214157). Hidden
                         for a fresh Active record with no note. -->
                    <StackPanel Spacing="2" IsVisible="{Binding HasRecoveryDetail}">
                        <TextBlock Classes="SectionHeader" Text="Recovery" Margin="0,0,0,2"/>
                        <TextBlock Classes="FieldValue" FontWeight="Normal" TextWrapping="Wrap"
                                   Text="{Binding RecoveryDetailText}"/>
                    </StackPanel>

                    <!-- Worn-loss vs carried-loss, split into two columns.
                         Captured from the inventory tracker's last-known
                         snapshot at death (one item per line, coins listed by
                         denomination under the carried half; "None recorded."
                         when the snapshot was empty or pre-tracking). -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="Equipment Lost" Margin="0,0,0,2"/>
                            <TextBlock Classes="FieldValue" TextWrapping="Wrap" FontWeight="Normal"
                                       Text="{Binding SelectedRecord.EquippedAtDeathText, FallbackValue='—'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="Inventory lost" Margin="0,0,0,2"/>
                            <TextBlock Classes="FieldValue" TextWrapping="Wrap" FontWeight="Normal"
                                       Text="{Binding SelectedRecord.LostItemsText, FallbackValue='—'}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
