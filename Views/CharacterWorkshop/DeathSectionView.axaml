<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
             xmlns:vmroot="using:FujinTerm.ViewModels"
             xmlns:profile="using:FujinTerm.Models.Profile"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="FujinTerm.Views.CharacterWorkshop.DeathSectionView"
             x:DataType="vm:DeathSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Death Recovery"
                   Foreground="{StaticResource ChromeFgBrush}"
                   FontSize="{StaticResource FontSizeLg}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <!-- Header: toggles + lives -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
            <CheckBox Grid.Column="0" Content="Auto-Recover Deathpiles"
                      IsChecked="{Binding AutoRecover, Mode=TwoWay}"
                      ToolTip.Tip="On re-entering a room holding your deathpile, grab the lost items (ignoring per-item auto-get policy). Item grab is inert until inventory tracking lands; the preference persists now."/>
            <CheckBox Grid.Column="1" Content="Auto-Equip After Recovery"
                      Margin="16,0,0,0"
                      IsChecked="{Binding AutoEquip, Mode=TwoWay}"
                      ToolTip.Tip="Re-equip items that were worn at death after recovering them. Inert until inventory tracking records what was equipped at death."/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="FieldLabel" Text="Lives:" VerticalAlignment="Center"/>
                <TextBlock Classes="FieldValue" Text="{Binding LivesRemaining}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Action buttons -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Recover Now" Margin="0,0,6,6"
                    Command="{Binding RecoverNowCommand}"
                    ToolTip.Tip="Recover this deathpile: grab the matching items in place if you're standing in the death room, otherwise walk there first. Item grab is inert until inventory tracking lands."/>
            <Button Content="Mark Recovered" Margin="0,0,6,6"
                    Command="{Binding MarkRecoveredCommand}"/>
            <Button Content="View Entry" Margin="0,0,6,6"
                    Command="{Binding ViewEntryCommand}"/>
            <Button Content="Clear Selected" Margin="0,0,6,6"
                    Command="{Binding ClearSelectedCommand}"/>
            <Button Content="Clear All Recovered" Margin="0,0,18,6"
                    Command="{Binding ClearAllRecoveredCommand}"/>
            <Button Content="Simulate Death" Margin="0,0,6,6"
                    Command="{Binding SimulateDeathCommand}"
                    ToolTip.Tip="Append a synthetic death record to exercise the grid + recovery flow without dying in game."/>
        </WrapPanel>

        <!-- Deathpile grid -->
        <DataGrid Grid.Row="3"
                  DoubleTapped="OnRecordDoubleTapped"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                  Background="{StaticResource ChromeBgSunkenBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource ChromeBorderBrush}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{ReflectionBinding RecordNumber}" SortMemberPath="RecordNumber"
                                    Width="50" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Room" Binding="{ReflectionBinding RoomName, TargetNullValue='—'}" SortMemberPath="RoomName"
                                    Width="240" Foreground="{StaticResource ChromeFgBrush}"/>
                <DataGridTextColumn Header="Map / Room #" Binding="{ReflectionBinding RoomKeyText}" SortMemberPath="RoomKeyText"
                                    Width="110" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTextColumn Header="Died" Binding="{ReflectionBinding DiedText}" SortMemberPath="At"
                                    Width="180" FontFamily="{StaticResource FontMono}"
                                    Foreground="{StaticResource ChromeFgSecBrush}"/>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="profile:DeathRecord">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="●" VerticalAlignment="Center"
                                           Foreground="{ReflectionBinding Status, Converter={x:Static vmroot:DeathStatusBrushConverter.Instance}}"/>
                                <TextBlock Text="{ReflectionBinding Status}" VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail panel for the selected record (double-click a row /
             View Entry). Bounded height + scroll so long item lists don't
             stretch the section. -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1" CornerRadius="4"
                IsVisible="{Binding DetailsVisible}">
            <ScrollViewer MaxHeight="200"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <!-- First line: room name + map / room number. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="FieldValue" VerticalAlignment="Center"
                                   Text="{Binding SelectedRecord.RoomName, FallbackValue='—', TargetNullValue='Unknown room'}"/>
                        <TextBlock Classes="FieldLabel" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontMono}"
                                   Text="{Binding SelectedRecord.RoomKeyText, FallbackValue='—'}"/>
                        <TextBlock Classes="FieldLabel" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontMono}"
                                   Text="{Binding SelectedRecord.DiedText, FallbackValue=''}"/>
                    </StackPanel>

                    <!-- Equipped vs inventory item loss, split MudProxy-style.
                         Both lists are placeholders until inventory tracking
                         records what was worn / carried at death. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="Equipped at death" Margin="0,0,0,2"/>
                            <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                       Text="Recorded once inventory tracking lands."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="Inventory lost" Margin="0,0,0,2"/>
                            <TextBlock Classes="FieldLabel" TextWrapping="Wrap"
                                       Text="Recorded once inventory tracking lands."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
