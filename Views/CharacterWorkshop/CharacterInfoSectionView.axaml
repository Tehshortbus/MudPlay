<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FujinTerm.ViewModels.CharacterWorkshop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
             x:Class="FujinTerm.Views.CharacterWorkshop.CharacterInfoSectionView"
             x:DataType="vm:CharacterInfoSectionViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        </Style>
        <Style Selector="Border.Box">
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="22" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="14" HorizontalAlignment="Left">

                <!-- ===== Box A: Base Stats (mirrors the in-game `stat` screen) =====
                     Three columns, same grouping the game prints: identity + vitals +
                     prime stats on the left two columns, the skill block on the right,
                     and the alignment standing on its own line at the bottom (where the
                     game prints "You are <standing>."). -->
                <Border Grid.Column="0" Classes="Box" VerticalAlignment="Top">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Row 0: Name (spans the two left columns) | Lives/CP -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Name" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Classes="FieldValue" Text="{Binding Name}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Classes="FieldLabel" Text="Lives/CP" Margin="0,0,8,3"/>
                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Classes="FieldValue" Text="{Binding Lives}"/>
                            <TextBlock Classes="FieldValue" Text="/"/>
                            <TextBlock Classes="FieldValue" Text="{Binding Cp}"/>
                        </StackPanel>

                        <!-- Row 1: Race | Exp | Perception -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Race" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding Race}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="FieldLabel" Text="Exp" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Classes="FieldValue" Text="{Binding Exp}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Classes="FieldLabel" Text="Perception" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="5" Classes="FieldValue" Text="{Binding Perception}" Margin="0,0,0,3"/>

                        <!-- Row 2: Class | Level | Stealth -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Class" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding CharClass}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Classes="FieldLabel" Text="Level" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="FieldValue" Text="{Binding Level}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Classes="FieldLabel" Text="Stealth" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="5" Classes="FieldValue" Text="{Binding Stealth}" Margin="0,0,0,3"/>

                        <!-- Row 3: Hits | Armour Class | Thievery -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Hits" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding Hits}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Classes="FieldLabel" Text="Armour Class" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Classes="FieldValue" Text="{Binding ArmourClass}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" Classes="FieldLabel" Text="Thievery" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="5" Classes="FieldValue" Text="{Binding Thievery}" Margin="0,0,0,3"/>

                        <!-- Row 4: Mana/Kai | Traps -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="{Binding ManaLabel}" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="FieldValue" Text="{Binding ManaValue}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Classes="FieldLabel" Text="Traps" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="5" Classes="FieldValue" Text="{Binding Traps}" Margin="0,0,0,3"/>

                        <!-- Row 5: (left blank) | Picklocks -->
                        <TextBlock Grid.Row="5" Grid.Column="4" Classes="FieldLabel" Text="Picklocks" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="5" Grid.Column="5" Classes="FieldValue" Text="{Binding Picklocks}" Margin="0,0,0,3"/>

                        <!-- Row 6: Strength | Agility | Tracking -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="FieldLabel" Text="Strength" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="FieldValue" Text="{Binding Strength}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Classes="FieldLabel" Text="Agility" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Classes="FieldValue" Text="{Binding Agility}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="4" Classes="FieldLabel" Text="Tracking" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="5" Classes="FieldValue" Text="{Binding Tracking}" Margin="0,0,0,3"/>

                        <!-- Row 7: Intellect | Health | Martial Arts -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="FieldLabel" Text="Intellect" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Classes="FieldValue" Text="{Binding Intellect}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Classes="FieldLabel" Text="Health" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="3" Classes="FieldValue" Text="{Binding Health}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="4" Classes="FieldLabel" Text="Martial Arts" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="5" Classes="FieldValue" Text="{Binding MartialArts}" Margin="0,0,0,3"/>

                        <!-- Row 8: Willpower | Charm | Magic Res -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="FieldLabel" Text="Willpower" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Classes="FieldValue" Text="{Binding Willpower}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Classes="FieldLabel" Text="Charm" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="3" Classes="FieldValue" Text="{Binding Charm}" Margin="0,0,20,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="4" Classes="FieldLabel" Text="Magic Res" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="5" Classes="FieldValue" Text="{Binding MagicRes}" Margin="0,0,0,3"/>

                        <!-- Row 9: (left blank) | Spellcasting -->
                        <TextBlock Grid.Row="9" Grid.Column="4" Classes="FieldLabel" Text="Spellcasting" Margin="0,0,8,3"/>
                        <TextBlock Grid.Row="9" Grid.Column="5" Classes="FieldValue" Text="{Binding Spellcasting}" Margin="0,0,0,3"/>

                        <!-- Row 10: Alignment standing (the game's "You are <standing>." line).
                             "A dark cloud passes over you" drops alignment but the word only
                             refreshes on the next `who` — flag it stale until then. -->
                        <TextBlock Grid.Row="10" Grid.Column="0" Classes="FieldLabel" Text="Alignment" Margin="0,10,8,0"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="5"
                                    Orientation="Horizontal" Margin="0,10,0,0" Spacing="6">
                            <TextBlock Classes="FieldValue" Text="{Binding Alignment}"/>
                            <TextBlock VerticalAlignment="Center" FontStyle="Italic"
                                       IsVisible="{Binding AlignmentStale}"
                                       Foreground="{StaticResource AccentAmberBrush}"
                                       Text="(stale — type ‘who’ to refresh)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Right column: Box B + Box C ===== -->
                <StackPanel Grid.Column="1" Spacing="14" HorizontalAlignment="Left">

                    <!-- Box B: Equipment Bonuses -->
                    <Border Classes="Box">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Equipment Bonuses"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       FontSize="{StaticResource FontSizeMd}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBlock Classes="FieldLabel"
                                       Text="No worn item contributes a bonus."
                                       IsVisible="{Binding !HasBonuses}"/>

                            <ItemsControl ItemsSource="{Binding BonusRows}"
                                          IsVisible="{Binding HasBonuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:EquipBonusRow">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ToolTip.Tip="{Binding Tooltip}">
                                            <TextBlock Grid.Column="0" Classes="FieldLabel"
                                                       Text="{Binding Stat}" Margin="0,0,12,2"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Foreground="{StaticResource AccentRedBrush}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeMd}"
                                                       Margin="0,0,0,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Quest Bonuses: completed-quest permanent rewards. Shown only
                         when at least one completed quest grants a bonus, so it stays
                         out of the way for characters with no quest rewards yet. -->
                    <Border Classes="Box" IsVisible="{Binding HasQuestBonuses}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Quest Bonuses"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       FontSize="{StaticResource FontSizeMd}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding QuestBonusRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:EquipBonusRow">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="FieldLabel"
                                                       Text="{Binding Stat}" Margin="0,0,12,2"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       Foreground="{StaticResource AccentAmberBrush}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeMd}"
                                                       Margin="0,0,0,2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Box C: Derived Combat -->
                    <Border Classes="Box">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldLabel" Text="Accy" Margin="0,0,16,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="FieldLabel" Text="Dmg" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Attack" Margin="0,0,18,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding AttackAccuracy}" Margin="0,0,16,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="FieldValue" Text="{Binding AttackDamage}" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Bash" Margin="0,0,18,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding BashAccuracy}" Margin="0,0,16,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="FieldValue" Text="{Binding BashDamage}" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="Smash" Margin="0,0,18,3"
                                           IsVisible="{Binding ShowSmash}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding SmashAccuracy}" Margin="0,0,16,3"
                                           IsVisible="{Binding ShowSmash}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Classes="FieldValue" Text="{Binding SmashDamage}" Margin="0,0,0,3"
                                           IsVisible="{Binding ShowSmash}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Backstab" Margin="0,0,18,3"
                                           IsVisible="{Binding ShowBackstab}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="FieldValue" Text="{Binding BackstabAccuracy}" Margin="0,0,16,3"
                                           IsVisible="{Binding ShowBackstab}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Classes="FieldValue" Text="{Binding BackstabDamage}" Margin="0,0,0,3"
                                           IsVisible="{Binding ShowBackstab}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="FieldLabel" Text="Punch" Margin="0,0,18,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Classes="FieldValue" Text="{Binding PunchAccuracy}" Margin="0,0,16,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Classes="FieldValue" Text="{Binding PunchDamage}" Margin="0,0,0,3"
                                           IsVisible="{Binding ShowMartialArts}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Classes="FieldLabel" Text="Kick" Margin="0,0,18,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Classes="FieldValue" Text="{Binding KickAccuracy}" Margin="0,0,16,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Classes="FieldValue" Text="{Binding KickDamage}" Margin="0,0,0,3"
                                           IsVisible="{Binding ShowMartialArts}"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Classes="FieldLabel" Text="Jumpkick" Margin="0,0,18,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Classes="FieldValue" Text="{Binding JumpKickAccuracy}" Margin="0,0,16,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Classes="FieldValue" Text="{Binding JumpKickDamage}" Margin="0,0,0,3"
                                           IsVisible="{Binding ShowMartialArts}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Box D: Monster Matchup -->
                    <Border Classes="Box">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Monster Matchup"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       FontSize="{StaticResource FontSizeMd}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <AutoCompleteBox ItemsSource="{Binding MonsterNames}"
                                             SelectedItem="{Binding SelectedMonsterName, Mode=TwoWay}"
                                             FilterMode="ContainsOrdinal"
                                             MinimumPrefixLength="1"
                                             PlaceholderText="Type a monster name…"
                                             Margin="0,0,0,8"/>

                            <TextBlock Classes="FieldLabel"
                                       Text="Pick a monster to preview both hit directions."
                                       IsVisible="{Binding !HasMatchup}"/>

                            <StackPanel Spacing="2" IsVisible="{Binding HasMatchup}">
                                <TextBlock Text="You → Monster"
                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                           FontSize="{StaticResource FontSizeMd}"
                                           FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Hit Chance" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupPlayerHit}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Damage" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupPlayerDamage}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="FieldLabel" Text="Swings/Rnd" Margin="0,0,12,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupSwings}" Margin="0,0,0,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="FieldLabel" Text="DPS" Margin="0,0,12,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupDps}" Margin="0,0,0,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="FieldLabel" Text="Rounds to Kill" Margin="0,0,12,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupRounds}" Margin="0,0,0,2"
                                               IsVisible="{Binding MatchupHasWeapon}"/>
                                </Grid>

                                <TextBlock Text="Monster → You"
                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                           FontSize="{StaticResource FontSizeMd}"
                                           FontWeight="SemiBold" Margin="0,8,0,3"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Hit Chance" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupMonsterHit}" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="FieldLabel" Text="Damage" Margin="0,0,12,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="FieldValue" Text="{Binding MatchupMonsterDamage}" Margin="0,0,0,2"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Refresh controls (bottom; the section title lives in the workshop nav rail) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="Reset" Margin="0,0,6,0"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Re-pull the live stat snapshot, re-aggregate worn gear, and recompute combat accuracy."/>
            <Button Grid.Column="2" Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Re-read the current inventory and recompute equipment bonuses + combat accuracy."/>
        </Grid>
    </Grid>
</UserControl>
