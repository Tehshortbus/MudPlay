<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Profile"
        xmlns:models="using:FujinTerm.Models.Profile"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="420"
        x:Class="FujinTerm.Views.Profile.ProfilePickerDialog"
        x:DataType="vm:ProfilePickerDialogViewModel"
        Title="{Binding WindowTitle}"
        Width="380" Height="420"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

            <TextBlock Grid.Row="0"
                       Text="{Binding Prompt}"
                       Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="1"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <ListBox Name="ProfilesList"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             DoubleTapped="OnRowDoubleTapped"
                             IsVisible="{Binding HasProfiles}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProfileRef">
                                <TextBlock>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text="  —  " Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                    <Run Text="{Binding Bbs}" Foreground="{StaticResource ChromeFgBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="{StaticResource ChromeFgMutedBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="16"
                               IsVisible="{Binding !HasProfiles}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{Binding ConfirmLabel}" Command="{Binding OpenCommand}"
                        IsEnabled="{Binding HasSelection}"
                        IsDefault="True" MinWidth="80"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsCancel="True"  MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
