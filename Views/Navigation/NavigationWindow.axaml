<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        xmlns:gd="using:MudPlay.ViewModels.GameData.Edit"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:controls="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="MudPlay.Views.Navigation.NavigationWindow"
        x:DataType="vm:NavigationViewModel"
        Title="Navigation"
        Width="1280" Height="720"
        MinWidth="{Binding WindowMinWidth}" MinHeight="{Binding WindowMinHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Display-toggle chip (Lairs / Shops / Spells / Legend) — colour-
             coded per chip to mirror the map fill brushes so the toggle's
             active state matches the room glyphs the user is filtering. -->
        <Style Selector="Button.ToggleChip">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>
        <!-- Lair: pink/magenta (MapControl.LairFill) -->
        <Style Selector="Button.ToggleChip.LairFill">
            <Setter Property="Background" Value="#8E4F7B"/>
            <Setter Property="BorderBrush" Value="#8E4F7B"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <!-- Shop: blue (MapControl.ShopFill) -->
        <Style Selector="Button.ToggleChip.ShopFill">
            <Setter Property="Background" Value="#4A7791"/>
            <Setter Property="BorderBrush" Value="#4A7791"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <!-- Spell: purple (MapControl.SpellFill) -->
        <Style Selector="Button.ToggleChip.SpellFill">
            <Setter Property="Background" Value="#6428A0"/>
            <Setter Property="BorderBrush" Value="#6428A0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- Legend: neutral amber (no map equivalent) -->
        <Style Selector="Button.ToggleChip.LegendFill">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <!-- Per-lair miss cell in the estimator readout: amber when a miss came within
             a whisker of respawning (nudge the loop to catch it), dim otherwise. -->
        <Style Selector="TextBlock.MissCell">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>
        <Style Selector="TextBlock.MissCell.NearMiss">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
        </Style>

        <!-- Transparent, chrome-free ListBox for rail lists. Using a ListBox (not a
             plain ItemsControl) is deliberate: its internal ScrollViewer +
             HorizontalScrollBarVisibility=Disabled constrains row width to the rail,
             so a long room name can't push the whole section wider than its
             neighbours. Same pattern the CURRENT NAV list uses. -->
        <Style Selector="ListBox.RailList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.RailList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.RailList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.RailList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Top-right action button (Run / Stop / Loop mode / Lair mode) -->
        <Style Selector="Button.ActionChip">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource ChromeBgElevBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="Button.ActionChip.Active">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
        <Style Selector="Button.ActionChip.Stop">
            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Button.ActionChip.Primary">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
        <!-- Run: green when the action chip is in "start something"
             mode. Pause: yellow when it's in "halt the in-flight
             engine" mode. Distinct from Stop (red, full teardown)
             so the user can tell at a glance whether a click will
             pause-resumable or hard-stop. -->
        <Style Selector="Button.ActionChip.Run">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Button.ActionChip.Pause">
            <Setter Property="Background" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
        </Style>

        <!-- Right-rail section header -->
        <Style Selector="TextBlock.RailSectionHeader">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <!-- GOTO header is blue-themed to match the walk-to line
             colour on the map. -->
        <Style Selector="TextBlock.RailSectionHeader.Goto">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
        <!-- CURRENT NAV header recolours per running engine so the
             user sees at a glance which line on the map drives the
             header: orange Auto-Lair, green loop, blue walk-to. -->
        <Style Selector="TextBlock.RailSectionHeader.CurrentNavLair">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
        <Style Selector="TextBlock.RailSectionHeader.CurrentNavLoop">
            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.RailSectionHeader.CurrentNavWalk">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>

        <!-- Compact right-rail Expander — slimmer header, no chrome
             box, chevron on the right. HorizontalAlignment=Stretch +
             HorizontalContentAlignment=Stretch so the section keeps a
             stable rail-fitting width whether collapsed or expanded. -->
        <Style Selector="Expander.RailSection">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.RailSection /template/ ToggleButton#PART_toggle">
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.RailSection /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ROOM INFO clickable game-data record link — cyan mono, underline on
             hover, chrome-free; mirrors the room-detail popup's MdbLink. -->
        <Style Selector="Button.RecordLink">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.RecordLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
        <!-- ROOM INFO title — the room name itself is the link to the room record.
             Bold like a header but clickable (hand cursor, underline on hover). -->
        <Style Selector="Button.RoomTitleLink">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.RoomTitleLink /template/ ContentPresenter">
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.RoomTitleLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
        <!-- Muted sub-group label inside ROOM INFO. -->
        <Style Selector="TextBlock.RoomInfoGroup">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>

        <!-- Engine-state badge in the top bar — Idle grey, Walking +
             Looping green, Auto-Lair orange. -->
        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.StatusBadge TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="Border.StatusBadge.WalkingState">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.StatusBadge.WalkingState TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="Border.StatusBadge.LoopingState">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.StatusBadge.LoopingState TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="Border.StatusBadge.LairState">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
        <Style Selector="Border.StatusBadge.LairState TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <!-- Tier overlays — engine-recovery gate state. Border-only;
             fill stays the engine colour. Tier 2 = gate watching for
             1-of-1 recovery (yellow); Tier 3 = backtrack recovery
             active (red). -->
        <Style Selector="Border.StatusBadge.Tier2State">
            <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.StatusBadge.Tier3State">
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Live activity chip next to the loop name — answers "why is the
             engine held right now?": Moving (green), Fighting (red), Waiting
             (amber, with the reason), or Paused (muted, user-initiated). -->
        <Style Selector="Border.ActivityChip">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeBorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.ActivityChip TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityMoving">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityMoving TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityFighting">
            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityFighting TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityWaiting">
            <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
        </Style>
        <Style Selector="Border.ActivityChip.ActivityWaiting TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>

        <!-- CURRENT NAV step row dynamic styling -->
        <Style Selector="Border.NavRow">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="Border.NavRow.Current">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Border.NavRow.Current TextBlock">
            <Setter Property="Foreground" Value="#0E0E0E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.NavRow.Completed TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
        <Style Selector="Border.NavRow.Upcoming TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>
        <Style Selector="Border.NavRow.Ready TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Top-bar status line severity: default grey, amber when movement is
             held for a reason, red when a nav action failed. A base class carries
             the default so the override classes (style setters) can win — an
             inline Foreground would beat them. -->
        <Style Selector="TextBlock.TopBarStatus">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgSecBrush}"/>
        </Style>
        <Style Selector="TextBlock.TopBarStatus.StatusWarning">
            <Setter Property="Foreground" Value="{StaticResource SeverityWarnBrush}"/>
        </Style>
        <Style Selector="TextBlock.TopBarStatus.StatusFailure">
            <Setter Property="Foreground" Value="{StaticResource SeverityErrorBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: status badge + activity chip + status text, then the
             selected-room chip + search box + collapse/expand toggle pinned to
             the top-right corner -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="12,6">
                <!-- Engine-state badge — IDLE / WALKING / LOOPING / AUTO-LAIR.
                     Tier overlays paint the border yellow / red on top of
                     whichever engine fill is active. -->
                <Border Grid.Column="0"
                        Classes="StatusBadge"
                        Classes.WalkingState="{Binding EngineActionIsWalking}"
                        Classes.LoopingState="{Binding EngineActionIsLooping}"
                        Classes.LairState="{Binding EngineActionIsLair}"
                        Classes.Tier2State="{Binding IsTier2}"
                        Classes.Tier3State="{Binding IsTier3}">
                    <TextBlock Text="{Binding TopBarStatusBadge}"/>
                </Border>
                <!-- Live activity chip — the moving / fighting / waiting-why /
                     paused reason, straight from the movement-coordinator gates.
                     Hidden while idle. Sits before the loop-name text so it's
                     never eaten by that text's ellipsis. -->
                <Border Grid.Column="1"
                        Classes="ActivityChip"
                        IsVisible="{Binding HasActivityStatus}"
                        Classes.ActivityMoving="{Binding ActivityIsMoving}"
                        Classes.ActivityFighting="{Binding ActivityIsFighting}"
                        Classes.ActivityWaiting="{Binding ActivityIsWaiting}"
                        Classes.ActivityPaused="{Binding ActivityIsPaused}">
                    <TextBlock Text="{Binding ActivityStatus}"/>
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding TopBarStatusText}"
                           ToolTip.Tip="{Binding TopBarStatusText}"
                           Classes="TopBarStatus"
                           Classes.StatusWarning="{Binding StatusIsWarning}"
                           Classes.StatusFailure="{Binding StatusIsFailure}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Goto button — rides just left of the search box. Shows the armed
                     destination (or "Go to…"); resolving the search box flips it to a
                     room. Click opens the recent-destination flyout, which is anchored
                     to the search box (below) so it drops down over the right rail. -->
                <Button Grid.Column="3"
                        IsVisible="{Binding MapExpanded}"
                        Click="OnGotoButtonClick"
                        Background="{StaticResource ChromeBgElevBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip.Tip="Recent destinations — click to pick one; type in the search box to set a new target.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding GotoButtonLabel}"
                                   FontSize="11"
                                   Foreground="{StaticResource ChromeFgBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200"/>
                        <TextBlock Text="▾"
                                   FontSize="10"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Search box — top-right corner of the header. Hidden while the
                     map is collapsed (search has no target rail to show results
                     against in that mode). -->
                <TextBox Grid.Column="4" Classes="clearable"
                         Name="SearchBox"
                         IsVisible="{Binding MapExpanded}"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         KeyDown="OnSearchBoxKeyDown"
                         PlaceholderText="Search rooms, lairs, loops…"
                         Width="150"
                         MinHeight="24"
                         Height="24"
                         Padding="7,2"
                         FontSize="11"
                         VerticalAlignment="Center">
                    <!-- Recent-destinations flyout lives on the search box (not the
                         goto button) so it drops straight down over the right rail,
                         matching its 290-wide column. The goto button's Click opens it
                         via FlyoutBase.ShowAttachedFlyout. -->
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="290" Spacing="3">
                                <Button Content="Clear destination"
                                        Command="{Binding ClearQueuedDestinationCommand}"
                                        Click="OnClearDestinationClick"
                                        IsVisible="{Binding HasQueuedDestination}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        FontSize="11"/>
                                <TextBlock Text="Recent destinations"
                                           FontSize="10"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding HasGotoHistory}"/>
                                <ListBox ItemsSource="{Binding GotoHistoryRows}"
                                         SelectedItem="{Binding SelectedGotoHistory, Mode=TwoWay}"
                                         SelectionChanged="OnGotoHistorySelected"
                                         MaxHeight="240"
                                         IsVisible="{Binding HasGotoHistory}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:GotoHistoryRowViewModel">
                                            <TextBlock Text="{Binding Label}"
                                                       ToolTip.Tip="{Binding Label}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No recent destinations."
                                           FontSize="11"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                           IsVisible="{Binding !HasGotoHistory}"/>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </TextBox>

                <!-- Collapse / expand the side chrome so the map can fill the
                     window (and the window shrink narrower than the rail).
                     Arrow points the direction the next click takes: ◀ collapse,
                     ▶ expand. -->
                <Button Grid.Column="5"
                        Content="{Binding MapCollapseGlyph}"
                        Command="{Binding ToggleMapExpandedCommand}"
                        ToolTip.Tip="{Binding MapCollapseTooltip}"
                        Background="{StaticResource ChromeBgElevBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,2"
                        MinHeight="24"
                        Height="24"
                        FontSize="11"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: chip row (display toggles + actions) -->
        <Border Grid.Row="1"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="12,6"
                  ColumnSpacing="6">
                <!-- Map-overlay toggles, tucked into a flyout to save bar room.
                     The Manage button lives down in the loops-rail footer
                     (already wired to OpenManagerCommand). -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding MapExpanded}">
                    <Button Classes="ToggleChip" Content="Overlays ▾"
                            ToolTip.Tip="Map overlays — lairs, shops, spells, legend.">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Orientation="Vertical" Spacing="4" Margin="2" MinWidth="120">
                                    <Button Classes="ToggleChip" Content="{Binding LairButtonLabel}"
                                            Command="{Binding ToggleLairsCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            ToolTip.Tip="Lair highlight: click to cycle uniform colour → respawn heat-map → max-monster count → heat-map + count → off. Your choice is saved per character."
                                            Classes.LairFill="{Binding HighlightLairs}"/>
                                    <Button Classes="ToggleChip" Content="Shops"
                                            Command="{Binding ToggleShopsCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Classes.ShopFill="{Binding HighlightShops}"/>
                                    <Button Classes="ToggleChip" Content="{Binding SpellButtonLabel}"
                                            Command="{Binding ToggleSpellsCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            ToolTip.Tip="Room-spell highlight: click to cycle one flat colour → colour each room by its spell (hover a room to see the spell name) → off. Your choice is saved per character."
                                            Classes.SpellFill="{Binding HighlightSpells}"/>
                                    <Button Classes="ToggleChip" Content="Legend"
                                            Command="{Binding ToggleLegendCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Classes.LegendFill="{Binding LegendVisible}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Centred readouts filling the flex gap between the toggle
                     chips and the action chips: the player's live room and the
                     cyan-boxed selection, side by side (single row) so they
                     don't add height to the bar. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <TextBlock Text="{Binding CurrentRoomText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource ChromeFgSecBrush}"/>
                    <TextBlock Text="{Binding SelectedRoomText}"
                               IsVisible="{Binding MapExpanded}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource ChromeFgSecBrush}"/>
                </StackPanel>

                <!-- Action chips (Save / Run / Loop-mode / Lair-mode) share one
                     row-end strip so the whole group hides together when the map
                     is collapsed, leaving just the display toggles + current-room
                     readout above the full-width map. -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding MapExpanded}">
                    <!-- Save — opens the appropriate editor dialog
                         (LoopEditor / LairEditor) pre-seeded with the
                         current build session OR running engine state.
                         Enabled in four cases: Loop build mode with
                         savable clicks, Loop running, AutoLair build
                         mode with markers, AutoLair running with
                         markers. -->
                    <Button Classes="ActionChip"
                            Content="Save"
                            ToolTip.Tip="Save the current loop / lair setup."
                            IsVisible="{Binding !EngineActionIsWalking}"
                            Command="{Binding SaveCurrentCommand}"
                            IsEnabled="{Binding CanSaveCurrent}"/>

                    <!-- Walk-to has no savable setup, so its Save slot becomes the
                         walk's Pause/Resume chip (parity with the loop/lair
                         pause affordance). Keys off the user-override tier, so a
                         mid-walk fight doesn't flip it to Resume. -->
                    <Button Classes="ActionChip"
                            Classes.Run="{Binding IsWalkUserPaused}"
                            Classes.Pause="{Binding !IsWalkUserPaused}"
                            Content="{Binding WalkPauseLabel}"
                            ToolTip.Tip="Pause / resume the walk-to."
                            IsVisible="{Binding EngineActionIsWalking}"
                            Command="{Binding PauseOrResumeCommand}"/>

                    <!-- Run / Pause — loop running shows "Pause" (assert
                         user gate + open builder seeded from running loop);
                         loop paused shows "Run" (resume); walker/auto-lair
                         keep the legacy Run/Stop one-shot semantics. -->
                    <Button Classes="ActionChip"
                            Classes.Run="{Binding !IsAnyExecuting}"
                            Classes.Pause="{Binding IsAnyExecuting}"
                            Content="{Binding RunStopLabel}"
                            Command="{Binding RunStopCommand}"
                            IsEnabled="{Binding CanRun}"/>

                    <!-- Loop mode chip — doubles as the full Stop when a
                         loop is running. The dispatcher
                         LoopModeButtonCommand routes to StopAll when in
                         Stop mode, ToggleLoopMode otherwise, so the user
                         sees a single chip that always means "exit the
                         current loop context." -->
                    <Button Classes="ActionChip"
                            Classes.Active="{Binding IsLoopMode}"
                            Classes.Stop="{Binding LoopModeButtonIsStop}"
                            Content="{Binding LoopModeButtonLabel}"
                            Command="{Binding LoopModeButtonCommand}"/>

                    <!-- Lair mode -->
                    <Button Classes="ActionChip"
                            Classes.Active="{Binding IsLairMode}"
                            Classes.Stop="{Binding LairModeButtonIsStop}"
                            Content="{Binding LairModeButtonLabel}"
                            Command="{Binding LairModeButtonCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: map + right rail. Second column is Auto so that hiding the
             rail (collapsed map) drops it to zero width and the map spans the
             whole row; the rail Border carries the fixed 290 width when shown. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

            <controls:MapControl Grid.Column="0"
                                 Name="MapHost"
                                 Layout="{Binding Layout}"
                                 CurrentRoomKey="{Binding CurrentRoomKey}"
                                 DestinationRoomKey="{Binding DestinationRoomKey}"
                                 WhereTargetRooms="{Binding WhereTargetRooms}"
                                 Graph="{Binding Graph}"
                                 LairMode="{Binding LairMode}"
                                 LairRespawnSeconds="{Binding LairRespawnSeconds}"
                                 LairMaxRespawnSeconds="{Binding LairMaxRespawnSeconds}"
                                 LairMonsterCounts="{Binding LairMonsterCounts}"
                                 HighlightShops="{Binding HighlightShops}"
                                 SpellMode="{Binding SpellMode}"
                                 NavLineStyles="{Binding NavLineStyles}"
                                 WalkPath="{Binding WalkPath}"
                                 PreviewPath="{Binding PreviewPath}"
                                 LoopPath="{Binding LoopPath}"
                                 LoopBuilderPath="{Binding LoopBuilderPath}"
                                 LoopBuilderWaypoints="{Binding LoopBuilderWaypoints}"
                                 LoopApproachPreviewPath="{Binding LoopApproachPreviewPath}"
                                 AvoidedRooms="{Binding AvoidedRooms}"
                                 StashRooms="{Binding StashRooms}"
                                 GhRooms="{Binding GhRooms}"
                                 LoopSequenceNumbers="{Binding LoopSequenceNumbers}"
                                 AutoLairRooms="{Binding AutoLairRooms}"
                                 AutoLairWaypoints="{Binding AutoLairMarkedKeys}"
                                 AutoLairApproachPath="{Binding AutoLairApproachPath}"
                                 TeleportRooms="{Binding TeleportRooms}"
                                 DeathRooms="{Binding DeathRooms}"
                                 BossRooms="{Binding BossRooms}"
                                 StopBeforeBossRooms="{Binding StopBeforeBossRooms}"
                                 TrainerRooms="{Binding TrainerRooms}"
                                 WalkPathIsAutoLair="{Binding IsAutoLairing}"
                                 SelectedRoomKey="{Binding SelectedRoomKey, Mode=TwoWay}"
                                 UpStepChord="{Binding UpStepChord}"
                                 DownStepChord="{Binding DownStepChord}"
                                 CompassChords="{Binding CompassChords}">
                <controls:MapControl.ContextMenu>
                    <ContextMenu Name="RoomContextMenu">
                        <ContextMenu.Resources>
                            <!-- Item theme for the Favorites / Recent-destinations walk-to
                                 sub-lists — mirrors the terminal right-click flyout's theme
                                 (MainWindow.axaml WalkFlyoutItemTheme) so both menus render
                                 identically: a numbered "N)" prefix in the default colour
                                 then the room name in goto-blue. Duplicated because the two
                                 menus live in separate windows and a keyed ControlTheme with
                                 BasedOn="{x:Type MenuItem}" doesn't resolve reliably from
                                 App-level resources. ReflectionBinding sidesteps the
                                 compiled-binding DataType on the generated child items. -->
                            <ControlTheme x:Key="RoomWalkItemTheme" TargetType="MenuItem"
                                          BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header"    Value="{ReflectionBinding}"/>
                                <Setter Property="Command"   Value="{ReflectionBinding Command}"/>
                                <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}"/>
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{ReflectionBinding Prefix}"/>
                                                <TextBlock Text="{ReflectionBinding Name}"
                                                           Foreground="{ReflectionBinding NameBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </ControlTheme>
                        </ContextMenu.Resources>
                        <MenuItem Header="{Binding ContextRoomName, StringFormat='At: {0}'}"
                                  IsEnabled="False" FontWeight="SemiBold"/>
                        <Separator/>
                        <!-- Starred favourites + recent GOTO destinations right under the
                             room header, each walking there on click (same route picker as
                             "Walk here"), rendered like the terminal's flyout. -->
                        <MenuItem Header="Favorites" IsVisible="{Binding HasContextFavorites}"
                                  ItemsSource="{Binding ContextFavorites}"
                                  ItemContainerTheme="{StaticResource RoomWalkItemTheme}"/>
                        <MenuItem Header="Recent destinations" IsVisible="{Binding HasContextRecentDestinations}"
                                  ItemsSource="{Binding ContextRecentDestinations}"
                                  ItemContainerTheme="{StaticResource RoomWalkItemTheme}"/>
                        <Separator IsVisible="{Binding HasContextWalkLists}"/>
                        <MenuItem Header="Walk here"
                                  Command="{Binding WalkToContextRoomCommand}"/>
                        <MenuItem Header="I am here (set located)"
                                  Command="{Binding SetContextRoomLocatedCommand}"/>
                        <MenuItem Header="Save as Go To"
                                  Command="{Binding ToggleContextRoomFavoriteCommand}"
                                  IsVisible="{Binding !ContextIsFavorite}"/>
                        <MenuItem Header="Remove from Go To"
                                  Command="{Binding ToggleContextRoomFavoriteCommand}"
                                  IsVisible="{Binding ContextIsFavorite}"/>
                        <MenuItem Header="Use Teleport"
                                  Command="{Binding UseTeleportCommand}"
                                  IsVisible="{Binding ContextTeleportSingle}"/>
                        <MenuItem Header="{Binding Teleport0.Label}"
                                  Command="{Binding Teleport0.Command}"
                                  IsVisible="{Binding Teleport0, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                        <MenuItem Header="{Binding Teleport1.Label}"
                                  Command="{Binding Teleport1.Command}"
                                  IsVisible="{Binding Teleport1, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                        <MenuItem Header="{Binding Teleport2.Label}"
                                  Command="{Binding Teleport2.Command}"
                                  IsVisible="{Binding Teleport2, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                        <MenuItem Header="{Binding Teleport3.Label}"
                                  Command="{Binding Teleport3.Command}"
                                  IsVisible="{Binding Teleport3, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                        <MenuItem Header="{Binding Teleport4.Label}"
                                  Command="{Binding Teleport4.Command}"
                                  IsVisible="{Binding Teleport4, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
                        <!-- Up/Down exits lead to a different floor not shown on the
                             current map — jump the map view there (view-only, like
                             Use Teleport). Shown only when the room has that exit. -->
                        <MenuItem Header="{Binding ContextUpLabel}"
                                  Command="{Binding GoUpFloorCommand}"
                                  IsVisible="{Binding ContextHasUp}"/>
                        <MenuItem Header="{Binding ContextDownLabel}"
                                  Command="{Binding GoDownFloorCommand}"
                                  IsVisible="{Binding ContextHasDown}"/>
                        <Separator/>
                        <MenuItem Header="Center on Player"
                                  Command="{Binding CenterOnPlayerCommand}"/>
                        <MenuItem Header="Center on…"
                                  Command="{Binding CenterOnSpecificCommand}"/>
                        <Separator/>
                        <MenuItem Header="Toggle: Avoid this room"
                                  Command="{Binding ToggleContextRoomAvoidedCommand}"/>
                        <MenuItem Header="Toggle: Stash room"
                                  Command="{Binding ToggleContextRoomStashCommand}"/>
                        <MenuItem Header="Toggle: Roomba Room"
                                  Command="{Binding ToggleContextGhRoomCommand}"/>
                        <!-- Auto-lair marking moved into the top-right
                             "Lair mode" toggle: enter the mode, click
                             rooms on the map to add / remove markers,
                             save via the rail's "Save lairs" button.
                             Mirrors how Loop build mode works. -->

                        <Separator/>
                        <MenuItem Header="Add this room to Blacklist"
                                  Foreground="{StaticResource AccentRedBrush}"
                                  Command="{Binding AddContextRoomToBlacklistCommand}"/>
                    </ContextMenu>
                </controls:MapControl.ContextMenu>
            </controls:MapControl>

            <!-- Hover tooltip popup. MaxWidth + Wrap on the text keeps
                 long single-line content (e.g. multi-action commands
                 with all their alternatives) readable instead of
                 stretching half-way across the window. Embedded "\n"
                 from RoomTooltipBuilder still produces multi-row
                 layouts. ZIndex lifts the tooltip above the right rail
                 and the loop-builder strip so it never disappears
                 under sibling panels. -->
            <Border Grid.Column="0"
                    Name="HoverTooltip"
                    IsVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#FFFFC0"
                    BorderBrush="#888" BorderThickness="1"
                    CornerRadius="6" Padding="8,6"
                    IsHitTestVisible="False"
                    ZIndex="100"
                    MaxWidth="540">
                <!-- Font/size here are design-time defaults; the runtime font is
                     set live per hover from DisplayConfig (Settings → General →
                     Navigation tooltip font). See OnMapRoomHovered. -->
                <TextBlock Name="HoverTooltipText"
                           Text=""
                           FontFamily="{StaticResource FontTerminal}"
                           FontSize="13"
                           Foreground="#000000"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Search results dropdown — drops straight down over the right rail
                 (nav / goto / loops collapsibles) under the search box, not over the
                 map. Lives in the rail column and carries a high ZIndex so it paints
                 above the rail Border, which is declared later in document order.
                 Visible only when the search box has results. -->
            <Border Grid.Column="1"
                    Name="SearchDropdown"
                    ZIndex="100"
                    IsVisible="{Binding HasSearchResults}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Background="{StaticResource ChromeBgElevBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    MaxHeight="320">
                <ListBox ItemsSource="{Binding SearchResults}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoomSearchResult">
                            <Border Padding="8,5"
                                    PointerPressed="OnSearchResultClicked"
                                    Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimaryLine}"
                                               ToolTip.Tip="{Binding PrimaryLine}"
                                               FontSize="11"
                                               Foreground="{StaticResource ChromeFgBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryLine}"
                                               ToolTip.Tip="{Binding SecondaryLine}"
                                               FontSize="10"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SecondaryLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Legend overlay — draggable. Anchored top-left; its Margin is a
                 (Left, Top) position in the map's coordinate space (the MapControl
                 shares this Grid column), driven by the drag handlers in the
                 code-behind. Defaults bottom-left; the code re-clamps it into the
                 visible map whenever it's toggled on. -->
            <Border Grid.Column="0"
                    Name="MapLegend"
                    IsVisible="{Binding LegendVisible}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Cursor="SizeAll"
                    PointerPressed="OnLegendPointerPressed"
                    PointerMoved="OnLegendPointerMoved"
                    PointerReleased="OnLegendPointerReleased"
                    Background="#F21A1A1A"
                    BorderBrush="{StaticResource ChromeBorderSoftBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10">
                <StackPanel Spacing="4" MinWidth="180">
                    <TextBlock Text="MAP LEGEND" FontSize="10"
                               FontWeight="SemiBold" Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#F8B500"/>
                        <TextBlock Text="Current room" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#8E4F7B"/>
                        <TextBlock Text="Lair" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#4A7791"/>
                        <TextBlock Text="Shop / banks" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#6428A0"/>
                        <TextBlock Text="Spell room" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#DC821E"/>
                        <TextBlock Text="Auto-lair mark" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <!-- Up / Down exits show up two ways on the map: a
                         full-cell fill on rooms whose ONLY vertical
                         exit is U (or D), and a small corner
                         triangle on rooms that ALSO have horizontal
                         exits. Legend carries one swatch per shape
                         so the user can map either back to the
                         legend without guessing. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#00C800"/>
                        <TextBlock Text="(full block) Up exit" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Polygon Points="14,0 7,0 14,7" Fill="#00C800"/>
                        </Grid>
                        <TextBlock Text="(corner mark) Up exit" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="14" Height="14" Background="#DCDC00"/>
                        <TextBlock Text="(full block) Down exit" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Polygon Points="14,14 7,14 14,7" Fill="#DCDC00"/>
                        </Grid>
                        <TextBlock Text="(corner mark) Down exit" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Path Stroke="#FF50E6FF" StrokeThickness="1.5" Data="M 0,14 L 14,0 M 0,7 L 7,0 M 7,14 L 14,7"/>
                            <Path Stroke="#FF50E6FF" StrokeThickness="1.5" Data="M 0,0 L 14,14 M 0,7 L 7,14 M 7,0 L 14,7"/>
                        </Grid>
                        <TextBlock Text="Teleport (CMD)" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <!-- Edge colours. Trap-red and action-magenta both
                         tint the corridor line between rooms (not the
                         room cells). Action edges = exits requiring
                         one or more in-room actions to traverse —
                         e.g. lever pulls, button presses. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Line StartPoint="0,7" EndPoint="14,7" Stroke="#DC3C3C" StrokeThickness="2"/>
                        </Grid>
                        <TextBlock Text="Trapped exit" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Line StartPoint="0,7" EndPoint="14,7" Stroke="#8B008B" StrokeThickness="2"/>
                        </Grid>
                        <TextBlock Text="Action required" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Line StartPoint="0,7" EndPoint="14,7" Stroke="#008B8B" StrokeThickness="2"/>
                        </Grid>
                        <TextBlock Text="Searchable hidden" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                    <!-- Gap-bridge: dashed dim line drawn when two rooms
                         connect but the map couldn't place them on
                         adjacent cells (non-tiling diagonals in hand-built
                         maps). Matches MapControl's ExitBridgePen
                         (#8A8A8A, 1.5 px, 2,2 dash). -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="14" Height="14">
                            <Border Background="#3A3A3A"/>
                            <Line StartPoint="0,14" EndPoint="14,0" Stroke="#8A8A8A" StrokeThickness="1.5"
                                  StrokeDashArray="2,2"/>
                        </Grid>
                        <TextBlock Text="Off-grid connection" FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RIGHT RAIL — ClipToBounds keeps long step labels from
                 overflowing the 290px column and rendering past the right
                 edge, which would make the section look stretched relative
                 to GOTO/LOOPS. -->
            <Border Grid.Column="1"
                    Width="290"
                    IsVisible="{Binding MapExpanded}"
                    ClipToBounds="True"
                    Background="{StaticResource ChromeBgSunkenBrush}"
                    BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10,6,10,6">
                        <!-- Bottom margin reserves a buffer below the last
                             expander so that when the rail scrolls, the final
                             loop / Auto-Lair row can't sit flush under the
                             fixed Manage footer and read as cut off. -->
                        <StackPanel Spacing="4" Margin="0,0,0,12">

                            <!-- ROOM INFO — populated on any left-click of a room;
                                 clickable links to every game-data record attached
                                 to it (room / monsters / floor items / shop / spell).
                                 First in the rail so its auto-expand-on-click lands
                                 at the top of the scroll view. -->
                            <Expander Classes="RailSection"
                                      IsExpanded="{Binding IsRoomInfoExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Classes="RailSectionHeader" Text="ROOM INFO" Margin="0"/>
                                </Expander.Header>
                                <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                                    <TextBlock IsVisible="{Binding !RoomInfo.HasRoom}"
                                               Text="Click a room on the map to inspect it."
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource ChromeFgMutedBrush}"/>

                                    <StackPanel IsVisible="{Binding RoomInfo.HasRoom}" Spacing="2">
                                        <!-- Room name (opens the room record, or a shop room's stock popup). -->
                                        <Button Classes="RoomTitleLink"
                                                Content="{Binding RoomInfo.RoomName}"
                                                Command="{Binding RoomInfo.OpenRoomRecordCommand}"
                                                ToolTip.Tip="{Binding RoomInfo.RoomTitleTip}"/>
                                        <!-- Map/room number below the name. -->
                                        <TextBlock Text="{Binding RoomInfo.RoomKeyLabel}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                        <!-- Room illumination below that; a single line trimmed to the
                                             panel width, full phrase on hover. -->
                                        <TextBlock Text="{Binding RoomInfo.RoomLight}"
                                                   IsVisible="{Binding RoomInfo.HasRoomLight}"
                                                   ToolTip.Tip="{Binding RoomInfo.RoomLight}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                        <!-- Your illumination (room light + your gear + configured light
                                             spells) just below Room Illu; same single-line trim. -->
                                        <TextBlock Text="{Binding RoomInfo.PlayerLight}"
                                                   IsVisible="{Binding RoomInfo.HasPlayerLight}"
                                                   ToolTip.Tip="{Binding RoomInfo.PlayerLight}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>

                                        <!-- Monsters — Placed / Assigned / Lair, mirroring the map tooltip -->
                                        <StackPanel IsVisible="{Binding RoomInfo.HasPlaced}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Placed"/>
                                            <ItemsControl ItemsSource="{Binding RoomInfo.PlacedMonsters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="gd:RoomDetailLink">
                                                        <Button Classes="RecordLink"
                                                                Content="{Binding Text}" Command="{Binding Open}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding RoomInfo.HasAssigned}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Assigned"/>
                                            <ItemsControl ItemsSource="{Binding RoomInfo.AssignedMonsters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="gd:RoomDetailLink">
                                                        <Button Classes="RecordLink"
                                                                Content="{Binding Text}" Command="{Binding Open}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding RoomInfo.HasLair}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Lair"/>
                                            <ItemsControl ItemsSource="{Binding RoomInfo.LairMonsters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="gd:RoomDetailLink">
                                                        <Button Classes="RecordLink"
                                                                Content="{Binding Text}" Command="{Binding Open}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Lair regen sits directly beneath the Lair group, like the tooltip. -->
                                            <TextBlock Text="{Binding RoomInfo.LairRegen}"
                                                       IsVisible="{Binding RoomInfo.HasLairRegen}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Obvious exits — click to re-root the map on the neighbour -->
                                        <StackPanel IsVisible="{Binding RoomInfo.HasExits}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Obvious exits"/>
                                            <ItemsControl ItemsSource="{Binding RoomInfo.Exits}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="gd:RoomDetailLink">
                                                        <Button Classes="RecordLink"
                                                                Content="{Binding Text}" Command="{Binding Open}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Floor items -->
                                        <StackPanel IsVisible="{Binding RoomInfo.HasFloorItems}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Floor items"/>
                                            <ItemsControl ItemsSource="{Binding RoomInfo.FloorItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="gd:RoomDetailLink">
                                                        <Button Classes="RecordLink"
                                                                Content="{Binding Text}" Command="{Binding Open}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Shop -->
                                        <StackPanel IsVisible="{Binding RoomInfo.HasShop}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Shop"/>
                                            <Button Classes="RecordLink"
                                                    Content="{Binding RoomInfo.ShopLink.Text}"
                                                    Command="{Binding RoomInfo.ShopLink.Open}"/>
                                        </StackPanel>

                                        <!-- Room spell -->
                                        <StackPanel IsVisible="{Binding RoomInfo.HasRoomSpell}" Spacing="1">
                                            <TextBlock Classes="RoomInfoGroup" Text="Room spell"/>
                                            <Button Classes="RecordLink"
                                                    Content="{Binding RoomInfo.RoomSpellLink.Text}"
                                                    Command="{Binding RoomInfo.RoomSpellLink.Open}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- CURRENT NAV. HorizontalAlignment=Stretch on
                                 the body StackPanel is the same width
                                 normalisation GOTO/LOOPS get implicitly
                                 from their button/border rows; without it
                                 the body inherits content-driven sizing
                                 and the expanded section appears narrower
                                 than the other two sidebar pills. -->
                            <Expander Classes="RailSection"
                                      IsExpanded="{Binding IsCurrentNavExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <!-- Title + a Details… button that opens the current
                                         route's full step plan in a browsable window. The
                                         button only shows while a route is executing; a
                                         click on it opens the window without toggling the
                                         expander (Button consumes the pointer). -->
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0"
                                                   Classes="RailSectionHeader"
                                                   Classes.CurrentNavLair="{Binding EngineActionIsLair}"
                                                   Classes.CurrentNavLoop="{Binding EngineActionIsLooping}"
                                                   Classes.CurrentNavWalk="{Binding EngineActionIsWalking}"
                                                   Text="CURRENT NAV"
                                                   VerticalAlignment="Center"
                                                   Margin="0"/>
                                        <Button Grid.Column="1"
                                                Content="Details…"
                                                IsVisible="{Binding CanShowRouteDetails}"
                                                Command="{Binding ShowRouteDetailsCommand}"
                                                Background="{StaticResource ChromeBgElevBrush}"
                                                BorderBrush="{StaticResource ChromeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,2"
                                                FontSize="11"
                                                Foreground="{StaticResource ChromeFgBrush}"
                                                VerticalAlignment="Center"
                                                Margin="6,0,8,0"
                                                ToolTip.Tip="Open the current route's full step plan, with the lair monsters at each room."/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                            <!-- The section's description line lives up in the
                                 top-bar action label (TopBarStatusText) now, so
                                 CURRENT NAV holds only its step rows. -->
                            <!-- Building-loop click list — visible only while in LoopBuild mode.
                                 Click a row to attach a command to that waypoint (opens the
                                 same Waypoint action editor the loop editor uses); ✕ removes,
                                 ↑ / ↓ reorder. -->
                            <ListBox Name="BuilderClicksList"
                                     ItemsSource="{Binding LoopBuilder.Clicks}"
                                     IsVisible="{Binding IsLoopBuilding}"
                                     MaxHeight="240"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionMode="Single"
                                     HorizontalAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     DragDrop.AllowDrop="True">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin"  Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor"  Value="Hand"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoopBuilderRow">
                                        <!-- Right margin reserves the overlay scrollbar's width so it
                                             doesn't cover the ✕ remove button when the list scrolls. -->
                                        <Border Padding="6,2"
                                                Margin="0,1,14,1"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource AccentRedBrush}"
                                                Background="Transparent"
                                                ToolTip.Tip="Click to attach a command to this waypoint; ✕ to remove, ↑ / ↓ to reorder">
                                            <Grid ColumnDefinitions="24,*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Index}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentRedBrush}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ChromeFgBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <!-- Gear marks a command; ⛔ marks a "do not rest" waypoint. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="2" Margin="2,0" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙" FontSize="11"
                                                               IsVisible="{Binding HasCommand}"
                                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                                               ToolTip.Tip="{Binding Command}"/>
                                                    <TextBlock Text="⛔" FontSize="11"
                                                               IsVisible="{Binding HasDoNotRest}"
                                                               Foreground="{StaticResource AccentRedBrush}"
                                                               ToolTip.Tip="Do not rest in this room"/>
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Content="↑" FontSize="13" Padding="7,3" MinWidth="26"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Move earlier"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveBuilderClickUpCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4"
                                                        Content="↓" FontSize="13" Padding="7,3" MinWidth="26"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Move later"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveBuilderClickDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="5"
                                                        Content="✕" FontSize="13" Padding="7,3" MinWidth="26"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Remove waypoint"
                                                        Foreground="{StaticResource AccentRedBrush}"
                                                        Click="OnBuilderRowRemoveClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Name="CurrentNavList"
                                     ItemsSource="{Binding CurrentNavRows}"
                                     SelectedItem="{Binding CurrentNavSelectedRow, Mode=OneWay}"
                                     IsVisible="{Binding !IsLoopBuilding}"
                                     MaxHeight="240"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     SelectionMode="Single"
                                     HorizontalAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Styles>
                                    <!-- Strip default selection / hover chrome — our
                                         NavRow border-classes (Completed / Current /
                                         Upcoming / Ready) own the per-row visuals. -->
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CurrentNavRowViewModel">
                                        <Border Classes="NavRow"
                                                ToolTip.Tip="{Binding RowTooltip}"
                                                Classes.Completed="{Binding IsCompleted}"
                                                Classes.Current="{Binding IsCurrent}"
                                                Classes.Upcoming="{Binding IsUpcoming}"
                                                Classes.Ready="{Binding IsReady}">
                                            <Grid ColumnDefinitions="24,*,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Index}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ChromeFgMutedBrush}"
                                                           HorizontalAlignment="Left"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SubLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding SubLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                                <!-- ✎ Edit timer override (Auto-Lair rows only). -->
                                                <Button Grid.Column="3"
                                                        Content="✎"
                                                        FontSize="10"
                                                        Padding="6,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip.Tip="Override this lair's respawn timer"
                                                        IsVisible="{Binding HasEdit}"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).EditLairTimerCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="4"
                                                        Content="✕"
                                                        FontSize="10"
                                                        Padding="6,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        IsVisible="{Binding HasRemove}"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).UnmarkAutoLairRoomCommand}"
                                                        CommandParameter="{Binding RemoveKey}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                                </StackPanel>
                            </Expander>

                            <!-- GOTO — favourite rooms saved via the map's
                                 right-click "Add to favorites" item. Each
                                 row click walks there; the X button removes
                                 the bookmark. Persisted on the active
                                 character profile. -->
                            <Expander Classes="RailSection"
                                      IsExpanded="{Binding IsGotoExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Classes="RailSectionHeader Goto" Text="GOTO" Margin="0"/>
                                </Expander.Header>
                                <StackPanel Spacing="2" HorizontalAlignment="Stretch">
                                    <!-- GOTO folders live in the character profile
                                         (not on disk like loops/lairs). Create /
                                         rename / delete folders and add favourites
                                         from the Navigation Management window's GOTO
                                         tab, or right-click nodes in this tree. -->
                                    <!-- Filter box first, then folders, then favourites. -->
                                    <!-- Fixed width so the box can't grow with typed text
                                         and push the clearable ✕ under the scrollbar (see
                                         the LOOPS filter box below for the full rationale). -->
                                    <TextBox Classes="clearable" Text="{Binding GotoFilter, Mode=TwoWay}"
                                             PlaceholderText="Filter favourites…"
                                             FontSize="11"
                                             Width="250" HorizontalAlignment="Left"
                                             Margin="0,0,0,2"
                                             IsVisible="{Binding HasFavorites}"/>
                                    <!-- Empty-state hint — cap MaxWidth +
                                         keep wrapping so a long string
                                         can't push the rail wider than
                                         the 290 px column. -->
                                    <TextBlock Text="No favourites — right-click a room → Add to favorites, or use the Navigation Management GOTO tab."
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               HorizontalAlignment="Left"
                                               IsVisible="{Binding !HasFavorites}"/>
                                    <TextBlock Text="No favourites match the filter."
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               HorizontalAlignment="Left"
                                               IsVisible="{Binding HasNoFavoriteMatches}"/>
                                    <!-- MaxHeight bounds the tree's own scroll viewport so its
                                         VirtualizingStackPanel engages — without a finite viewport
                                         (it sits in the rail's outer ScrollViewer) every row of a
                                         broad filter match realises at once and the first keystroke
                                         stalls. Folders rest collapsed, so the cap only bites once a
                                         filter expands a large match set. -->
                                    <ListBox Name="FavoriteTreeView"
                                             ItemsSource="{Binding FavoriteRows}"
                                             IsVisible="{Binding HasFavoriteTree}"
                                             Background="Transparent"
                                             Margin="0,0,8,0"
                                             Padding="0,0,14,0"
                                             MaxHeight="400"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             DragDrop.AllowDrop="True">
                                        <!-- Rendered FLAT: folders and their open children are all
                                             uniform-height NavFlatRow rows, NOT a nested TreeView where
                                             an expanded folder is one giant item that wrecks the
                                             virtualized scrollbar and drifts on expand. -->
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <!-- Right-click empty space → create a root-level GOTO folder. -->
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="New folder…"
                                                          Command="{Binding NewGotoFolderCommand}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.Styles>
                                            <!-- Strip the ListBoxItem chrome so rows read like tree
                                                 rows: no padding, no selection fill, full width. -->
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.DataTemplates>
                                            <!-- Flat-row wrapper: depth indent + a chevron for folders,
                                                 then the item's own row template via the ContentControl. -->
                                            <DataTemplate DataType="vm:NavFlatRow">
                                                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" Background="Transparent">
                                                    <Button Grid.Column="0"
                                                            Width="16" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            Foreground="{StaticResource ChromeFgMutedBrush}"
                                                            IsVisible="{Binding IsFolder}"
                                                            Content="{Binding ChevronGlyph}"
                                                            ToolTip.Tip="Expand / collapse"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleFolderCommand}"
                                                            CommandParameter="{Binding Folder}"/>
                                                    <ContentControl Grid.Column="1" Content="{Binding Item}"/>
                                                </Grid>
                                            </DataTemplate>
                                            <!-- Folder header — clicking the name toggles it too. -->
                                            <DataTemplate DataType="vm:NavFolderNodeViewModel">
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleFolderCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="📁"
                                                                   FontSize="14"
                                                                   Margin="0,0,4,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   ToolTip.Tip="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentVioletBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="New subfolder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).NewGotoFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Rename folder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RenameGotoFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Delete folder"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).DeleteGotoFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate>
                                            <!-- Favourite leaf. -->
                                            <DataTemplate DataType="vm:FavoriteRowViewModel">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" Background="Transparent">
                                                    <TextBlock Grid.Column="0"
                                                               Text="★"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsStarred}"
                                                               Foreground="{StaticResource AccentAmberBrush}"
                                                               ToolTip.Tip="In the right-click Favorites menu"/>
                                                    <Button Grid.Column="1"
                                                            Content="{Binding Label}"
                                                            ToolTip.Tip="{Binding LabelWithKey}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            FontSize="11"
                                                            Padding="6,2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).GoToFavoriteCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2"
                                                            Content="✎"
                                                            FontSize="10"
                                                            Padding="6,2"
                                                            ToolTip.Tip="Edit favourite (name / map / room)"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RenameFavoriteCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="3"
                                                            Content="✕"
                                                            FontSize="10"
                                                            Padding="6,2"
                                                            Foreground="{StaticResource AccentRedBrush}"
                                                            ToolTip.Tip="Delete this Go To"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RemoveFavoriteCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Walk here"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).GoToFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Edit…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RenameFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Move to folder…"
                                                                      IsVisible="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).HasGotoFolders}"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveFavoriteToFolderPromptCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="{Binding FavoriteMenuHeader}"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleFavoriteStarCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Delete this Go To"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RemoveFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.DataTemplates>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <!-- LOOPS + AUTO-LAIRS — single combined
                                 section. Header tokens are
                                 individually coloured: "Loops"
                                 green to match loop-name rows, "+"
                                 neutral white, "Auto-Lairs" orange
                                 to match (future) auto-lair setup
                                 rows. -->
                            <Expander Classes="RailSection"
                                      IsExpanded="{Binding IsLoopsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Classes="RailSectionHeader" Margin="0">
                                        <Run Text="LOOPS"
                                             Foreground="{StaticResource AccentGreenBrush}"/>
                                        <Run Text=" + "
                                             Foreground="{StaticResource ChromeFgBrush}"/>
                                        <Run Text="AUTO-LAIRS"
                                             Foreground="{StaticResource AccentAmberBrush}"/>
                                    </TextBlock>
                                </Expander.Header>
                                <StackPanel Spacing="2" HorizontalAlignment="Stretch">
                                    <!-- Filter box first, then folders, then loops. -->
                                    <!-- Fixed width caps the box at the rail's content
                                         width so it can't grow with typed text — the
                                         expander measures its content unbounded, which
                                         otherwise let the box widen past the rail edge and
                                         pushed the clearable ✕ under the auto-hiding
                                         scrollbar. Long text scrolls inside the box instead.
                                         Left-aligned so the spare width sits on the
                                         scrollbar side. -->
                                    <TextBox Classes="clearable" Text="{Binding LoopFilter, Mode=TwoWay}"
                                             PlaceholderText="Filter loops / lairs…"
                                             FontSize="11"
                                             Width="250" HorizontalAlignment="Left"
                                             Margin="0,0,0,2"
                                             IsVisible="{Binding HasAnyLoopsOrSetups}"/>
                                    <TextBlock Text="No loops or Auto-Lair setups saved on this BBS."
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               HorizontalAlignment="Left"
                                               IsVisible="{Binding !HasAnyLoopsOrSetups}"/>
                                    <TextBlock Text="No loops or lairs match the filter."
                                               Foreground="{StaticResource ChromeFgMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               HorizontalAlignment="Left"
                                               IsVisible="{Binding HasNoLoopMatches}"/>
                                    <!-- Loops + Auto-Lair setups share ONE on-disk Loops
                                         directory tree and render as a single combined
                                         list: Auto-Lair leaves amber, loop leaves green.
                                         Folder create / rename / delete is reachable via
                                         the folder-node context menu here (and the Manage
                                         dialog); there is no "+ Folder" button on the rail. -->
                                    <!-- MaxHeight bounds the scroll viewport so virtualization
                                         engages on broad filter matches — see FavoriteTreeView. -->
                                    <ListBox Name="NavTreeView"
                                             ItemsSource="{Binding NavRows}"
                                             IsVisible="{Binding HasNavTree}"
                                             Background="Transparent"
                                             Margin="0,0,8,0"
                                             Padding="0,0,14,0"
                                             MaxHeight="400"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             DragDrop.AllowDrop="True">
                                        <!-- Rendered FLAT (uniform-height rows) so an expanded folder
                                             isn't one giant virtualized item — see FavoriteTreeView. -->
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.DataTemplates>
                                            <!-- Flat-row wrapper: depth indent + folder chevron + the
                                                 item's own row template. -->
                                            <DataTemplate DataType="vm:NavFlatRow">
                                                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" Background="Transparent">
                                                    <Button Grid.Column="0"
                                                            Width="16" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            Foreground="{StaticResource ChromeFgMutedBrush}"
                                                            IsVisible="{Binding IsFolder}"
                                                            Content="{Binding ChevronGlyph}"
                                                            ToolTip.Tip="Expand / collapse"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleFolderCommand}"
                                                            CommandParameter="{Binding Folder}"/>
                                                    <ContentControl Grid.Column="1" Content="{Binding Item}"/>
                                                </Grid>
                                            </DataTemplate>
                                            <!-- Folder header — click name (or chevron) to toggle.
                                                 Loop + lair folders are one on-disk tree, so these
                                                 commands mutate both leaf kinds at once. -->
                                            <DataTemplate DataType="vm:NavFolderNodeViewModel">
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                        Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleFolderCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="📁"
                                                                   FontSize="14"
                                                                   Margin="0,0,4,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   ToolTip.Tip="{Binding Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentVioletBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="New subfolder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).NewLoopFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Rename folder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RenameLoopFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Delete folder"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).DeleteLoopFolderCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate>
                                            <!-- Auto-Lair setup leaf — amber accent. -->
                                            <DataTemplate DataType="vm:LairSetupRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2" ColumnSpacing="4" Background="Transparent"
                                                      ToolTip.Tip="{Binding RowTooltip}">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AccentAmberBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding AnchorKey}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding SubLabel}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Load" FontSize="10"
                                                            Padding="8,2"
                                                            ToolTip.Tip="Load these markers into Auto-Lair without starting."
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).LoadSetupCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2"
                                                            Content="Run" FontSize="10"
                                                            Padding="8,2"
                                                            Classes="Accent"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RunSetupCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Load"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).LoadSetupCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Run"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RunSetupCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Edit…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).EditSetupCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Move to folder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveSetupToFolderPromptCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="{Binding FavoriteMenuHeader}"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleSetupFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                </Grid>
                                            </DataTemplate>
                                            <!-- Loop leaf — green accent. Name ellipsised when
                                                 long; start-room key + room count on a smaller
                                                 second line. Load + Run stay right-aligned at
                                                 any name length. -->
                                            <DataTemplate DataType="vm:LoopRowViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2" ColumnSpacing="4" Background="Transparent"
                                                      ToolTip.Tip="{Binding RowTooltip}">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AccentGreenBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding StartRoomKey}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding SubLabel}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Load" FontSize="10"
                                                            Padding="8,2"
                                                            ToolTip.Tip="Load this loop into the builder so you can preview / edit before running."
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).LoadLoopCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2"
                                                            Content="Run" FontSize="10"
                                                            Padding="8,2"
                                                            Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RunLoopCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Load"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).LoadLoopCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Run"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RunLoopCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Edit…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).EditLoopCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Move to folder…"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveLoopToFolderPromptCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="{Binding FavoriteMenuHeader}"
                                                                      Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).ToggleLoopFavoriteCommand}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.DataTemplates>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <!-- EXP/HR ESTIMATOR — build-time planning tool. Enter / exit
                                 with the button right inside this section (locked while a
                                 loop is being built — both modes consume map clicks). While
                                 active, click rooms on the map to build a throwaway loop; the
                                 estimate + per-lair breakdown surface here. Starts collapsed
                                 like the other rail sections. -->
                            <Expander Classes="RailSection" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Classes="RailSectionHeader" Margin="0"
                                               Text="EXP/HR ESTIMATOR"/>
                                </Expander.Header>
                                <StackPanel Margin="6,4" Spacing="6" HorizontalAlignment="Stretch">

                                    <!-- Enter button lives in the section itself (no overlay
                                         chip). Disabled while building a loop. -->
                                    <Button IsVisible="{Binding !IsExpEstimatorMode}"
                                            Content="Start estimating"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            IsEnabled="{Binding !IsLoopMode}"
                                            ToolTip.Tip="Click rooms on the map to build a throwaway loop and estimate exp/hr."
                                            Command="{Binding ToggleExpEstimatorModeCommand}"/>
                                    <TextBlock IsVisible="{Binding IsLoopMode}"
                                               FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource ChromeFgSecBrush}"
                                               Text="Locked while building a loop — save or run it first."/>

                                    <StackPanel IsVisible="{Binding IsExpEstimatorMode}" Spacing="6"
                                                HorizontalAlignment="Stretch">

                                        <!-- Actions up top so Save / Discard / Load are reachable
                                             without scrolling past the readout + room list. -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                            <Button Grid.Column="0" Content="Save as loop" FontSize="11"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    IsEnabled="{Binding ExpEstimator.CanSave}"
                                                    Command="{Binding SaveEstimatorAsLoopCommand}"/>
                                            <Button Grid.Column="1" Content="Stop Estimating" FontSize="11"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    ToolTip.Tip="Leave estimator mode without saving."
                                                    Command="{Binding DiscardEstimatorCommand}"/>
                                        </Grid>
                                        <Button Content="Load loop…" FontSize="11"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Browse for a saved .loop file to analyse (opens in the active set's Loops folder)."
                                                Command="{Binding BrowseLoadLoopIntoEstimatorCommand}"/>
                                        <Button Content="Clear rooms" FontSize="10"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                IsVisible="{Binding ExpEstimator.HasClicks}"
                                                Command="{Binding ClearEstimatorClicksCommand}"/>

                                        <!-- Headline result. -->
                                        <Border Background="{StaticResource ChromeBgElevBrush}"
                                                BorderBrush="#2F8F83" BorderThickness="1"
                                                CornerRadius="4" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource ChromeFgBrush}"
                                                           Text="{Binding ExpEstimator.ExpPerHour, StringFormat='{}{0:N0} exp/hr'}"/>
                                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource ChromeFgSecBrush}"
                                                           Text="{Binding ExpEstimator.Summary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Per-lair breakdown: fires vs misses per hour, amber
                                             when a miss was close (nudge the loop to catch it). -->
                                        <ListBox Classes="RailList" Focusable="False"
                                                 ItemsSource="{Binding ExpEstimator.Lairs}"
                                                 MaxHeight="180"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExpEstimatorLairRow">
                                                    <!-- Right margin reserves space for the overlay scrollbar so it
                                                         doesn't cover the fires / early-by figures when the list is long. -->
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,14,1" ColumnSpacing="6">
                                                        <TextBlock Grid.Column="0" FontSize="11"
                                                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding RoomLabel}"
                                                                   Text="{Binding RoomLabel}"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <!-- Death-summon lair: exp/time already fold in the
                                                                 whole summon tree; this flags why the yield is
                                                                 higher than the base monster's face value. -->
                                                            <TextBlock FontSize="11" Foreground="#B98BE0"
                                                                       IsVisible="{Binding Summons}"
                                                                       ToolTip.Tip="This monster summons more monsters on death — its exp and clear time fold in the whole tree."
                                                                       Text="summons"/>
                                                            <TextBlock FontSize="11" Foreground="#4FD3C4"
                                                                       Text="{Binding FiresLabel}"/>
                                                            <TextBlock FontSize="11" Classes="MissCell"
                                                                       Classes.NearMiss="{Binding NearMiss}"
                                                                       Text="{Binding MissLabel}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Bosses (GameLimit 1 / long regen): pulled out of the lair
                                             average and amortised over their regen (once per Nh), so
                                             they add a flat exp/hr instead of firing on every pass. -->
                                        <StackPanel IsVisible="{Binding ExpEstimator.HasBosses}" Spacing="1">
                                            <TextBlock Text="Bosses (amortised over regen)" FontSize="10"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}" Margin="0,3,0,0"/>
                                            <ItemsControl ItemsSource="{Binding ExpEstimator.Bosses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ExpEstimatorBossRow">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1,14,1" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" FontSize="11"
                                                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Label}"
                                                                       Text="{Binding Label}"/>
                                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#E0B060"
                                                                       Text="{Binding ContribLabel}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Room-spell summons: rooms whose entry spell rolls extra
                                             monsters (nomonsters-gated), credited on top of the lair. -->
                                        <StackPanel IsVisible="{Binding ExpEstimator.HasSummons}" Spacing="1">
                                            <TextBlock Text="Room summons" FontSize="10"
                                                       Foreground="{StaticResource ChromeFgMutedBrush}" Margin="0,3,0,0"/>
                                            <ItemsControl ItemsSource="{Binding ExpEstimator.Summons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ExpEstimatorSummonRow">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1,14,1" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0" FontSize="11" FontFamily="{StaticResource FontMono}"
                                                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                                                       Text="{Binding RoomLabel}"/>
                                                            <TextBlock Grid.Column="1" FontSize="11"
                                                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding SpellName}"
                                                                       Text="{Binding SpellName}"/>
                                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="#E0B060"
                                                                       Text="{Binding ContribLabel}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource ChromeBorderSoftBrush}"/>

                                        <TextBox Text="{Binding ExpEstimator.ProposedName, Mode=TwoWay}"
                                                 PlaceholderText="Loop name" FontSize="11"/>

                                        <TextBlock IsVisible="{Binding !ExpEstimator.HasClicks}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                                   Text="Click rooms on the map to add waypoints."/>

                                        <ListBox Classes="RailList" Focusable="False"
                                                 ItemsSource="{Binding ExpEstimator.Clicks}"
                                                 MaxHeight="200"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LoopBuilderRow">
                                                    <!-- Right margin reserves the overlay scrollbar's width so it
                                                         doesn't cover the ✕ remove button when the list scrolls. -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="3" Margin="0,1,14,1">
                                                        <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource ChromeFgSecBrush}"
                                                                   Text="{Binding Index, StringFormat='{}{0}.'}"/>
                                                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Name}"/>
                                                        <Button Grid.Column="2" Content="▲" FontSize="9" Padding="5,1"
                                                                ToolTip.Tip="Move earlier"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveEstimatorClickUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="3" Content="▼" FontSize="9" Padding="5,1"
                                                                ToolTip.Tip="Move later"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).MoveEstimatorClickDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="4" Content="✕" FontSize="9" Padding="5,1"
                                                                Foreground="{StaticResource AccentRedBrush}"
                                                                ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[ListBox].((vm:NavigationViewModel)DataContext).RemoveEstimatorClickCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Height="1" Background="{StaticResource ChromeBorderSoftBrush}"/>

                                        <CheckBox IsChecked="{Binding ExpEstimator.AreaCombat, Mode=TwoWay}"
                                                  FontSize="11"
                                                  ToolTip.Tip="On: you hit every mob in the room at once, so a room clears in your rounds-to-kill no matter how many mobs. Off: you kill mobs one at a time (room cost scales with the mob count)."
                                                  Content="I'm Rooming"/>

                                        <!-- Labels stack ABOVE each picker and wrap: the rail is only
                                             290px wide, so a side-by-side label + full-size
                                             NumericUpDown clips the value and a long single-line label
                                             pushes the section wider than its neighbours. -->
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                                       Text="Seconds per room (loop pace)"/>
                                            <NumericUpDown FontSize="11" HorizontalAlignment="Stretch"
                                                           Value="{Binding ExpEstimator.SecondsPerStep, Mode=TwoWay}"
                                                           Minimum="0" Maximum="30" Increment="0.1"
                                                           FormatString="0.0" ShowButtonSpinner="True"
                                                           ToolTip.Tip="Your EFFECTIVE time per room while looping — NOT your raw walk speed. In a fighting loop each room is a move command + its server round-trip + an attack + the combat tick, so the real pace is ~1.2–1.4s even at 1.0 movespeed (default 1.4). Set it too low and a loop that backtracks past cleared lairs reads too high. Only costs exp when a hop is too long to finish inside a 5s round; short hops ride the downtime free."/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                                       Text="Rounds to kill a mob"/>
                                            <NumericUpDown FontSize="11" HorizontalAlignment="Stretch"
                                                           Value="{Binding ExpEstimator.RoundsPerMob, Mode=TwoWay}"
                                                           Minimum="0.1" Maximum="50" Increment="0.5"
                                                           FormatString="0.0" ShowButtonSpinner="True"
                                                           ToolTip.Tip="Average combat rounds to kill one monster (5s per round). When rooming, this is the rounds to clear the whole room."/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource ChromeFgSecBrush}"
                                                       Text="Real-world multiplier (0–1)"/>
                                            <NumericUpDown FontSize="11" HorizontalAlignment="Stretch"
                                                           Value="{Binding ExpEstimator.RealConditionsMultiplier, Mode=TwoWay}"
                                                           Minimum="0.1" Maximum="1" Increment="0.01"
                                                           FormatString="0.00" ShowButtonSpinner="True"
                                                           ToolTip.Tip="Haircut for real conditions (regen breaks, missed rounds, travel). 1.0 = perfect play; 0.9 default."/>
                                        </StackPanel>

                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom action strip — Manage is the single
                         entry into the loops/lairs CRUD surface; the
                         .mp importer used to live here as a separate
                         button but moved INTO the Manage dialog per
                         UX direction (it's a CRUD action on saved
                         loops, not a top-level rail action). -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource ChromeBgBrush}">
                        <Grid Margin="6,4">
                            <Button Content="Navigation Management"
                                    FontSize="10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenManagerCommand}"
                                    ToolTip.Tip="Rename / delete / import saved loops + Auto-Lair setups"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: bottom strip — loop builder session status only.
             Per UX direction the bar carries no actions: Save+Start
             is the top-right Run button, naming/deleting/renaming
             live in the Manage dialog, and exiting build mode
             discards the in-progress clicks. -->
        <Border Grid.Row="3"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsLoopBuilding}">
            <Grid ColumnDefinitions="Auto,*" Margin="12,6" ColumnSpacing="8">
                <Border Grid.Column="0"
                        CornerRadius="3" Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentAmberBrush}">
                    <TextBlock Text="BUILDING LOOP"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#0E0E0E"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{StaticResource ChromeFgSecBrush}">
                        <Run Text="{Binding LoopBuilder.Clicks.Count, FallbackValue=0}"/>
                        <Run Text=" room(s) clicked · "/>
                        <Run Text="{Binding LoopBuilder.ExpandedStepCount, FallbackValue=0}"/>
                        <Run Text=" step(s) total · Run to save+start, toggle Loop to discard"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource AccentRedBrush}"
                               Text="{Binding LoopBuilder.UnreachableSummary}"
                               IsVisible="{Binding LoopBuilder.UnreachableSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The dedicated Auto-Lair RUNNING phase strip used to live
             here. Its content (phase + current target + wait-room)
             now rides next to the top-left AUTO-LAIR badge via
             TopBarStatusText, so the bottom edge stays clean during
             active runs. The BUILDING LAIR strip below still shows
             pre-Run because the top-bar status reads the engine, not
             the build session. -->

        <!-- Row 3 (alternate): Auto-Lair BUILDING status strip. Mirrors
             the Loop-builder strip — visible only while the user is
             actively marking lair rooms (CurrentMode == AutoLair AND
             scheduler not yet running). The Lair phase strip above
             takes over the moment the scheduler starts. -->
        <Border Grid.Row="3"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsLairBuilding}">
            <Grid ColumnDefinitions="Auto,*" Margin="12,6" ColumnSpacing="8">
                <Border Grid.Column="0"
                        CornerRadius="3" Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentAmberBrush}">
                    <TextBlock Text="BUILDING LAIR"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#0E0E0E"/>
                </Border>
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           Text="{Binding LairBuildStatusText}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
