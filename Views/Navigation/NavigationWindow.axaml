<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Navigation"
        xmlns:controls="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="FujinTerm.Views.Navigation.NavigationWindow"
        x:DataType="vm:NavigationViewModel"
        Title="Navigation"
        Width="1280" Height="720"
        MinWidth="780" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <Style Selector="Border.StatusBadge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.StatusBadge TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="Button.ModeChip">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ModeChip.Active">
            <Setter Property="Background" Value="#F8B500"/>
            <Setter Property="Foreground" Value="#0E0E0E"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top status + mode bar -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="12,8">
                <TextBlock Grid.Column="0" Text="Navigation" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Border Grid.Column="1" Classes="StatusBadge"
                        Background="{Binding StatusBadgeBrush}">
                    <TextBlock Text="{Binding StatusLabel}"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding CurrentRoomLabel}"
                           Margin="10,0" VerticalAlignment="Center"
                           Foreground="#BBB" FontSize="12"/>
                <Button Grid.Column="3" Classes="ModeChip" Content="Loop mode"
                        Command="{Binding ToggleLoopModeCommand}"
                        Classes.Active="{Binding IsLoopMode}"/>
                <Button Grid.Column="4" Classes="ModeChip" Content="Lair mode"
                        Command="{Binding ToggleLairModeCommand}"
                        Classes.Active="{Binding IsLairMode}"/>
                <Button Grid.Column="5" Classes="ModeChip" Content="Pause"
                        Command="{Binding PauseOrResumeCommand}"
                        IsVisible="{Binding !IsPaused}"/>
                <Button Grid.Column="5" Classes="ModeChip" Content="Resume"
                        Command="{Binding PauseOrResumeCommand}"
                        IsVisible="{Binding IsPaused}"/>
            </Grid>
        </Border>

        <!-- Main: map placeholder | right rail -->
        <Grid Grid.Row="1" ColumnDefinitions="*,260">

            <controls:MapControl Grid.Column="0"
                                 Name="MapHost"
                                 Layout="{Binding Layout}"
                                 CurrentRoomKey="{Binding CurrentRoomKey}"
                                 Graph="{Binding Graph}">
                <controls:MapControl.ContextMenu>
                    <ContextMenu Name="RoomContextMenu">
                        <MenuItem Header="{Binding ContextRoomName, StringFormat='At: {0}'}"
                                  IsEnabled="False" FontWeight="SemiBold"/>
                        <Separator/>
                        <MenuItem Header="Walk here"
                                  Command="{Binding WalkToContextRoomCommand}"/>
                        <MenuItem Header="I am here (set located)"
                                  Command="{Binding SetContextRoomLocatedCommand}"/>
                        <Separator/>
                        <MenuItem Header="Toggle: Avoid this room"
                                  Command="{Binding ToggleContextRoomAvoidedCommand}"/>
                        <MenuItem Header="Toggle: Stash room"
                                  Command="{Binding ToggleContextRoomStashCommand}"/>
                    </ContextMenu>
                </controls:MapControl.ContextMenu>
            </controls:MapControl>

            <Border Grid.Column="1" Background="#141414"
                    BorderBrush="#2A2A2A" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*" Margin="12,8">

                    <!-- Search box always on top so the user can find a
                         room while a walk is in progress. -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="SectionHeader" Text="SEARCH ROOMS"/>
                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                 FontSize="11"
                                 BorderBrush="#2A2A2A"/>
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 Margin="0,6,0,0"
                                 MaxHeight="220"
                                 IsVisible="{Binding HasSearchResults}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoomSearchResult">
                                    <Border Padding="6,3"
                                            PointerPressed="OnSearchResultClicked"
                                            Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="#DDD"/>
                                            <TextBlock Text="{Binding DisplayLocation}"
                                                       FontSize="10"
                                                       Foreground="#777"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Rest of the rail. -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="SectionHeader" Text="CURRENT NAV"/>
                        <TextBlock Text="No active navigation."
                                   Foreground="#666" FontSize="11"
                                   IsVisible="{Binding !IsWalking}"/>
                        <TextBlock Text="Walking — see status strip above."
                                   Foreground="#3DDC97" FontSize="11"
                                   IsVisible="{Binding IsWalking}"/>

                        <TextBlock Classes="SectionHeader" Text="GOTO"/>
                        <TextBlock Text="Favourites land in PR 7.13."
                                   Foreground="#555" FontSize="11"/>

                        <TextBlock Classes="SectionHeader" Text="LOOPS"/>
                        <TextBlock Text="No loops saved on this BBS."
                                   Foreground="#666" FontSize="11"
                                   IsVisible="{Binding !HasLoops}"/>
                        <Button Content="Stop running loop" FontSize="11"
                                Padding="8,2" Margin="0,4,0,0"
                                IsVisible="{Binding IsLoopRunning}"
                                Command="{Binding StopLoopCommand}"/>
                        <ItemsControl ItemsSource="{Binding Loops}"
                                      IsVisible="{Binding HasLoops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoopRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       Foreground="#DDD"/>
                                            <TextBlock FontSize="10" Foreground="#777">
                                                <Run Text="{Binding SubLabel}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding LastRunBadge}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Run"
                                                FontSize="11" Padding="8,2"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:NavigationViewModel)DataContext).RunLoopCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom strip: loop builder state. Visible only when
             a loop session is active. -->
        <Border Grid.Row="2" Background="#1A1A1A"
                BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
                IsVisible="{Binding IsLoopBuilding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,8" ColumnSpacing="8">
                <Border Grid.Column="0" Classes="StatusBadge" Background="#F8B500">
                    <TextBlock Text="BUILDING LOOP"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="#BBB">
                        <Run Text="{Binding LoopBuilder.Clicks.Count, FallbackValue=0}"/>
                        <Run Text=" room(s) clicked · "/>
                        <Run Text="{Binding LoopBuilder.ExpandedStepCount, FallbackValue=0}"/>
                        <Run Text=" step(s) total"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#F25C54"
                               Text="{Binding LoopBuilder.UnreachableSummary}"
                               IsVisible="{Binding LoopBuilder.UnreachableSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <TextBox Grid.Column="2"
                         Text="{Binding LoopBuilder.ProposedName, Mode=TwoWay}"
                         Width="180" FontSize="11"/>
                <CheckBox Grid.Column="3"
                          Content="Closed loop"
                          IsChecked="{Binding LoopBuilder.CloseLoop, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Content="Save"
                            Command="{Binding SaveLoopBuilderCommand}"
                            IsEnabled="{Binding LoopBuilder.CanSave, FallbackValue=False}"/>
                    <Button Content="Discard"
                            Command="{Binding DiscardLoopBuilderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
