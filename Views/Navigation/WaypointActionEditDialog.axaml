<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        xmlns:ctl="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="220"
        x:Class="MudPlay.Views.Navigation.WaypointActionEditDialog"
        x:DataType="vm:WaypointActionEditDialogViewModel"
        Title="Waypoint action"
        Width="480" MinWidth="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

            <TextBlock Grid.Row="0"
                       Text="{Binding WaypointLabel}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource ChromeFgBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <Grid Grid.Row="1" ColumnDefinitions="80,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Command" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="e.g. rest  ·  chain with ; or ^M: get all;drop coins"
                           FontSize="11"
                           ToolTip.Tip="Sent when the loop reaches this waypoint. Chain several commands with ; or ^M — each is sent as its own line (e.g. 'get all;drop coins')."/>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="80,Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Delay" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
                <ctl:LoopDelayEditor Grid.Column="1"
                                     DelayMs="{Binding DelayMs, Mode=TwoWay}"
                                     FontSize="11"
                                     ToolTip.Tip="How long to wait after the command before the loop moves on, counted in real time from the command (sent once the room is clear). A fight during the wait doesn't stop the clock; the loop still moves only when the room is clear."/>
                <TextBlock Grid.Column="2"
                           Text="0 = move on once the command is answered"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="3" VerticalAlignment="Top" Spacing="6">
                <CheckBox IsChecked="{Binding DoNotRest, Mode=TwoWay}"
                          Content="Do not rest in this room"
                          FontSize="11"
                          ToolTip.Tip="When HP/MA drop below your 'rest if below' gates, the loop won't rest in THIS room — it advances to the next room instead. Only this exact room is protected; resting resumes the moment you step out (loops only)."/>
                <CheckBox IsChecked="{Binding DoNotAttack, Mode=TwoWay}"
                          Content="Do not attack in this room"
                          FontSize="11"
                          ToolTip.Tip="The loop skips combat in THIS room as if auto-combat were off, walking on even if the Min/Max monster count is met. One exception: if a rest is triggered here, it still clears the room so the rest can proceed. Only this exact room is affected (loops only)."/>
                <CheckBox IsChecked="{Binding RestHereHp, Mode=TwoWay}"
                          Content="Rest up here (HP)"
                          FontSize="11"
                          ToolTip.Tip="On arriving, rest until HP is back to its rest-max ('rest to' on the Health tab) before moving on — even above your 'rest if below' trigger. Skipped when HP is already there (loops only)."/>
                <CheckBox IsChecked="{Binding RestHereMana, Mode=TwoWay}"
                          Content="Rest up here (mana)"
                          FontSize="11"
                          ToolTip.Tip="On arriving, rest until mana is back to its rest-max before moving on — even above your 'rest if below' trigger. Skipped when mana is already there (loops only)."/>
                <CheckBox IsChecked="{Binding StartHere, Mode=TwoWay}"
                          Content="When starting this loop, always go to this room first"
                          FontSize="11"
                          ToolTip.Tip="Starting the loop walks here first and opens the lap in this room, even when you stand on the loop somewhere else. Without it, a start joins the loop at its nearest room. One room per loop: ticking it here clears it from the others. A loop picked back up after a detour, a recovery or a reconnect carries on where it was."/>
                <TextBlock Text="{Binding StartRoomNote}"
                           IsVisible="{Binding StartRoomNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Margin="28,-2,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource ChromeFgMutedBrush}"/>

                <!-- The lap wait reads the lap's clock, not the command's, so it sits in
                     a box of its own, apart from the Delay above. -->
                <Border Margin="0,6,0,0" Padding="8" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{StaticResource ChromeBorderBrush}"
                        Background="{StaticResource ChromeBgSunkenBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Lap time" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource ChromeFgBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Wait here until the lap has run" FontSize="11"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <ctl:LoopDelayEditor DelayMs="{Binding LapWaitMs, Mode=TwoWay}"
                                                 FontSize="11"
                                                 ToolTip.Tip="Hold in this room until the current lap has run at least this long, counted from the lap's start (not from the command). A lap already past it moves straight on."/>
                        </StackPanel>
                        <TextBlock Text="0 = off. Skipped on a lap joined partway round. Fights and rests go on while it waits."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        IsCancel="True" MinWidth="80"/>
                <Button Content="Save" Command="{Binding SaveCommand}"
                        IsDefault="True" MinWidth="80"
                        Classes="accent"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
