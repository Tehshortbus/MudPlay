<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="340"
        x:Class="FujinTerm.Views.Navigation.AmbiguousLocationDialog"
        x:DataType="vm:AmbiguousLocationDialogViewModel"
        Title="Which room are you in?"
        Width="420" Height="340"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">

            <TextBlock Grid.Row="0"
                       Text="{Binding Header}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ChromeFgBrush}"/>

            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="2">
                <TextBlock FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}">
                    <Run Text="Observed: "/>
                    <Run Text="{Binding ObservationName}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
                </TextBlock>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}">
                    <Run Text="Exits: "/>
                    <Run Text="{Binding ObservationExits}"
                         Foreground="{StaticResource ChromeFgBrush}"/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Row="2" Height="1"
                    Background="{StaticResource ChromeBorderBrush}"
                    Margin="0,2,0,2"/>

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Candidates}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="1"
                     BorderBrush="{StaticResource ChromeBorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AmbiguousCandidate">
                        <Grid ColumnDefinitions="70,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding KeyLabel}"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource ChromeFgMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="{StaticResource ChromeFgBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <!-- IsCancel routes Escape + title-bar X through DeferCommand (returns null,
                     tracker untouched, user is expected to right-click "I am here" later). -->
                <Button Grid.Column="0"
                        Content="I'll set it myself"
                        Command="{Binding DeferCommand}"
                        IsCancel="True"
                        ToolTip.Tip="Close this prompt. Right-click a room on the map and pick &quot;I am here&quot; when you're sure where you are."
                        MinWidth="140"/>
                <Button Grid.Column="2"
                        Content="Pick"
                        Command="{Binding PickCommand}"
                        IsEnabled="{Binding CanPick}"
                        IsDefault="True"
                        MinWidth="90"/>
            </Grid>
        </Grid>
    </Border>
</Window>
