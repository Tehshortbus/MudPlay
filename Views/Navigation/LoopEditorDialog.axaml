<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MudPlay.ViewModels.Navigation"
        xmlns:ctl="using:MudPlay.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="540"
        x:Class="MudPlay.Views.Navigation.LoopEditorDialog"
        x:DataType="vm:LoopEditorDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="996" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Border.WaypointRow">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="6,3"/>
            <Setter Property="Margin"       Value="0,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Background"   Value="Transparent"/>
        </Style>
        <Style Selector="Border.WaypointRow TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">

            <!-- Header row: Name -->
            <Grid Grid.Row="0" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Name" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="11"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Notes" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBox   Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="11"
                               AcceptsReturn="True"
                               Height="48"
                               TextWrapping="Wrap"/>
                    <CheckBox  Content="★  Set as favorite (shows in the right-click Favorites menu)"
                               IsChecked="{Binding Favorite, Mode=TwoWay}"
                               FontSize="11"/>
                    <!-- Entire Loop Setting: mirror of the nav rail's Entire Loop
                         Settings flyout. Loop-wide, not per-room, and saved for the
                         loaded character, not in the loop file. -->
                    <CheckBox  Content="⚔  Only attack in lair rooms (walk through the rest)"
                               IsChecked="{Binding OnlyAttackInLairRooms, Mode=TwoWay}"
                               FontSize="11"
                               ToolTip.Tip="When on, the loop only engages hostiles in game-data lair rooms; every other room is walked through as if auto-combat were off. A per-room 'do not attack' still skips even a lair room, and a triggered rest still clears any room so it can rest. This character's own setting for the loop: your other characters keep theirs."/>
                    <CheckBox Content="Wait to enter lairs until I can debuff"
                              FontSize="11"
                              IsChecked="{Binding WaitToDebuffBeforeLairs, Mode=TwoWay}"
                              ToolTip.Tip="Stand one step short of each lair until the round's between-round cast is free, so your combat profile's debuff goes out as you walk in instead of behind the attack. It also waits there while mana is under that debuff's Min mana per cast. Does nothing unless the profile has a debuff set, and skips lairs marked 'do not attack'. This character's own setting for the loop: your other characters keep theirs."/>
                    <ComboBox Margin="22,0,0,0" FontSize="11" MinWidth="160"
                              IsVisible="{Binding WaitToDebuffBeforeLairs}"
                              SelectedIndex="{Binding LairDebuffWaitChoice, Mode=TwoWay}">
                        <ComboBoxItem Content="Wait for spells" ToolTip.Tip="Cast the buffs, heals and cures that are due first (one a round, three rounds at most), then enter. Keeps buffs up; costs the wait."/>
                        <ComboBoxItem Content="Block spells" ToolTip.Tip="Hold buffs back and enter as soon as the cast is free (a round at most). Buffs are let through again once the debuff has gone out in the lair. Heals and cures are never held."/>
                        <ComboBoxItem Content="Wait for priority buff spells" ToolTip.Tip="Cast every buff ticked 'Priority buff' that is due first (one a round, however many) and hold every other buff back, then enter. The held buffs are let through again once the debuff has gone out in the lair. Heals and cures are never held."/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Waypoints header row — column titles aligned to the table's
                 shared ColumnDefinitions below. -->
            <!-- Column widths + insets must match the waypoint-row template below
                 EXACTLY or the headers drift off their cells: the ↑↓✕ columns are
                 fixed (not Auto) so the empty header cells don't collapse and widen
                 the * column, and the Margin matches the row's ListBox-border +
                 WaypointRow-border + padding inset (1+1+6). -->
            <Grid Grid.Row="2" ColumnDefinitions="32,*,150,132,50,50,50,50,132,92,30,30,30" ColumnSpacing="4"
                  Margin="8,4,8,2">
                <Grid.Styles>
                    <!-- Each label sits over its cell as the cell sits in the row: text
                         fields from their left edge, everything else centred. -->
                    <Style Selector="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
                    </Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="#" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="1" Text="Waypoint" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="2" Text="Command" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="3" Text="Delay (min / s)"/>
                <TextBlock Grid.Column="4" Text="No rest"/>
                <TextBlock Grid.Column="5" Text="No atk"/>
                <TextBlock Grid.Column="6" Text="Rest HP"/>
                <TextBlock Grid.Column="7" Text="Rest MA"/>
                <TextBlock Grid.Column="8" Text="Wait for lap (min / s)"/>
                <TextBlock Grid.Column="9" Text="Always Start Here"/>
            </Grid>

            <!-- Waypoint list -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Waypoints}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="1"
                     BorderBrush="{StaticResource ChromeBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoopWaypointRowViewModel">
                        <Border Classes="WaypointRow">
                            <!-- ColumnDefinitions must stay identical to the header grid
                                 above (fixed ↑↓✕ widths, not Auto) so headers line up. -->
                            <Grid ColumnDefinitions="32,*,150,132,50,50,50,50,132,92,30,30,30" ColumnSpacing="4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Index}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Inline per-waypoint action edits — command, delay,
                                     do-not-rest, do-not-attack (replaces the old ✎
                                     dialog for edit-time; the build-time strip keeps it). -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="10" Padding="4,1"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="cmd on arrival"
                                         ToolTip.Tip="Command sent when the loop reaches this waypoint (chain with ; or ^M). Blank = none."/>
                                <ctl:LoopDelayEditor Grid.Column="3"
                                                     DelayMs="{Binding DelayMs, Mode=TwoWay}"
                                                     ShowSpinners="False"
                                                     FontSize="10"
                                                     VerticalAlignment="Center"
                                                     ToolTip.Tip="Minutes and seconds to wait after the command before moving on, in real time from the command. Ignored with no command."/>
                                <CheckBox Grid.Column="4"
                                          IsChecked="{Binding DoNotRest, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="Do not rest in this room — the loop advances instead of resting here."/>
                                <CheckBox Grid.Column="5"
                                          IsChecked="{Binding DoNotAttack, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="Do not attack in this room — the loop skips combat here (as if auto-combat were off), but a triggered rest still clears it."/>
                                <CheckBox Grid.Column="6"
                                          IsChecked="{Binding RestHereHp, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="Rest up here (HP) — on arriving, rest until HP is back to its rest-max ('rest to' on the Health tab) before moving on, even above your 'rest if below' trigger."/>
                                <CheckBox Grid.Column="7"
                                          IsChecked="{Binding RestHereMana, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="Rest up here (mana) — on arriving, rest until mana is back to its rest-max before moving on, even above your 'rest if below' trigger."/>
                                <ctl:LoopDelayEditor Grid.Column="8"
                                                     DelayMs="{Binding LapWaitMs, Mode=TwoWay}"
                                                     ShowSpinners="False"
                                                     FontSize="10"
                                                     VerticalAlignment="Center"
                                                     ToolTip.Tip="Wait here until the current lap has run at least this long, counted from the lap's start (not from the command). 0 = off; skipped on a lap joined partway round."/>
                                <CheckBox Grid.Column="9"
                                          IsChecked="{Binding StartHere, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip.Tip="When starting this loop, always go to this room first — a start walks here and opens the lap here, even from elsewhere on the loop. One room per loop; a loop picked back up after a detour, a recovery or a reconnect carries on where it was."/>
                                <Button Grid.Column="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="↑" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move earlier in cycle"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="11"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="↓" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move later in cycle"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveDownCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="12"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Content="✕" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Remove waypoint"
                                        Foreground="{StaticResource AccentRedBrush}"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add waypoint row — mirrors the Navigation window's
                 search box. Accepts a raw room key (1/297, 1,297,
                 bare 297) or substring against room names; live
                 results dropdown shows up to 50 matches. Enter on
                 the TextBox adds the highlighted (or top) result;
                 click a row to commit immediately. The TextBox's
                 KeyDown handler swallows Enter so it adds a row
                 instead of firing the IsDefault Save. -->
            <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0"
                               Text="Add room:"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBox Grid.Column="1" Classes="clearable"
                             Name="AddRoomTextBox"
                             Text="{Binding NewWaypointQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Room key (1/297) or name"
                             FontSize="11"
                             KeyDown="OnAddRoomKeyDown"/>
                    <Button Grid.Column="2"
                            Content="Add"
                            Command="{Binding AddWaypointCommand}"/>
                </Grid>
                <!-- Live results dropdown — visible only while there
                     are matches. Capped height so the dialog stays
                     usable on a small window; clicking a row adds
                     that room straight away. -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasSearchResults}"
                        Background="{StaticResource ChromeBgElevBrush}"
                        BorderBrush="{StaticResource ChromeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        MaxHeight="180"
                        Margin="60,2,40,0">
                    <ListBox Name="AddRoomResults"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomSearchResult">
                                <Border Padding="6,3"
                                        PointerPressed="OnAddRoomResultClicked"
                                        Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PrimaryLine}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ChromeFgBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SecondaryLine}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource ChromeFgMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding SecondaryLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock Grid.Row="2"
                           Text="{Binding AddWaypointError}"
                           IsVisible="{Binding HasAddWaypointError}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AccentRedBrush}"/>
            </Grid>

            <!-- Dialog buttons -->
            <Grid Grid.Row="6"
                  ColumnDefinitions="*,Auto"
                  Margin="0,6,0,0">
                <!-- Inline save error so the user sees why a Save
                     click didn't persist (empty name, too few
                     waypoints, no active game-data set, a name
                     already taken). -->
                <TextBlock Grid.Column="0"
                           Text="{Binding SaveError}"
                           IsVisible="{Binding HasSaveError}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AccentRedBrush}"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" MinWidth="80"/>
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            IsDefault="True" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
