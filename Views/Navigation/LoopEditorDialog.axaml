<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="540"
        x:Class="FujinTerm.Views.Navigation.LoopEditorDialog"
        x:DataType="vm:LoopEditorDialogViewModel"
        Title="Edit loop"
        Width="540" Height="560"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Per-row container; cyan border when the row has a command. -->
        <Style Selector="Border.WaypointRow">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="6,3"/>
            <Setter Property="Margin"       Value="0,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Background"   Value="Transparent"/>
        </Style>
        <Style Selector="Border.WaypointRow.HasCommand">
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
        <Style Selector="Border.WaypointRow TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">

            <!-- Header row: Name -->
            <Grid Grid.Row="0" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Name" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="11"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Notes" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="11"
                           AcceptsReturn="True"
                           Height="48"
                           TextWrapping="Wrap"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="Waypoints" FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource ChromeFgMutedBrush}"/>

            <!-- Waypoint list -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Waypoints}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="1"
                     BorderBrush="{StaticResource ChromeBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoopWaypointRowViewModel">
                        <Border Classes="WaypointRow"
                                Classes.HasCommand="{Binding HasCommand}">
                            <Grid ColumnDefinitions="32,*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Index}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Command}"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           Margin="6,0"
                                           IsVisible="{Binding HasCommand}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="120"/>
                                <Button Grid.Column="3"
                                        Content="↑" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move earlier in cycle"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="4"
                                        Content="↓" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move later in cycle"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveDownCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="5"
                                        Content="✕" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Remove waypoint"
                                        Foreground="{StaticResource AccentRedBrush}"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected-waypoint command editor — only meaningful with a
                 selection. Apply writes the textbox values back to the
                 selected row; Clear blanks them. -->
            <Border Grid.Row="4"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6"
                    IsVisible="{Binding HasSelection}">
                <Grid ColumnDefinitions="Auto,*,Auto,80,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Text="Command:"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBox   Grid.Column="1"
                               Text="{Binding SelectedCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Delay (ms):"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBox   Grid.Column="3"
                               Text="{Binding SelectedDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="11"/>
                    <Button    Grid.Column="4"
                               Content="Apply"
                               Command="{Binding ApplyCommandEditCommand}"/>
                    <Button    Grid.Column="5"
                               Content="Clear"
                               Command="{Binding ClearCommandCommand}"/>
                </Grid>
            </Border>

            <!-- Dialog buttons -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8" Margin="0,6,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" MinWidth="80"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        IsDefault="True" MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
