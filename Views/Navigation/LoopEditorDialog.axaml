<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels.Navigation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="540"
        x:Class="FujinTerm.Views.Navigation.LoopEditorDialog"
        x:DataType="vm:LoopEditorDialogViewModel"
        Title="Edit loop"
        Width="520" Height="540"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- Per-row container; coloured by IsCommand vs IsMove. -->
        <Style Selector="Border.StepRow">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="6,3"/>
            <Setter Property="Margin"       Value="0,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Background"   Value="Transparent"/>
        </Style>
        <Style Selector="Border.StepRow.Command">
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
        <Style Selector="Border.StepRow TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgBrush}"/>
        </Style>
        <Style Selector="Border.StepRow.Command TextBlock.StepLabel">
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{StaticResource ChromeBgBrush}" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="8">

            <!-- Header row: Name + Notes -->
            <Grid Grid.Row="0" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Name" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="11"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="60,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Notes" FontSize="11"
                           Foreground="{StaticResource ChromeFgMutedBrush}"
                           VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           FontSize="11"
                           AcceptsReturn="True"
                           Height="48"
                           TextWrapping="Wrap"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="Steps" FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource ChromeFgMutedBrush}"/>

            <!-- Steps list -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Steps}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="1"
                     BorderBrush="{StaticResource ChromeBorderBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoopStepRowViewModel">
                        <Border Classes="StepRow"
                                Classes.Command="{Binding IsCommand}">
                            <Grid ColumnDefinitions="32,*,Auto,Auto,Auto" ColumnSpacing="4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Index}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ChromeFgMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Classes="StepLabel"
                                           Text="{Binding DisplayLabel}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Content="↑" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move up (commands only)"
                                        IsEnabled="{Binding IsCommand}"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="3"
                                        Content="↓" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Move down (commands only)"
                                        IsEnabled="{Binding IsCommand}"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).MoveDownCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="4"
                                        Content="✕" FontSize="10" Padding="6,1"
                                        ToolTip.Tip="Remove (commands only)"
                                        IsEnabled="{Binding IsCommand}"
                                        Command="{Binding $parent[ListBox].((vm:LoopEditorDialogViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Insert buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal" Spacing="6">
                <Button Content="+ Insert command above"
                        Command="{Binding InsertCommandAboveCommand}"/>
                <Button Content="+ Insert command below"
                        Command="{Binding InsertCommandBelowCommand}"/>
            </StackPanel>

            <!-- Selected command editor -->
            <Border Grid.Row="5"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6"
                    IsVisible="{Binding SelectedRowIsCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto,80,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Text="Command:"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBox   Grid.Column="1"
                               Text="{Binding SelectedCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Delay (ms):"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ChromeFgMutedBrush}"/>
                    <TextBox   Grid.Column="3"
                               Text="{Binding SelectedDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="11"/>
                    <Button    Grid.Column="4"
                               Content="Apply"
                               Command="{Binding ApplyCommandEditCommand}"/>
                </Grid>
            </Border>

            <!-- Dialog buttons -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8" Margin="0,6,0,0">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" MinWidth="80"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        IsDefault="True" MinWidth="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
