<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:model="using:FujinTerm.Models.Profile"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
        x:Class="FujinTerm.Views.BlacklistEditorDialog"
        x:DataType="vm:BlacklistEditorDialogViewModel"
        Title="Modify Room Blacklist"
        Width="560" Height="440"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ChromeFgMutedBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Blacklisted rooms are hidden from the map render and the room search; edges into them render as dangling stubs. Tick &quot;Can't reach&quot; for dev / orphan rooms a normal player can never stand in — the navigation system then refuses to resolve your position into them."
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{StaticResource ChromeFgMutedBrush}"
                   Margin="0,0,0,10"/>

        <!-- Current entries list -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid RowDefinitions="Auto,*">
                <!-- Column headers -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="60,70,*,90"
                      Background="{StaticResource ChromeBgAltBrush}">
                    <TextBlock Grid.Column="0" Classes="SectionHeader" Text="Map"        Margin="8,4"/>
                    <TextBlock Grid.Column="1" Classes="SectionHeader" Text="Room"       Margin="0,4"/>
                    <TextBlock Grid.Column="2" Classes="SectionHeader" Text="Name"       Margin="0,4"/>
                    <TextBlock Grid.Column="3" Classes="SectionHeader" Text="Can't reach" Margin="0,4"/>
                </Grid>
                <ListBox Grid.Row="1"
                         x:Name="EntriesList"
                         ItemsSource="{Binding Entries}"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="model:BlacklistedRoom">
                            <Grid ColumnDefinitions="60,70,*,90">
                                <TextBlock Grid.Column="0" Text="{Binding Map}"  Margin="0,2"/>
                                <TextBlock Grid.Column="1" Text="{Binding Room}" Margin="0,2"/>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="0,2"
                                           TextTrimming="CharacterEllipsis"/>
                                <CheckBox  Grid.Column="3"
                                           IsChecked="{Binding CannotBeReached, Mode=TwoWay}"
                                           HorizontalAlignment="Center"
                                           ToolTip.Tip="Exclude this room from navigation position resolution (dev / unreachable room)."/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Remove selected -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,8">
            <Button Content="Remove selected"
                    Command="{Binding RemoveSelectedCommand}"
                    IsEnabled="{Binding CanRemoveSelected}"/>
        </StackPanel>

        <!-- Add row -->
        <Grid Grid.Row="3"
              ColumnDefinitions="60,80,80,80,*,Auto"
              ColumnSpacing="6"
              Margin="0,4,0,12">
            <TextBlock Grid.Column="0" Classes="Label" Text="Add — Map"/>
            <TextBox   Grid.Column="1"
                       Text="{Binding AddMap, Mode=TwoWay}"
                       PlaceholderText="map #"/>
            <TextBlock Grid.Column="2" Classes="Label" Text="Room" HorizontalAlignment="Right"/>
            <TextBox   Grid.Column="3"
                       Text="{Binding AddRoom, Mode=TwoWay}"
                       PlaceholderText="room #"/>
            <TextBlock Grid.Column="4" Classes="Label"
                       Text="{Binding AddNamePreview}"
                       TextTrimming="CharacterEllipsis"
                       Margin="6,0"/>
            <Button Grid.Column="5" Content="Add"
                    Command="{Binding AddRowCommand}"
                    IsEnabled="{Binding CanAdd}"
                    IsDefault="True"/>
        </Grid>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    MinWidth="80"/>
            <Button Content="Save"   Command="{Binding SaveCommand}"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
