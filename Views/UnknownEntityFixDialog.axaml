<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="280"
        x:Class="FujinTerm.Views.UnknownEntityFixDialog"
        x:DataType="vm:UnknownEntityFixDialogViewModel"
        Title="Fix unknown entity"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource ChromeBgBrush}" Padding="16">
        <StackPanel Spacing="10">

            <TextBlock Text="Unknown entity in Also Here line"
                       Foreground="{StaticResource ChromeFgBrush}"
                       FontSize="{StaticResource FontSizeLg}"
                       FontWeight="SemiBold"/>

            <!-- Raw Also-Here line, monospace + selectable for copy. -->
            <Border Background="{StaticResource ChromeBgSunkenBrush}"
                    BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                    BorderThickness="1"
                    Padding="8,6"
                    CornerRadius="{StaticResource CornerSm}">
                <SelectableTextBlock Text="{Binding RawAlsoHereLine}"
                                     Foreground="{StaticResource ChromeFgBrush}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="11"
                                     TextWrapping="Wrap"/>
            </Border>

            <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="Unknown name:"
                           Foreground="{StaticResource ChromeFgSecBrush}"
                           FontSize="{StaticResource FontSizeMd}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding UnknownEntity}"
                                     Foreground="{StaticResource AccentAmberBrush}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="{Binding GuidanceText}"
                       Foreground="{StaticResource ChromeFgSecBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Add as monster" Width="150"
                        Command="{Binding AddAsMonsterCommand}"
                        ToolTip.Tip="Insert a new MonsterMessageRecord with this name (AllowNoPrefix=true, all line lists empty). The classifier recognises the name on the next Also-Here parse; fill in hit / death / dodge lines later via the Monsters tab editor."/>
                <Button Content="Add as flavor prefix…" Width="160"
                        Command="{Binding AddFlavorPrefixCommand}"
                        ToolTip.Tip="Attach this name as a flavor prefix on an existing monster."/>
                <Button Content="Add player observation" Width="170"
                        Command="{Binding AddPlayerObservationCommand}"
                        ToolTip.Tip="Add a placeholder PlayerRecord to the per-BBS database. The next `who` enriches the row with class / race / alignment."/>
                <Button Content="Cancel" Width="80"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
