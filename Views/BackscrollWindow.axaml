<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctrl="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="725" d:DesignHeight="580"
        x:Class="FujinTerm.Views.BackscrollWindow"
        x:DataType="vm:BackscrollViewModel"
        Title="Backscroll"
        Width="725" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Content="Jump to end"
                        Command="{Binding JumpToEndCommand}"/>
                <TextBox Grid.Column="2" x:Name="SearchBox" MinWidth="240"
                         PlaceholderText="Search…"
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Margin="6,0,0,0"
                        Content="Find next"
                        Command="{Binding FindNextCommand}"/>
                <Button Grid.Column="4" Margin="6,0,0,0"
                        Content="Export…"
                        Command="{Binding ExportCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Transcript ============ -->
        <!-- BackscrollView is a virtualized canvas: it draws only the rows in
             view and owns its own (row, col) selection, so drag-select and copy
             stay flat no matter how deep the history runs. It implements
             ILogicalScrollable, so this ScrollViewer hands scrolling straight to
             it (only the visible slice is realized) instead of translating one
             tall bitmap. The timestamp gutter is drawn inside the control. -->
        <ScrollViewer x:Name="OuterScroll"
                      Background="Black"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ctrl:BackscrollView x:Name="Transcript"
                                 FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                 FontSize="16"/>
        </ScrollViewer>

    </DockPanel>
</Window>
