<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctl="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="725" d:DesignHeight="580"
        x:Class="FujinTerm.Views.BackscrollWindow"
        x:DataType="vm:BackscrollViewModel"
        Title="Backscroll"
        Width="725" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Content="Go to live"
                        Command="{Binding GoToLiveCommand}"/>
                <TextBox Grid.Column="2" x:Name="SearchBox" MinWidth="240"
                         PlaceholderText="Search…"
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Margin="6,0,0,0"
                        Content="Find next"
                        Command="{Binding FindNextCommand}"/>
                <Button Grid.Column="4" Margin="6,0,0,0"
                        Content="Export…"
                        Command="{Binding ExportCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Scrollback rows ============ -->
        <!-- Terminal-tight row spacing: ListBoxItem padding 0, no per-row
             margin, fixed line-height set on the cell renderer to match
             the Mx437 font's cell height (16 px). The default Fluent
             ListBoxItem ships with ~6 px vertical padding which reads as
             "double-spaced" against terminal output. -->
        <!-- Two-column layout inside one ScrollViewer so the gutter scrolls
             in lockstep with the body. Timestamps render in the gutter
             (non-selectable); body is a SelectableTextBlock so drag-select
             spans rows and Ctrl+C copies the multi-line range. Both
             controls share the same font + size so the lines stay aligned. -->
        <ScrollViewer x:Name="RowsScroll"
                      Background="Black"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      UseLayoutRounding="True">
            <Grid ColumnDefinitions="Auto,*" Margin="4">
                <ctl:TimestampGutter Grid.Column="0"
                                     Rows="{Binding Rows}"
                                     Margin="0,0,12,0"
                                     FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                     FontSize="16"/>
                <ctl:SelectableTranscript Grid.Column="1"
                                          x:Name="Transcript"
                                          Rows="{Binding Rows}"
                                          Foreground="White"
                                          FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                          FontSize="16"/>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
