<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:ctl="using:FujinTerm.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="725" d:DesignHeight="580"
        x:Class="FujinTerm.Views.BackscrollWindow"
        x:DataType="vm:BackscrollViewModel"
        Title="Backscroll"
        Width="725" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Content="Go to live"
                        Command="{Binding GoToLiveCommand}"/>
                <TextBox Grid.Column="2" x:Name="SearchBox" MinWidth="240"
                         PlaceholderText="Search…"
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Margin="6,0,0,0"
                        Content="Find next"
                        Command="{Binding FindNextCommand}"/>
                <Button Grid.Column="4" Margin="6,0,0,0"
                        Content="Export…"
                        Command="{Binding ExportCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Scrollback rows ============ -->
        <!-- One virtualizing ListBox so only the ~screenful of rows actually
             on screen ever materialise — a 10k+ row transcript would freeze
             the client if every row laid out at once. Each row is a
             two-column template: a non-selectable timestamp gutter plus a
             TranscriptRow (a per-row SelectableTextBlock) so drag-select +
             Ctrl+C copy work within a row, and ListBox multi-select + Ctrl+C
             copies whole rows across the range. ListBoxItem padding is zeroed
             to keep terminal-tight line spacing. -->
        <ListBox x:Name="RowsList"
                 ItemsSource="{Binding Rows}"
                 Background="Black"
                 BorderThickness="0"
                 Padding="4"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 UseLayoutRounding="True">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:BackscrollRowViewModel">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TimestampText}"
                                   Foreground="#808080"
                                   FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                   FontSize="16"
                                   Margin="0,0,12,0"/>
                        <ctl:TranscriptRow Grid.Column="1"
                                           Row="{Binding}"
                                           Foreground="White"
                                           FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                           FontSize="16"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
