<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FujinTerm.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="725" d:DesignHeight="580"
        x:Class="FujinTerm.Views.BackscrollWindow"
        x:DataType="vm:BackscrollViewModel"
        Title="Backscroll"
        Width="725" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- ============ Control strip ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ChromeBgElevBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <Button Grid.Column="0"
                        Content="Jump to end"
                        Command="{Binding JumpToEndCommand}"/>
                <TextBox Grid.Column="2" x:Name="SearchBox" MinWidth="240"
                         PlaceholderText="Search…"
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding FindNextCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Margin="6,0,0,0"
                        Content="Find next"
                        Command="{Binding FindNextCommand}"/>
                <Button Grid.Column="4" Margin="6,0,0,0"
                        Content="Export…"
                        Command="{Binding ExportCommand}"/>
            </Grid>
        </Border>

        <!-- ============ Status footer ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBgBrush}"
                BorderBrush="{StaticResource ChromeBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <TextBlock Foreground="{StaticResource ChromeFgMutedBrush}"
                       FontSize="11"
                       Text="{Binding StatusText}"/>
        </Border>

        <!-- ============ Transcript ============ -->
        <!-- The whole transcript is one SelectableTextBlock so drag-select spans
             lines and Ctrl+C copies the exact character range across rows —
             virtualization is dropped deliberately (the ring is capped, and a
             per-row ListBox can't span a text selection across its rows).
             Timestamps sit in a sibling gutter column so they align line-for-line
             (identical monospace metrics) yet stay out of the copied text. The
             code-behind rebuilds both from the VM's Rows. -->
        <Grid>
            <!-- Aliased text + edges (matching TerminalControl): the VGA bitmap
                 font fringes coloured pixels at glyph edges when anti-aliased,
                 which reads as colour bleeding off letters. Inherits down to the
                 gutter + transcript. -->
            <ScrollViewer x:Name="OuterScroll"
                          Background="Black"
                          TextOptions.TextRenderingMode="Alias"
                          RenderOptions.EdgeMode="Aliased"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="4">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0"
                               x:Name="Gutter"
                               Foreground="#808080"
                               FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                               FontSize="16"
                               Margin="0,0,12,0"/>
                    <SelectableTextBlock Grid.Column="1"
                                         x:Name="Transcript"
                                         Foreground="White"
                                         Background="Transparent"
                                         FontFamily="avares://FujinTerm/Assets/Fonts/Mx437_IBM_VGA_8x16.ttf#Mx437 IBM VGA 8x16"
                                         FontSize="16"
                                         TextWrapping="NoWrap"/>
                </Grid>
            </ScrollViewer>

            <!-- History/screen divider: an amber rule the code-behind positions
                 at the boundary between scrolled-off history and the screen
                 snapshot captured at open, offset by the vertical scroll.
                 Non-hit-testing so it never blocks a drag-select. -->
            <Border x:Name="HistoryDivider"
                    Height="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Background="{StaticResource AccentAmberBrush}"/>
        </Grid>

    </DockPanel>
</Window>
