<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build a desktop GUI executable; no console window opens on Windows. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FujinTerm</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Windows-only assembly manifest; harmless on Linux. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Avalonia: bind XAML to view-model properties at compile time so
         typos and bad bindings show up as build errors instead of silent
         no-ops at runtime. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed everything under Assets/ (fonts) into the assembly so it can
         be loaded at runtime via avares:// URIs. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- FujinTerm.Tests lives at the repo root as a sibling project. Without
         these exclusions the SDK's default Compile glob would pull every
         test file into the app assembly. -->
    <Compile Remove="FujinTerm.Tests\**" />
    <None Remove="FujinTerm.Tests\**" />
    <EmbeddedResource Remove="FujinTerm.Tests\**" />
    <AvaloniaResource Remove="FujinTerm.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FujinTerm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <!-- DataGrid widget — first-party Avalonia control shipped as a
         separate package; powers the Game Data Browser tables. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <!-- Diagnostics overlay (F12 dev tools) — only pulled in for Debug
         builds so Release ships without it. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Source-generated MVVM helpers ([ObservableProperty], [RelayCommand]). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <!-- Pure-managed Jet (.mdb / .accdb) reader for the Phase 5 MdbImporter.
         No OLE DB / ACE / ODBC / Wine — runs natively on Windows, Linux,
         and macOS. Jet3 + Jet4 + ACCDB. -->
    <PackageReference Include="JetDatabaseReader" Version="2.2.0" />
  </ItemGroup>

</Project>
